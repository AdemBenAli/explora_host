<div class="front-panorama-modal-overlay" id="frontPanoramaModal" aria-hidden="true" style="display:none;">
    <div class="front-panorama-modal-card" role="dialog" aria-modal="true" aria-labelledby="frontPanoramaTitle">
        <div class="front-panorama-modal-header">
            <div>
                <div class="front-panorama-modal-kicker">Panorama</div>
                <h2 id="frontPanoramaTitle">Panorama Viewer</h2>
            </div>
            <button type="button" class="front-panorama-modal-close" id="frontPanoramaCloseBtn" aria-label="Close panorama">×</button>
        </div>

        <div class="front-panorama-modal-body">
            <div class="front-panorama-loading" id="frontPanoramaLoading">Loading image...</div>
            <div class="front-panorama-notice" id="frontPanoramaNotice" style="display:none;"></div>

            <div class="front-panorama-stage" id="frontPanoramaStage" style="display:none;">
                <div class="front-panorama-viewer-wrap" id="frontPanoramaViewerWrap" style="display:none;">
                    <iframe
                        class="front-panorama-viewer-frame"
                        id="frontPanoramaViewerFrame"
                        title="Panorama viewer"
                        loading="lazy"
                        referrerpolicy="no-referrer"
                    ></iframe>
                </div>
                <div class="front-panorama-fallback-wrap" id="frontPanoramaFallbackWrap" style="display:none;">
                    <img src="" alt="" class="front-panorama-fallback-image" id="frontPanoramaFallbackImage">
                </div>
            </div>
        </div>
    </div>
</div>


<script>

document.addEventListener('DOMContentLoaded', function () {
    const panoramaModal = document.getElementById('frontPanoramaModal');
    const panoramaCloseBtn = document.getElementById('frontPanoramaCloseBtn');
    const panoramaTitle = document.getElementById('frontPanoramaTitle');
    const panoramaLoading = document.getElementById('frontPanoramaLoading');
    const panoramaNotice = document.getElementById('frontPanoramaNotice');
    const panoramaStage = document.getElementById('frontPanoramaStage');
    const panoramaViewerWrap = document.getElementById('frontPanoramaViewerWrap');
    const panoramaViewerFrame = document.getElementById('frontPanoramaViewerFrame');
    const panoramaFallbackWrap = document.getElementById('frontPanoramaFallbackWrap');
    const panoramaFallbackImage = document.getElementById('frontPanoramaFallbackImage');

    if (!panoramaModal || !panoramaCloseBtn || !panoramaTitle || !panoramaLoading || !panoramaNotice || !panoramaStage || !panoramaViewerWrap || !panoramaViewerFrame || !panoramaFallbackWrap || !panoramaFallbackImage) {
        return;
    }

    function resetPanoramaModal() {
        panoramaViewerFrame.removeAttribute('srcdoc');
        panoramaViewerWrap.style.display = 'none';
        panoramaFallbackWrap.style.display = 'none';
        panoramaStage.style.display = 'none';
        panoramaNotice.style.display = 'none';
        panoramaNotice.textContent = '';
        panoramaLoading.style.display = 'flex';
        panoramaLoading.textContent = 'Loading image...';
        panoramaFallbackImage.removeAttribute('src');
        panoramaFallbackImage.setAttribute('alt', '');
    }

    window.openPanoramaModal = function openPanoramaModal() {
        panoramaModal.style.display = 'flex';
        panoramaModal.classList.add('active');
        panoramaModal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('modal-open');
    };

    window.closePanoramaModal = function closePanoramaModal() {
        panoramaModal.classList.remove('active');
        panoramaModal.style.display = 'none';
        panoramaModal.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('modal-open');
        resetPanoramaModal();
    };

    function shouldUsePanoramaViewer(src, width, height) {
        const safeSrc = String(src || '').toLowerCase();
        const ratio = height > 0 ? (width / height) : 0;
        return ratio >= 1.8 || /(?:360|pano|panorama|equirectangular)/.test(safeSrc);
    }

    function showFallbackImage(src, title, message) {
        panoramaLoading.style.display = 'none';
        panoramaStage.style.display = 'block';
        panoramaFallbackWrap.style.display = 'flex';
        panoramaViewerWrap.style.display = 'none';
        panoramaFallbackImage.src = src;
        panoramaFallbackImage.alt = title || 'Panorama image';
        panoramaNotice.textContent = message || '';
        panoramaNotice.style.display = message ? 'block' : 'none';
    }

    function buildPanoramaSrcdoc(src, title) {
        const safeSrc = JSON.stringify(src);
        const safeTitle = JSON.stringify(title || 'Panorama Viewer');

        return `<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${JSON.parse(safeTitle)}</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pannellum@2.5.7/build/pannellum.css">
<style>
html, body { margin:0; width:100%; height:100%; background:#eef2f7; overflow:hidden; }
#panorama { width:100%; height:100%; }
#fallback {
    display:none;
    width:100%;
    height:100%;
    align-items:center;
    justify-content:center;
    background:#eef2f7;
}
#fallback img {
    width:100%;
    height:100%;
    object-fit:contain;
}
</style>
</head>
<body>
<div id="panorama"></div>
<div id="fallback"><img src=${safeSrc} alt=${safeTitle}></div>
<script src="https://cdn.jsdelivr.net/npm/pannellum@2.5.7/build/pannellum.js"><\/script>
<script>
(function () {
    var loaded = false;
    function showFallback() {
        if (loaded) return;
        document.getElementById('panorama').style.display = 'none';
        document.getElementById('fallback').style.display = 'flex';
    }

    try {
        var viewer = pannellum.viewer('panorama', {
            type: 'equirectangular',
            panorama: ${safeSrc},
            autoLoad: true,
            showControls: true,
            showZoomCtrl: true,
            mouseZoom: true,
            draggable: true,
            hfov: 110,
            minHfov: 40,
            maxHfov: 140
        });

        viewer.on('load', function () {
            loaded = true;
            try { viewer.resize(); } catch (e) {}
        });

        viewer.on('error', showFallback);
        viewer.on('sceneerror', showFallback);
        setTimeout(function () {
            if (!loaded) showFallback();
        }, 1800);
    } catch (e) {
        showFallback();
    }
})();
<\/script>
</body>
</html>`;
    }

    function showPanoramaViewer(src, title) {
        panoramaLoading.style.display = 'none';
        panoramaStage.style.display = 'block';
        panoramaFallbackWrap.style.display = 'none';
        panoramaViewerWrap.style.display = 'block';
        panoramaNotice.textContent = 'Drag to rotate. Use the mouse wheel or touchpad to zoom.';
        panoramaNotice.style.display = 'block';
        panoramaViewerFrame.srcdoc = buildPanoramaSrcdoc(src, title);
    }

    function preloadAndOpenPanorama(src, title) {
        if (!src) {
            return;
        }

        resetPanoramaModal();
        panoramaTitle.textContent = title || 'Panorama Viewer';
        window.openPanoramaModal();

        const probe = new Image();
        probe.decoding = 'async';

        probe.onload = function () {
            const width = probe.naturalWidth || 0;
            const height = probe.naturalHeight || 0;

            if (shouldUsePanoramaViewer(src, width, height)) {
                showPanoramaViewer(src, title);
            } else {
                showFallbackImage(
                    src,
                    title,
                    'This image is not a real panoramic 360 photo. It is shown enlarged for a clearer view.'
                );
            }
        };

        probe.onerror = function () {
            panoramaLoading.textContent = 'Unable to load this image.';
            panoramaNotice.textContent = 'The image file path is invalid or the file does not exist.';
            panoramaNotice.style.display = 'block';
        };

        probe.src = src;
    }

    document.addEventListener('click', function (event) {
        const imageNode = event.target.closest('[data-panorama-open="true"]');
        if (!imageNode) {
            return;
        }

        event.preventDefault();
        preloadAndOpenPanorama(
            imageNode.getAttribute('data-panorama-src'),
            imageNode.getAttribute('data-panorama-title') || 'Panorama Viewer'
        );
    });

    panoramaCloseBtn.addEventListener('click', function () {
        window.closePanoramaModal();
    });

    panoramaModal.addEventListener('click', function (event) {
