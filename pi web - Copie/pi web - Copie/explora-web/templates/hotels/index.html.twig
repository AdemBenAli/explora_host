            'Vatican',
            'Venezuela',
            'Viêt Nam',
            'Yémen',
            'Zambie',
            'Zimbabwe'
        ];

        let activeIndex = -1;
        let currentSuggestions = [];

        function normalizeText(value) {
            return value
                .toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/[’']/g, '')
                .trim();
        }

        function hideCountrySuggestions() {
            countrySuggestions.style.display = 'none';
            countrySuggestions.innerHTML = '';
            activeIndex = -1;
            currentSuggestions = [];
        }

        function highlightActiveItem() {
            const buttons = countrySuggestions.querySelectorAll('.country-suggestion-item');

            buttons.forEach(function (button, index) {
                if (index === activeIndex) {
                    button.style.background = '#f4f7fb';
                    button.style.color = '#f7941d';
                } else {
                    button.style.background = '#ffffff';
                    button.style.color = '#1a3a5c';
                }
            });
        }

        function selectSuggestion(country) {
            destinationInput.value = country;
            hideCountrySuggestions();
            destinationInput.focus();
        }

        function showCountrySuggestions(items) {
            countrySuggestions.innerHTML = '';

            if (!items.length) {
                hideCountrySuggestions();
                return;
            }

            currentSuggestions = items;
            activeIndex = -1;

            items.forEach(function (country) {
                const item = document.createElement('button');
                item.type = 'button';
                item.className = 'country-suggestion-item';
                item.textContent = country;
                item.style.display = 'block';
                item.style.width = '100%';
                item.style.padding = '16px 24px';
                item.style.border = 'none';
                item.style.background = '#ffffff';
                item.style.textAlign = 'left';
                item.style.cursor = 'pointer';
                item.style.color = '#1a3a5c';
                item.style.fontSize = '16px';
                item.style.fontWeight = '700';
                item.style.transition = '0.15s ease';

                item.addEventListener('mouseenter', function () {
                    item.style.background = '#f8f9fb';
                });

                item.addEventListener('mouseleave', function () {
                    item.style.background = '#ffffff';
                });

                item.addEventListener('click', function () {
                    selectSuggestion(country);
                });

                countrySuggestions.appendChild(item);
            });

            countrySuggestions.style.display = 'block';
        }

        function updateCountrySuggestions() {
            const rawValue = destinationInput.value || '';
            const normalizedValue = normalizeText(rawValue);

            let startsWithMatches = [];
            let includesMatches = [];

            if (normalizedValue === '') {
                startsWithMatches = countries.slice();
            } else {
                countries.forEach(function (country) {
                    const normalizedCountry = normalizeText(country);

                    if (normalizedCountry.startsWith(normalizedValue)) {
                        startsWithMatches.push(country);
                    } else if (normalizedCountry.includes(normalizedValue)) {
                        includesMatches.push(country);
                    }
                });
            }

            const finalMatches = startsWithMatches.concat(includesMatches).slice(0, 10);
            showCountrySuggestions(finalMatches);
        }

        destinationInput.addEventListener('focus', function () {
            updateCountrySuggestions();
        });

        destinationInput.addEventListener('input', function () {
            updateCountrySuggestions();
        });

        destinationInput.addEventListener('keydown', function (event) {
            if (countrySuggestions.style.display !== 'block' || currentSuggestions.length === 0) {
                return;
            }

            if (event.key === 'ArrowDown') {
                event.preventDefault();
                activeIndex = (activeIndex + 1) % currentSuggestions.length;
                highlightActiveItem();
            } else if (event.key === 'ArrowUp') {
                event.preventDefault();
                activeIndex = (activeIndex - 1 + currentSuggestions.length) % currentSuggestions.length;
                highlightActiveItem();
            } else if (event.key === 'Enter') {
                if (activeIndex >= 0 && currentSuggestions[activeIndex]) {
                    event.preventDefault();
                    selectSuggestion(currentSuggestions[activeIndex]);
                }
            } else if (event.key === 'Escape') {
                hideCountrySuggestions();
            }
        });

        document.addEventListener('click', function (event) {
            if (!destinationInput.contains(event.target) && !countrySuggestions.contains(event.target)) {
                hideCountrySuggestions();
            }
        });
    }
});

document.addEventListener('DOMContentLoaded', function () {
    const mapModal = document.getElementById('mapModal');
    const mapFrame = document.getElementById('mapFrame');
    const mapCloseTopBtn = document.getElementById('mapCloseTopBtn');
    const mapHotelTitle = document.getElementById('mapHotelTitle');
    const mapButtons = document.querySelectorAll('.js-open-map');
    const page = document.getElementById('frontHotelsPage');

    if (!mapModal || !mapFrame || !mapButtons.length || !page) {
        return;
    }

    function blurPage() {
        page.classList.add('page-blurred');
        document.body.style.overflow = 'hidden';
    }

    function unblurPage() {
        page.classList.remove('page-blurred');
        document.body.style.overflow = '';
    }

    function openMapModal(hotelName, lat, lng, price) {
        const numLat = parseFloat(lat);
        const numLng = parseFloat(lng);

        if (
            Number.isNaN(numLat) ||
            Number.isNaN(numLng) ||
            (numLat === 0 && numLng === 0)
        ) {
            alert('Aucune localisation définie pour cet hébergement.');
            return;
        }

        mapHotelTitle.textContent = hotelName || 'Hotel';

        const src =
            "{{ asset('map/leaflet_map.html') }}" +
            '?lat=' + encodeURIComponent(numLat) +
            '&lng=' + encodeURIComponent(numLng) +
            '&name=' + encodeURIComponent(hotelName || 'Hotel') +
            '&price=' + encodeURIComponent(price || '');

        mapFrame.src = src;
        mapModal.style.display = 'flex';
        mapModal.setAttribute('aria-hidden', 'false');
        blurPage();
    }

    function closeMapModal() {
        mapModal.style.display = 'none';
        mapModal.setAttribute('aria-hidden', 'true');
        mapFrame.src = "{{ asset('map/leaflet_map.html') }}";
        unblurPage();
    }

    mapButtons.forEach(function (button) {
        button.addEventListener('click', function () {
            openMapModal(
                this.dataset.hotelName,
                this.dataset.hotelLat,
                this.dataset.hotelLng,
                this.dataset.hotelPrice
            );
        });
    });

    mapCloseTopBtn.addEventListener('click', closeMapModal);

    mapModal.addEventListener('click', function (event) {
        if (event.target === mapModal) {
            closeMapModal();
        }
    });

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && mapModal.style.display === 'flex') {
            closeMapModal();
        }
    });
});

document.addEventListener('DOMContentLoaded', function () {
    const modal = document.getElementById('bookingModal');
    const page = document.getElementById('frontHotelsPage');

    const bookingHotelId = document.getElementById('bookingHotelId');
    const bookingHotelName = document.getElementById('bookingHotelName');
    const bookingBasePrice = document.getElementById('bookingBasePrice');

    const bookingCheckin = document.getElementById('bookingCheckin');
    const bookingCheckout = document.getElementById('bookingCheckout');
    const bookingRooms = document.getElementById('bookingRooms');
    const bookingOccupancy = document.getElementById('bookingOccupancy');
    const bookingGuests = document.getElementById('bookingGuests');
    const bookingRoomType = document.getElementById('bookingRoomType');

    const bookingDetailsBtn = document.getElementById('bookingDetailsBtn');
    const bookingCancelBtn = document.getElementById('bookingCancelBtn');
    const bookingCloseTopBtn = document.getElementById('bookingCloseTopBtn');
    const guestDetailsSection = document.getElementById('guestDetailsSection');
    const guestDetailsContainer = document.getElementById('guestDetailsContainer');
    const bookingFilledText = document.getElementById('bookingFilledText');

    const bookingNights = document.getElementById('bookingNights');
    const bookingRoomSummary = document.getElementById('bookingRoomSummary');
    const bookingSubtotal = document.getElementById('bookingSubtotal');
    const bookingRoomSurcharge = document.getElementById('bookingRoomSurcharge');
    const bookingWeekendSurcharge = document.getElementById('bookingWeekendSurcharge');
    const bookingDiscount = document.getElementById('bookingDiscount');
    const bookingTotal = document.getElementById('bookingTotal');

    const openButtons = document.querySelectorAll('.js-open-booking');

    if (!modal || !page || openButtons.length === 0) {
        return;
    }

    function formatMoney(value) {
        return '$' + Number(value).toFixed(1);
    }

    function formatPercent(value) {
        return Math.round(value * 100) + '%';
    }

    function getRoomMultiplier(roomType) {
        if (roomType === 'Deluxe') {
            return 1.15;
        }
        if (roomType === 'Suite') {
            return 1.30;
        }
        return 1.00;
    }

    function parseDate(value) {
        if (!value) {
            return null;
        }

        const parts = value.split('-');
        if (parts.length !== 3) {
            return null;
        }

        return new Date(parts[0], parts[1] - 1, parts[2]);
    }

    function diffDays(start, end) {
        const oneDay = 1000 * 60 * 60 * 24;
        return Math.round((end - start) / oneDay);
    }

    function countWeekendNights(start, end) {
        let count = 0;
        let current = new Date(start.getFullYear(), start.getMonth(), start.getDate());

        while (current < end) {
            const day = current.getDay();
            if (day === 5 || day === 6) {
                count++;
            }
            current.setDate(current.getDate() + 1);
        }

        return count;
    }

    function todayString() {
        const today = new Date();
        const year = today.getFullYear();
        const month = String(today.getMonth() + 1).padStart(2, '0');
        const day = String(today.getDate()).padStart(2, '0');

        return year + '-' + month + '-' + day;
    }

    function enforceReservationDates() {
        const today = todayString();

        bookingCheckin.min = today;

        if (!bookingCheckin.value || bookingCheckin.value < today) {
            bookingCheckin.value = today;
        }

        bookingCheckout.min = bookingCheckin.value || today;

        if (bookingCheckout.value && bookingCheckout.value <= bookingCheckin.value) {
            const checkinDate = parseDate(bookingCheckin.value);
            if (checkinDate) {
                checkinDate.setDate(checkinDate.getDate() + 1);
                const year = checkinDate.getFullYear();
                const month = String(checkinDate.getMonth() + 1).padStart(2, '0');
                const day = String(checkinDate.getDate()).padStart(2, '0');
                bookingCheckout.value = year + '-' + month + '-' + day;
            }
        }
    }

    function updateFilledText() {
        const nameInputs = guestDetailsContainer.querySelectorAll('input[name="guestNames[]"]');
        let filled = 0;

        nameInputs.forEach(function (input) {
            if (input.value.trim() !== '') {
                filled++;
            }
        });

        bookingFilledText.textContent = filled + '/' + nameInputs.length + ' filled';
    }

    function generateGuestFields() {
        const guests = Math.max(1, parseInt(bookingGuests.value || '1', 10));

        guestDetailsContainer.innerHTML = '';

        for (let i = 0; i < guests; i++) {
            const row = document.createElement('div');
            row.style.display = 'grid';
            row.style.gridTemplateColumns = '1fr 200px';
            row.style.gap = '12px';
            row.style.marginBottom = '10px';

            const nameInput = document.createElement('input');
            nameInput.type = 'text';
            nameInput.name = 'guestNames[]';
            nameInput.placeholder = 'Guest ' + (i + 1) + ' full name';
            nameInput.style.width = '100%';
            nameInput.style.height = '44px';
            nameInput.style.border = '1px solid #cfd7e2';
            nameInput.style.borderRadius = '10px';
            nameInput.style.padding = '0 14px';
            nameInput.style.fontSize = '14px';
            nameInput.addEventListener('input', updateFilledText);

            const birthInput = document.createElement('input');
            birthInput.type = 'date';
            birthInput.name = 'guestBirthDates[]';
            birthInput.placeholder = 'Birth date';
            birthInput.title = 'Birth date';
            birthInput.max = todayString();
            birthInput.style.width = '100%';
            birthInput.style.height = '44px';
            birthInput.style.border = '1px solid #cfd7e2';
            birthInput.style.borderRadius = '10px';
            birthInput.style.padding = '0 14px';
            birthInput.style.fontSize = '14px';
            birthInput.style.color = '#6c757d';

            row.appendChild(nameInput);
            row.appendChild(birthInput);
            guestDetailsContainer.appendChild(row);
        }

        updateFilledText();
    }

    function updateGuestsCapacity() {
        const rooms = Math.max(1, parseInt(bookingRooms.value || '1', 10));
        const occupancy = bookingOccupancy.value;
        const perRoom = occupancy === 'SINGLE' ? 1 : 2;
        const maxGuests = rooms * perRoom;

        bookingGuests.max = String(maxGuests);

        if (parseInt(bookingGuests.value || '1', 10) > maxGuests) {
            bookingGuests.value = maxGuests;
        }

        if (parseInt(bookingGuests.value || '1', 10) < 1) {
            bookingGuests.value = 1;
        }

        generateGuestFields();
    }

    function updatePriceDetails() {
        const basePrice = parseFloat(bookingBasePrice.value || '0');
        const checkin = parseDate(bookingCheckin.value);
        const checkout = parseDate(bookingCheckout.value);
        const rooms = Math.max(1, parseInt(bookingRooms.value || '1', 10));
        const guests = Math.max(1, parseInt(bookingGuests.value || '1', 10));
        const occupancy = bookingOccupancy.value || 'DOUBLE';
        const roomType = bookingRoomType.value || 'Standard';
        const multiplier = getRoomMultiplier(roomType);

        let nights = 0;
        let baseSubtotal = 0;
        let roomTypeSurcharge = 0;
        let weekendSurcharge = 0;
        let discount = 0;
        let total = 0;
        let discountRate = 0;
        let discountLabel = '';

        if (checkin && checkout && checkout > checkin) {
            nights = diffDays(checkin, checkout);

            const baseWithoutMultiplier = basePrice * nights * rooms;
            baseSubtotal = baseWithoutMultiplier * multiplier;
            roomTypeSurcharge = baseSubtotal - baseWithoutMultiplier;

            const weekendCount = countWeekendNights(checkin, checkout);
            weekendSurcharge = weekendCount * (basePrice * multiplier * 0.15 * rooms);

            if (nights >= 10) {
                discountRate = 0.20;
                discountLabel = ' (10+ nights)';
            } else if (nights >= 5) {
                discountRate = 0.10;
                discountLabel = ' (5+ nights)';
            }

            discount = (baseSubtotal + weekendSurcharge) * discountRate;
            total = (baseSubtotal + weekendSurcharge) - discount;
        }

        bookingNights.textContent = String(nights);

        const roomSummaryParts = [];
        roomSummaryParts.push(roomType);
        roomSummaryParts.push(occupancy === 'SINGLE' ? 'Single' : 'Double');
        roomSummaryParts.push(rooms + ' room' + (rooms > 1 ? 's' : ''));
        roomSummaryParts.push(guests + ' guest' + (guests > 1 ? 's' : ''));

        bookingRoomSummary.textContent = roomSummaryParts.join(' • ');

        bookingSubtotal.textContent = formatMoney(baseSubtotal);

        if (roomTypeSurcharge > 0) {
            bookingRoomSurcharge.textContent = '+ ' + formatMoney(roomTypeSurcharge) + ' (' + formatPercent(multiplier - 1) + ')';
        } else {
            bookingRoomSurcharge.textContent = formatMoney(0);
        }

        if (weekendSurcharge > 0) {
            bookingWeekendSurcharge.textContent = '+ ' + formatMoney(weekendSurcharge);
        } else {
            bookingWeekendSurcharge.textContent = formatMoney(0);
        }

        if (discount > 0) {
            bookingDiscount.textContent = '- ' + formatMoney(discount) + ' (' + formatPercent(discountRate) + ')' + discountLabel;
        } else {
            bookingDiscount.textContent = '- ' + formatMoney(0);
        }

        bookingTotal.textContent = formatMoney(total);
    }

    function openBookingModal(hotelId, hotelName, pricePerNight) {
        bookingHotelId.value = hotelId;
        bookingHotelName.textContent = 'Hotel: ' + hotelName;
        bookingBasePrice.value = pricePerNight;

        modal.style.display = 'flex';
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        page.style.filter = 'blur(6px)';
        page.style.pointerEvents = 'none';
        page.style.userSelect = 'none';

        enforceReservationDates();
        updateGuestsCapacity();
        updatePriceDetails();
    }

    function closeBookingModal() {
        modal.style.display = 'none';
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        page.style.filter = '';
        page.style.pointerEvents = '';
        page.style.userSelect = '';
    }

    openButtons.forEach(function (button) {
        button.addEventListener('click', function () {
            openBookingModal(
                this.dataset.hotelId,
                this.dataset.hotelName,
                this.dataset.hotelPrice
            );
        });
    });

    bookingDetailsBtn.addEventListener('click', function () {
        const isHidden = guestDetailsSection.style.display === 'none' || guestDetailsSection.style.display === '';
        guestDetailsSection.style.display = isHidden ? 'block' : 'none';
        if (isHidden) {
            generateGuestFields();
        }
    });

    bookingCancelBtn.addEventListener('click', closeBookingModal);
    bookingCloseTopBtn.addEventListener('click', closeBookingModal);

    bookingRooms.addEventListener('input', function () {
        updateGuestsCapacity();
        updatePriceDetails();
    });

    bookingOccupancy.addEventListener('change', function () {
        updateGuestsCapacity();
        updatePriceDetails();
    });

    bookingGuests.addEventListener('input', function () {
        updateGuestsCapacity();
        updatePriceDetails();
    });

    bookingRoomType.addEventListener('change', updatePriceDetails);

    bookingCheckin.addEventListener('change', function () {
        enforceReservationDates();
        updatePriceDetails();
    });

    bookingCheckout.addEventListener('change', function () {
        enforceReservationDates();
        updatePriceDetails();
    });

    modal.addEventListener('click', function (event) {
        if (event.target === modal) {
            closeBookingModal();
        }
    });

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && modal.style.display === 'flex') {
            closeBookingModal();
        }
    });

    document.getElementById('bookingForm').addEventListener('submit', function (event) {
        enforceReservationDates();

        if (bookingCheckout.value <= bookingCheckin.value) {
            event.preventDefault();
            alert('Check-out must be after check-in.');
            return;
        }

        if (bookingCheckin.value < todayString()) {
            event.preventDefault();
            alert('You cannot reserve a past date.');
        }
    });

    closeBookingModal();
    enforceReservationDates();
    generateGuestFields();
    updatePriceDetails();
});

