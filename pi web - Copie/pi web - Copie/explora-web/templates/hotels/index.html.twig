    const viewReviewsCloseBtn = document.getElementById('viewReviewsCloseBtn');
    const viewReviewsHotelTitle = document.getElementById('viewReviewsHotelTitle');
    const viewReviewsAlert = document.getElementById('viewReviewsAlert');
    const viewReviewsList = document.getElementById('viewReviewsList');
    const viewReviewsListMeta = document.getElementById('viewReviewsListMeta');
    const viewReviewsSummaryScore = document.getElementById('viewReviewsSummaryScore');
    const viewReviewsSummaryCount = document.getElementById('viewReviewsSummaryCount');
    const aiSummaryBox = document.getElementById('aiSummaryBox');
    const generateAiSummaryBtn = document.getElementById('generateAiSummaryBtn');
    const reviewSummaryCsrfToken = document.getElementById('reviewSummaryCsrfToken');

    if (!page) {
        return;
    }

    let currentHotelId = null;
    let predictTimer = null;
    let currentPredictedStars = 0;

    function blurPage() {
        document.body.style.overflow = 'hidden';
        page.style.filter = 'blur(6px)';
        page.style.pointerEvents = 'none';
        page.style.userSelect = 'none';
    }

    function unblurPage() {
        document.body.style.overflow = '';
        page.style.filter = '';
        page.style.pointerEvents = '';
        page.style.userSelect = '';
    }

    function escapeHtml(value) {
        return String(value || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function showAlert(element, message, type) {
        element.style.display = 'block';
        element.textContent = message;

        if (type === 'success') {
            element.style.background = '#e9f8ee';
            element.style.color = '#1f7a39';
            element.style.border = '1px solid #b7e4c7';
        } else {
            element.style.background = '#fdeceb';
            element.style.color = '#b42318';
            element.style.border = '1px solid #f5c2c7';
        }
    }

    function hideAlert(element) {
        element.style.display = 'none';
        element.textContent = '';
    }

    function setAutoStars(stars) {
        currentPredictedStars = Number(stars) || 0;

        const starNodes = addReviewAutoStars.querySelectorAll('span');
        starNodes.forEach(function (node, index) {
            if ((index + 1) <= currentPredictedStars) {
                node.className = 'review-auto-star review-auto-star-filled';
            } else {
                node.className = 'review-auto-star review-auto-star-empty';
            }
        });

        addReviewAutoText.textContent = 'Auto: ' + currentPredictedStars + '/5';
    }

    function renderReviewStars(note) {
        let html = '';
        const stars = Number(note) || 0;

        for (let i = 1; i <= 5; i++) {
            html += '<span style="color:' + (i <= stars ? '#f7941d' : '#d1dae5') + ';">★</span>';
        }

        return html;
    }

    function renderReviewList(reviews) {
        if (!reviews || !reviews.length) {
            viewReviewsList.innerHTML = `
                <div style="padding:18px;border:1px dashed #d6e0ea;border-radius:18px;color:#7b8794;background:#fcfdff;">
                    No reviews yet for this hotel.
                </div>
            `;
            viewReviewsListMeta.textContent = '0 review';
            return;
        }

        viewReviewsListMeta.textContent = reviews.length + ' review' + (reviews.length > 1 ? 's' : '');

        viewReviewsList.innerHTML = reviews.map(function (review) {
            return `
                <div class="review-list-card">
                    <div class="review-list-top">
                        <div class="review-list-author">${escapeHtml(review.author || 'Guest')}</div>
                        <div class="review-list-date">${escapeHtml(review.dateAvis || '')}</div>
                    </div>
                    <div class="review-list-stars">${renderReviewStars(review.note)}</div>
                    <div class="review-list-comment">${escapeHtml(review.commentaire || '')}</div>
                </div>
            `;
        }).join('');
    }

    function setSummary(summary) {
        const score10 = Number(summary && summary.score10 ? summary.score10 : 0);
        const count = Number(summary && summary.count ? summary.count : 0);

        viewReviewsSummaryScore.textContent = score10.toFixed(1) + ' / 10';
        viewReviewsSummaryCount.textContent = String(count);
    }

    function updateHotelCardSummary(hotelId, summary) {
        const textNode = document.querySelector('[data-summary-text="' + hotelId + '"]');
        const starsNode = document.querySelector('[data-summary-stars="' + hotelId + '"]');

        if (!textNode || !starsNode || !summary) {
            return;
        }

        const score10 = Number(summary.score10 || 0);
        const count = Number(summary.count || 0);
        const starsRounded = Number(summary.starsRounded || 0);

        if (count > 0) {
            textNode.textContent = score10.toFixed(1) + ' / 10 • ' + count + ' review' + (count > 1 ? 's' : '');
        } else {
            textNode.textContent = 'No reviews yet';
        }

        let starsHtml = '';
        for (let i = 1; i <= 5; i++) {
            starsHtml += '<span class="' + (i <= starsRounded ? 'front-star-filled' : 'front-star-empty') + '">★</span>';
        }
        starsNode.innerHTML = starsHtml;
    }

    async function fetchHotelReviews(hotelId) {
        const response = await fetch('/avis/hebergement/' + hotelId, {
            method: 'GET',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        });

        const data = await response.json();

        if (!response.ok || !data.success) {
            throw new Error(data.message || 'Unable to load reviews.');
        }

        return data;
    }

    async function loadHotelReviews(hotelId) {
        viewReviewsList.innerHTML = `
            <div style="padding:18px;border:1px dashed #d6e0ea;border-radius:18px;color:#7b8794;background:#fcfdff;">
                Loading reviews...
            </div>
        `;
        aiSummaryBox.textContent = 'Click “Generate” to build the AI summary from the existing reviews.';
        setSummary({ score10: 0, count: 0 });

        const data = await fetchHotelReviews(hotelId);

        renderReviewList(data.reviews || []);
        setSummary(data.summary || {});
        updateHotelCardSummary(hotelId, data.summary || {});
    }

    function openAddReviewModal(hotelId, hotelName) {
        currentHotelId = hotelId;
        addReviewHotelId.value = hotelId;
        addReviewHotelTitle.textContent = hotelName;
        addReviewAuthor.value = '';
        addReviewComment.value = '';
        setAutoStars(0);
        addReviewPredictStatus.textContent = 'Type a comment to predict stars';
        hideAlert(addReviewAlert);

        addReviewModal.style.display = 'flex';
        addReviewModal.setAttribute('aria-hidden', 'false');
        blurPage();
    }

    function closeAddReviewModal() {
        addReviewModal.style.display = 'none';
        addReviewModal.setAttribute('aria-hidden', 'true');
        unblurPage();
    }

    function openViewReviewsModal(hotelId, hotelName) {
        currentHotelId = hotelId;
        viewReviewsHotelTitle.textContent = hotelName;
        hideAlert(viewReviewsAlert);
        aiSummaryBox.textContent = 'Click “Generate” to build the AI summary from the existing reviews.';

        viewReviewsModal.style.display = 'flex';
        viewReviewsModal.setAttribute('aria-hidden', 'false');
        blurPage();

        loadHotelReviews(hotelId).catch(function (error) {
            showAlert(viewReviewsAlert, error.message || 'Unable to load reviews.', 'error');
            renderReviewList([]);
            setSummary({ score10: 0, count: 0 });
        });
    }

    function closeViewReviewsModal() {
        viewReviewsModal.style.display = 'none';
        viewReviewsModal.setAttribute('aria-hidden', 'true');
        unblurPage();
    }

    function debouncePredict() {
        if (predictTimer) {
            clearTimeout(predictTimer);
        }

        predictTimer = setTimeout(async function () {
            const comment = addReviewComment.value.trim();

            if (comment === '') {
                setAutoStars(0);
                addReviewPredictStatus.textContent = 'Type a comment to predict stars';
                return;
            }

            addReviewPredictStatus.textContent = 'Predicting...';

            try {
                const response = await fetch('/avis/predict?comment=' + encodeURIComponent(comment), {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const data = await response.json();

                if (!response.ok || !data.success) {
                    throw new Error(data.message || 'Prediction failed.');
                }

                setAutoStars(data.stars || 0);
                addReviewPredictStatus.textContent = 'Automatic rating ready';
            } catch (error) {
                setAutoStars(0);
                addReviewPredictStatus.textContent = 'Prediction unavailable';
            }
        }, 600);
    }

    async function submitReview(event) {
        event.preventDefault();
        hideAlert(addReviewAlert);

        const hotelId = addReviewHotelId.value;
        const commentaire = addReviewComment.value.trim();
        const nomAuteur = addReviewAuthor.value.trim();

        if (commentaire === '') {
            showAlert(addReviewAlert, 'Merci d’écrire un commentaire.', 'error');
            return;
        }

        const formData = new FormData();
        formData.append('_token', reviewCsrfToken.value);
        formData.append('hebergementId', hotelId);
        formData.append('commentaire', commentaire);
        formData.append('nomAuteur', nomAuteur);

        const submitBtn = document.getElementById('addReviewSubmitBtn');
        submitBtn.disabled = true;
        submitBtn.textContent = 'Saving...';

        try {
            const response = await fetch('/avis/create', {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            const data = await response.json();

            if (!response.ok || !data.success) {
                throw new Error(data.message || 'Unable to save the review.');
            }

            showAlert(addReviewAlert, data.message || 'Review added successfully.', 'success');
            addReviewComment.value = '';
            addReviewAuthor.value = '';
            setAutoStars(0);
            addReviewPredictStatus.textContent = 'Type a comment to predict stars';

            if (data.summary) {
                updateHotelCardSummary(hotelId, data.summary);
            }
        } catch (error) {
            showAlert(addReviewAlert, error.message || 'Unable to save the review.', 'error');
        } finally {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Save review';
        }
    }

    async function generateAiSummary() {
        hideAlert(viewReviewsAlert);

        if (!currentHotelId) {
            return;
        }

        generateAiSummaryBtn.disabled = true;
        generateAiSummaryBtn.textContent = 'Loading...';
        aiSummaryBox.textContent = 'Generating AI summary...';

        try {
            const formData = new FormData();
            formData.append('_token', reviewSummaryCsrfToken.value);

            const response = await fetch('/avis/hebergement/' + currentHotelId + '/summary', {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            const data = await response.json();

            if (!response.ok || !data.success) {
                throw new Error(data.message || 'Unable to generate the AI summary.');
            }

            aiSummaryBox.textContent = data.summary || 'No AI summary available.';
        } catch (error) {
            aiSummaryBox.textContent = '❌ ' + (error.message || 'Unable to generate the AI summary.');
        } finally {
            generateAiSummaryBtn.disabled = false;
            generateAiSummaryBtn.textContent = 'Generate';
        }
    }

    openAddReviewButtons.forEach(function (button) {
        button.addEventListener('click', function () {
            openAddReviewModal(this.dataset.hotelId, this.dataset.hotelName);
        });
    });

    openViewReviewsButtons.forEach(function (button) {
        button.addEventListener('click', function () {
            openViewReviewsModal(this.dataset.hotelId, this.dataset.hotelName);
        });
    });

    addReviewComment.addEventListener('input', debouncePredict);
    addReviewForm.addEventListener('submit', submitReview);
    generateAiSummaryBtn.addEventListener('click', generateAiSummary);

    addReviewCloseTopBtn.addEventListener('click', closeAddReviewModal);
    addReviewCancelBtn.addEventListener('click', closeAddReviewModal);

    viewReviewsCloseTopBtn.addEventListener('click', closeViewReviewsModal);
    viewReviewsCloseBtn.addEventListener('click', closeViewReviewsModal);

    addReviewModal.addEventListener('click', function (event) {
        if (event.target === addReviewModal) {
            closeAddReviewModal();
        }
    });

    viewReviewsModal.addEventListener('click', function (event) {
        if (event.target === viewReviewsModal) {
            closeViewReviewsModal();
        }
    });

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && addReviewModal.style.display === 'flex') {
            closeAddReviewModal();
        }

        if (event.key === 'Escape' && viewReviewsModal.style.display === 'flex') {
            closeViewReviewsModal();
        }
    });


    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && typeof window.closePanoramaModal === 'function') {
            window.closePanoramaModal();
        }
    });

    if (typeof window.closePanoramaModal === 'function') {
        window.closePanoramaModal();
    }
    closeAddReviewModal();
    closeViewReviewsModal();
});
</script>
{% endblock %}