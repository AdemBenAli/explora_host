{% extends 'base.html.twig' %}

{% block title %}Reservation History | Explora{% endblock %}

{% block body %}
<div class="front-hotels-shell" id="reservationHistoryPage">

    <header class="front-navbar">
        <div class="front-navbar-inner">
            <a href="{{ path('app_hebergement_front') }}" class="front-brand">
                <img src="{{ asset('images/Explora.png') }}" alt="Explora" class="front-brand-logo">
            </a>

            <nav class="front-center-nav">
                <a href="#" class="front-nav-pill">Home</a>
                <a href="#" class="front-nav-pill">Voyages</a>
                <a href="#" class="front-nav-pill">Transport</a>
                <a href="{{ path('app_hebergement_front') }}" class="front-nav-pill">Hotels</a>
            </nav>

            <div class="front-right-nav">
                <a href="{{ path('app_hebergement_index') }}" class="front-outline-pill">Dashboard</a>
                <a href="{{ path('app_reservation_history') }}" class="front-outline-pill front-nav-pill-active">History</a>
                <a href="#" class="front-accent-pill">Profile</a>
            </div>
        </div>
    </header>

    <section class="front-hero-hotels">
        <div class="front-hero-content">
            <h1>Reservation History</h1>
            <p>All your latest bookings in one place</p>
        </div>
    </section>

    <section style="width:min(1400px, calc(100% - 32px)); margin:44px auto 56px;">

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div
                    style="
                        margin-bottom: 18px;
                        padding: 14px 16px;
                        border-radius: 14px;
                        font-weight: 700;
                        background: {{ label == 'success' ? '#e9f8ee' : '#fdeceb' }};
                        color: {{ label == 'success' ? '#1f7a39' : '#b42318' }};
                        border: 1px solid {{ label == 'success' ? '#b7e4c7' : '#f5c2c7' }};
                    "
                >
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% if reservations is empty %}
            <div class="front-empty-state">
                No reservations found yet.
            </div>
        {% else %}
            <div style="display:flex; flex-direction:column; gap:24px;">
                {% for reservation in reservations %}
                    <article
                        style="
                            background:#ffffff;
                            border-radius:24px;
                            box-shadow:0 8px 20px rgba(0,0,0,0.08);
                            padding:28px;
                        "
                    >
                        <div style="display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;">
                            <div style="flex:1;min-width:280px;">
                                <h2 style="margin:0 0 10px;color:#1a3a5c;font-size:28px;font-weight:800;">
                                    {{ reservation.hebergement ? reservation.hebergement.nom : 'Unknown hotel' }}
                                </h2>

                                <div style="color:#868e96;font-size:16px;margin-bottom:16px;">
                                    Client: {{ reservation.nomClient }}
                                </div>

                                <div style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:14px;">
                                    <span class="front-tag">Status: {{ reservation.statut }}</span>
                                    <span class="front-tag">Guests: {{ reservation.guestsCount }}</span>
                                    <span class="front-tag">Rooms: {{ reservation.roomsCount }}</span>
                                    <span class="front-tag">Occupancy: {{ reservation.occupancy }}</span>
                                    <span class="front-tag">Room type: {{ reservation.roomType ?: 'Standard' }}</span>
                                </div>
                            </div>

                            <div style="min-width:320px;flex:1;">
                                <div style="display:grid;grid-template-columns:180px 1fr;gap:12px 18px;">
                                    <div style="color:#1a3a5c;font-weight:800;">Check-in</div>
                                    <div style="color:#212529;">{{ reservation.dateCheckin ? reservation.dateCheckin|date('d/m/Y') : '-' }}</div>

                                    <div style="color:#1a3a5c;font-weight:800;">Check-out</div>
                                    <div style="color:#212529;">{{ reservation.dateCheckout ? reservation.dateCheckout|date('d/m/Y') : '-' }}</div>

                                    <div style="color:#1a3a5c;font-weight:800;">Reservation date</div>
                                    <div style="color:#212529;">{{ reservation.dateReservation ? reservation.dateReservation|date('d/m/Y H:i') : '-' }}</div>

                                    <div style="color:#1a3a5c;font-weight:800;">Email</div>
                                    <div style="color:#212529;">{{ reservation.emailClient ?: '-' }}</div>

                                    <div style="color:#1a3a5c;font-weight:800;">Total</div>
                                    <div style="color:#f7941d;font-size:28px;font-weight:800;">
                                        ${{ reservation.prixTotal is not null ? reservation.prixTotal|number_format(1, '.', '') : '0.0' }}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div
                            style="
                                margin-top: 24px;
                                display: flex;
                                justify-content: flex-end;
                                gap: 12px;
                                align-items: center;
                                flex-wrap: wrap;
                            "
                        >
                            <a
                                href="{{ path('app_reservation_edit', {'id': reservation.id}) }}"
                                title="Edit reservation"
                                style="
                                    min-width: 52px;
                                    height: 52px;
                                    padding: 0 16px;
                                    border-radius: 14px;
                                    display: inline-flex;
                                    align-items: center;
                                    justify-content: center;
                                    background: rgba(247,148,29,0.12);
                                    color: #f7941d;
                                    text-decoration: none;
                                    border: none;
                                    transition: 0.2s ease;
                                    box-shadow: 0 4px 10px rgba(247,148,29,0.08);
                                "
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-9.5 9.5L3 14l.646-3.354 9.5-9.5zM11.207 2 4 9.207V10h.793L12 2.793 11.207 2z"/>
                                    <path fill-rule="evenodd" d="M1 13l9-9 3 3-9 9H0v-3z"/>
                                </svg>
                            </a>

                            <form
                                method="post"
                                action="{{ path('app_reservation_delete', {'id': reservation.id}) }}"
                                style="margin:0;"
                                class="js-delete-form"
                                data-reservation-name="{{ reservation.hebergement ? reservation.hebergement.nom|e('html_attr') : 'this reservation' }}"
                                data-client-name="{{ reservation.nomClient|e('html_attr') }}"
                            >
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_reservation_' ~ reservation.id) }}">
                                <button
                                    type="button"
                                    class="js-open-delete-modal"
                                    title="Delete reservation"
                                    style="
                                        min-width: 52px;
                                        height: 52px;
                                        padding: 0 16px;
                                        border-radius: 14px;
                                        display: inline-flex;
                                        align-items: center;
                                        justify-content: center;
                                        background: rgba(231,76,60,0.12);
                                        color: #e74c3c;
                                        border: none;
                                        cursor: pointer;
                                        transition: 0.2s ease;
                                        box-shadow: 0 4px 10px rgba(231,76,60,0.08);
                                    "
                                >
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0A.5.5 0 0 1 8.5 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                                        <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1 0-2H5V1a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1h2.5a1 1 0 0 1 1 1zM6 1v1h4V1H6zm-2 3v9a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4H4z"/>
                                    </svg>
                                </button>
                            </form>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </section>
</div>

<div
    id="deleteReservationModal"
    aria-hidden="true"
    style="
        display:none;
        position:fixed;
        top:0;
        left:0;
        right:0;
        bottom:0;
        width:100vw;
        height:100vh;
        background:rgba(25, 33, 45, 0.35);
        backdrop-filter:blur(8px);
        -webkit-backdrop-filter:blur(8px);
        z-index:999999;
        align-items:center;
        justify-content:center;
        padding:24px;
    "
>
    <div
        style="
            width:100%;
            max-width:520px;
            background:#ffffff;
            border-radius:24px;
            box-shadow:0 26px 60px rgba(0,0,0,0.22);
            padding:28px 28px 24px;
            position:relative;
        "
        onclick="event.stopPropagation();"
    >
        <div style="display:flex;align-items:center;gap:14px;margin-bottom:16px;">
            <div
                style="
                    width:52px;
                    height:52px;
                    border-radius:16px;
                    background:rgba(231,76,60,0.12);
                    color:#e74c3c;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    flex-shrink:0;
                "
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0A.5.5 0 0 1 8.5 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                    <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1 0-2H5V1a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1h2.5a1 1 0 0 1 1 1zM6 1v1h4V1H6zm-2 3v9a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4H4z"/>
                </svg>
            </div>

            <div>
                <h3 style="margin:0;color:#1a3a5c;font-size:24px;font-weight:800;">Delete reservation</h3>
                <p style="margin:6px 0 0;color:#868e96;font-size:15px;">This action cannot be undone.</p>
            </div>
        </div>

        <div
            id="deleteReservationMessage"
            style="
                background:#f8f9fb;
                border:1px solid #e4e9f0;
                color:#33465e;
                border-radius:16px;
                padding:16px 18px;
                font-size:15px;
                line-height:1.5;
                margin-bottom:22px;
            "
        >
            Are you sure you want to delete this reservation?
        </div>

        <div style="display:flex;justify-content:flex-end;gap:14px;flex-wrap:wrap;">
            <button
                type="button"
                id="deleteReservationCancelBtn"
                class="front-btn-outline"
            >
                Cancel
            </button>

            <button
                type="button"
                id="deleteReservationConfirmBtn"
                class="front-btn-primary"
                style="
                    background:#e74c3c;
                    box-shadow:0 8px 18px rgba(231,76,60,0.22);
                "
            >
                Delete
            </button>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const modal = document.getElementById('deleteReservationModal');
    const page = document.getElementById('reservationHistoryPage');
    const messageBox = document.getElementById('deleteReservationMessage');
    const cancelBtn = document.getElementById('deleteReservationCancelBtn');
    const confirmBtn = document.getElementById('deleteReservationConfirmBtn');
    const openButtons = document.querySelectorAll('.js-open-delete-modal');

    let activeForm = null;

    if (!modal || !page || !messageBox || !cancelBtn || !confirmBtn || openButtons.length === 0) {
        return;
    }

    function openDeleteModal(form) {
        activeForm = form;

        const reservationName = form.dataset.reservationName || 'this reservation';
        const clientName = form.dataset.clientName || 'this client';

        messageBox.innerHTML =
            'Are you sure you want to delete the reservation for <strong style="color:#1a3a5c;">' +
            clientName +
            '</strong> at <strong style="color:#1a3a5c;">' +
            reservationName +
            '</strong>?';

        modal.style.display = 'flex';
        modal.setAttribute('aria-hidden', 'false');

        page.style.filter = 'blur(6px)';
        page.style.pointerEvents = 'none';
        page.style.userSelect = 'none';
        document.body.style.overflow = 'hidden';
    }

    function closeDeleteModal() {
        modal.style.display = 'none';
        modal.setAttribute('aria-hidden', 'true');

        page.style.filter = '';
        page.style.pointerEvents = '';
        page.style.userSelect = '';
        document.body.style.overflow = '';

        activeForm = null;
    }

    openButtons.forEach(function (button) {
        button.addEventListener('click', function () {
            const form = this.closest('form');
            if (form) {
                openDeleteModal(form);
            }
        });
    });

    cancelBtn.addEventListener('click', closeDeleteModal);

    confirmBtn.addEventListener('click', function () {
        if (activeForm) {
            activeForm.submit();
        }
    });

    modal.addEventListener('click', function (event) {
        if (event.target === modal) {
            closeDeleteModal();
        }
    });

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && modal.style.display === 'flex') {
            closeDeleteModal();
        }
    });
});
</script>
{% endblock %}