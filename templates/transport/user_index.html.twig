    </div>
</div>

<div class="ut-modal-overlay" id="ecoScoreModalOverlay" role="dialog" aria-modal="true">
    <div class="ut-modal-box" style="text-align: center; max-width: 500px;">
        <button class="ut-modal-close" id="ecoScoreModalClose"><i class="fas fa-times"></i></button>
        <div style="font-size: 50px; margin-bottom: 15px;">🌱</div>
        <h3 class="ut-modal-title">{{ 'eco.impact_title'|trans }}</h3>
        <p style="margin-bottom: 20px;">{{ ecoScore.badgeNiveau|trans }} — {{ 'eco.level'|trans }} {{ ecoScore.niveauActuel }}</p>
        <div style="background: var(--gray-lt); border-radius: 12px; padding: 20px; margin-bottom: 20px;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                <span style="font-weight: 700;">{{ 'eco.progress'|trans }}</span>
                <span id="modalEcoPointsVal" style="color: var(--orange);">{{ ecoScore.pointsActuels }}/1000 PTS</span>
            </div>
            <div style="height: 12px; background: var(--gray-md); border-radius: 6px; overflow: hidden;"><div id="modalEcoProgressBar" style="width: {{ ecoScore.progressionPourcent }}%; height: 100%; background: linear-gradient(90deg, #10b981, #f7941d);"></div></div>
            <p id="modalEcoPointsStatus" style="font-size: 12px; margin-top: 10px;">
                {% if ecoScore.reductionDisponible %}
                    🎉 {{ 'eco.reduction_ready'|trans|raw }}
                {% else %}
                    {{ 'eco.reduction_needed'|trans({'%pts%': ecoScore.pointsRestants})|raw }}
                {% endif %}
            </p>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 25px;">
            <div style="background: #f0fdf4; padding: 15px; border-radius: 10px; border: 1px solid #bbf7d0;">🌳 <span style="font-size: 18px; font-weight: 800; color: #166534;">{{ (ecoScore.co2Economise / 25)|round(1) }}</span><br><span style="font-size: 10px;">{{ 'eco.trees_saved'|trans }}</span></div>
            <div style="background: #eff6ff; padding: 15px; border-radius: 10px; border: 1px solid #bfdbfe;">✅ <span style="font-size: 18px; font-weight: 800; color: #1e40af;">{{ ecoScore.voyagesEco }}</span><br><span style="font-size: 10px;">{{ 'eco.eco_trips'|trans }}</span></div>
        </div>
        <button type="button" class="ut-btn ut-btn--primary" id="ecoScoreDone" style="width: 100%;">{{ 'btn.continue'|trans }}</button>
    </div>
</div>

<div class="ut-toast" id="toastMsg"><i class="fas fa-check-circle" id="toastIcon"></i><span id="toastText"></span></div>

{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', () => {
    // 0. Globals & Helpers
    const CURRENCY_RATE = {{ currency_rate()|number_format(6, '.', '') }};
    const CURRENCY_SYMBOL = '{{ current_currency_symbol()|e('js') }}';
    const q = (id) => document.getElementById(id);
    const qa = (sel) => document.querySelectorAll(sel);

    // Helper Toast (manquant)
    function showToast(msg, type = "success") {
        const t = q('toastMsg'), txt = q('toastText'), icon = q('toastIcon');
        if (!t) return;
        txt.textContent = msg;
        t.className = 'ut-toast show ' + type;
        if (icon) icon.className = type === 'success' ? 'fas fa-check-circle' : 'fas fa-exclamation-circle';
        setTimeout(() => t.classList.remove('show'), 3000);
    }

    // 1. Theme Toggle
    const themeBtn = q('btnTheme'), themeIcon = q('themeIcon');
    if (themeBtn) {
        let dark = localStorage.getItem('ut-dark') === '1';
        const applyTheme = () => { document.body.classList.toggle('dark-mode', dark); if(themeIcon) themeIcon.className = dark ? 'fas fa-sun' : 'fas fa-moon'; };
        applyTheme();
        themeBtn.onclick = () => { dark = !dark; localStorage.setItem('ut-dark', dark ? '1' : '0'); applyTheme(); };
    }

    // 2. Navigation & Hero
    (function initHero() {
        const slides = qa('.ut-hero__slide'), dots = qa('.ut-dot');
        if (!slides.length) return;
        let cur = 0, timer;
        const goTo = (n) => { 
            slides[cur].classList.remove('active'); dots[cur].classList.remove('active'); 
            cur = (n + slides.length) % slides.length; 
            slides[cur].classList.add('active'); dots[cur].classList.add('active'); 
        };
        dots.forEach(d => d.onclick = () => { clearInterval(timer); goTo(+d.dataset.slide); startAuto(); });
        const startAuto = () => { timer = setInterval(() => goTo(cur + 1), 4500); };
        startAuto();
    })();

    // 3. Reservation System
    let currentReservation = null;
    const resOverlay = q('modalReserver'), resForm = q('formReserver');
    const inPlaces = q('inPlacesCount'), mTotalLabel = q('mTotalLabel');
    
    function updateTotal() {
        if (!currentReservation || !mTotalLabel) return;
        const count = parseInt(inPlaces?.value || 1);
        const total = (parseFloat(currentReservation.prix) * count);
        mTotalLabel.textContent = total.toFixed(0) + ' ' + CURRENCY_SYMBOL;
    }

    if (inPlaces) inPlaces.oninput = updateTotal;

    window.initReservationEvents = () => {
        qa('.btn-reserver').forEach(btn => {
            if (btn.dataset.init) return; btn.dataset.init = "1";
            btn.onclick = () => {
                currentReservation = btn.dataset;
                
                if(q('mOrig')) q('mOrig').textContent = currentReservation.origine;
                if(q('mDest')) q('mDest').textContent = currentReservation.destination;
                if(q('mType')) q('mType').textContent = currentReservation.type;
                if(q('mPrix')) q('mPrix').textContent = currentReservation.prix + ' ' + CURRENCY_SYMBOL;
                if(q('mHeure')) q('mHeure').textContent = currentReservation.heuredepart;
                if(q('mPlaces')) q('mPlaces').textContent = currentReservation.places;
                
                if(q('inId')) q('inId').value = currentReservation.id;
                if(q('inType')) q('inType').value = currentReservation.type;
                
                updateTotal();
                resOverlay?.classList.add('open');
            };
        });
    };
    initReservationEvents();
    if(q('btnCloseModal')) q('btnCloseModal').onclick = () => resOverlay?.classList.remove('open');
    if(resOverlay) resOverlay.onclick = (e) => { if(e.target === resOverlay) resOverlay.classList.remove('open'); };

    // 4. Weather Tool
    const weatherBtn = q('btnWeatherApi'), weatherOv = q('weatherOverlay'), weatherCity = q('weatherCityInput'), weatherSearch = q('weatherSearchBtn');
    const weatherError = q('weatherError');
    if (weatherBtn && weatherOv) {
        function showWeatherError(msg) {
            if (weatherError) { weatherError.textContent = msg; weatherError.style.display = 'block'; }
        }
        function hideWeatherError() {
            if (weatherError) { weatherError.textContent = ''; weatherError.style.display = 'none'; }
        }
        async function updateWeather() {
            try {
                hideWeatherError();
                const cityValue = weatherCity.value.trim();
                if (!cityValue) {
                    showWeatherError('Veuillez entrer un nom de ville.');
                    return;
                }
                // Loading state
                q('weatherMainTemp').textContent = '...';
                q('weatherMainCity').textContent = cityValue;
                q('weatherMainIcon').textContent = '⏳';

                const res = await fetch(`{{ path('user_transport_weather') }}?city=${encodeURIComponent(cityValue)}`);
                const d = await res.json();
                if (d.error) {
                    showWeatherError('Ville introuvable. Vérifiez le nom et réessayez.');
                    q('weatherMainTemp').textContent = '--°C';
                    q('weatherMainCity').textContent = '--';
                    q('weatherMainIcon').textContent = '⛅';
                    return;
                }
                if (d.temperature !== undefined) {
                    q('weatherMainTemp').textContent = Math.round(d.temperature) + '°C';
                    q('weatherMainCity').textContent = d.ville + ' (' + d.pays + ')';
                    const getIcon = (c) => c<=1?'☀️':(c<=3?'⛅':(c<=48?'🌫️':(c<=82?'🌧️':'⛈️')));
                    q('weatherMainIcon').textContent = getIcon(d.weatherCode);
                    const fore = q('weatherForecast'); fore.innerHTML = '';
                    d.forecasts.forEach(f => {
                        const dv = document.createElement('div'); dv.className='ut-weather-day';
                        dv.innerHTML = `<div style="font-size:10px;">${new Date(f.date).toLocaleDateString('{{ app.request.locale }}',{weekday:'short'})}</div><div style="font-size:24px;">${getIcon(f.weatherCode)}</div><div style="font-weight:700">${Math.round(f.maxTemp)}°</div>`;
                        fore.appendChild(dv);
                    });
                }
            } catch(e) {
                console.error("Weather error", e);
                showWeatherError('Erreur de connexion. Réessayez.');
                q('weatherMainTemp').textContent = '--°C';
                q('weatherMainCity').textContent = '--';
                q('weatherMainIcon').textContent = '⛅';
            }
        }
        weatherBtn.onclick = () => { 
            weatherOv.classList.add('open'); 
            if (!weatherCity.value.trim()) {
                const destination = q('inputDestination')?.value?.trim();
                if (destination) weatherCity.value = destination;
            }
            updateWeather(); 
        };
        if(weatherSearch) weatherSearch.onclick = updateWeather;
        // Support touche Entrée dans le champ de recherche
        if(weatherCity) weatherCity.addEventListener('keydown', (e) => { if(e.key === 'Enter') { e.preventDefault(); updateWeather(); } });
        if(q('weatherClose')) q('weatherClose').onclick = () => weatherOv.classList.remove('open');
    }

    // 5. Eco-Score Tool
    const ecoBtn = q('btnEcoScore'), ecoOv = q('ecoScoreModalOverlay');
    if (ecoBtn && ecoOv) {
        ecoBtn.onclick = () => ecoOv.classList.add('open');
        if(q('ecoScoreModalClose')) q('ecoScoreModalClose').onclick = () => ecoOv.classList.remove('open');
        if(q('ecoScoreDone')) q('ecoScoreDone').onclick = () => ecoOv.classList.remove('open');
    }

    // 6. Sync Eco UI
    function updateEcoUI(totalPoints) {
        // Navbar
        const navPoints = q('navEcoPoints');
        if (navPoints) {
            navPoints.textContent = totalPoints;
            navPoints.classList.add('pulse');
            setTimeout(() => navPoints.classList.remove('pulse'), 500);
        }
        // Modal
        const modalPointsVal = q('modalEcoPointsVal');
        if (modalPointsVal) modalPointsVal.textContent = totalPoints + '/1000 PTS';
        
        const progressBar = q('modalEcoProgressBar');
        if (progressBar) {
            const pct = Math.min(100, Math.round((totalPoints / 1000) * 100));
            progressBar.style.width = pct + '%';
        }
        
        const statusText = q('modalEcoPointsStatus');
        if (statusText) {
            if (totalPoints >= 1000) {
                statusText.innerHTML = "🎉 {{ 'eco.reduction_ready'|trans|e('js') }}";
            } else {
                const rest = 1000 - totalPoints;
                statusText.innerHTML = "Plus que <strong>" + rest + " points</strong> pour -20% !";
            }
        }
    }

    // 6. Bike Rental Tool
    const veloOv = q('veloModalOverlay'), promoOv = q('promoModalOverlay');
    if (veloOv && promoOv) {
        if(q('veloModalClose')) q('veloModalClose').onclick = () => veloOv.classList.remove('open');
        if(q('btnContinueTransport')) q('btnContinueTransport').onclick = () => veloOv.classList.remove('open');
        
        const btnVelo = q('btnChooseVelo');
        if (btnVelo) {
            btnVelo.onclick = async () => {
                const dep = q('inputOrigine')?.value.trim() || 'Tunis';
                const dest = q('inputDestination')?.value.trim() || 'Carthage';
                
                btnVelo.disabled = true;
                btnVelo.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Traitement...';
                
                try {
                    const res = await fetch("{{ path('user_eco_generer_code') }}", {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ origine: dep, destination: dest })
                    });
                    const d = await res.json();
                    
                    if (d.code) {
                        veloOv.classList.remove('open');
                        const codeEl = q('promoCodeVal');
                        if(codeEl) codeEl.textContent = d.code;
                        promoOv.classList.add('open');
                        
                        // Mettre à jour les points partout
                        const currentNav = parseInt(q('navEcoPoints')?.textContent || 0);
                        const gain = d.pointsVelo || 300;
                        updateEcoUI(currentNav + gain);
                        showToast("Points ajoutés ! 🌱 +" + gain + " PTS", "success");
                    } else if (d.error) {
                        showToast(d.error, "error");
                    }
                } catch(e) {
                    console.error("Eco error", e);
                    showToast("Erreur lors de la génération du code", "error");
                } finally {
                    btnVelo.disabled = false;
                    btnVelo.innerHTML = '<i class="fas fa-bicycle"></i> {{ 'eco.btn_rent_bike'|trans|e('js') }}';
                }
            };
        }
        
        if(q('promoModalClose')) q('promoModalClose').onclick = () => promoOv.classList.remove('open');
        if(q('btnCopyPromo')) {
            q('btnCopyPromo').onclick = () => {
                const code = q('promoCodeVal')?.textContent;
                if(code) {
                    // Méthode robuste pour copier (fallback HTTP)
                    if (navigator.clipboard && window.isSecureContext) {
                        navigator.clipboard.writeText(code).then(() => showToast("Code copié ! ✅", "success"));
                    } else {
                        const textArea = document.createElement("textarea");
                        textArea.value = code;
                        document.body.appendChild(textArea);
                        textArea.select();
                        try {
                            document.execCommand('copy');
                            showToast("Code copié ! ✅", "success");
                        } catch (err) {
                            console.error('Erreur de copie manuelle', err);
                        }
                        document.body.removeChild(textArea);
                    }
                }
                promoOv.classList.remove('open');
            };
        }
    }

    // 7. Real Flights System
    const realBtn = q('btnRealFlights'), cardsList = q('cardsList');
    if (realBtn && cardsList) {
        realBtn.onclick = async () => {
            const dep = q('inputOrigine')?.value.trim() || 'TUN', arr = q('inputDestination')?.value.trim() || '';
            realBtn.disabled = true; realBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>...';
            try {
                const res = await fetch(`{{ path('user_transport_real_flights') }}?dep=${encodeURIComponent(dep)}&arr=${encodeURIComponent(arr)}`);
                const data = await res.json();
                if(data.items && data.items.length > 0) {
                    cardsList.innerHTML = '';
                    data.items.forEach(t => {
                        cardsList.insertAdjacentHTML('beforeend', `
                            <article class="ut-card" style="animation: slideUp 0.4s ease forwards;">
                                <div class="ut-card__company">
                                    <div class="ut-card__company-icon"><i class="fas fa-plane"></i></div>
                                    <div class="ut-card__company-name">${t.compagnie}</div>
                                </div>
                                <div class="ut-card__route">
                                    <div class="ut-card__endpoint"><div class="ut-card__city">${t.origine}</div><div class="ut-card__time">${t.heureDepart}</div></div>
                                    <div class="ut-card__arrow-area"><div class="ut-card__line"><span class="ut-card__dot"></span><span class="ut-card__dash"></span><i class="fas fa-plane" style="color:var(--orange); font-size:12px;"></i><span class="ut-card__dash"></span><span class="ut-card__dot"></span></div></div>
                                    <div class="ut-card__endpoint"><div class="ut-card__city">${t.destination}</div><div class="ut-card__time">${t.heureArrivee}</div></div>
                                </div>
                                <div class="ut-card__sep"></div>
                                <div class="ut-card__price-area">
                                    <div class="ut-card__price"><span class="ut-card__price-val">${(parseFloat(t.prix) * CURRENCY_RATE).toFixed(0)}</span><span class="ut-card__price-cur">${CURRENCY_SYMBOL}</span></div>
                                    <button class="ut-btn ut-btn--primary ut-btn--sm btn-reserver" data-id="${t.id}" data-type="AVION" data-origine="${t.origine}" data-destination="${t.destination}" data-prix="${t.prix}" data-compagnie="${t.compagnie}" style="width:100%">{{ 'btn.book'|trans }}</button>
                                </div>
                            </article>
                        `);
                    });
                    initReservationEvents();
                }
            } catch(e) { console.error("Real flights error", e); }
            realBtn.disabled = false; realBtn.innerHTML = '<i class="fas fa-plane"></i> {{ 'badge.real_flights'|trans|default('Vols Réels') }}';
        };
    }

    // 9. Short Trip (Bike) Detection
    {% if shortTrip is defined and shortTrip is not null %}
        const st = {{ shortTrip|json_encode|raw }};
        if (veloOv) {
            const vDist = q('veloDistance');
            if(vDist) vDist.textContent = st.distance + ' km';
            const vType = q('veloTransportType');
            if(vType) vType.textContent = st.type;
            
            // Show shortly after load
            setTimeout(() => {
                veloOv.classList.add('open');
            }, 800);
        }
    {% endif %}
});
</script>
{% endblock %}
