        <div class="ut-weather-main">
            <div class="ut-weather-icon" id="weatherMainIcon">⛅</div>
            <div>
                <div class="ut-weather-temp" id="weatherMainTemp">--°C</div>
                <div class="ut-weather-city" id="weatherMainCity">--</div>
            </div>
        </div>
        <div class="ut-weather-forecast" id="weatherForecast"></div>
    </div>
</div>

