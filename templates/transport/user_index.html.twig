            </div>

            <div class="ut-modal-actions">
                <button type="submit" class="ut-btn ut-btn--primary" style="width:100%; justify-content:center;">
                    <i class="fas fa-check-circle"></i> {{ 'modal.btn_confirm'|trans }}
                </button>
            </div>
        </form>
    </div>
</div>

<div class="ut-weather-overlay" id="weatherOverlay" role="dialog" aria-modal="true">
