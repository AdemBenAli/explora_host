</div>

<div class="ut-modal-overlay" id="promoModalOverlay" role="dialog" aria-modal="true">
    <div class="ut-modal-box" style="text-align: center;">
        <button class="ut-modal-close" id="promoModalClose"><i class="fas fa-times"></i></button>
        <div style="font-size: 50px; margin-bottom: 15px;">🎁</div>
        <h3 class="ut-modal-title">{{ 'eco.promo_title'|trans }}</h3>
        <div style="background: var(--navy); color: #fff; padding: 20px; border-radius: 12px; margin-top: 15px;">
            <span style="font-size: 14px; opacity: 0.8; display: block;">{{ 'eco.promo_code_label'|trans }}</span>
