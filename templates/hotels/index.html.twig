<div class="front-panorama-modal-overlay" id="frontPanoramaModal" aria-hidden="true">
    <div class="front-panorama-modal-card" role="dialog" aria-modal="true">
        <div class="front-panorama-modal-header">
            <div>
                <div class="front-panorama-modal-kicker">Photo</div>
                <h2 id="frontPanoramaTitle">Panorama Viewer</h2>
            </div>
            <button type="button" class="front-panorama-modal-close" id="frontPanoramaCloseBtn" aria-label="Close">×</button>
        </div>
        <div class="front-panorama-modal-body">
            <div class="front-panorama-loading" id="frontPanoramaLoading">Loading image...</div>
            <div class="front-panorama-notice" id="frontPanoramaNotice" style="display:none;"></div>
            <div id="frontPanoramaStage" style="display:none;">
                <div class="front-panorama-viewer-wrap" id="frontPanoramaViewerWrap" style="display:none;">
                    <iframe class="front-panorama-viewer-frame" id="frontPanoramaViewerFrame" title="Panorama viewer" loading="lazy" referrerpolicy="no-referrer"></iframe>
                </div>
                <div class="front-panorama-fallback-wrap" id="frontPanoramaFallbackWrap" style="display:none;">
                    <img src="" alt="" class="front-panorama-fallback-image" id="frontPanoramaFallbackImage">
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {

    // ==================== PANORAMA ====================
    const panoramaModal     = document.getElementById('frontPanoramaModal');
    const panoramaCloseBtn  = document.getElementById('frontPanoramaCloseBtn');
    const panoramaTitle     = document.getElementById('frontPanoramaTitle');
    const panoramaLoading   = document.getElementById('frontPanoramaLoading');
    const panoramaNotice    = document.getElementById('frontPanoramaNotice');
    const panoramaStage     = document.getElementById('frontPanoramaStage');
    const panoramaViewerWrap  = document.getElementById('frontPanoramaViewerWrap');
    const panoramaViewerFrame = document.getElementById('frontPanoramaViewerFrame');
    const panoramaFallbackWrap  = document.getElementById('frontPanoramaFallbackWrap');
    const panoramaFallbackImage = document.getElementById('frontPanoramaFallbackImage');

    function resetPanoramaModal() {
        panoramaViewerFrame.removeAttribute('srcdoc');
        panoramaViewerWrap.style.display    = 'none';
        panoramaFallbackWrap.style.display  = 'none';
        panoramaStage.style.display         = 'none';
        panoramaNotice.style.display        = 'none';
        panoramaNotice.textContent          = '';
        panoramaLoading.style.display       = 'flex';
        panoramaLoading.textContent         = 'Loading image...';
        panoramaFallbackImage.removeAttribute('src');
    }

    function openPanoramaModal() {
        panoramaModal.classList.add('active');
        panoramaModal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('modal-open');
    }

    function closePanoramaModal() {
        panoramaModal.classList.remove('active');
        panoramaModal.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('modal-open');
        resetPanoramaModal();
    }
    window.closePanoramaModal = closePanoramaModal;

    function shouldUsePanorama(src, w, h) {
        const ratio = h > 0 ? (w / h) : 0;
        return ratio >= 1.8 || /(?:360|pano|panorama|equirectangular)/.test(String(src).toLowerCase());
    }

    function buildPanoramaSrcdoc(src, title) {
        const safeSrc   = JSON.stringify(src);
        const safeTitle = JSON.stringify(title || 'Viewer');
        return `<!doctype html><html><head><meta charset="utf-8"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pannellum@2.5.7/build/pannellum.css"><style>html,body{margin:0;width:100%;height:100%;background:#eef2f7;overflow:hidden}#panorama{width:100%;height:100%}#fallback{display:none;width:100%;height:100%;align-items:center;justify-content:center;background:#eef2f7}#fallback img{width:100%;height:100%;object-fit:contain}</style></head><body><div id="panorama"></div><div id="fallback"><img src=${safeSrc} alt=""></div><script src="https://cdn.jsdelivr.net/npm/pannellum@2.5.7/build/pannellum.js"><\/script><script>(function(){var loaded=false;function fb(){if(loaded)return;document.getElementById('panorama').style.display='none';document.getElementById('fallback').style.display='flex';}try{var v=pannellum.viewer('panorama',{type:'equirectangular',panorama:${safeSrc},autoLoad:true,showControls:true,mouseZoom:true,draggable:true,hfov:110});v.on('load',function(){loaded=true;try{v.resize();}catch(e){}});v.on('error',fb);setTimeout(function(){if(!loaded)fb();},1800);}catch(e){fb();}})()</s`+'cript></body></html>';
    }

    function showPanoramaViewer(src, title) {
        panoramaLoading.style.display       = 'none';
        panoramaStage.style.display         = 'block';
        panoramaFallbackWrap.style.display  = 'none';
        panoramaViewerWrap.style.display    = 'block';
        panoramaNotice.textContent  = 'Drag to rotate. Use the mouse wheel to zoom.';
        panoramaNotice.style.display = 'block';
        panoramaViewerFrame.srcdoc  = buildPanoramaSrcdoc(src, title);
    }

    function showFallbackImage(src, title, msg) {
        panoramaLoading.style.display       = 'none';
        panoramaStage.style.display         = 'block';
        panoramaFallbackWrap.style.display  = 'flex';
        panoramaViewerWrap.style.display    = 'none';
        panoramaFallbackImage.src = src;
        panoramaFallbackImage.alt = title || '';
        panoramaNotice.textContent   = msg || '';
        panoramaNotice.style.display = msg ? 'block' : 'none';
    }

    function preloadAndOpen(src, title) {
        if (!src) return;
        resetPanoramaModal();
        panoramaTitle.textContent = title || 'Photo';
        openPanoramaModal();
        const probe = new Image();
        probe.onload = function () {
            if (shouldUsePanorama(src, probe.naturalWidth, probe.naturalHeight)) {
                showPanoramaViewer(src, title);
            } else {
                showFallbackImage(src, title, 'This image is not a 360° panorama. It is shown enlarged for a clearer view.');
            }
        };
        probe.onerror = function () {
            panoramaLoading.textContent  = 'Unable to load this image.';
            panoramaNotice.textContent   = 'The image file is invalid or does not exist.';
            panoramaNotice.style.display = 'block';
        };
        probe.src = src;
    }

    document.addEventListener('click', function (e) {
        const wrap = e.target.closest('[data-panorama-open="true"]');
        if (!wrap) return;
        e.preventDefault();
        preloadAndOpen(wrap.getAttribute('data-panorama-src'), wrap.getAttribute('data-panorama-title'));
    });
    panoramaCloseBtn.addEventListener('click', closePanoramaModal);
    panoramaModal.addEventListener('click', function (e) { if (e.target === panoramaModal) closePanoramaModal(); });

    // ==================== PAYS AUTOCOMPLETE ====================
    const destInput = document.getElementById('destination');
    const destBox   = document.getElementById('countrySuggestions');
    if (destInput && destBox) {
        const countries = ['Afghanistan','Afrique du Sud','Albanie','Algérie','Allemagne','Angola','Arabie saoudite','Argentine','Arménie','Australie','Autriche','Azerbaïdjan','Bahamas','Bahreïn','Bangladesh','Belgique','Bénin','Brésil','Bulgarie','Cameroun','Canada','Chili','Chine','Colombie','Corée du Sud','Côte d\'Ivoire','Croatie','Cuba','Danemark','Égypte','Émirats arabes unis','Espagne','États-Unis','Éthiopie','Finlande','France','Ghana','Grèce','Hongrie','Inde','Indonésie','Irak','Iran','Irlande','Islande','Israël','Italie','Jamaïque','Japon','Jordanie','Kazakhstan','Kenya','Liban','Libye','Luxembourg','Madagascar','Malaisie','Malawi','Mali','Maroc','Maurice','Mexique','Mongolie','Mozambique','Népal','Nicaragua','Niger','Nigeria','Norvège','Nouvelle-Zélande','Oman','Pakistan','Palestine','Panama','Paraguay','Pays-Bas','Pérou','Philippines','Pologne','Portugal','Qatar','Roumanie','Royaume-Uni','Russie','Rwanda','Sénégal','Serbie','Singapour','Slovaquie','Slovénie','Somalie','Soudan','Sri Lanka','Suède','Suisse','Syrie','Tanzanie','Tchad','Thaïlande','Togo','Tunisie','Turquie','Ukraine','Uruguay','Venezuela','Viêt Nam','Yémen'];
        let active = -1, current = [];
        const norm = v => v.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/['']/g,'').trim();
        function hide() { destBox.style.display='none'; destBox.innerHTML=''; active=-1; current=[]; }
        function show(items) {
            destBox.innerHTML = '';
            if (!items.length) { hide(); return; }
            current = items; active = -1;
            items.forEach(function(c) {
                const btn = document.createElement('button');
                btn.type='button'; btn.textContent=c;
                btn.style.cssText='display:block;width:100%;padding:14px 22px;border:none;background:#fff;text-align:left;cursor:pointer;color:#1a3a5c;font-size:15px;font-weight:700;transition:0.15s;';
                btn.addEventListener('mouseenter',function(){btn.style.background='#f8f9fb';});
                btn.addEventListener('mouseleave',function(){btn.style.background='#fff';});
                btn.addEventListener('click',function(){destInput.value=c;hide();});
                destBox.appendChild(btn);
            });
            destBox.style.display='block';
        }
        function update() {
            const v = norm(destInput.value||'');
            let starts=[], includes=[];
            countries.forEach(function(c){
                const n=norm(c);
                if(v===''||n.startsWith(v)) starts.push(c);
                else if(n.includes(v)) includes.push(c);
            });
            show(starts.concat(includes).slice(0,10));
        }
        destInput.addEventListener('focus',update);
        destInput.addEventListener('input',update);
        destInput.addEventListener('keydown',function(e){
            if(destBox.style.display!=='block'||!current.length) return;
            if(e.key==='ArrowDown'){e.preventDefault();active=(active+1)%current.length;}
            else if(e.key==='ArrowUp'){e.preventDefault();active=(active-1+current.length)%current.length;}
            else if(e.key==='Enter'&&active>=0){e.preventDefault();destInput.value=current[active];hide();}
            else if(e.key==='Escape'){hide();}
            destBox.querySelectorAll('button').forEach(function(b,i){b.style.background=i===active?'#f4f7fb':'#fff';b.style.color=i===active?'#f7941d':'#1a3a5c';});
        });
        document.addEventListener('click',function(e){if(!destInput.contains(e.target)&&!destBox.contains(e.target))hide();});
    }

    // ==================== MAP MODAL ====================
    const mapModal      = document.getElementById('mapModal');
    const mapFrame      = document.getElementById('mapFrame');
    const mapCloseBtn   = document.getElementById('mapCloseTopBtn');
    const mapTitle      = document.getElementById('mapHotelTitle');
    const page          = document.getElementById('frontHotelsPage');

    function blurPage()   { page.classList.add('page-blurred');    document.body.style.overflow='hidden'; }
    function unblurPage() { page.classList.remove('page-blurred'); document.body.style.overflow=''; }

    function openMap(name, lat, lng, price) {
        const numLat = parseFloat(lat), numLng = parseFloat(lng);
        if (isNaN(numLat)||isNaN(numLng)||(numLat===0&&numLng===0)) { alert('Aucune localisation définie pour cet hébergement.'); return; }
        mapTitle.textContent = name||'Hotel';
        mapFrame.src = "{{ asset('map/leaflet_map.html') }}"+'?lat='+encodeURIComponent(numLat)+'&lng='+encodeURIComponent(numLng)+'&name='+encodeURIComponent(name||'Hotel')+'&price='+encodeURIComponent(price||'');
        mapModal.style.display='flex'; mapModal.setAttribute('aria-hidden','false'); blurPage();
    }
    function closeMap() {
        mapModal.style.display='none'; mapModal.setAttribute('aria-hidden','true');
        mapFrame.src="{{ asset('map/leaflet_map.html') }}"; unblurPage();
    }
    document.querySelectorAll('.js-open-map').forEach(function(btn){
        btn.addEventListener('click',function(){ openMap(this.dataset.hotelName,this.dataset.hotelLat,this.dataset.hotelLng,this.dataset.hotelPrice); });
    });
    mapCloseBtn.addEventListener('click',closeMap);
    mapModal.addEventListener('click',function(e){if(e.target===mapModal)closeMap();});
    document.addEventListener('keydown',function(e){if(e.key==='Escape'&&mapModal.style.display==='flex')closeMap();});

    // ==================== BOOKING MODAL ====================
    const bookingModal      = document.getElementById('bookingModal');
    const bookingHotelId    = document.getElementById('bookingHotelId');
    const bookingHotelName  = document.getElementById('bookingHotelName');
    const bookingBasePrice  = document.getElementById('bookingBasePrice');
    const bookingCheckin    = document.getElementById('bookingCheckin');
    const bookingCheckout   = document.getElementById('bookingCheckout');
    const bookingRooms      = document.getElementById('bookingRooms');
    const bookingOccupancy  = document.getElementById('bookingOccupancy');
    const bookingGuests     = document.getElementById('bookingGuests');
    const bookingRoomType   = document.getElementById('bookingRoomType');
    const bookingDetailsBtn = document.getElementById('bookingDetailsBtn');
    const bookingCancelBtn  = document.getElementById('bookingCancelBtn');
    const bookingCloseTopBtn= document.getElementById('bookingCloseTopBtn');
    const guestDetailsSection   = document.getElementById('guestDetailsSection');
    const guestDetailsContainer = document.getElementById('guestDetailsContainer');
    const bookingFilledText = document.getElementById('bookingFilledText');
    const bookingNights     = document.getElementById('bookingNights');
    const bookingRoomSummary= document.getElementById('bookingRoomSummary');
    const bookingSubtotal   = document.getElementById('bookingSubtotal');
    const bookingRoomSurcharge   = document.getElementById('bookingRoomSurcharge');
    const bookingWeekendSurcharge= document.getElementById('bookingWeekendSurcharge');
    const bookingDiscount   = document.getElementById('bookingDiscount');
    const bookingTotal      = document.getElementById('bookingTotal');

    function fmt(v){ return '$'+Number(v).toFixed(1); }
    function fmtPct(v){ return Math.round(v*100)+'%'; }
    function getRoomMult(t){ return t==='Deluxe'?1.15:t==='Suite'?1.30:1.00; }
    function parseD(v){ if(!v)return null; const p=v.split('-'); if(p.length!==3)return null; return new Date(p[0],p[1]-1,p[2]); }
    function diffDays(a,b){ return Math.round((b-a)/86400000); }
    function countWeekend(s,e){ let n=0,c=new Date(s); while(c<e){const d=c.getDay();if(d===5||d===6)n++;c.setDate(c.getDate()+1);} return n; }
    function todayStr(){ const t=new Date(); return t.getFullYear()+'-'+String(t.getMonth()+1).padStart(2,'0')+'-'+String(t.getDate()).padStart(2,'0'); }

    function enforceDates(){
        const today=todayStr();
        bookingCheckin.min=today;
        if(!bookingCheckin.value||bookingCheckin.value<today) bookingCheckin.value=today;
        bookingCheckout.min=bookingCheckin.value||today;
        if(bookingCheckout.value&&bookingCheckout.value<=bookingCheckin.value){
            const d=parseD(bookingCheckin.value); if(d){d.setDate(d.getDate()+1);bookingCheckout.value=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}
        }
    }

    function updateFilledText(){
        const inputs=guestDetailsContainer.querySelectorAll('input[name="guestNames[]"]');
        let filled=0; inputs.forEach(function(i){if(i.value.trim()!=='')filled++;});
        bookingFilledText.textContent=filled+'/'+inputs.length+' filled';
    }

    function generateGuestFields(){
        const n=Math.max(1,parseInt(bookingGuests.value||'1',10));
        guestDetailsContainer.innerHTML='';
        for(let i=0;i<n;i++){
            const row=document.createElement('div');
            row.style.cssText='display:grid;grid-template-columns:1fr 200px;gap:12px;margin-bottom:10px;';
            const ni=document.createElement('input'); ni.type='text'; ni.name='guestNames[]'; ni.placeholder='Guest '+(i+1)+' full name';
            ni.style.cssText='width:100%;height:44px;border:1px solid #cfd7e2;border-radius:10px;padding:0 14px;font-size:14px;';
            ni.addEventListener('input',updateFilledText);
            const bi=document.createElement('input'); bi.type='date'; bi.name='guestBirthDates[]'; bi.max=todayStr();
            bi.style.cssText='width:100%;height:44px;border:1px solid #cfd7e2;border-radius:10px;padding:0 14px;font-size:14px;color:#6c757d;';
            row.appendChild(ni); row.appendChild(bi);
            guestDetailsContainer.appendChild(row);
        }
        updateFilledText();
    }

    function updateCapacity(){
        const rooms=Math.max(1,parseInt(bookingRooms.value||'1',10));
        const max=rooms*(bookingOccupancy.value==='SINGLE'?1:2);
        bookingGuests.max=String(max);
        if(parseInt(bookingGuests.value||'1',10)>max) bookingGuests.value=max;
        if(parseInt(bookingGuests.value||'1',10)<1) bookingGuests.value=1;
        generateGuestFields();
    }

    function updatePrice(){
        const base=parseFloat(bookingBasePrice.value||'0');
        const ci=parseD(bookingCheckin.value), co=parseD(bookingCheckout.value);
        const rooms=Math.max(1,parseInt(bookingRooms.value||'1',10));
        const mult=getRoomMult(bookingRoomType.value||'Standard');
        let nights=0,sub=0,rsurch=0,wsurch=0,disc=0,total=0,rate=0;
        if(ci&&co&&co>ci){
            nights=diffDays(ci,co);
            const baseNoMult=base*nights*rooms;
            sub=baseNoMult*mult; rsurch=sub-baseNoMult;
            wsurch=countWeekend(ci,co)*(base*mult*0.15*rooms);
            if(nights>=10)rate=0.20; else if(nights>=5)rate=0.10;
            disc=(sub+wsurch)*rate; total=(sub+wsurch)-disc;
        }
        bookingNights.textContent=String(nights);
        bookingRoomSummary.textContent=(bookingRoomType.value||'Standard')+' • '+(bookingOccupancy.value==='SINGLE'?'Single':'Double')+' • '+rooms+' room'+(rooms>1?'s':'')+' • '+(parseInt(bookingGuests.value||'1',10))+' guest'+(parseInt(bookingGuests.value||'1',10)>1?'s':'');
        bookingSubtotal.textContent=fmt(sub);
        bookingRoomSurcharge.textContent=rsurch>0?'+ '+fmt(rsurch)+' ('+fmtPct(mult-1)+')':fmt(0);
        bookingWeekendSurcharge.textContent=wsurch>0?'+ '+fmt(wsurch):fmt(0);
        bookingDiscount.textContent=disc>0?'- '+fmt(disc)+' ('+fmtPct(rate)+')':'- '+fmt(0);
        bookingTotal.textContent=fmt(total);
    }

    function openBooking(hotelId, hotelName, price){
        bookingHotelId.value=hotelId; bookingHotelName.textContent='Hotel: '+hotelName;
        bookingBasePrice.value=price;
        bookingModal.style.display='flex'; bookingModal.setAttribute('aria-hidden','false');
        document.body.style.overflow='hidden'; blurPage();
        enforceDates(); updateCapacity(); updatePrice();
    }
    function closeBooking(){
        bookingModal.style.display='none'; bookingModal.setAttribute('aria-hidden','true');
        document.body.style.overflow=''; unblurPage();
    }

    document.querySelectorAll('.js-open-booking').forEach(function(btn){
        btn.addEventListener('click',function(){ openBooking(this.dataset.hotelId,this.dataset.hotelName,this.dataset.hotelPrice); });
    });
    bookingDetailsBtn.addEventListener('click',function(){
        const hidden=guestDetailsSection.style.display==='none'||guestDetailsSection.style.display==='';
        guestDetailsSection.style.display=hidden?'block':'none';
        if(hidden) generateGuestFields();
    });
    bookingCancelBtn.addEventListener('click',closeBooking);
    bookingCloseTopBtn.addEventListener('click',closeBooking);
    bookingRooms.addEventListener('input',function(){updateCapacity();updatePrice();});
    bookingOccupancy.addEventListener('change',function(){updateCapacity();updatePrice();});
    bookingGuests.addEventListener('input',function(){updateCapacity();updatePrice();});
    bookingRoomType.addEventListener('change',updatePrice);
    bookingCheckin.addEventListener('change',function(){enforceDates();updatePrice();});
    bookingCheckout.addEventListener('change',function(){enforceDates();updatePrice();});
    bookingModal.addEventListener('click',function(e){if(e.target===bookingModal)closeBooking();});
    document.addEventListener('keydown',function(e){if(e.key==='Escape'&&bookingModal.style.display==='flex')closeBooking();});
    document.getElementById('bookingForm').addEventListener('submit',function(e){
        enforceDates();
        if(bookingCheckout.value<=bookingCheckin.value){e.preventDefault();alert('Check-out must be after check-in.');return;}
        if(bookingCheckin.value<todayStr()){e.preventDefault();alert('You cannot reserve a past date.');}
    });
    closeBooking(); enforceDates(); generateGuestFields(); updatePrice();

    // ==================== REVIEWS ====================
    const addReviewModal    = document.getElementById('addReviewModal');
    const viewReviewsModal  = document.getElementById('viewReviewsModal');
    const addReviewHotelId  = document.getElementById('addReviewHotelId');
    const addReviewHotelTitle = document.getElementById('addReviewHotelTitle');
    const addReviewAuthor   = document.getElementById('addReviewAuthor');
    const addReviewComment  = document.getElementById('addReviewComment');
    const addReviewAutoStars= document.getElementById('addReviewAutoStars');
    const addReviewAutoText = document.getElementById('addReviewAutoText');
    const addReviewPredictStatus = document.getElementById('addReviewPredictStatus');
    const addReviewForm     = document.getElementById('addReviewForm');
    const addReviewAlert    = document.getElementById('addReviewAlert');
    const reviewCsrfToken   = document.getElementById('reviewCsrfToken');
    const viewReviewsHotelTitle  = document.getElementById('viewReviewsHotelTitle');
    const viewReviewsAlert       = document.getElementById('viewReviewsAlert');
    const viewReviewsList        = document.getElementById('viewReviewsList');
    const viewReviewsListMeta    = document.getElementById('viewReviewsListMeta');
    const viewReviewsSummaryScore= document.getElementById('viewReviewsSummaryScore');
    const viewReviewsSummaryCount= document.getElementById('viewReviewsSummaryCount');
    const aiSummaryBox           = document.getElementById('aiSummaryBox');
    const generateAiSummaryBtn   = document.getElementById('generateAiSummaryBtn');
    const reviewSummaryCsrfToken = document.getElementById('reviewSummaryCsrfToken');

    let currentHotelId = null, predictTimer = null, currentPredictedStars = 0;

    function esc(v){ return String(v||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;'); }
    function showAlert(el,msg,type){ el.style.display='block'; el.textContent=msg; el.style.background=type==='success'?'#e9f8ee':'#fdeceb'; el.style.color=type==='success'?'#1f7a39':'#b42318'; el.style.border='1px solid '+(type==='success'?'#b7e4c7':'#f5c2c7'); }
    function hideAlert(el){ el.style.display='none'; el.textContent=''; }

    function setAutoStars(n){
        currentPredictedStars=Number(n)||0;
        addReviewAutoStars.querySelectorAll('span').forEach(function(s,i){ s.className='review-auto-star '+(i+1<=currentPredictedStars?'review-auto-star-filled':'review-auto-star-empty'); });
        addReviewAutoText.textContent='Auto: '+currentPredictedStars+'/5';
    }

    function renderStars(note){ let h=''; for(let i=1;i<=5;i++) h+='<span style="color:'+(i<=note?'#f7941d':'#d1dae5')+';">★</span>'; return h; }

    function renderReviewList(reviews){
        if(!reviews||!reviews.length){ viewReviewsList.innerHTML='<div style="padding:18px;border:1px dashed #d6e0ea;border-radius:18px;color:#7b8794;background:#fcfdff;">No reviews yet.</div>'; viewReviewsListMeta.textContent='0 review'; return; }
        viewReviewsListMeta.textContent=reviews.length+' review'+(reviews.length>1?'s':'');
        viewReviewsList.innerHTML=reviews.map(function(r){
            return '<div class="review-list-card"><div class="review-list-top"><div class="review-list-author">'+esc(r.author||'Guest')+'</div><div class="review-list-date">'+esc(r.dateAvis||'')+'</div></div><div class="review-list-stars">'+renderStars(r.note)+'</div><div class="review-list-comment">'+esc(r.commentaire||'')+'</div></div>';
        }).join('');
    }

    function setSummary(s){
        const score=Number(s&&s.score10?s.score10:0), count=Number(s&&s.count?s.count:0);
        viewReviewsSummaryScore.textContent=score.toFixed(1)+' / 10';
        viewReviewsSummaryCount.textContent=String(count);
    }

    function updateCardSummary(id, s){
        const textNode  = document.querySelector('[data-summary-text="'+id+'"]');
        const starsNode = document.querySelector('[data-summary-stars="'+id+'"]');
        if(!textNode||!starsNode||!s) return;
        const score=Number(s.score10||0), count=Number(s.count||0), rounded=Number(s.starsRounded||0);
        textNode.textContent=count>0?score.toFixed(1)+' / 10 • '+count+' review'+(count>1?'s':''):'No reviews yet';
        let h=''; for(let i=1;i<=5;i++) h+='<span class="'+(i<=rounded?'front-star-filled':'front-star-empty')+'">★</span>';
        starsNode.innerHTML=h;
    }

    async function loadReviews(id){
        viewReviewsList.innerHTML='<div style="padding:18px;border:1px dashed #d6e0ea;border-radius:18px;color:#7b8794;background:#fcfdff;">Loading...</div>';
        aiSummaryBox.textContent='Click "Generate" to build the AI summary.';
        setSummary({score10:0,count:0});
        const res=await fetch('/avis/hebergement/'+id,{method:'GET',headers:{'X-Requested-With':'XMLHttpRequest'}});
        const data=await res.json();
        if(!res.ok||!data.success) throw new Error(data.message||'Unable to load reviews.');
        renderReviewList(data.reviews||[]);
        setSummary(data.summary||{});
        updateCardSummary(id,data.summary||{});
    }

    function openAddReview(id,name){
        currentHotelId=id; addReviewHotelId.value=id; addReviewHotelTitle.textContent=name;
        addReviewAuthor.value=''; addReviewComment.value=''; setAutoStars(0);
        addReviewPredictStatus.textContent='Type a comment to predict stars'; hideAlert(addReviewAlert);
        addReviewModal.style.display='flex'; addReviewModal.setAttribute('aria-hidden','false'); blurPage();
    }
    function closeAddReview(){ addReviewModal.style.display='none'; addReviewModal.setAttribute('aria-hidden','true'); unblurPage(); }

    function openViewReviews(id,name){
        currentHotelId=id; viewReviewsHotelTitle.textContent=name; hideAlert(viewReviewsAlert);
        aiSummaryBox.textContent='Click "Generate" to build the AI summary.';
        viewReviewsModal.style.display='flex'; viewReviewsModal.setAttribute('aria-hidden','false'); blurPage();
        loadReviews(id).catch(function(e){ showAlert(viewReviewsAlert,e.message||'Error','error'); renderReviewList([]); setSummary({score10:0,count:0}); });
    }
    function closeViewReviews(){ viewReviewsModal.style.display='none'; viewReviewsModal.setAttribute('aria-hidden','true'); unblurPage(); }

    function debouncePredict(){
        if(predictTimer) clearTimeout(predictTimer);
        predictTimer=setTimeout(async function(){
            const c=addReviewComment.value.trim();
            if(!c){ setAutoStars(0); addReviewPredictStatus.textContent='Type a comment to predict stars'; return; }
            addReviewPredictStatus.textContent='Predicting...';
            try{
                const r=await fetch('/avis/predict?comment='+encodeURIComponent(c),{method:'GET',headers:{'X-Requested-With':'XMLHttpRequest'}});
                const d=await r.json();
                if(!r.ok||!d.success) throw new Error(d.message||'Error');
                setAutoStars(d.stars||0); addReviewPredictStatus.textContent='Automatic rating ready';
            }catch(e){ setAutoStars(0); addReviewPredictStatus.textContent='Prediction unavailable'; }
        },600);
    }

    addReviewForm.addEventListener('submit',async function(e){
        e.preventDefault(); hideAlert(addReviewAlert);
        const c=addReviewComment.value.trim();
        if(!c){ showAlert(addReviewAlert,'Please write a comment.','error'); return; }
        const fd=new FormData();
        fd.append('_token',reviewCsrfToken.value); fd.append('hebergementId',addReviewHotelId.value);
        fd.append('commentaire',c); fd.append('nomAuteur',addReviewAuthor.value.trim());
        const btn=document.getElementById('addReviewSubmitBtn'); btn.disabled=true; btn.textContent='Saving...';
        try{
            const r=await fetch('/avis/create',{method:'POST',body:fd,headers:{'X-Requested-With':'XMLHttpRequest'}});
            const d=await r.json();
            if(!r.ok||!d.success) throw new Error(d.message||'Error');
            showAlert(addReviewAlert,d.message||'Review added.','success');
            addReviewComment.value=''; addReviewAuthor.value=''; setAutoStars(0);
            addReviewPredictStatus.textContent='Type a comment to predict stars';
            if(d.summary) updateCardSummary(addReviewHotelId.value,d.summary);
        }catch(e){ showAlert(addReviewAlert,e.message||'Error','error'); }
        finally{ btn.disabled=false; btn.textContent='Save review'; }
    });

    generateAiSummaryBtn.addEventListener('click',async function(){
        hideAlert(viewReviewsAlert);
        if(!currentHotelId) return;
        generateAiSummaryBtn.disabled=true; generateAiSummaryBtn.textContent='Loading...';
        aiSummaryBox.textContent='Generating AI summary...';
        try{
            const fd=new FormData(); fd.append('_token',reviewSummaryCsrfToken.value);
            const r=await fetch('/avis/hebergement/'+currentHotelId+'/summary',{method:'POST',body:fd,headers:{'X-Requested-With':'XMLHttpRequest'}});
            const d=await r.json();
            if(!r.ok||!d.success) throw new Error(d.message||'Error');
            aiSummaryBox.textContent=d.summary||'No summary available.';
        }catch(e){ aiSummaryBox.textContent='❌ '+(e.message||'Error'); }
        finally{ generateAiSummaryBtn.disabled=false; generateAiSummaryBtn.textContent='Generate'; }
    });

    document.querySelectorAll('.js-open-add-review').forEach(function(btn){
        btn.addEventListener('click',function(){ openAddReview(this.dataset.hotelId,this.dataset.hotelName); });
    });
    document.querySelectorAll('.js-open-view-reviews').forEach(function(btn){
        btn.addEventListener('click',function(){ openViewReviews(this.dataset.hotelId,this.dataset.hotelName); });
    });

    addReviewComment.addEventListener('input',debouncePredict);
    document.getElementById('addReviewCloseTopBtn').addEventListener('click',closeAddReview);
    document.getElementById('addReviewCancelBtn').addEventListener('click',closeAddReview);
    document.getElementById('viewReviewsCloseTopBtn').addEventListener('click',closeViewReviews);
    document.getElementById('viewReviewsCloseBtn').addEventListener('click',closeViewReviews);
    addReviewModal.addEventListener('click',function(e){if(e.target===addReviewModal)closeAddReview();});
    viewReviewsModal.addEventListener('click',function(e){if(e.target===viewReviewsModal)closeViewReviews();});
    document.addEventListener('keydown',function(e){
        if(e.key==='Escape'){
            if(addReviewModal.style.display==='flex') closeAddReview();
            if(viewReviewsModal.style.display==='flex') closeViewReviews();
            closePanoramaModal();
        }
    });

    closeAddReview(); closeViewReviews();
});
</script>
{% endblock %}
