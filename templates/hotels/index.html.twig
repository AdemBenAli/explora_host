{% extends 'base_hotels.html.twig' %}

{% block title %}Hotels | Explora{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pannellum@2.5.7/build/pannellum.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* ============================
           RESET GLOBAL
        ============================ */
        * { box-sizing: border-box; }
        body { margin: 0; padding: 0; background: #f3f4f6; font-family: 'Segoe UI', Roboto, sans-serif; }

        :root {
            --navy:#1a3a5c; --navy-dark:#0f2540;
            --orange:#f7941d; --orange-dk:#e07800; --orange-lt:#fff3e0;
            --white:#ffffff; --bg-card:#ffffff; --gray-lt:#f8f9fa; --gray-md:#e9ecef;
            --text-heading:#1e293b; --text-body:#64748b;
            --sh-sm:0 2px 8px rgba(0,0,0,.08);
            --r-sm:8px; --tr:.2s ease;
            --fd:'Plus Jakarta Sans',sans-serif;
            --fb:'DM Sans',sans-serif;
        }

        /* ============================
           VOYAGEUR TOPBAR
        ============================ */
        .ut-navbar{
            background:var(--bg-card);
            box-shadow:var(--sh-sm);
            position:sticky;
            top:0;
            z-index:200;
        }
        .ut-navbar__inner{
            max-width:1440px;
            margin:0 auto;
            padding:0 25px;
            height:64px;
            display:flex;
            align-items:center;
            gap:12px;
        }
        .ut-navbar__logo{
            display:flex;
            align-items:center;
            gap:10px;
            text-decoration:none;
            font-family:var(--fd);
            font-weight:800;
            font-size:20px;
            color:var(--text-heading);
            flex-shrink:0;
        }
        .ut-navbar__links{
            display:flex;
            gap:4px;
            margin-left:auto;
        }
        .ut-nav-link{
            font-family:var(--fd);
            font-weight:600;
            font-size:13px;
            color:var(--text-heading);
            text-decoration:none;
            padding:8px 14px 10px;
            border-radius:var(--r-sm);
            transition:var(--tr);
            white-space:nowrap;
            position:relative;
        }
        .ut-nav-link:hover{ color:var(--orange); }
        .ut-nav-link--active{ color:var(--orange); }
        .ut-nav-link--active::after{
            content:'';
            position:absolute;
            bottom:0;
            left:14px;
            right:14px;
            height:3px;
            border-radius:3px;
            background:var(--orange);
        }
        .ut-navbar__actions{
            display:flex;
            align-items:center;
            gap:8px;
            margin-left:12px;
        }
        .ut-theme-btn{
            background:var(--gray-lt);
            border:none;
            border-radius:999px;
            width:40px;
            height:40px;
            cursor:pointer;
            display:flex;
            align-items:center;
            justify-content:center;
            color:var(--text-heading);
            transition:var(--tr);
        }
        .ut-theme-btn:hover{ background:var(--gray-md); }
        .ut-btn{
            display:inline-flex;
            align-items:center;
            gap:6px;
            font-family:var(--fd);
            font-weight:700;
            font-size:12px;
            padding:8px 14px;
            border-radius:999px;
            border:2px solid transparent;
            text-decoration:none;
            cursor:pointer;
            transition:var(--tr);
            white-space:nowrap;
        }
        .ut-btn--secondary{ background:#fff; border-color:#e2e8f0; color:var(--text-heading); }
        .ut-btn--secondary:hover{ border-color:var(--orange); color:var(--orange); }
        .ut-btn--primary{ background:var(--orange); color:#fff; border-color:var(--orange); }
        .ut-btn--primary:hover{ background:var(--orange-dk); border-color:var(--orange-dk); }
        .ut-btn--sm{ padding:7px 12px; font-size:12px; }

        .user-profile-wrap{ position:relative; }
        .user-profile{
            display:flex;
            align-items:center;
            gap:10px;
            padding:6px 10px;
            border-radius:999px;
            border:1px solid #e2e8f0;
            cursor:pointer;
            background:#fff;
        }
        .user-avatar{ width:36px; height:36px; border-radius:50%; }
        .user-name{ font-weight:700; font-size:12px; color:var(--text-heading); }
        .user-role{ font-size:11px; color:var(--text-body); }
        .user-dropdown-icon{ color:#94a3b8; font-size:12px; }
        .user-dropdown{
            position:absolute;
            right:0;
            top:56px;
            background:#fff;
            border:1px solid #e2e8f0;
            border-radius:12px;
            box-shadow:0 12px 30px rgba(0,0,0,.12);
            min-width:220px;
            padding:10px;
            display:none;
            z-index:50;
        }
        .user-dropdown.open{ display:block; }
        .dropdown-header{ display:flex; align-items:center; gap:10px; padding:8px; }
        .dropdown-header img{ width:40px; height:40px; border-radius:50%; }
        .dropdown-header-name{ font-weight:700; font-size:13px; }
        .dropdown-header-role{ font-size:12px; color:var(--text-body); }
        .dropdown-item{
            display:flex;
            align-items:center;
            gap:8px;
            padding:8px 10px;
            border-radius:8px;
            text-decoration:none;
            color:var(--text-heading);
            font-size:13px;
        }
        .dropdown-item:hover{ background:#f8fafc; }
        .dropdown-divider{ height:1px; background:#e2e8f0; margin:6px 0; }
        .dropdown-item--danger{ color:#dc2626; }

        /* ============================
           NAVBAR - Force 1 ligne horizontale
        ============================ */
        .front-navbar {
            background: #ffffff !important;
            border-bottom: 1px solid rgba(26,58,92,0.08) !important;
        }
        .front-navbar-inner {
            width: calc(100% - 80px) !important;
            max-width: 1680px !important;
            margin: 0 auto !important;
            display: grid !important;
            grid-template-columns: 240px 1fr auto !important;
            align-items: center !important;
            min-height: 90px !important;
            gap: 20px !important;
            padding: 0 !important;
            justify-items: unset !important;
        }
        .front-brand-logo {
            width: 200px !important;
            height: auto !important;
        }
        .front-center-nav {
            display: flex !important;
            flex-direction: row !important;
            flex-wrap: nowrap !important;
            justify-content: center !important;
            align-items: center !important;
            gap: 10px !important;
            width: auto !important;
        }
        .front-nav-pill {
            white-space: nowrap !important;
            flex-shrink: 0 !important;
            width: auto !important;
            min-width: 90px !important;
            padding: 10px 16px !important;
            border: 1px solid #d4dbe3 !important;
            border-radius: 12px !important;
            background: #fafafa !important;
            color: #1a3a5c !important;
            font-size: 13px !important;
            font-weight: 800 !important;
            text-align: center !important;
            text-decoration: none !important;
            transition: 0.2s ease !important;
        }
        .front-nav-pill:hover {
            border-color: rgba(26,58,92,0.22) !important;
            background: #ffffff !important;
        }
        .front-nav-pill-active {
            background: #ffffff !important;
            border-color: #cfd6df !important;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04) !important;
        }
        .front-right-nav {
            display: flex !important;
            flex-direction: row !important;
            flex-wrap: nowrap !important;
            justify-content: flex-end !important;
            align-items: center !important;
            gap: 10px !important;
            width: auto !important;
        }
        .front-outline-pill {
            white-space: nowrap !important;
            width: auto !important;
            min-width: 110px !important;
            height: 46px !important;
            padding: 0 20px !important;
            border: 2px solid #1a3a5c !important;
            border-radius: 999px !important;
            background: #ffffff !important;
            color: #1a3a5c !important;
            font-size: 13px !important;
            font-weight: 800 !important;
            text-decoration: none !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            transition: 0.2s ease !important;
        }
        .front-outline-pill:hover {
            background: #1a3a5c !important;
            color: #ffffff !important;
        }
        .front-accent-pill {
            white-space: nowrap !important;
            width: auto !important;
            min-width: 90px !important;
            height: 46px !important;
            padding: 0 20px !important;
            border-radius: 999px !important;
            background: #f7941d !important;
            color: #ffffff !important;
            border: none !important;
            font-size: 13px !important;
            font-weight: 800 !important;
            text-decoration: none !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
        }

        /* ============================
           HERO
        ============================ */
        .front-hero-hotels {
            background: linear-gradient(90deg, #14988f 0%, #39df74 100%) !important;
            padding: 58px 20px 130px !important;
            text-align: center !important;
        }
        .front-hero-content h1 {
            margin: 0 0 14px !important;
            color: #ffffff !important;
            font-size: 64px !important;
            font-weight: 800 !important;
        }
        .front-hero-content p {
            margin: 0 !important;
            color: rgba(255,255,255,0.96) !important;
            font-size: 20px !important;
        }

        /* ============================
           SEARCH BAR
        ============================ */
        .front-search-card-wrap {
            width: calc(100% - 60px) !important;
            max-width: 1680px !important;
            margin: -65px auto 0 !important;
            position: relative !important;
            z-index: 2 !important;
        }
        .front-search-card {
            background: #ffffff !important;
            border-radius: 20px !important;
            box-shadow: 0 10px 26px rgba(0,0,0,0.1) !important;
            padding: 24px 28px !important;
        }
        .front-search-main {
            display: grid !important;
            grid-template-columns: 1fr 200px auto !important;
            gap: 18px !important;
            align-items: end !important;
        }
        .front-search-field label {
            display: block !important;
            margin-bottom: 10px !important;
            color: #1a3a5c !important;
            font-size: 13px !important;
            font-weight: 800 !important;
        }
        .front-search-field input,
        .front-search-field select {
            width: 100% !important;
            height: 50px !important;
            border: 1px solid #d9dfe6 !important;
            border-radius: 12px !important;
            background: #f8f9fb !important;
            padding: 0 16px !important;
            font-size: 15px !important;
            color: #212529 !important;
        }
        .front-search-actions {
            display: flex !important;
            gap: 14px !important;
            align-items: center !important;
        }
        .front-btn-primary {
            min-width: 120px !important;
            height: 50px !important;
            border: none !important;
            padding: 0 24px !important;
            background: #f7941d !important;
            color: #ffffff !important;
            font-size: 15px !important;
            font-weight: 800 !important;
            border-radius: 999px !important;
            cursor: pointer !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            text-decoration: none !important;
            transition: 0.2s ease !important;
        }
        .front-btn-primary:hover { background: #e0820a !important; }
        .front-btn-outline {
            min-width: 100px !important;
            height: 50px !important;
            padding: 0 24px !important;
            border: 2px solid #1a3a5c !important;
            background: transparent !important;
            color: #1a3a5c !important;
            font-size: 15px !important;
            font-weight: 800 !important;
            border-radius: 999px !important;
            cursor: pointer !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            text-decoration: none !important;
            transition: 0.2s ease !important;
        }
        .front-btn-outline:hover {
            background: #1a3a5c !important;
            color: #ffffff !important;
        }

        /* ============================
           MAIN LAYOUT
        ============================ */
        .front-hotels-page {
            width: calc(100% - 60px) !important;
            max-width: 1680px !important;
            margin: 40px auto 56px !important;
            display: grid !important;
            grid-template-columns: 300px 1fr !important;
            gap: 30px !important;
            align-items: start !important;
        }

        /* ============================
           FILTERS SIDEBAR
        ============================ */
        .front-filters-card {
            background: #ffffff !important;
            border-radius: 20px !important;
            box-shadow: 0 8px 22px rgba(0,0,0,0.08) !important;
            padding: 26px 22px 24px !important;
        }
        .front-filters-card h2 {
            margin: 0 !important;
            font-size: 26px !important;
            color: #1a3a5c !important;
            font-weight: 800 !important;
        }
        .front-divider {
            height: 2px !important;
            background: rgba(26,58,92,0.4) !important;
            margin: 18px 0 22px !important;
        }
        .front-filters-form { display: flex !important; flex-direction: column !important; gap: 16px !important; }
        .front-filter-group { display: flex !important; flex-direction: column !important; gap: 6px !important; }
        .front-filter-group label { font-size: 13px !important; font-weight: 800 !important; color: #1a3a5c !important; }
        .front-filter-group input,
        .front-filter-group select {
            height: 42px !important; border-radius: 10px !important; border: 1px solid #d4dce6 !important;
            padding: 0 12px !important; background: #ffffff !important; font-size: 14px !important; width: 100% !important;
        }
        .front-checkbox-line {
            display: flex !important; align-items: center !important; gap: 10px !important;
            color: #1a3a5c !important; font-size: 14px !important; font-weight: 500 !important;
        }
        .front-checkbox-line input[type="checkbox"] {
            width: 20px !important; height: 20px !important; accent-color: #f7941d !important;
            cursor: pointer !important; flex-shrink: 0 !important;
        }
        .front-filter-submit {
            margin-top: 16px !important; width: 100% !important; height: 48px !important;
            background: #f7941d !important; color: #ffffff !important; border: none !important;
            border-radius: 999px !important; font-size: 15px !important; font-weight: 800 !important; cursor: pointer !important;
        }

        /* ============================
           HOTELS RESULTS
        ============================ */
        .front-hotels-results h2 { margin: 0 0 20px !important; color: #1a3a5c !important; font-size: 20px !important; font-weight: 800 !important; }
        .front-hotels-results h2 span { color: #868e96 !important; font-size: 16px !important; font-weight: 700 !important; }
        .front-hotels-list { display: flex !important; flex-direction: column !important; gap: 20px !important; }

        /* ============================
           HOTEL CARD
        ============================ */
        .front-hotel-card {
            display: grid !important;
            grid-template-columns: 320px 1fr !important;
            align-items: stretch !important;
            background: #ffffff !important;
            border-radius: 20px !important;
            box-shadow: 0 8px 20px rgba(0,0,0,0.08) !important;
            overflow: hidden !important;
            min-height: 240px !important;
        }
        .front-hotel-image-wrap {
            position: relative !important;
            background: #e9eef5 !important;
            min-height: 240px !important;
            overflow: hidden !important;
            cursor: pointer !important;
        }
        .front-hotel-image {
            width: 100% !important; height: 100% !important; object-fit: cover !important;
            display: block !important; min-height: 240px !important;
            transition: transform 0.35s ease !important;
        }
        .front-hotel-image-wrap:hover .front-hotel-image { transform: scale(1.04) !important; }
        .front-hotel-content {
            padding: 22px 24px 20px !important; display: flex !important;
            flex-direction: row !important; justify-content: space-between !important; gap: 20px !important;
        }
        .front-hotel-main { flex: 1 !important; min-width: 0 !important; }
        .front-hotel-main h3 { margin: 0 0 8px !important; color: #1a3a5c !important; font-size: 24px !important; font-weight: 800 !important; }
        .front-hotel-location { color: #868e96 !important; font-size: 15px !important; margin-bottom: 10px !important; }
        .front-hotel-description { color: #8d97a3 !important; font-size: 14px !important; line-height: 1.5 !important; margin-bottom: 14px !important; }
        .front-hotel-price { color: #f7941d !important; font-size: 30px !important; font-weight: 800 !important; margin-bottom: 2px !important; }
        .front-hotel-price-sub { color: #868e96 !important; font-size: 14px !important; margin-bottom: 12px !important; }
        .front-hotel-stars-line {
            display: flex !important; align-items: center !important; gap: 8px !important;
            margin-bottom: 12px !important; flex-wrap: wrap !important;
        }
        .front-stars { display: flex !important; gap: 2px !important; }
        .front-star-filled { color: #f4be2a !important; font-size: 20px !important; line-height: 1 !important; }
        .front-star-empty  { color: #d8dde3 !important; font-size: 20px !important; line-height: 1 !important; }
        .front-review-text { color: #868e96 !important; font-size: 14px !important; }
        .front-hotel-tags { display: flex !important; flex-wrap: wrap !important; gap: 8px !important; }
        .front-tag {
            display: inline-flex !important; align-items: center !important; justify-content: center !important;
            min-height: 30px !important; padding: 0 12px !important; border-radius: 999px !important;
            background: rgba(26,58,92,0.08) !important; color: #1a3a5c !important;
            font-size: 12px !important; font-weight: 700 !important;
        }
        .front-hotel-actions {
            width: 360px !important; display: flex !important; flex-wrap: wrap !important;
            align-items: flex-end !important; justify-content: flex-end !important;
            gap: 10px !important; align-content: flex-end !important; flex-shrink: 0 !important;
        }
        .action-pill {
            min-width: 130px !important; height: 46px !important; border-radius: 999px !important;
            font-size: 14px !important; font-weight: 800 !important; cursor: pointer !important;
            display: inline-flex !important; align-items: center !important;
            justify-content: center !important; padding: 0 18px !important;
        }
        .front-btn-map { min-width: 90px !important; }
        .front-empty-state {
            background: #ffffff !important; border-radius: 20px !important;
            box-shadow: 0 8px 20px rgba(0,0,0,0.08) !important; padding: 42px !important;
            text-align: center !important; color: #868e96 !important; font-size: 18px !important;
        }

        /* ============================
           PANORAMA BADGE
        ============================ */
        .front-panorama-badge {
            position: absolute !important;
            left: 14px !important; bottom: 14px !important;
            display: inline-flex !important; align-items: center !important; justify-content: center !important;
            min-width: 98px !important; height: 34px !important; padding: 0 14px !important;
            border-radius: 999px !important;
            background: rgba(26,58,92,0.82) !important;
            color: #ffffff !important; font-size: 13px !important; font-weight: 800 !important;
            box-shadow: 0 8px 18px rgba(0,0,0,0.16) !important; z-index: 2 !important;
            pointer-events: none !important;
        }

        /* ============================
           PAGINATION
        ============================ */
        .front-pagination-wrapper {
            display: flex !important; justify-content: center !important;
            align-items: center !important; margin: 28px 0 8px !important;
        }
        .front-pagination-wrapper nav { display: flex !important; justify-content: center !important; }
        .front-pagination-wrapper ul.pagination {
            list-style: none !important; margin: 0 !important; padding: 0 !important;
            display: flex !important; justify-content: center !important; align-items: center !important;
            gap: 10px !important; flex-wrap: wrap !important;
        }
        .front-pagination-wrapper ul.pagination li.page-item { list-style: none !important; margin: 0 !important; padding: 0 !important; }
        .front-pagination-wrapper ul.pagination li.page-item .page-link {
            min-width: 48px !important; height: 48px !important; padding: 0 16px !important;
            border-radius: 999px !important; border: 2px solid #d7dde5 !important;
            background: #ffffff !important; color: #1a3a5c !important;
            font-size: 15px !important; font-weight: 800 !important;
            display: inline-flex !important; align-items: center !important;
            justify-content: center !important; text-decoration: none !important;
        }
        .front-pagination-wrapper ul.pagination li.page-item .page-link:hover {
            background: rgba(247,148,29,0.10) !important; border-color: #f7941d !important; color: #f7941d !important;
        }
        .front-pagination-wrapper ul.pagination li.page-item.active .page-link {
            background: #f7941d !important; border-color: #f7941d !important; color: #ffffff !important;
        }
        .front-pagination-wrapper ul.pagination li.page-item.disabled .page-link {
            opacity: 0.45 !important; cursor: not-allowed !important; pointer-events: none !important;
            background: #f4f6f9 !important; color: #98a3af !important;
        }

        /* ============================
           MODALS COMMUNES
        ============================ */
        body.modal-open { overflow: hidden; }

        /* ============================
           REVIEW STYLES
        ============================ */
        .review-auto-star-filled { color: #f7941d; text-shadow: 0 4px 10px rgba(247,148,29,0.28); }
        .review-auto-star-empty  { color: #d1dae5; }
        .review-list-card {
            padding: 16px; border-radius: 18px; border: 1px solid #e3ebf2;
            background: #ffffff; box-shadow: 0 8px 20px rgba(18,44,72,0.06);
        }
        .review-list-top { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 10px; }
        .review-list-author { font-size: 15px; font-weight: 800; color: #1a3a5c; }
        .review-list-date { font-size: 12px; font-weight: 700; color: #91a0b1; }
        .review-list-stars { display: flex; gap: 3px; font-size: 17px; line-height: 1; margin-bottom: 10px; }
        .review-list-comment { font-size: 14px; line-height: 1.65; color: #445b73; white-space: pre-line; }

        /* ============================
           PANORAMA MODAL
        ============================ */
        .front-panorama-modal-overlay {
            position: fixed; inset: 0;
            background: rgba(20,27,38,0.34);
            backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
            display: none; align-items: center; justify-content: center;
            z-index: 100000; padding: 24px;
        }
        .front-panorama-modal-overlay.active { display: flex; }
        .front-panorama-modal-card {
            width: min(100%, 1240px); max-height: calc(100vh - 48px);
            overflow: hidden; background: #ffffff; border-radius: 28px;
            box-shadow: 0 30px 70px rgba(0,0,0,0.26);
        }
        .front-panorama-modal-header {
            display: flex; align-items: center; justify-content: space-between;
            gap: 16px; padding: 22px 24px 16px; border-bottom: 1px solid #e6edf5;
        }
        .front-panorama-modal-kicker { font-size: 14px; font-weight: 800; color: #f7941d; letter-spacing: 0.05em; text-transform: uppercase; }
        .front-panorama-modal-header h2 { margin: 6px 0 0; color: #1a3a5c; font-size: 26px; font-weight: 900; }
        .front-panorama-modal-close {
            border: none; background: transparent; font-size: 32px;
            line-height: 1; cursor: pointer; color: #1a3a5c;
        }
        .front-panorama-modal-body { padding: 18px 24px 24px; }
        .front-panorama-notice {
            margin-bottom: 14px; padding: 12px 16px; border-radius: 14px;
            background: #f6f8fb; border: 1px solid #dde7f1; color: #5d7086; font-size: 14px;
        }
        .front-panorama-viewer-wrap,
        .front-panorama-fallback-wrap {
            width: 100%; height: min(72vh, 700px); border-radius: 22px;
            overflow: hidden; background: #eef2f7;
        }
        .front-panorama-viewer-frame { width: 100%; height: 100%; border: none; display: block; background: #eef2f7; }
        .front-panorama-fallback-wrap { display: flex; align-items: center; justify-content: center; }
        .front-panorama-fallback-image { width: 100%; height: 100%; object-fit: contain; background: #eef2f7; }
        .front-panorama-loading {
            display: flex; align-items: center; justify-content: center;
            height: min(72vh, 700px); color: #8d99a8; font-size: 16px; font-weight: 700;
        }
    </style>
{% endblock %}

{% block body %}
<div class="front-hotels-shell" id="frontHotelsPage">

    <nav class="ut-navbar">
        <div class="ut-navbar__inner">
            <a href="{{ path('app_home') }}" class="ut-navbar__logo">
                {{ include('partials/explora_brand.html.twig', {admin: false, logoHeight: 52}) }}
            </a>
            <div class="ut-navbar__links">
                <a href="{{ path('app_home') }}" class="ut-nav-link">Accueil</a>
                <a href="{{ path('voyages') }}" class="ut-nav-link">Voyages</a>
                <a href="{{ path('user_transport') }}" class="ut-nav-link">Transport</a>
                <a href="{{ path('app_hebergement_front') }}" class="ut-nav-link ut-nav-link--active">Hôtels</a>
                <a href="{{ path('voyageur_index') }}" class="ut-nav-link">Activités</a>
            </div>
            <div class="ut-navbar__actions">
                <button class="ut-theme-btn" type="button" title="Mode nuit / jour">
                    <i class="fas fa-moon"></i>
                </button>
                <button type="button" class="ut-btn ut-btn--secondary ut-btn--sm"
                        style="color:#059669;border-color:#059669;background:rgba(5,150,105,.07)">
                    🌿 <span>{{ ecoScore.pointsActuels ?? 0 }}</span> PTS
                </button>
                <button type="button" class="ut-btn ut-btn--secondary ut-btn--sm">
                    <i class="fas fa-cloud-sun"></i> Météo
                </button>
                <a href="#" class="ut-btn ut-btn--secondary ut-btn--sm">
                    <i class="fas fa-map-marked-alt"></i> Carte
                </a>
                <a href="{{ path('user_transport_flight_map') }}" class="ut-btn ut-btn--secondary ut-btn--sm">
                    <i class="fas fa-plane-departure"></i> Carte Vols
                </a>
                <a href="{{ path('app_reservation_history') }}" class="ut-btn ut-btn--primary">
                    <i class="fas fa-ticket-alt"></i> Mes Réservations
                </a>

                {% set userFirst = voyageur is defined and voyageur.prenom is defined ? voyageur.prenom : 'Ben' %}
                {% set userLast = voyageur is defined and voyageur.nom is defined ? voyageur.nom : 'Ali' %}
                <div class="user-profile-wrap" id="userWrap">
                    <div class="user-profile" id="userToggle">
                        <img src="https://ui-avatars.com/api/?name={{ userFirst }}+{{ userLast }}&background=1e293b&color=fff"
                             alt="Avatar" class="user-avatar">
                        <div>
                            <div class="user-name">{{ userFirst }} {{ userLast }}</div>
                            <div class="user-role">Voyageur</div>
                        </div>
                        <i class="fas fa-chevron-down user-dropdown-icon"></i>
                    </div>

                    <div class="user-dropdown" id="userDropdown">
                        <div class="dropdown-header">
                            <img src="https://ui-avatars.com/api/?name={{ userFirst }}+{{ userLast }}&background=1e293b&color=fff" alt="Avatar">
                            <div>
                                <div class="dropdown-header-name">{{ userFirst }} {{ userLast }}</div>
                                <div class="dropdown-header-role">Voyageur</div>
                            </div>
                        </div>
                        <a href="#" class="dropdown-item">
                            <i class="fas fa-user"></i> Mon profil
                        </a>
                        <a href="#" class="dropdown-item">
                            <i class="fas fa-cog"></i> Paramètres
                        </a>
                        <div class="dropdown-divider"></div>
                        <a href="{{ path('app_logout') }}" class="dropdown-item dropdown-item--danger">
                            <i class="fas fa-sign-out-alt"></i> Se déconnecter
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </nav>
    <script>
        (function () {
            var toggle = document.getElementById('userToggle');
            var dropdown = document.getElementById('userDropdown');
            if (!toggle || !dropdown) return;

            toggle.addEventListener('click', function (event) {
                event.stopPropagation();
                dropdown.classList.toggle('open');
            });

            document.addEventListener('click', function () {
                dropdown.classList.remove('open');
            });
        })();
    </script>

    <section class="front-hero-hotels">
        <div class="front-hero-content">
            <h1>Find Your Perfect Stay</h1>
            <p>From cozy boutique hotels to luxury resorts</p>
        </div>
    </section>

    <section class="front-search-card-wrap">
        <div class="front-search-card">
            <form method="get" action="{{ path('app_hebergement_front') }}" autocomplete="off">
                <div class="front-search-main">
                    <div class="front-search-field" style="position:relative;">
                        <label for="destination">Destination (Country)</label>
                        <input type="text" id="destination" name="destination"
                            value="{{ filters.destination }}" placeholder="Where are you going?" autocomplete="off">
                        <div id="countrySuggestions" style="display:none;position:absolute;top:100%;left:0;right:0;margin-top:10px;background:#ffffff;border:1px solid #d9dfe6;border-radius:18px;box-shadow:0 18px 36px rgba(0,0,0,0.14);z-index:999999;max-height:420px;overflow-y:auto;padding:10px 0;"></div>
                    </div>
                    <div class="front-search-field">
                        <label for="type">Accommodation Type</label>
                        <select id="type" name="type">
                            <option value="">Select type</option>
                            <option value="hotel" {{ filters.type == 'hotel' ? 'selected' : '' }}>Hotel</option>
                            <option value="hostel" {{ filters.type == 'hostel' ? 'selected' : '' }}>Hostel</option>
                            <option value="motel" {{ filters.type == 'motel' ? 'selected' : '' }}>Motel</option>
                            <option value="maison" {{ filters.type == 'maison' ? 'selected' : '' }}>Maison</option>
                            <option value="appartement" {{ filters.type == 'appartement' ? 'selected' : '' }}>Appartement</option>
                        </select>
                    </div>
                    <div class="front-search-actions">
                        <button type="submit" class="front-btn-primary">Search</button>
                        <a href="{{ path('app_hebergement_front') }}" class="front-btn-outline">Reset</a>
                    </div>
                </div>
            </form>
        </div>
    </section>

    <section class="front-hotels-page">

        <aside class="front-filters-card">
            <h2>Filters</h2>
            <div class="front-divider"></div>
            <form method="get" action="{{ path('app_hebergement_front') }}" class="front-filters-form">
                <input type="hidden" name="destination" value="{{ filters.destination }}">
                <input type="hidden" name="type" value="{{ filters.type }}">
                <div class="front-filter-group">
                    <label for="minPrice">Min price</label>
                    <input type="number" id="minPrice" name="minPrice" value="{{ filters.minPrice }}">
                </div>
                <div class="front-filter-group">
                    <label for="maxPrice">Max price</label>
                    <input type="number" id="maxPrice" name="maxPrice" value="{{ filters.maxPrice }}">
                </div>
                <div class="front-filter-group">
                    <label for="sort">Select order</label>
                    <select id="sort" name="sort">
                        <option value="price_asc" {{ filters.sort == 'price_asc' ? 'selected' : '' }}>Price: Low to High</option>
                        <option value="price_desc" {{ filters.sort == 'price_desc' ? 'selected' : '' }}>Price: High to Low</option>
                        <option value="name_asc" {{ filters.sort == 'name_asc' ? 'selected' : '' }}>Name: A to Z</option>
                        <option value="name_desc" {{ filters.sort == 'name_desc' ? 'selected' : '' }}>Name: Z to A</option>
                    </select>
                </div>
                <label class="front-checkbox-line">
                    <input type="checkbox" name="specialCouple" value="1" {{ filters.specialCouple ? 'checked' : '' }}>
                    <span>Special Couple</span>
                </label>
                <label class="front-checkbox-line">
                    <input type="checkbox" name="under18Allowed" value="1" {{ filters.under18Allowed ? 'checked' : '' }}>
                    <span>-18 years allowed</span>
                </label>
                <label class="front-checkbox-line">
                    <input type="checkbox" name="seaView" value="1" {{ filters.seaView ? 'checked' : '' }}>
                    <span>Sea view</span>
                </label>
                <button type="submit" class="front-btn-primary front-filter-submit">Apply Filters</button>
            </form>
        </aside>

        <div class="front-hotels-results">

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div style="margin-bottom:18px;padding:14px 16px;border-radius:14px;font-weight:700;background:{{ label == 'success' ? '#e9f8ee' : '#fdeceb' }};color:{{ label == 'success' ? '#1f7a39' : '#b42318' }};border:1px solid {{ label == 'success' ? '#b7e4c7' : '#f5c2c7' }};">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            <h2>Hotels found <span>({{ hotelsCount }})</span></h2>

            <div class="front-hotels-list">
                {% for h in hebergements %}
                    {% set hotelSummary = summaries[h.id] ?? { avg5: (h.noteMoyenne ?? 0), count: 0, score10: ((h.noteMoyenne ?? 0) / 5 * 10), starsRounded: ((h.noteMoyenne ?? 0)|round(0, 'common')) } %}
                    {% set avg5 = hotelSummary.avg5 ?? 0 %}
                    {% set score10 = hotelSummary.score10 ?? 0 %}
                    {% set stars = hotelSummary.starsRounded ?? 0 %}
                    {% set countAvis = hotelSummary.count ?? 0 %}
                    {% if h.image %}
                        {% if h.image starts with 'http://' or h.image starts with 'https://' %}
                            {% set imageSrc = h.image %}
                        {% elseif h.image starts with '/uploads/' %}
                            {% set imageSrc = asset(h.image|slice(1)) %}
                        {% elseif h.image starts with 'uploads/' %}
                            {% set imageSrc = asset(h.image) %}
                        {% else %}
                            {% set imageSrc = asset('uploads/hebergements/' ~ h.image) %}
                        {% endif %}
                    {% else %}
                        {% set imageSrc = 'https://images.unsplash.com/photo-1566073771259-6a8506099945' %}
                    {% endif %}

                    <article class="front-hotel-card" data-hotel-card="{{ h.id }}">
                        <div class="front-hotel-image-wrap"
                             data-panorama-open="true"
                             data-panorama-src="{{ imageSrc }}"
                             data-panorama-title="{{ h.nom|e('html_attr') }}"
                             title="Cliquer pour agrandir">
                            <img src="{{ imageSrc }}" alt="{{ h.nom }}" class="front-hotel-image">
                            <div class="front-panorama-badge">🔍 View</div>
                        </div>

                        <div class="front-hotel-content">
                            <div class="front-hotel-main">
                                <h3>{{ h.nom }}</h3>
                                <div class="front-hotel-location">
                                    {{ h.localisation ?: 'Unknown location' }}{% if h.pays %} / {{ h.pays }}{% endif %}
                                </div>
                                <div class="front-hotel-description">
                                    {{ h.description ?: 'A comfortable stay designed for your next trip.' }}
                                </div>
                                <div class="front-hotel-price">
                                    ${{ h.prixParNuit is not null ? h.prixParNuit|number_format(1, '.', '') : '0.0' }}
                                </div>
                                <div class="front-hotel-price-sub">per night</div>
                                <div class="front-hotel-stars-line">
                                    <div class="front-stars" data-summary-stars="{{ h.id }}">
                                        {% for i in 1..5 %}
                                            <span class="{{ i <= stars ? 'front-star-filled' : 'front-star-empty' }}">★</span>
                                        {% endfor %}
                                    </div>
                                    <span class="front-review-text" data-summary-text="{{ h.id }}">
                                        {% if countAvis > 0 %}
                                            {{ score10|number_format(1, '.', '') }} / 10 • {{ countAvis }} review{{ countAvis > 1 ? 's' : '' }}
                                        {% else %}
                                            No reviews yet
                                        {% endif %}
                                    </span>
                                </div>
                                <div class="front-hotel-tags">
                                    {% if h.specialCouple %}<span class="front-tag">Special Couple</span>{% endif %}
                                    {% if h.under18Allowed %}<span class="front-tag">-18 allowed</span>{% endif %}
                                    {% if h.seaView %}<span class="front-tag">Sea view</span>{% endif %}
                                    {% if h.capacite %}<span class="front-tag">Capacity: {{ h.capacite }}</span>{% endif %}
                                </div>
                            </div>

                            <div class="front-hotel-actions">
                                <button type="button" class="front-btn-outline action-pill js-open-add-review"
                                    data-hotel-id="{{ h.id }}" data-hotel-name="{{ h.nom|e('html_attr') }}">
                                    Add a review
                                </button>
                                <button type="button" class="front-btn-outline action-pill js-open-view-reviews"
                                    data-hotel-id="{{ h.id }}" data-hotel-name="{{ h.nom|e('html_attr') }}">
                                    View all reviews
                                </button>
                                <button type="button" class="front-btn-outline action-pill front-btn-map js-open-map"
                                    data-hotel-name="{{ h.nom|e('html_attr') }}"
                                    data-hotel-lat="{{ h.latitude is not null ? h.latitude : '' }}"
                                    data-hotel-lng="{{ h.longitude is not null ? h.longitude : '' }}"
                                    data-hotel-price="{{ h.prixParNuit is not null ? h.prixParNuit|number_format(1, '.', '') : '0.0' }}">
                                    Map
                                </button>
                                <button type="button" class="front-btn-primary action-pill js-open-booking"
                                    data-hotel-id="{{ h.id }}" data-hotel-name="{{ h.nom|e('html_attr') }}"
                                    data-hotel-price="{{ h.prixParNuit is not null ? h.prixParNuit|number_format(1, '.', '') : '0.0' }}">
                                    Book Now
                                </button>
                            </div>
                        </div>
                    </article>
                {% else %}
                    <div class="front-empty-state">No hotels match your current filters.</div>
                {% endfor %}
            </div>

            {% if pagination is defined and pagination.pageCount > 1 %}
                <div class="front-pagination-wrapper">
                    {{ knp_pagination_render(pagination) }}
                </div>
            {% endif %}
        </div>
    </section>
</div>

{# ==================== MAP MODAL ==================== #}
<div id="mapModal" aria-hidden="true" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;width:100vw;height:100vh;background:rgba(25,33,45,0.28);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);z-index:999999;align-items:center;justify-content:center;padding:24px;">
    <div id="mapModalCard" onclick="event.stopPropagation();" style="width:100%;max-width:1040px;max-height:94vh;overflow:hidden;background:#ffffff;border-radius:28px;box-shadow:0 30px 70px rgba(0,0,0,0.24);position:relative;">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:16px;padding:22px 24px 16px;border-bottom:1px solid #e6edf5;">
            <div>
                <div style="font-size:14px;font-weight:800;color:#f7941d;letter-spacing:0.05em;text-transform:uppercase;">Map</div>
                <h2 id="mapHotelTitle" style="margin:6px 0 0;color:#1a3a5c;font-size:26px;font-weight:900;">Hotel</h2>
            </div>
            <button type="button" id="mapCloseTopBtn" style="border:none;background:transparent;font-size:32px;line-height:1;cursor:pointer;color:#1a3a5c;">×</button>
        </div>
        <div style="padding:18px 24px 24px;">
            <iframe id="mapFrame" src="{{ asset('map/leaflet_map.html') }}"
                style="width:100%;height:620px;border:none;border-radius:22px;background:#eef2f7;display:block;" loading="lazy"></iframe>
        </div>
    </div>
</div>

{# ==================== BOOKING MODAL ==================== #}
<div id="bookingModal" aria-hidden="true" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;width:100vw;height:100vh;background:rgba(25,33,45,0.28);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);z-index:999999;align-items:center;justify-content:center;padding:24px;">
    <div id="bookingModalCard" onclick="event.stopPropagation();" style="width:100%;max-width:620px;max-height:90vh;overflow-y:auto;background:#ffffff;border-radius:24px;box-shadow:0 26px 60px rgba(0,0,0,0.22);padding:24px 24px 22px;position:relative;">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:10px;">
            <h2 style="margin:0;color:#1a3a5c;font-size:22px;font-weight:800;">Book Now</h2>
            <button type="button" id="bookingCloseTopBtn" style="border:none;background:transparent;font-size:28px;line-height:1;cursor:pointer;color:#1a3a5c;">×</button>
        </div>
        <p id="bookingHotelName" style="margin:0 0 18px;color:#868e96;font-size:16px;padding-bottom:14px;border-bottom:1px solid #dfe5ec;">Hotel: -</p>
        <form id="bookingForm" method="post" action="{{ path('app_reservation_create') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('create_reservation') }}">
            <input type="hidden" name="hotelId" id="bookingHotelId">
            <input type="hidden" name="basePrice" id="bookingBasePrice">

            <label for="bookingFullName" style="display:block;margin-bottom:8px;color:#1a3a5c;font-size:14px;font-weight:800;">Full name</label>
            <input id="bookingFullName" name="nomClient" type="text" placeholder="Your name" required
                style="width:100%;height:44px;margin-bottom:14px;border:1px solid #cfd7e2;border-radius:10px;padding:0 14px;font-size:14px;background:#ffffff;">

            <label for="bookingEmail" style="display:block;margin-bottom:8px;color:#1a3a5c;font-size:14px;font-weight:800;">Email</label>
            <input id="bookingEmail" name="emailClient" type="email" placeholder="your@email.com (optional)"
                style="width:100%;height:44px;margin-bottom:14px;border:1px solid #cfd7e2;border-radius:10px;padding:0 14px;font-size:14px;background:#ffffff;">

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;">
                <div>
                    <label for="bookingCheckin" style="display:block;margin-bottom:8px;color:#1a3a5c;font-size:14px;font-weight:800;">Check-in</label>
                    <input id="bookingCheckin" name="dateCheckin" type="date" required
                        style="width:100%;height:44px;margin-bottom:14px;border:1px solid #cfd7e2;border-radius:10px;padding:0 14px;font-size:14px;background:#ffffff;">
                </div>
                <div>
                    <label for="bookingCheckout" style="display:block;margin-bottom:8px;color:#1a3a5c;font-size:14px;font-weight:800;">Check-out</label>
                    <input id="bookingCheckout" name="dateCheckout" type="date" required
                        style="width:100%;height:44px;margin-bottom:14px;border:1px solid #cfd7e2;border-radius:10px;padding:0 14px;font-size:14px;background:#ffffff;">
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;">
                <div>
                    <label for="bookingRooms" style="display:block;margin-bottom:8px;color:#1a3a5c;font-size:14px;font-weight:800;">Rooms</label>
                    <input id="bookingRooms" name="roomsCount" type="number" min="1" value="1" required
                        style="width:100%;height:44px;margin-bottom:14px;border:1px solid #cfd7e2;border-radius:10px;padding:0 14px;font-size:14px;background:#ffffff;">
                </div>
                <div>
                    <label for="bookingOccupancy" style="display:block;margin-bottom:8px;color:#1a3a5c;font-size:14px;font-weight:800;">Occupancy</label>
                    <select id="bookingOccupancy" name="occupancy"
                        style="width:100%;height:44px;margin-bottom:14px;border:1px solid #cfd7e2;border-radius:10px;padding:0 14px;font-size:14px;background:#ffffff;">
                        <option value="SINGLE">Single</option>
                        <option value="DOUBLE" selected>Double</option>
                    </select>
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr auto 1fr;gap:18px;align-items:end;">
                <div>
                    <label for="bookingGuests" style="display:block;margin-bottom:8px;color:#1a3a5c;font-size:14px;font-weight:800;">Guests</label>
                    <input id="bookingGuests" name="guestsCount" type="number" min="1" value="1" required
                        style="width:100%;height:44px;margin-bottom:14px;border:1px solid #cfd7e2;border-radius:10px;padding:0 14px;font-size:14px;background:#ffffff;">
                </div>
                <div style="display:flex;align-items:center;gap:10px;padding-bottom:14px;">
                    <button type="button" id="bookingDetailsBtn"
                        style="height:40px;padding:0 16px;border-radius:999px;border:2px solid #c7d3df;background:#f6f9fc;color:#1a3a5c;font-size:14px;font-weight:700;cursor:pointer;">Details</button>
                    <span id="bookingFilledText" style="color:#868e96;font-size:14px;">0/1 filled</span>
                </div>
                <div>
                    <label for="bookingRoomType" style="display:block;margin-bottom:8px;color:#1a3a5c;font-size:14px;font-weight:800;">Room type</label>
                    <select id="bookingRoomType" name="roomType"
                        style="width:100%;height:44px;margin-bottom:14px;border:1px solid #cfd7e2;border-radius:10px;padding:0 14px;font-size:14px;background:#ffffff;">
                        <option value="Standard" selected>Standard</option>
                        <option value="Deluxe">Deluxe</option>
                        <option value="Suite">Suite</option>
                    </select>
                </div>
            </div>

            <div id="guestDetailsSection" style="display:none;margin-top:6px;margin-bottom:12px;">
                <div style="margin-bottom:10px;color:#1a3a5c;font-size:15px;font-weight:800;">Guest details</div>
                <div id="guestDetailsContainer"></div>
            </div>

            <div style="margin-top:8px;padding-top:10px;">
                <h3 style="margin:0 0 12px;color:#1a3a5c;font-size:18px;font-weight:800;">Price details</h3>
                <div style="display:flex;justify-content:space-between;align-items:center;gap:18px;margin-bottom:8px;color:#6f7f90;font-size:15px;">
                    <span>Nights:</span><strong id="bookingNights" style="color:#1a3a5c;">0</strong>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;gap:18px;margin-bottom:8px;color:#6f7f90;font-size:15px;">
                    <span>Room summary:</span><strong id="bookingRoomSummary" style="color:#1a3a5c;">1 room × Standard</strong>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;gap:18px;margin-bottom:8px;color:#6f7f90;font-size:15px;">
                    <span>Base subtotal:</span><strong id="bookingSubtotal" style="color:#1a3a5c;">$0.0</strong>
                </div>
