{% extends 'base.html.twig' %}

{% block title %}Admin — Gestion des Billets{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
/* ══════════════════════════════════════════════════════
   EXPLORA ADMIN — Billets  (style identique AdminTransport)
   CSS 100% inline — aucune dépendance externe
══════════════════════════════════════════════════════ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

:root{
  --navy:#1e3a5f;--navy-dark:#0f2540;--navy-mid:#2d5a8a;
  --orange:#f7941d;--orange-dk:#e07800;--orange-lt:#fff3e0;
  --white:#ffffff;--bg:#f5f7fa;--bg-card:#ffffff;
  --gray-lt:#f8f9fa;--gray-md:#e9ecef;--gray:#8492a6;
  --text:#212529;--text-m:#6c757d;
  --green:#28a745;--green-lt:#d4edda;
  --red:#e74c3c;--red-lt:#fde8ea;
  --blue:#17a2b8;--blue-lt:#d1ecf1;
  --yellow:#ffc107;--yellow-lt:#fff3cd;
  --r-sm:8px;--r:12px;--r-lg:16px;
  --sh-sm:0 2px 8px rgba(0,0,0,.08);
  --sh:0 4px 20px rgba(0,0,0,.10);
  --tr:.22s ease;
  --fd:'Plus Jakarta Sans',sans-serif;
  --fb:'DM Sans',sans-serif;
  --sidebar-w:250px;
}

/* -- DARK MODE -- */
body.dark-mode{
  --navy:#a8c4e0;--navy-dark:#e8f0f8;
  --white:#1e2d40;--bg:#0f1923;--bg-card:#162032;
  --gray-lt:#1e2d40;--gray-md:#2a3d52;--gray:#7a8fa3;
  --text:#e8edf3;--text-m:#8ca0b5;--orange-lt:rgba(247,148,29,.12);
}
body.dark-mode .at-sidebar{background:#0f1419!important;}
body.dark-mode .at-table th{background:#1a3a5c;}
body.dark-mode .at-table td{border-color:#2a3d52;}
body.dark-mode .at-table tr:hover td{background:#1e2d40;}
body.dark-mode .at-tab-bar,
body.dark-mode .at-search-row,
body.dark-mode .at-stat-card,
body.dark-mode .at-table-wrap{background:#162032;}
body.dark-mode .at-input{background:#1e2d40;border-color:#2a3d52;color:#e8edf3;}
body.dark-mode .at-modal-box,
body.dark-mode .at-confirm-box{background:#162032;}
body.dark-mode .at-confirm-box .mf-select{background:#1e2d40;border-color:#2a3d52;color:#e8edf3;}

body{font-family:var(--fb);background:var(--bg);color:var(--text);min-height:100vh;transition:background var(--tr),color var(--tr);}
.at-layout{display:flex;min-height:100vh;}

/* ══ SIDEBAR ══ */
.at-sidebar{
  width:var(--sidebar-w);background:#1e3a5f;flex-shrink:0;
  display:flex;flex-direction:column;
  position:sticky;top:0;height:100vh;overflow-y:auto;
  transition:background var(--tr);
}
.at-sidebar-logo{
  display:flex;align-items:center;gap:12px;
  padding:24px 20px 28px;
  border-bottom:1px solid rgba(255,255,255,.08);
}
.at-sidebar-logo-icon{font-size:32px;color:var(--orange);}
.at-sidebar-logo-text{font-family:var(--fd);font-weight:800;font-size:16px;color:#fff;}
.at-sidebar-section{
  font-size:11px;font-weight:700;letter-spacing:.8px;
  color:rgba(255,255,255,.45);padding:18px 20px 6px;
  text-transform:uppercase;
}
.at-sidebar-item{
  display:flex;align-items:center;gap:12px;
  padding:0 20px;height:45px;
  font-family:var(--fd);font-weight:600;font-size:14px;
  color:rgba(255,255,255,.75);text-decoration:none;
  cursor:pointer;transition:var(--tr);
  background:transparent;border:none;width:100%;text-align:left;
  border-radius:var(--r-sm);margin:0 0 2px;
}
.at-sidebar-item:hover{background:rgba(247,148,29,.18);color:#fff;}
.at-sidebar-item--active{
  background:rgba(247,148,29,.15);color:var(--orange);
  font-weight:700;border-left:3px solid var(--orange);
}
.at-sidebar-item--active:hover{background:rgba(247,148,29,.22);color:var(--orange);}
.at-sidebar-item--logout{color:#e74c3c;background:rgba(231,76,60,.08);}
.at-sidebar-item--logout:hover{background:rgba(231,76,60,.18);color:#e74c3c;}
.at-sidebar-spacer{flex:1;}

/* ══ MAIN CONTENT ══ */
.at-content{flex:1;display:flex;flex-direction:column;overflow:auto;}
.at-inner{padding:30px 40px;}

/* ══ HEADER ══ */
.at-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px;}
.at-header-left h1{font-family:var(--fd);font-size:28px;font-weight:800;color:var(--navy);}
.at-header-left p{font-size:14px;color:var(--gray);margin-top:4px;}
.at-header-right{display:flex;align-items:center;gap:12px;}

/* BUTTONS */
.at-btn{display:inline-flex;align-items:center;gap:8px;font-family:var(--fd);font-weight:700;font-size:13px;padding:11px 22px;border-radius:var(--r-sm);border:none;cursor:pointer;text-decoration:none;transition:var(--tr);white-space:nowrap;}
.at-btn--orange{background:var(--orange);color:#fff;box-shadow:0 3px 10px rgba(247,148,29,.3);}
.at-btn--orange:hover{background:var(--orange-dk);transform:translateY(-1px);}
.at-btn--gray{background:var(--white);color:var(--navy);border:2px solid var(--gray-md);}
.at-btn--gray:hover{background:var(--gray-lt);}
.at-btn--red{background:var(--red);color:#fff;}
.at-btn--red:hover{background:#c0392b;}
.at-btn--sm{padding:7px 14px;font-size:12px;border-radius:6px;}
.at-theme-btn{background:var(--gray-lt);border:none;border-radius:50%;width:42px;height:42px;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--navy);transition:var(--tr);flex-shrink:0;}
.at-theme-btn:hover{background:var(--gray-md);transform:rotate(15deg);}

/* ══ STAT CARDS — 3 colonnes ══ */
.at-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:28px;}
.at-stat-card{background:var(--bg-card);border-radius:var(--r-lg);box-shadow:var(--sh-sm);padding:22px;transition:var(--tr);}
.at-stat-card:hover{box-shadow:var(--sh);}
.at-stat-inner{display:flex;align-items:center;gap:16px;}
.at-stat-icon{width:60px;height:60px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;}
.at-stat-icon--yellow{background:var(--yellow-lt);color:var(--yellow);}
.at-stat-icon--green{background:var(--green-lt);color:var(--green);}
.at-stat-icon--red{background:var(--red-lt);color:var(--red);}
.at-stat-val{font-family:var(--fd);font-size:32px;font-weight:800;color:var(--navy);line-height:1;}
.at-stat-label{font-size:13px;color:var(--gray);margin-top:3px;}
.at-stat-hint{font-size:12px;font-weight:600;margin-top:6px;}
.at-hint-yellow{color:var(--orange);}
.at-hint-green{color:var(--green);}
.at-hint-red{color:var(--red);}

/* ══ TABLE SECTION ══ */
.at-table-wrap{background:var(--bg-card);border-radius:var(--r-lg);box-shadow:var(--sh-sm);overflow:hidden;}

/* ONGLETS STATUT */
.at-tab-bar{
  display:flex;align-items:center;
  border-bottom:2px solid var(--gray-md);
  padding:20px 30px 0;background:var(--bg-card);
  gap:2px;
}
.at-tab{
  display:flex;align-items:center;gap:7px;
  padding:0 22px;height:50px;
  font-family:var(--fd);font-size:14px;font-weight:700;
  color:var(--navy);text-decoration:none;
  border-radius:var(--r-sm) var(--r-sm) 0 0;
  transition:var(--tr);cursor:pointer;white-space:nowrap;
  background:transparent;
}
.at-tab:hover{background:var(--gray-lt);color:var(--orange);}
.at-tab--active{background:var(--navy);color:#fff;}
.at-tab--active:hover{background:var(--navy);color:#fff;}
.at-tab-spacer{flex:1;}
.at-refresh-btn{background:var(--gray-lt);border:none;border-radius:var(--r-sm);width:38px;height:38px;font-size:15px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--navy);transition:var(--tr);margin-bottom:4px;text-decoration:none;}
.at-refresh-btn:hover{background:var(--gray-md);transform:rotate(180deg);}

/* SEARCH ROW */
.at-search-row{display:flex;align-items:center;gap:14px;padding:18px 30px;flex-wrap:wrap;background:var(--bg-card);}
.at-input{
  height:42px;padding:0 14px;
  background:var(--gray-lt);border:1.5px solid var(--gray-md);
  border-radius:var(--r-sm);font-family:var(--fb);font-size:13px;
  color:var(--text);outline:none;transition:var(--tr);
}
.at-input:focus{border-color:var(--orange);background:var(--white);}
.at-input::placeholder{color:var(--gray);}
.at-input--search{width:280px;}
.at-input--sort{width:190px;cursor:pointer;}
.at-sort-label{font-family:var(--fd);font-weight:700;font-size:13px;color:var(--gray);}
.at-search-spacer{flex:1;}

/* TABLE */
.at-table-scroll{overflow-x:auto;}
.at-table{width:100%;border-collapse:collapse;min-width:860px;}
.at-table th{
  background:#2c3e50;color:#fff;
  font-family:var(--fd);font-weight:700;font-size:13px;
  padding:14px 12px;text-align:left;
  border-bottom:2px solid #1a252f;
  white-space:nowrap;
}
.at-table td{padding:12px;border-bottom:1px solid var(--gray-md);font-size:13px;color:var(--text);vertical-align:middle;white-space:nowrap;}
.at-table tr:last-child td{border-bottom:none;}
.at-table tr:nth-child(odd) td{background:rgba(0,0,0,.015);}
.at-table tr:hover td{background:var(--orange-lt);cursor:pointer;}

/* Cells */
.at-id{font-weight:700;color:var(--gray);}
.at-prix{font-family:var(--fd);font-weight:800;color:var(--orange);}
.at-tc{text-align:center;}

/* Client chip */
.at-user-chip{
  display:inline-flex;align-items:center;gap:5px;
  background:#e8f0fe;color:#1a3a5c;
  padding:3px 10px;border-radius:20px;
  font-size:12px;font-weight:600;
}
/* Places pill */
.at-places-pill{
  display:inline-flex;align-items:center;justify-content:center;
  min-width:28px;height:24px;border-radius:12px;padding:0 8px;
  background:var(--green-lt);color:#155724;font-weight:700;font-size:12px;
}
/* Statut pill */
.at-pill{display:inline-block;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:700;}
.at-pill--attente{background:var(--yellow-lt);color:#856404;}
.at-pill--confirme{background:var(--blue-lt);color:#0c5460;}
.at-pill--annule{background:var(--red-lt);color:#721c24;}

/* Transport cell */
.at-transport-cell{display:flex;align-items:center;gap:10px;}
.at-transport-ico{font-size:18px;color:var(--navy-mid);width:22px;text-align:center;}
.at-transport-comp{font-family:var(--fd);font-weight:700;color:var(--navy);}
.at-transport-route{font-size:12px;color:var(--gray);margin-top:1px;}
.at-arr{color:var(--orange);}

/* Actions */
.at-actions{display:flex;gap:6px;align-items:center;}
.at-act-btn{
  width:32px;height:32px;border-radius:var(--r-sm);
  border:none;cursor:pointer;font-size:13px;
  display:inline-flex;align-items:center;justify-content:center;
  transition:transform .15s,opacity .15s;
  text-decoration:none;
}
.at-act-btn:hover{transform:scale(1.12);}
.at-act--view{background:rgba(52,144,220,.12);color:#1565c0;}
.at-act--edit{background:rgba(247,148,29,.15);color:var(--orange-dk);}

/* Empty */
.at-empty{padding:60px;text-align:center;}
.at-empty i{font-size:48px;color:var(--gray);margin-bottom:16px;display:block;}
.at-empty p{font-family:var(--fd);font-size:17px;font-weight:700;color:var(--navy);}

/* Table footer */
.at-tbl-footer{
  display:flex;justify-content:space-between;align-items:center;
  padding:12px 30px;border-top:1px solid var(--gray-md);
  font-size:12.5px;color:var(--gray);
}

/* Flash */
.at-flash{
  display:flex;align-items:center;gap:10px;
  padding:14px 18px;border-radius:var(--r-sm);
  margin-bottom:20px;font-weight:600;font-size:13px;
}
.at-flash--success{background:var(--green-lt);color:#155724;border:1px solid #c3e6cb;}
.at-flash--error{background:var(--red-lt);color:#721c24;border:1px solid #f5c6cb;}
.at-flash-close{margin-left:auto;background:none;border:none;cursor:pointer;font-size:18px;color:inherit;opacity:.6;}
.at-flash-close:hover{opacity:1;}

/* ══ MODAL CHANGER STATUT ══ */
.at-modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:500;display:none;align-items:center;justify-content:center;}
.at-modal-overlay.open{display:flex;}
.at-modal-box{
  background:var(--bg-card);border-radius:var(--r-lg);
  padding:36px 40px;max-width:480px;width:90%;
  box-shadow:0 20px 60px rgba(0,0,0,.3);
  animation:slideUp .25s ease;
}
@keyframes slideUp{from{transform:translateY(20px);opacity:0}to{transform:translateY(0);opacity:1}}
.at-modal-header{display:flex;align-items:center;gap:14px;margin-bottom:20px;padding-bottom:16px;border-bottom:1px solid var(--gray-md);}
.at-modal-icon{font-size:26px;color:var(--orange);}
.at-modal-title{font-family:var(--fd);font-size:18px;font-weight:800;color:var(--navy);}
.at-mf-row{display:flex;align-items:center;gap:14px;margin-bottom:16px;}
.at-mf-label{font-size:13px;font-weight:700;color:var(--navy);min-width:130px;flex-shrink:0;}
.at-mf-val{font-size:14px;color:var(--gray);}
.at-mf-select{
  flex:1;padding:9px 13px;border-radius:var(--r-sm);
  border:1.5px solid var(--gray-md);background:var(--gray-lt);
  font-family:var(--fb);font-size:14px;color:var(--text);
  outline:none;cursor:pointer;transition:border var(--tr);
}
.at-mf-select:focus{border-color:var(--orange);}
.at-modal-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:24px;padding-top:16px;border-top:1px solid var(--gray-md);}

/* ══ MODAL SUPPRIMER ══ */
.at-confirm-box{background:var(--bg-card);border-radius:var(--r-lg);padding:40px;max-width:460px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,.3);text-align:center;animation:slideUp .25s ease;}
.at-confirm-icon{font-size:52px;margin-bottom:16px;color:var(--red);}
.at-confirm-title{font-family:var(--fd);font-size:20px;font-weight:800;color:var(--red);margin-bottom:10px;}
.at-confirm-text{font-size:14px;color:var(--text-m);margin-bottom:26px;line-height:1.7;}
.at-confirm-actions{display:flex;gap:12px;justify-content:center;}

/* TOAST */
.at-toast{position:fixed;bottom:30px;right:30px;z-index:600;background:var(--navy-dark);color:#fff;font-family:var(--fd);font-weight:700;font-size:14px;padding:14px 22px;border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,.25);display:none;align-items:center;gap:10px;max-width:380px;}
.at-toast.show{display:flex;animation:slideUp .3s ease;}
.at-toast.success{background:var(--green);}
.at-toast.error{background:var(--red);}

@media(max-width:1100px){.at-stats{grid-template-columns:1fr 1fr;}}
@media(max-width:768px){
  .at-sidebar{display:none;}
  .at-inner{padding:16px;}
  .at-stats{grid-template-columns:1fr;}
}
</style>
{% endblock %}

{% block body %}
<div class="at-layout">

{# ══ SIDEBAR ══ #}
{% include 'partials/sidebar.html.twig' with { active: 'billets' } %}

{# ══ CONTENU ══ #}
<div class="at-content">
<div class="at-inner">

    {# FLASH #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
        <div class="at-flash at-flash--{{ label == 'success' ? 'success' : 'error' }}">
            <i class="fas fa-{{ label == 'success' ? 'check-circle' : 'exclamation-circle' }}"></i>
            {{ message }}
            <button class="at-flash-close" onclick="this.parentElement.remove()">&times;</button>
        </div>
        {% endfor %}
    {% endfor %}

    {# HEADER #}
    <div class="at-header">
        <div class="at-header-left">
            <h1>Gestion des Billets</h1>
            <p>Gérez toutes les réservations de transport</p>
        </div>
        <div class="at-header-right">
            <button class="at-btn at-btn--orange" id="btnAnalyzeIA">
                <i class="fas fa-magic"></i> Analyser avec IA
            </button>
            <button class="at-theme-btn" type="button" id="btnTheme" title="Mode nuit / jour">
                <i class="fas fa-moon" id="themeIcon"></i>
            </button>
        </div>
    </div>

    {# ══ STATS 3 cartes ══ #}
    <div class="at-stats">

        <div class="at-stat-card">
            <div class="at-stat-inner">
                <div class="at-stat-icon at-stat-icon--yellow">
                    <i class="fas fa-hourglass-half"></i>
                </div>
                <div>
                    <div class="at-stat-val">{{ stats.en_attente }}</div>
                    <div class="at-stat-label">En Attente</div>
                </div>
            </div>
            <div class="at-stat-hint at-hint-yellow">
                <i class="fas fa-circle-notch fa-spin" style="font-size:10px;margin-right:4px;"></i>
                {{ stats.en_attente }} à traiter
            </div>
        </div>

        <div class="at-stat-card">
            <div class="at-stat-inner">
                <div class="at-stat-icon at-stat-icon--green">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div>
                    <div class="at-stat-val">{{ stats.confirme }}</div>
                    <div class="at-stat-label">Confirmés</div>
                </div>
            </div>
            <div class="at-stat-hint at-hint-green">
                <i class="fas fa-info-circle" style="font-size:10px;margin-right:4px;"></i>
                Billets confirmés.
            </div>
        </div>

        <div class="at-stat-card">
            <div class="at-stat-inner">
                <div class="at-stat-icon at-stat-icon--red">
                    <i class="fas fa-times-circle"></i>
                </div>
                <div>
                    <div class="at-stat-val">{{ stats.annule }}</div>
                    <div class="at-stat-label">Annulés</div>
                </div>
            </div>
            <div class="at-stat-hint at-hint-red">
                <i class="fas fa-ban" style="font-size:10px;margin-right:4px;"></i>
                Réservations annulées
            </div>
        </div>

    </div>

    {# ══ TABLE PANEL ══ #}
    <div class="at-table-wrap">

        {# ONGLETS #}
        <div class="at-tab-bar">
            <a href="{{ path('admin_billet_index', {statut: 'tous',       search: search, sort: sort}) }}"
               class="at-tab {{ currentStatut == 'tous' ? 'at-tab--active' : '' }}">
                <i class="fas fa-list"></i> Tous
            </a>
            <a href="{{ path('admin_billet_index', {statut: 'EN_ATTENTE', search: search, sort: sort}) }}"
               class="at-tab {{ currentStatut == 'EN_ATTENTE' ? 'at-tab--active' : '' }}">
                <i class="fas fa-hourglass-half"></i> En Attente
            </a>
            <a href="{{ path('admin_billet_index', {statut: 'CONFIRME',   search: search, sort: sort}) }}"
               class="at-tab {{ currentStatut == 'CONFIRME' ? 'at-tab--active' : '' }}">
                <i class="fas fa-check-circle"></i> Confirmés
            </a>
            <a href="{{ path('admin_billet_index', {statut: 'ANNULE',     search: search, sort: sort}) }}"
               class="at-tab {{ currentStatut == 'ANNULE' ? 'at-tab--active' : '' }}">
                <i class="fas fa-times-circle"></i> Annulés
            </a>

            <div class="at-tab-spacer"></div>

            <a href="{{ path('admin_billet_index') }}" class="at-refresh-btn" title="Réinitialiser">
                <i class="fas fa-sync-alt"></i>
            </a>
        </div>

        {# BARRE RECHERCHE #}
        <form method="get" action="{{ path('admin_billet_index') }}" id="searchForm">
            <input type="hidden" name="statut" value="{{ currentStatut }}">
            <div class="at-search-row">
                <input type="text"
                       name="search"
                       value="{{ search }}"
                       placeholder="Rechercher par type, compagnie, trajet, statut, prix, date..."
                       class="at-input at-input--search">

                <button type="submit" class="at-btn at-btn--orange at-btn--sm">
                    <i class="fas fa-search"></i> Rechercher
                </button>

                <a href="{{ path('admin_billet_index') }}" class="at-btn at-btn--gray at-btn--sm">
                    <i class="fas fa-undo"></i> Réinitialiser
                </a>

                <div class="at-search-spacer"></div>

                <span class="at-sort-label">Trier :</span>
                <select name="sort" class="at-input at-input--sort" id="sortSelect">
                    <option value="date_desc"  {{ sort == 'date_desc'  ? 'selected' : '' }}>Date (Plus récent)</option>
                    <option value="date_asc"   {{ sort == 'date_asc'   ? 'selected' : '' }}>Date (Plus ancien)</option>
                    <option value="prix_asc"   {{ sort == 'prix_asc'   ? 'selected' : '' }}>Prix (Croissant)</option>
                    <option value="prix_desc"  {{ sort == 'prix_desc'  ? 'selected' : '' }}>Prix (Décroissant)</option>
                    <option value="id_asc"     {{ sort == 'id_asc'     ? 'selected' : '' }}>ID (Croissant)</option>
                    <option value="id_desc"    {{ sort == 'id_desc'    ? 'selected' : '' }}>ID (Décroissant)</option>
                </select>
            </div>
        </form>

        {# TABLEAU #}
        <div class="at-table-scroll">
        <table class="at-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Client</th>
                    <th>Transport</th>
                    <th class="at-tc">Places</th>
                    <th style="text-align:right">Prix Total</th>
                    <th class="at-tc">Date Réserv.</th>
                    <th class="at-tc">Statut</th>
                    <th class="at-tc">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% if billets is empty %}
                <tr>
                    <td colspan="8">
                        <div class="at-empty">
                            <i class="fas fa-ticket-alt"></i>
                            <p>Aucun billet trouvé
                                {% if search %} pour « {{ search }} »{% endif %}
                            </p>
                        </div>
                    </td>
                </tr>
            {% else %}
                {% for billet in billets %}
                <tr>
                    <td><span class="at-id">#{{ billet.id }}</span></td>

                    <td>
                        <span class="at-user-chip">
                            <i class="fas fa-user" style="font-size:10px;"></i>
                            #{{ billet.userId }}
                        </span>
                    </td>

                    <td>
                        {% if billet.transport %}
                        <div class="at-transport-cell">
                            <span class="at-transport-ico">
                                {% set typeVal = billet.transport.type.value ?? '' %}
                                {% if typeVal == 'AVION' %}<i class="fas fa-plane"></i>
                                {% elseif typeVal == 'TRAIN' %}<i class="fas fa-train"></i>
                                {% elseif typeVal == 'BUS' %}<i class="fas fa-bus"></i>
                                {% elseif typeVal == 'BATEAU' %}<i class="fas fa-ship"></i>
                                {% elseif typeVal == 'TAXI' %}<i class="fas fa-taxi"></i>
                                {% elseif typeVal == 'VOITURE' %}<i class="fas fa-car"></i>
                                {% else %}<i class="fas fa-route"></i>{% endif %}
                            </span>
                            <div>
                                <div class="at-transport-comp">{{ billet.transport.compagnie ?? 'N/A' }}</div>
                                <div class="at-transport-route">
                                    {{ billet.transport.origine }}
                                    <span class="at-arr">→</span>
                                    {{ billet.transport.destination }}
                                </div>
                            </div>
                        </div>
                        {% else %}
                            <span style="color:var(--gray)">N/A</span>
                        {% endif %}
                    </td>

                    <td class="at-tc">
                        <span class="at-places-pill">{{ billet.nombrePlaces }}</span>
                    </td>

                    <td style="text-align:right">
                        <span class="at-prix">{{ (billet.prixTotal * currency_rate())|number_format(2, ".", " ") }} {{ current_currency_symbol() }}</span>
                    </td>

                    <td class="at-tc">
                        {{ billet.dateReservation ? billet.dateReservation|date('d/m/Y') : '—' }}
                    </td>

                    <td class="at-tc">
                        {% set sv = billet.statut.value %}
                        <span class="at-pill
                            {% if sv == 'EN_ATTENTE' %}at-pill--attente
                            {% elseif sv == 'ANNULE' %}at-pill--annule
                            {% else %}at-pill--confirme{% endif %}">
                            {% if sv == 'EN_ATTENTE' %}<i class="fas fa-hourglass-half"></i> En attente
                            {% elseif sv == 'ANNULE' %}<i class="fas fa-ban"></i> Annulé
                            {% else %}<i class="fas fa-check"></i> Confirmé{% endif %}
                        </span>
                    </td>

                    <td class="at-tc">
                        <div class="at-actions">
                            {# Voir détail #}
                            <a href="{{ path('admin_billet_show', {id: billet.id}) }}"
                               class="at-act-btn at-act--view" title="Voir détails">
                                <i class="fas fa-eye"></i>
                            </a>
                            {# Changer statut #}
                            <button type="button"
                                    class="at-act-btn at-act--edit btn-changer-statut"
                                    title="Changer le statut"
                                    data-id="{{ billet.id }}"
                                    data-statut="{{ billet.statut.value }}"
                                    data-label="{{ billet.statut.label }}">
                                <i class="fas fa-exchange-alt"></i>
                            </button>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            {% endif %}
            </tbody>
        </table>
        </div>

        {% if billets is not empty %}
        <div class="at-tbl-footer">
            <span>{{ billets|length }} billet(s) affiché(s)</span>
            <span>Filtre : <strong>{{ currentStatut == 'tous' ? 'Tous' : currentStatut }}</strong></span>
        </div>
        {% endif %}

    </div>{# /at-table-wrap #}

</div>{# /at-inner #}
</div>{# /at-content #}
</div>{# /at-layout #}

{# ══ MODAL CHANGER STATUT ══ #}
<div class="at-modal-overlay" id="modalStatut">
    <div class="at-modal-box">
        <div class="at-modal-header">
            <i class="fas fa-exchange-alt at-modal-icon"></i>
            <h3 class="at-modal-title">Changer le Statut du Billet <span id="modalBilletId"></span></h3>
        </div>

        <form method="post" id="statutForm">
            <input type="hidden" name="_token" id="csrfStatut">

            <div class="at-mf-row">
                <span class="at-mf-label">Statut actuel</span>
                <span class="at-mf-val" id="statutActuelLabel">—</span>
            </div>

            <div class="at-mf-row">
                <label class="at-mf-label" for="selectStatut">Nouveau statut</label>
                <select name="statut" id="selectStatut" class="at-mf-select">
                    <option value="EN_ATTENTE">En attente</option>
                    <option value="CONFIRME">Confirmé</option>
                    <option value="ANNULE">Annulé</option>
                </select>
            </div>

            <div class="at-modal-actions">
                <button type="button" class="at-btn at-btn--gray" id="modalStatutCancel">
                    <i class="fas fa-times"></i> Annuler
                </button>
                <button type="submit" class="at-btn at-btn--orange">
                    <i class="fas fa-check"></i> Confirmer
                </button>
            </div>
        </form>
    </div>
</div>

{# ══ MODAL RÉSULTAT IA ══ #}
<div class="at-modal-overlay" id="modalIA">
    <div class="at-modal-box" style="text-align:center; max-width:650px;">
        <div class="at-modal-header" style="justify-content:space-between;">
            <div style="display:flex; align-items:center; gap:14px;">
                <i class="fas fa-robot at-modal-icon" style="color:var(--purple);font-size:32px;"></i>
                <h3 class="at-modal-title">Analyse Intelligente Gemini</h3>
            </div>
            <button class="at-flash-close" onclick="document.getElementById('modalIA').classList.remove('open')">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div id="iaLoader" style="padding:40px; text-align:center;">
            <i class="fas fa-circle-notch fa-spin" style="font-size:48px; color:var(--orange); margin-bottom:20px;"></i>
            <p style="font-weight:700; color:var(--navy); font-size:16px;">Gemini analyse vos réservations...</p>
            <p style="font-size:13px; color:var(--gray); margin-top:8px;">Recherche d'anomalies et tendances en cours.</p>
        </div>

        <div id="iaContent" style="display:none; padding:10px 0; text-align:left; max-height:400px; overflow-y:auto; line-height:1.6; font-family:var(--fb);">
            <!-- Injecté par JS -->
        </div>

        <div class="at-modal-actions">
            <button class="at-btn at-btn--gray" onclick="document.getElementById('modalIA').classList.remove('open')">Fermer</button>
        </div>
    </div>
</div>

{# TOAST #}
<div class="at-toast" id="atToast">
    <i class="fas fa-check-circle" id="toastIcon"></i>
    <span id="toastText"></span>
</div>

{% block javascripts %}
<script>
/* -- 1. MODE NUIT/JOUR -- */
(function(){
    const btn=document.getElementById('btnTheme'),icon=document.getElementById('themeIcon');
    let dark=localStorage.getItem('at-dark')==='1';
    function apply(){document.body.classList.toggle('dark-mode',dark);icon.className=dark?'fas fa-sun':'fas fa-moon';}
    apply();
    if(btn)btn.addEventListener('click',()=>{dark=!dark;localStorage.setItem('at-dark',dark?'1':'0');apply();});
})();

/* -- 2. TRI INSTANTANÉ -- */
(function(){
    const sel=document.getElementById('sortSelect'),form=document.getElementById('searchForm');
    if(sel&&form)sel.addEventListener('change',()=>form.submit());
})();

/* -- 3. MODAL CHANGER STATUT -- */
(function(){
    const overlay=document.getElementById('modalStatut');
    const cancelBtn=document.getElementById('modalStatutCancel');
    const form=document.getElementById('statutForm');

    document.querySelectorAll('.btn-changer-statut').forEach(btn=>{
        btn.addEventListener('click',()=>{
            const id=btn.dataset.id;
            const statut=btn.dataset.statut;
            const label=btn.dataset.label;

            document.getElementById('modalBilletId').textContent='#'+id;
            document.getElementById('statutActuelLabel').textContent=label;
            document.getElementById('selectStatut').value=statut;

            fetch('/admin/billets/'+id+'/csrf-token')
                .then(r=>r.text())
                .then(token=>{ document.getElementById('csrfStatut').value=token; })
                .catch(()=>{ document.getElementById('csrfStatut').value=''; });

            form.action='/admin/billets/'+id+'/changer-statut';
            overlay.classList.add('open');
        });
    });

    function close(){overlay.classList.remove('open');}
    cancelBtn.addEventListener('click',close);
    overlay.addEventListener('click',e=>{if(e.target===overlay)close();});
    document.addEventListener('keydown',e=>{if(e.key==='Escape')close();});
})();

/* -- 4. TOAST FLASH -- */
(function(){
    function showToast(msg,type){
        const toast=document.getElementById('atToast');
        const icon=document.getElementById('toastIcon');
        document.getElementById('toastText').textContent=msg;
        toast.className='at-toast show '+(type||'');
        icon.className=type==='success'?'fas fa-check-circle':'fas fa-exclamation-circle';
        setTimeout(()=>toast.classList.remove('show'),4500);
    }
    {% for msg in app.flashes('success') %}showToast('{{ msg|e('js') }}','success');{% endfor %}
    {% for msg in app.flashes('error') %}showToast('{{ msg|e('js') }}','error');{% endfor %}
})();

/* -- 5. Auto-dismiss flash -- */
setTimeout(()=>{ document.querySelectorAll('.at-flash').forEach(el=>el.remove()); },5000);

/* -- 6. IA ANALYSIS -- */
document.getElementById('btnAnalyzeIA')?.addEventListener('click', function() {
    const modal = document.getElementById('modalIA');
    const loader = document.getElementById('iaLoader');
    const content = document.getElementById('iaContent');
    
    modal.classList.add('open');
    loader.style.display = 'block';
    content.style.display = 'none';
    
    fetch('/admin/billets/analyser', {
        method: 'POST',
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(r => r.json())
    .then(data => {
        loader.style.display = 'none';
        content.style.display = 'block';
        if(data.success && data.html) {
            content.innerHTML = data.html;
        } else {
            content.innerHTML = '<p style="color:var(--red);text-align:center;"><i class="fas fa-exclamation-triangle"></i> Erreur lors de l\'analyse: ' + (data.error || 'Erreur inconnue') + '</p>';
        }
    })
    .catch(err => {
        loader.style.display = 'none';
        content.style.display = 'block';
        content.innerHTML = '<p style="color:var(--red);text-align:center;"><i class="fas fa-wifi"></i> Impossible de joindre l\'intelligence artificielle.</p>';
    });
});
</script>
{% endblock %}
{% endblock %}
