});

/* ── Payment method toggle ── */
function selectMethod(method) {
    const creditCard = document.getElementById('creditCardOption');
    const paypal     = document.getElementById('paypalOption');
    const cardSection = document.getElementById('cardDetailsSection');
    const cardPreview = document.getElementById('cardPreviewSection');
    const infoLabel  = document.getElementById('paymentMethodInfo');
    const input      = document.getElementById('paymentMethodInput');

    if (method === 'credit') {
        creditCard.classList.add('active');
        paypal.classList.remove('active');
        cardSection.style.display = '';
        cardPreview.style.display = '';
        infoLabel.textContent = '✓ Secure payment processing powered by Stripe';
        infoLabel.style.color = '#635bff';
    } else {
        paypal.classList.add('active');
        creditCard.classList.remove('active');
        cardSection.style.display = 'none';
        cardPreview.style.display = 'none';
        infoLabel.textContent = '✓ You will be redirected to PayPal to complete payment';
        infoLabel.style.color = '#003087';
    }
    input.value = method;
    updateRequiredFieldsForMethod(method);
}

function updateRequiredFieldsForMethod(method) {
    const isCredit = method === 'credit';
    const cardholder = document.getElementById('cardholderName');
    const cardNumber = document.getElementById('cardNumber');
    const expiryMonth = document.getElementById('expiryMonth');
    const expiryYear = document.getElementById('expiryYear');
    const cvv = document.getElementById('cvv');

    [cardholder, cardNumber, expiryMonth, expiryYear, cvv].forEach((field) => {
        if (!field) return;
        field.required = isCredit;
    });
}

/* ── Live card preview ── */
function updatePreviewName(val) {
    document.getElementById('previewName').textContent = val.toUpperCase() || 'YOUR NAME';
}

function updatePreviewExpiry() {
    const m = document.getElementById('expiryMonth').value;
    const y = document.getElementById('expiryYear').value;
    const yy = y ? y.slice(-2) : 'YY';
    document.getElementById('previewExpiry').textContent = (m || 'MM') + '/' + yy;
}

function formatCardNumber(input) {
    let digits = input.value.replace(/\D/g, '');
    const cardType = detectCardType(digits);
    const maxLength = cardType === 'amex' ? 15 : 16;
    digits = digits.substring(0, maxLength);

    input.value = formatDigitsForInput(digits, cardType);
    updatePreviewDigits(digits);
    applyCardTheme(cardType);

    if (digits.length === 0) {
        setCardValidationStatus('', '');
        isCardValidated = false;
        return;
    }

    isCardValidated = false;
    setCardValidationStatus('warning', '⚠️ Card number changed - please validate again');
}

function updatePreviewDigits(digits) {
    const parts = digits.padEnd(16, '●').match(/.{1,4}/g) || [];
    ['cn1','cn2','cn3','cn4'].forEach((id, i) => {
        document.getElementById(id).textContent = parts[i] || '●●●●';
    });
}

function formatDigitsForInput(digits, type) {
    if (type === 'amex') {
        const part1 = digits.substring(0, 4);
        const part2 = digits.substring(4, 10);
        const part3 = digits.substring(10, 15);
        return [part1, part2, part3].filter(Boolean).join(' ');
    }

    return digits.match(/.{1,4}/g)?.join(' ') || digits;
}

function detectCardType(digits) {
    if (/^4/.test(digits)) return 'visa';
    if (/^(5[1-5]|2[2-7])/.test(digits)) return 'mastercard';
    if (/^3[47]/.test(digits)) return 'amex';
    if (/^(6011|65|64[4-9])/.test(digits)) return 'discover';
    return 'default';
}

function applyCardTheme(type) {
    const theme = CARD_THEME_MAP[type] || CARD_THEME_MAP.default;
    const cardTypeLabel = document.getElementById('cardTypeLabel');
    const cardPreview = document.querySelector('.credit-card');
    const cardChip = document.querySelector('.card-chip');
    const cardBrand = document.getElementById('cardBrand');

    cardTypeLabel.textContent = theme.label;
    cardPreview.style.background = theme.gradient;
    cardChip.style.background = theme.chipGradient;

    const logo = CARD_LOGO_MAP[type];
    if (logo) {
        cardBrand.className = 'card-brand brand-' + type;
        cardBrand.innerHTML = '<img src="' + logo.src + '" class="' + logo.cls + '" alt="' + logo.alt + '">';
    } else {
        cardBrand.className = 'card-brand brand-default';
        cardBrand.textContent = 'CARD';
    }
}

function expectedLengthsByType(type) {
    switch (type) {
        case 'amex':
            return [15];
        case 'visa':
            return [13, 16];
        case 'mastercard':
            return [16];
        case 'discover':
            return [16];
        default:
            return [];
    }
}

function setCardValidationStatus(kind, message) {
    const status = document.getElementById('cardValidationStatus');
    status.className = 'card-validation-status';

    if (!kind || !message) {
        status.textContent = '';
        return;
    }

    status.classList.add(kind);
    status.textContent = message;
}

function luhnCheck(digits) {
    let sum = 0;
    let shouldDouble = false;

    for (let i = digits.length - 1; i >= 0; i--) {
        let digit = Number(digits.charAt(i));

        if (shouldDouble) {
            digit *= 2;
            if (digit > 9) digit -= 9;
        }

        sum += digit;
        shouldDouble = !shouldDouble;
    }

    return sum % 10 === 0;
}

function validateCard() {
    const digits = document.getElementById('cardNumber').value.replace(/\D/g, '');
    const cardType = detectCardType(digits);
    const expectedLengths = expectedLengthsByType(cardType);

    if (digits.length === 0) {
        isCardValidated = false;
        setCardValidationStatus('error', 'Please enter a card number.');
        return;
    }

    if (expectedLengths.length === 0) {
        isCardValidated = false;
        setCardValidationStatus('error', 'Unsupported card type.');
        return;
    }

    if (!expectedLengths.includes(digits.length)) {
        isCardValidated = false;
        setCardValidationStatus('error', 'Invalid length for ' + CARD_THEME_MAP[cardType].label + '.');
        return;
    }

    if (!luhnCheck(digits)) {
        isCardValidated = false;
        setCardValidationStatus('error', 'Luhn validation failed. Please check your card number.');
        return;
    }

    isCardValidated = true;
    setCardValidationStatus('success', '✓ Card validated successfully (' + CARD_THEME_MAP[cardType].label + ')');
}

function errorContainerForField(field) {
    const wrapper = field.closest('.form-group, .cvv-group, .expiry-group, .terms-row');
    if (!wrapper) return null;

    let el = wrapper.querySelector(`.field-error[data-error-for="${field.id}"]`);
    if (!el) {
        el = document.createElement('p');
        el.className = 'field-error';
        el.setAttribute('data-error-for', field.id);
        wrapper.appendChild(el);
    }

    return el;
}

function setFieldError(field, message) {
    const errorEl = errorContainerForField(field);
    if (errorEl) {
        errorEl.textContent = message;
    }
    field.classList.add('is-invalid');
}

function clearFieldError(field) {
    const wrapper = field.closest('.form-group, .cvv-group, .expiry-group, .terms-row');
    if (wrapper) {
        const errorEl = wrapper.querySelector(`.field-error[data-error-for="${field.id}"]`);
        if (errorEl) {
            errorEl.textContent = '';
        }
    }
    field.classList.remove('is-invalid');
}

function validatePaymentForm() {
    const method = document.getElementById('paymentMethodInput').value;
    let valid = true;

    const cardholder = document.getElementById('cardholderName');
    const cardNumber = document.getElementById('cardNumber');
    const expiryMonth = document.getElementById('expiryMonth');
    const expiryYear = document.getElementById('expiryYear');
    const cvv = document.getElementById('cvv');
    const country = document.getElementById('countrySelect');
    const city = document.getElementById('citySelect');
    const street = document.getElementById('streetField');
    const postal = document.getElementById('postalCodeField');
    const terms = document.getElementById('termsCheckbox');

    [cardholder, cardNumber, expiryMonth, expiryYear, cvv, country, city, street, postal, terms].forEach(clearFieldError);

    if (!country.value) {
        setFieldError(country, 'Country is required.');
        valid = false;
    }

    if (!city.value) {
        setFieldError(city, 'City is required.');
        valid = false;
    }

    if (!street.value || street.value.trim().length < 5) {
        setFieldError(street, 'Street address must contain at least 5 characters.');
        valid = false;
    }

    if (!/^[A-Za-z0-9\-\s]{3,12}$/.test((postal.value || '').trim())) {
        setFieldError(postal, 'Postal code format is invalid.');
        valid = false;
    }

    if (!terms.checked) {
        setFieldError(terms, 'You must accept the terms to continue.');
        valid = false;
    }

    if (method === 'credit') {
        if (!/^[A-Za-zÀ-ÿ'\-\s]{2,80}$/.test((cardholder.value || '').trim())) {
            setFieldError(cardholder, 'Cardholder name is invalid.');
            valid = false;
        }

        const digits = cardNumber.value.replace(/\D/g, '');
        const cardType = detectCardType(digits);
        const expectedLengths = expectedLengthsByType(cardType);

        if (!digits) {
            setFieldError(cardNumber, 'Card number is required.');
            valid = false;
        } else if (expectedLengths.length === 0) {
            setFieldError(cardNumber, 'Unsupported card type.');
            valid = false;
        } else if (!expectedLengths.includes(digits.length)) {
            setFieldError(cardNumber, 'Card number length is invalid.');
            valid = false;
        } else if (!luhnCheck(digits)) {
            setFieldError(cardNumber, 'Card number failed Luhn validation.');
            valid = false;
        }

        if (!/^\d{3,4}$/.test((cvv.value || '').trim())) {
            setFieldError(cvv, 'CVV must contain 3 or 4 digits.');
            valid = false;
        }

        const month = parseInt(expiryMonth.value || '0', 10);
        const year = parseInt(expiryYear.value || '0', 10);
        const now = new Date();
        const expiry = new Date(year, month, 0, 23, 59, 59);

        if (!month || !year) {
            setFieldError(expiryMonth, 'Expiry month is required.');
            setFieldError(expiryYear, 'Expiry year is required.');
            valid = false;
        } else if (expiry < now) {
            setFieldError(expiryMonth, 'Card is expired.');
            setFieldError(expiryYear, 'Card is expired.');
            valid = false;
        }
    }

    return valid;
}

document.getElementById('paymentForm').addEventListener('submit', async function(event) {
    if (!validatePaymentForm()) {
        event.preventDefault();
        return;
    }

    const method = document.getElementById('paymentMethodInput').value;
    if (method !== 'paypal') {
        return;
    }

    event.preventDefault();

    const popup = window.open('', 'paypalCheckoutPopup', 'width=520,height=760,menubar=no,toolbar=no,location=yes,resizable=yes,scrollbars=yes,status=no');
    if (popup) {
        popup.document.write('<!DOCTYPE html><html><head><title>PayPal</title></head><body style="font-family:Arial,sans-serif;padding:16px;">Redirecting to PayPal...</body></html>');
    }

    try {
        const formData = new FormData(event.target);
        const response = await fetch(event.target.action, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json'
            },
            body: formData
        });

        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload.redirectUrl) {
            throw new Error(payload.error || 'Unable to initialize PayPal checkout.');
        }

        if (popup) {
            popup.location.href = payload.redirectUrl;
        } else {
            window.location.href = payload.redirectUrl;
        }
    } catch (error) {
        if (popup && !popup.closed) {
            popup.close();
        }
        alert(error.message || 'PayPal initialization failed. Please try again.');
    }
});

['cardholderName', 'cardNumber', 'expiryMonth', 'expiryYear', 'cvv', 'countrySelect', 'citySelect', 'streetField', 'postalCodeField', 'termsCheckbox']
    .forEach((id) => {
        const field = document.getElementById(id);
        if (!field) return;
        const eventName = field.tagName === 'SELECT' || field.type === 'checkbox' ? 'change' : 'input';
        field.addEventListener(eventName, () => clearFieldError(field));
    });

applyCardTheme('default');
updateRequiredFieldsForMethod('credit');

function renderStreetSuggestions(items) {
    if (!Array.isArray(items) || items.length === 0) {
        streetSuggestionsEl.style.display = 'none';
        streetSuggestionsEl.innerHTML = '';
        return;
    }

    streetSuggestionsEl.innerHTML = items.map((item) => `<div class="suggestion-item">${item}</div>`).join('');
    streetSuggestionsEl.style.display = 'block';

    streetSuggestionsEl.querySelectorAll('.suggestion-item').forEach((node) => {
        node.addEventListener('mousedown', () => {
            streetFieldEl.value = node.textContent || '';
            renderStreetSuggestions([]);
            clearFieldError(streetFieldEl);
        });
    });
}

function loadStreetSuggestions(query) {
    const q = (query || '').trim();
    if (q.length < 3) {
        renderStreetSuggestions([]);
        return;
    }

    fetch(addressSuggestionsApiUrl + '?q=' + encodeURIComponent(q))
        .then((r) => r.json())
        .then((items) => renderStreetSuggestions(items))
        .catch(() => renderStreetSuggestions([]));
}

streetFieldEl.addEventListener('input', () => {
    clearTimeout(streetDebounceTimer);
    streetDebounceTimer = setTimeout(() => {
        loadStreetSuggestions(streetFieldEl.value);
    }, 250);
});

streetFieldEl.addEventListener('blur', () => {
    setTimeout(() => renderStreetSuggestions([]), 120);
});

document.addEventListener('click', (event) => {
    if (!streetSuggestionsEl.contains(event.target) && event.target !== streetFieldEl) {
        renderStreetSuggestions([]);
    }
});

function populateCountries(countries) {
    countrySelectEl.innerHTML = '<option value="">Select Country</option>';

    countries.forEach((country) => {
        const option = document.createElement('option');
        option.value = country.code;
        option.textContent = country.name;
        if (initialCountry && initialCountry === country.code) {
            option.selected = true;
        }
        countrySelectEl.appendChild(option);
    });
}

function loadCountries() {
    fetch(countriesApiUrl)
        .then((r) => r.json())
        .then((countries) => {
            const list = Array.isArray(countries) ? countries : [];
            if (list.length > 0) {
                populateCountries(list);
            }

            if (countrySelectEl.value) {
                loadCities(countrySelectEl.value, initialCity);
            }
        })
        .catch(() => {
            if (countrySelectEl.value) {
                loadCities(countrySelectEl.value, initialCity);
            }
        });
}

/* ── Load cities by country  ── */
function loadCities(countryCode, selectedCity = null) {
    if (!countryCode) {
        citySelectEl.disabled = true;
        citySelectEl.innerHTML = '<option value="">Select City (Choose country first)</option>';
        return Promise.resolve();
    }

    return fetch(citiesApiUrl + '?country=' + encodeURIComponent(countryCode))
        .then(r => r.json())
        .then(cities => {
            const list = Array.isArray(cities) ? cities : [];
            citySelectEl.disabled = false;
            citySelectEl.innerHTML = '<option value="">Select City</option>';

            list.forEach((city) => {
                const option = document.createElement('option');
                option.value = city;
                option.textContent = city;
                if (selectedCity && selectedCity === city) {
                    option.selected = true;
                }
                citySelectEl.appendChild(option);
            });
        })
        .catch(() => {
            citySelectEl.disabled = false;
            citySelectEl.innerHTML = '<option value="">Select City</option>';
        });
}

loadCountries();

if (scratchRewardData) {
    const overlay = document.getElementById('scratchOverlay');
    const canvas = document.getElementById('scratchCanvas');
    const revealBtn = document.getElementById('scratchRevealBtn');
    const closeBtn = document.getElementById('scratchCloseBtn');

    if (overlay && canvas && revealBtn && closeBtn) {
        overlay.style.display = 'flex';

        const ctx = canvas.getContext('2d');
        const brush = 26;
        let isDrawing = false;
        let revealed = false;
        const grid = 8;
        const cols = Math.ceil(canvas.width / grid);
        const rows = Math.ceil(canvas.height / grid);
        const scratched = new Set();
        const totalCells = cols * rows;

        function paintCover() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#b8b8b8';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#a3a3a3';
            for (let y = 8; y < canvas.height; y += 18) {
                ctx.fillRect(0, y, canvas.width, 6);
            }
            ctx.fillStyle = '#686868';
            ctx.font = 'bold 20px Segoe UI';
            ctx.textAlign = 'center';
            ctx.fillText('SCRATCH HERE', canvas.width / 2, canvas.height / 2 - 6);
            ctx.font = '13px Segoe UI';
            ctx.fillText('Drag to reveal your reward', canvas.width / 2, canvas.height / 2 + 18);
        }

        function eraseAt(clientX, clientY) {
            if (revealed) return;
            const rect = canvas.getBoundingClientRect();
            const x = clientX - rect.left;
            const y = clientY - rect.top;

            ctx.save();
            ctx.globalCompositeOperation = 'destination-out';
            ctx.beginPath();
            ctx.arc(x, y, brush / 2, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();

            const gx = Math.floor(x / grid);
            const gy = Math.floor(y / grid);
            for (let dx = -1; dx <= 1; dx++) {
                for (let dy = -1; dy <= 1; dy++) {
                    const nx = gx + dx;
                    const ny = gy + dy;
                    if (nx >= 0 && ny >= 0 && nx < cols && ny < rows) {
                        scratched.add(nx + '-' + ny);
                    }
                }
            }

            if (scratched.size / totalCells >= 0.4) {
                revealAll();
            }
        }

        function revealAll() {
            if (revealed) return;
            revealed = true;
            canvas.style.transition = 'opacity .35s ease';
            canvas.style.opacity = '0';
        }

        canvas.addEventListener('mousedown', (e) => {
            isDrawing = true;
            eraseAt(e.clientX, e.clientY);
        });
        canvas.addEventListener('mousemove', (e) => {
            if (!isDrawing) return;
            eraseAt(e.clientX, e.clientY);
        });
        document.addEventListener('mouseup', () => {
            isDrawing = false;
        });

        canvas.addEventListener('touchstart', (e) => {
            isDrawing = true;
            eraseAt(e.touches[0].clientX, e.touches[0].clientY);
            e.preventDefault();
        }, { passive: false });
        canvas.addEventListener('touchmove', (e) => {
            if (!isDrawing) return;
            eraseAt(e.touches[0].clientX, e.touches[0].clientY);
            e.preventDefault();
        }, { passive: false });
        document.addEventListener('touchend', () => {
            isDrawing = false;
        });

        revealBtn.addEventListener('click', revealAll);
        closeBtn.addEventListener('click', () => {
            overlay.style.display = 'none';
            openFeedbackModal();
        });

        paintCover();
    }
}
