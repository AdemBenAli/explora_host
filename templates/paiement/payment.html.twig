            <div class="credit-card">
                <div class="card-corner-dots tl"><span>●</span><span>●</span><span>●</span></div>
                <div class="card-corner-dots tr"><span>●</span><span>●</span><span>●</span></div>

                <div class="card-header">
                    <div class="card-chip"></div>
                    <span class="card-type-label" id="cardTypeLabel">CARD</span>
                    <div id="cardBrand" class="card-brand brand-default">CARD</div>
