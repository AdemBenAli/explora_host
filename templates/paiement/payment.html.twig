<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Explora - Payment</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Arial, sans-serif;
            color: #1a3a5c;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: background-color .25s ease, color .25s ease;
        }

        body.dark-theme {
            background-color: #0f172a;
            color: #e2e8f0;
        }

        /* ── Navbar ── */
        .navbar {
            background: white;
            box-shadow: 0 2px 10px rgba(0,0,0,.1);
            height: 80px;
            display: flex;
            align-items: center;
            padding: 0 50px;
            gap: 20px;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .navbar-brand { font-size: 24px; font-weight: bold; color: #1a3a5c; text-decoration: none; }
        .navbar-spacer { flex: 1; }
        .nav-links { display: flex; gap: 10px; align-items: center; }
        .nav-links a {
            background: transparent; border: none; color: #1a3a5c; cursor: pointer;
            font-size: 14px; padding: 8px 14px; text-decoration: none;
            border-radius: 6px; transition: background .2s;
        }
        .nav-links a:hover { background: #f0f2f5; }
        .navbar-right { display: flex; gap: 15px; align-items: center; }
        .btn-theme {
            background: #e9ecef;
            border: none;
            border-radius: 5px;
            padding: 8px 16px;
            font-size: 16px;
            cursor: pointer;
        }
        .btn-profile {
            background: #e9ecef; color: #1a3a5c; border: none; border-radius: 6px;
            padding: 8px 20px; cursor: pointer; font-size: 14px; text-decoration: none;
        }

        body.dark-theme .navbar,
        body.dark-theme .form-card,
        body.dark-theme .sidebar-card,
        body.dark-theme .scratch-modal,
        body.dark-theme .map-picker-modal {
            background: #111827;
            box-shadow: 0 2px 12px rgba(0,0,0,.35);
        }

        body.dark-theme .navbar-brand,
        body.dark-theme .nav-links a,
        body.dark-theme .btn-profile,
        body.dark-theme .form-card h2,
        body.dark-theme .billing-card-title,
        body.dark-theme .form-group label,
        body.dark-theme .expiry-group label,
        body.dark-theme .cvv-group label,
        body.dark-theme .sidebar-card h3,
        body.dark-theme .order-item-name,
        body.dark-theme .summary-row .value,
        body.dark-theme .summary-row .label,
        body.dark-theme .summary-row.total .label,
        body.dark-theme .secure-checkout-label,
        body.dark-theme .cancellation-title,
        body.dark-theme .badge,
        body.dark-theme .scratch-note {
            color: #e5e7eb;
        }

        body.dark-theme .nav-links a:hover {
            background: #1f2937;
        }

        body.dark-theme .btn-theme,
        body.dark-theme .btn-profile,
        body.dark-theme .btn-back,
        body.dark-theme .badge,
        body.dark-theme .form-control,
        body.dark-theme .expiry-selects select,
        body.dark-theme .cvv-input {
            background: #1f2937;
            color: #e5e7eb;
            border-color: #374151;
        }

        body.dark-theme .form-control:focus {
            background: #111827;
            border-color: #11998e;
        }

        body.dark-theme .method-option {
            background: #1f2937;
            border-color: #374151;
        }

        body.dark-theme .method-option .method-sub,
        body.dark-theme .order-item-qty,
        body.dark-theme .cancellation-text,
        body.dark-theme .scratch-note {
            color: #94a3b8;
        }

        body.dark-theme .suggestions-list,
        body.dark-theme .suggestion-item {
            background: #111827;
            color: #e5e7eb;
            border-color: #1f2937;
        }

        body.dark-theme .suggestion-item:hover {
            background: #1f2937;
        }

        body.dark-theme .sidebar-sep,
        body.dark-theme .form-sep {
            border-top-color: #1f2937;
        }

        /* ── Secure Payment Banner ── */
        .secure-banner {
            background: #11998e;
            padding: 10px 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        .secure-banner .title { color: white; font-weight: bold; font-size: 14px; }
        .secure-banner .subtitle { color: rgba(255,255,255,.9); font-size: 12px; }

        /* ── Main layout ── */
        .payment-layout {
            display: flex;
            gap: 30px;
            padding: 30px 50px 40px;
            align-items: flex-start;
            flex: 1;
        }

        /* ── Left form col ── */
        .payment-form-col { flex: 1; max-width: 700px; display: flex; flex-direction: column; gap: 25px; }

        .form-card {
            background: white; border-radius: 10px;
            box-shadow: 0 2px 12px rgba(0,0,0,.08);
            padding: 25px;
        }
        .form-card h2 { font-size: 20px; font-weight: bold; color: #1a3a5c; margin-bottom: 16px; }
        .form-sep { border: none; border-top: 1px solid #f0f0f0; margin: 12px 0 20px; }

        /* ── Payment Method Toggle ── */
        .payment-method-row { display: flex; gap: 15px; justify-content: center; margin-bottom: 16px; }
        .method-option {
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            width: 200px; height: 80px;
            border: 2px solid #e0e0e0; border-radius: 8px; cursor: pointer;
            background: white; transition: border-color .2s;
        }
        .method-option.active { border-color: #635bff; }
        .method-option .method-name { font-weight: bold; font-size: 14px; }
        .method-option.stripe .method-name { color: #635bff; }
        .method-option.paypal .method-name { color: #003087; }
        .method-option .method-sub { font-size: 11px; color: #6c757d; margin-top: 2px; }
        .secure-stripe-note { color: #635bff; font-size: 12px; font-weight: bold; margin-top: 4px; }

        /* ── Credit Card Preview ── */
        .card-preview-wrapper { display: flex; justify-content: center; }
        .credit-card {
            width: 420px; height: 250px;
            background: linear-gradient(135deg, #1e3c72, #2a5298);
            border-radius: 15px;
            box-shadow: 0 8px 25px rgba(0,0,0,.3);
            padding: 25px 30px;
            position: relative;
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .card-corner-dots {
            position: absolute; display: flex; gap: 4px; opacity: .35; font-size: 10px;
        }
        .card-corner-dots.tl { top: 16px; left: 20px; }
        .card-corner-dots.tr { top: 16px; right: 20px; }

        .card-header { display: flex; align-items: center; justify-content: space-between; }
        .card-chip {
            width: 44px; height: 34px; background: linear-gradient(135deg, #d4a843, #b8922a);
            border-radius: 5px;
            box-shadow: inset 0 1px 2px rgba(255,255,255,.35), inset 0 -1px 2px rgba(0,0,0,.25);
        }

        .card-brand {
            min-width: 110px;
            height: 48px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
        }
        .card-brand img {
            display: block;
            max-width: 106px;
            max-height: 44px;
            width: auto;
            height: auto;
            object-fit: contain;
        }
        .card-brand img.logo-mastercard {
            max-width: 72px;
            max-height: 38px;
        }
        .card-brand img.logo-visa {
            max-width: 106px;
            max-height: 34px;
        }
        .card-brand img.logo-discover,
        .card-brand img.logo-amex {
            max-width: 94px;
            max-height: 42px;
            border-radius: 6px;
        }
        .card-brand.brand-default {
            background: rgba(255,255,255,.18);
            border: 1px solid rgba(255,255,255,.28);
            color: rgba(255,255,255,.9);
            font-size: 14px;
            letter-spacing: 1px;
            border-radius: 8px;
            font-weight: 700;
        }
        .card-type-label {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip: rect(0,0,0,0);
            white-space: nowrap;
            clip-path: inset(50%);
        }

        .card-number { font-size: 20px; letter-spacing: 4px; text-align: center; margin: 10px 0; }
        .card-number span { margin: 0 4px; }

        .card-footer { display: flex; justify-content: space-between; align-items: flex-end; }
        .card-field label { font-size: 10px; opacity: .7; text-transform: uppercase; letter-spacing: 1px; }
        .card-field p { font-weight: bold; font-size: 14px; margin-top: 2px; }

        /* ── Card Details Form ── */
        .form-group { margin-bottom: 18px; }
        .form-group label { display: block; font-weight: bold; color: #1a3a5c; margin-bottom: 6px; font-size: 14px; }
        .form-control {
            width: 100%; border: 1px solid #dee2e6; border-radius: 6px;
            padding: 0 14px; height: 45px; font-size: 14px; background: #f7f8fa;
            transition: border-color .2s;
        }
        .form-control:focus { outline: none; border-color: #11998e; background: white; }
        .form-control[disabled] { opacity: .5; cursor: not-allowed; }
        .form-control.is-invalid, .cvv-input.is-invalid, .expiry-selects select.is-invalid {
            border-color: #e74c3c;
            background: #fff6f6;
        }
        .field-error {
            color: #e74c3c;
            font-size: 12px;
            margin-top: 6px;
            min-height: 16px;
            font-weight: 600;
        }
        .address-suggestions {
            position: relative;
        }
        .suggestions-list {
            position: absolute;
            top: calc(100% + 4px);
            left: 0;
            right: 0;
            z-index: 50;
            border: 1px solid #d9dee4;
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 8px 20px rgba(0,0,0,.08);
            max-height: 220px;
            overflow-y: auto;
            display: none;
        }
        .suggestion-item {
            padding: 10px 12px;
            cursor: pointer;
            font-size: 13px;
            border-bottom: 1px solid #f1f3f5;
        }
        .suggestion-item:last-child {
            border-bottom: none;
        }
        .suggestion-item:hover {
            background: #f8fafc;
        }

        .map-picker-row {
            margin-top: 10px;
            display: flex;
            justify-content: flex-end;
        }
        .btn-map-picker {
            background: #e8f3ff;
            color: #1a3a5c;
            border: 1px solid #bfdcff;
            border-radius: 8px;
            padding: 8px 12px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            transition: all .2s ease;
        }
        .btn-map-picker:hover {
            background: #d6ebff;
            border-color: #97c9fb;
        }

        /* Card number row */
        .card-number-row { display: flex; gap: 10px; }
        .card-number-row .form-control { flex: 1; }
        .btn-validate {
            background: #11998e; color: white; border: none; border-radius: 6px;
            padding: 0 24px; font-size: 14px; font-weight: bold; cursor: pointer;
            height: 45px; white-space: nowrap;
        }
        .card-validation-status {
            min-height: 22px;
            margin-top: 10px;
            font-size: 14px;
            font-weight: 500;
        }
        .card-validation-status.warning { color: #f39c12; }
        .card-validation-status.success { color: #27ae60; }
        .card-validation-status.error { color: #e74c3c; }

        /* Expiry + CVV row */
        .expiry-cvv-row { display: flex; gap: 20px; align-items: flex-end; }
        .expiry-group { display: flex; flex-direction: column; }
        .expiry-group label { font-weight: bold; color: #1a3a5c; margin-bottom: 6px; font-size: 14px; }
        .expiry-selects { display: flex; gap: 10px; }
        .expiry-selects select {
            border: 1px solid #dee2e6; border-radius: 6px; padding: 0 10px;
            height: 45px; font-size: 14px; background: #f7f8fa; cursor: pointer; width: 100px;
        }
        .cvv-group { display: flex; flex-direction: column; }
        .cvv-group label { font-weight: bold; color: #1a3a5c; margin-bottom: 6px; font-size: 14px; }
        .cvv-input {
            border: 1px solid #dee2e6; border-radius: 6px; padding: 0 14px;
            height: 45px; font-size: 14px; background: #f7f8fa; width: 100px;
            letter-spacing: 3px;
        }

        .save-card-row { display: flex; align-items: center; gap: 8px; margin-top: 6px; }
        .save-card-row input[type=checkbox] { width: 16px; height: 16px; cursor: pointer; accent-color: #11998e; }
        .save-card-row label { font-size: 14px; cursor: pointer; }

        /* ── Billing Address Form ── */
        .billing-card-title { font-size: 18px; font-weight: bold; color: #1a3a5c; margin-bottom: 14px; }

        /* ── Terms ── */
        .terms-section { display: flex; flex-direction: column; gap: 12px; }
        .terms-row { display: flex; align-items: center; gap: 8px; }
        .terms-row input[type=checkbox] { width: 16px; height: 16px; cursor: pointer; accent-color: #11998e; }
        .terms-row label { font-size: 14px; cursor: pointer; }
        .terms-row label.bold { font-weight: bold; }

        /* ── Nav buttons ── */
        .nav-buttons { display: flex; gap: 15px; justify-content: flex-end; }
        .btn-back {
            background: #e9ecef; color: #1a3a5c; border: none; border-radius: 5px;
            padding: 12px 25px; font-size: 14px; cursor: pointer; text-decoration: none;
            display: inline-flex; align-items: center;
        }
        .btn-complete {
            background: #f7941d; color: white; border: none; border-radius: 5px;
            padding: 12px 25px; font-size: 14px; font-weight: bold; cursor: pointer;
            min-width: 200px;
        }
        .btn-complete:disabled { opacity: .6; cursor: not-allowed; }

        /* ── Sidebar ── */
        .sidebar { width: 380px; flex-shrink: 0; display: flex; flex-direction: column; gap: 20px; }

        .sidebar-card {
            background: white; border-radius: 10px;
            box-shadow: 0 2px 12px rgba(0,0,0,.08);
            padding: 20px 25px;
        }
        .sidebar-card h3 { font-size: 18px; font-weight: bold; color: #1a3a5c; margin-bottom: 14px; }
        .sidebar-sep { border: none; border-top: 1px solid #f0f0f0; margin: 12px 0; }

        .order-item-row { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 10px; }
        .order-item-name { font-weight: bold; font-size: 14px; color: #1a3a5c; }
        .order-item-qty { font-size: 12px; color: #6c757d; }
        .order-item-price { font-weight: bold; font-size: 14px; color: #f7941d; }

        .summary-row { display: flex; justify-content: space-between; margin-bottom: 6px; font-size: 14px; }
        .summary-row .label { color: #333; }
        .summary-row .value { font-weight: bold; color: #1a3a5c; }
        .summary-row.discount-row .label,
        .summary-row.discount-row .value { color: #11998e; }
        .summary-row.total .label { font-size: 20px; font-weight: bold; color: #1a3a5c; }
        .summary-row.total .value { font-size: 20px; font-weight: bold; color: #f7941d; }

        /* Security badges */
        .secure-checkout-label { font-weight: bold; font-size: 14px; text-align: center; margin-bottom: 12px; }
        .badges-row { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
        .badge {
            background: #e9ecef; border-radius: 5px;
            padding: 5px 12px; font-size: 12px; font-weight: bold; color: #1a3a5c;
        }

        /* Cancellation */
        .cancellation-title { font-weight: bold; font-size: 14px; margin-bottom: 8px; }
        .cancellation-text { color: #6c757d; font-size: 12px; line-height: 1.5; }

        /* ── Footer ── */
        footer { background: #0f2540; padding: 40px 100px 20px; text-align: center; margin-top: auto; }
        footer p { color: rgba(255,255,255,.5); font-size: 12px; }

        .scratch-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 37, 64, .72);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            padding: 20px;
        }
        .scratch-modal {
            width: min(440px, 100%);
            background: #fff;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 24px 60px rgba(0,0,0,.28);
        }
        .scratch-head {
            background: linear-gradient(120deg, #11998e, #38ef7d);
            color: #fff;
            text-align: center;
            padding: 18px 20px;
        }
        .scratch-head h3 { font-size: 22px; margin-bottom: 4px; }
        .scratch-content { padding: 18px 20px 20px; text-align: center; }
        .scratch-note { color: #6c757d; font-size: 13px; margin-bottom: 10px; }
        .scratch-canvas-wrap {
            width: 320px;
            height: 170px;
            margin: 0 auto 12px;
            border-radius: 12px;
            position: relative;
            overflow: hidden;
        }
        .scratch-reward {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #fff;
            background: linear-gradient(135deg, #f7941d, #ff6b6b);
            padding: 12px;
        }
        .scratch-reward.no-win {
            background: linear-gradient(135deg, #667eea, #764ba2);
        }
        .scratch-discount { font-size: 34px; font-weight: 800; line-height: 1; }
        .scratch-code { margin-top: 8px; font-size: 14px; font-weight: 700; }
        #scratchCanvas {
            position: absolute;
            inset: 0;
            cursor: crosshair;
            touch-action: none;
        }
        .scratch-actions {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 10px;
        }
        .scratch-btn {
            border: none;
            border-radius: 6px;
            padding: 10px 14px;
            font-weight: 700;
            cursor: pointer;
        }
        .scratch-btn.primary { background: #1a3a5c; color: #fff; }
        .scratch-btn.light { background: #edf2f7; color: #1a3a5c; }

        .feedback-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, .68);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 10000;
            padding: 20px;
        }
        .feedback-modal {
            width: min(560px, 100%);
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 20px 50px rgba(0,0,0,.3);
            overflow: hidden;
        }
        .feedback-head {
            background: linear-gradient(120deg, #1a3a5c, #2d5a8a);
            color: #fff;
            padding: 16px 20px;
        }
        .feedback-head h3 { margin: 0; font-size: 22px; }
        .feedback-content { padding: 18px 20px 20px; }
        .feedback-content p { margin-bottom: 12px; color: #3b4252; }
        .feedback-textarea {
            width: 100%;
            min-height: 130px;
            border: 1px solid #d9dee4;
            border-radius: 8px;
            padding: 10px 12px;
            font-size: 14px;
            resize: vertical;
            outline: none;
        }
        .feedback-textarea:focus {
            border-color: #1a3a5c;
        }
        .feedback-error {
            color: #b91c1c;
            font-size: 13px;
            margin-top: 8px;
            min-height: 18px;
        }
        .feedback-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 14px;
        }
        .feedback-btn {
            border: none;
            border-radius: 6px;
            padding: 10px 14px;
            font-weight: 700;
            cursor: pointer;
        }
        .feedback-btn.secondary { background: #edf2f7; color: #1a3a5c; }
        .feedback-btn.primary { background: #1a3a5c; color: #fff; }

        .map-picker-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, .74);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 10020;
            padding: 20px;
        }
        .map-picker-modal {
            width: min(900px, 100%);
            max-height: 90vh;
            display: flex;
            flex-direction: column;
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 24px 60px rgba(0,0,0,.3);
            overflow: hidden;
        }
        .map-picker-head {
            background: linear-gradient(120deg, #1a3a5c, #2d5a8a);
            color: #fff;
            padding: 16px 20px;
        }
        .map-picker-head h3 {
            margin: 0;
            font-size: 22px;
        }
        .map-picker-content {
            padding: 16px 20px 18px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            min-height: 0;
        }
        .map-picker-search {
            width: 100%;
            border: 1px solid #d9dee4;
            border-radius: 8px;
            padding: 0 12px;
            height: 44px;
            font-size: 14px;
            outline: none;
        }
        .map-picker-search:focus {
            border-color: #1a3a5c;
        }
        .map-picker-results {
            border: 1px solid #d9dee4;
            border-radius: 8px;
            max-height: 160px;
            overflow-y: auto;
            display: none;
            background: #fff;
        }
        .map-picker-result-item {
            padding: 9px 10px;
            font-size: 13px;
            cursor: pointer;
            border-bottom: 1px solid #eef2f6;
            color: #334155;
        }
        .map-picker-result-item:last-child {
            border-bottom: none;
        }
        .map-picker-result-item:hover {
            background: #f8fafc;
        }
        .map-picker-note {
            margin: 0;
            font-size: 13px;
            color: #52627a;
        }
        #mapPickerCanvas {
            width: 100%;
            height: 420px;
            border-radius: 10px;
            border: 1px solid #d9dee4;
            background: #f3f6fb;
        }
        .map-picker-error {
            margin: 0;
            min-height: 18px;
            color: #b91c1c;
            font-size: 13px;
            font-weight: 600;
        }
        .map-picker-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }
        .map-picker-btn {
            border: none;
            border-radius: 6px;
            padding: 10px 14px;
