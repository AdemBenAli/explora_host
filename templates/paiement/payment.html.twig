<script>
function toggleTheme() {
    document.body.classList.toggle('dark-theme');
    localStorage.setItem('explora-theme', document.body.classList.contains('dark-theme') ? 'dark' : 'light');
    const btn = document.getElementById('themeToggleBtn');
    if (btn) {
        btn.textContent = document.body.classList.contains('dark-theme') ? '☀️' : '🌙';
    }
}

function applySavedTheme() {
    const savedTheme = localStorage.getItem('explora-theme');
    if (savedTheme === 'dark') {
        document.body.classList.add('dark-theme');
    }

    const btn = document.getElementById('themeToggleBtn');
    if (btn) {
        btn.textContent = document.body.classList.contains('dark-theme') ? '☀️' : '🌙';
    }
}

applySavedTheme();

let isCardValidated = false;

const CARD_THEME_MAP = {
    default: {
        label: 'CARD',
        gradient: 'linear-gradient(135deg, #1e3c72, #2a5298)',
        chipGradient: 'linear-gradient(135deg, #d4a843, #b8922a)',
    },
    visa: {
        label: 'VISA',
        gradient: 'linear-gradient(135deg, #1f2b8f, #313ea8)',
        chipGradient: 'linear-gradient(135deg, #d5b560, #a9852f)',
    },
    mastercard: {
        label: 'MASTERCARD',
        gradient: 'linear-gradient(135deg, #ff0015, #ff9c1a)',
        chipGradient: 'linear-gradient(135deg, #ce9e44, #9f782d)',
    },
    discover: {
        label: 'DISCOVER',
        gradient: 'linear-gradient(135deg, #ff7a00, #ff9f00)',
        chipGradient: 'linear-gradient(135deg, #e3ba71, #b58633)',
    },
    amex: {
        label: 'AMEX',
        gradient: 'linear-gradient(135deg, #1679c8, #1ba3d8)',
        chipGradient: 'linear-gradient(135deg, #cba45f, #98742f)',
    },
};

const CARD_LOGO_MAP = {
    visa: {
        src: '/assets/card-logos/visa-logo.png',
        cls: 'logo-visa',
        alt: 'Visa',
    },
    mastercard: {
        src: '/assets/card-logos/mastercard-logo.png',
        cls: 'logo-mastercard',
        alt: 'Mastercard',
    },
    discover: {
        src: '/assets/card-logos/discover-logo.png',
        cls: 'logo-discover',
        alt: 'Discover',
    },
    amex: {
        src: '/assets/card-logos/amex-logo.png',
        cls: 'logo-amex',
        alt: 'American Express',
    },
};

const countrySelectEl = document.getElementById('countrySelect');
const citySelectEl = document.getElementById('citySelect');
const streetFieldEl = document.getElementById('streetField');
const streetSuggestionsEl = document.getElementById('streetSuggestions');
const mapPickerOpenBtn = document.getElementById('mapPickerOpenBtn');
const mapPickerOverlay = document.getElementById('mapPickerOverlay');
const mapPickerSearchEl = document.getElementById('mapPickerSearch');
const mapPickerResultsEl = document.getElementById('mapPickerResults');
const mapPickerErrorEl = document.getElementById('mapPickerError');
const mapPickerUseBtn = document.getElementById('mapPickerUseBtn');
const mapPickerCancelBtn = document.getElementById('mapPickerCancelBtn');
const postalCodeEl = document.getElementById('postalCodeField');
const countriesApiUrl = '/api/countries';
const citiesApiUrl = '/api/cities';
const addressSuggestionsApiUrl = '/api/address-suggestions';
const initialCountry = {{ billingCountry is not null ? billingCountry|json_encode|raw : 'null' }};
const initialCity = {{ billingCity is not null ? billingCity|json_encode|raw : 'null' }};
const scratchRewardData = {{ scratchReward ? scratchReward|json_encode|raw : 'null' }};
const feedbackStoreUrl = '{{ path('payment_feedback_store') }}';
let streetDebounceTimer = null;
let mapPickerMap = null;
let mapPickerMarker = null;
let selectedMapPlace = null;
let mapSearchDebounceTimer = null;

const feedbackOverlay = document.getElementById('feedbackOverlay');
const feedbackMessage = document.getElementById('feedbackMessage');
const feedbackError = document.getElementById('feedbackError');
const feedbackSubmitBtn = document.getElementById('feedbackSubmitBtn');
const feedbackSkipBtn = document.getElementById('feedbackSkipBtn');

function openFeedbackModal() {
    if (!feedbackOverlay) return;
    feedbackOverlay.style.display = 'flex';
    if (feedbackMessage) {
        feedbackMessage.value = '';
        setTimeout(() => feedbackMessage.focus(), 20);
    }
    if (feedbackError) {
        feedbackError.textContent = '';
    }
}

function closeFeedbackModal() {
    if (feedbackOverlay) {
        feedbackOverlay.style.display = 'none';
    }
}

async function submitFeedback() {
    if (!feedbackMessage) return;
    const message = String(feedbackMessage.value || '').trim();

    if (message.length < 3) {
        if (feedbackError) {
            feedbackError.textContent = 'Please enter at least 3 characters.';
        }
        return;
    }

    if (feedbackSubmitBtn) {
        feedbackSubmitBtn.disabled = true;
        feedbackSubmitBtn.textContent = 'Sending...';
    }
    if (feedbackError) {
        feedbackError.textContent = '';
    }

    try {
        const csrfInput = document.querySelector('input[name="_token"]');
        const csrfToken = csrfInput ? csrfInput.value : '';

        const body = new URLSearchParams();
        body.set('_token', csrfToken);
        body.set('message', message);

        const response = await fetch(feedbackStoreUrl, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                'Accept': 'application/json'
            },
            body: body.toString()
        });

        const payload = await response.json().catch(() => ({}));
        if (!response.ok || payload.error) {
            throw new Error(payload.error || 'Failed to send feedback.');
        }

        closeFeedbackModal();
        alert('Thank you for your feedback!');
    } catch (error) {
        if (feedbackError) {
            feedbackError.textContent = error.message || 'Failed to send feedback.';
        }
    } finally {
        if (feedbackSubmitBtn) {
            feedbackSubmitBtn.disabled = false;
            feedbackSubmitBtn.textContent = 'Send Feedback';
        }
    }
}

feedbackSubmitBtn?.addEventListener('click', submitFeedback);
feedbackSkipBtn?.addEventListener('click', closeFeedbackModal);
feedbackOverlay?.addEventListener('click', (event) => {
    if (event.target === feedbackOverlay) {
        closeFeedbackModal();
    }
});

function extractAddressParts(place) {
    const addr = place?.address || {};
    const countryCode = String(addr.country_code || '').toUpperCase();
    const city = String(
        addr.city ||
        addr.town ||
        addr.village ||
        addr.municipality ||
        addr.county ||
        addr.state_district ||
        addr.state ||
        ''
    ).trim();
    const postalCode = String(addr.postcode || '').trim();

    let street = [addr.house_number || '', addr.road || ''].filter(Boolean).join(' ').trim();
    if (!street) {
        street = String(addr.neighbourhood || addr.suburb || '').trim();
    }
    if (!street) {
        const display = String(place?.display_name || '').trim();
        street = display ? (display.split(',')[0] || '').trim() : '';
    }

    return {
        street,
        postalCode,
        countryCode,
        city,
    };
}

function upsertCityOption(cityName) {
    if (!cityName) {
        return;
    }

    const normalized = cityName.trim().toLowerCase();
    const existingOption = Array.from(citySelectEl.options).find((option) => option.value.trim().toLowerCase() === normalized);

    if (!existingOption) {
        const option = document.createElement('option');
        option.value = cityName;
        option.textContent = cityName;
        citySelectEl.appendChild(option);
    }

    citySelectEl.value = cityName;
    clearFieldError(citySelectEl);
}

async function applyMapPlaceToBilling(place) {
    const { street, postalCode, countryCode, city } = extractAddressParts(place);

    if (!countryCode) {
        throw new Error('Selected place has no country. Please choose a more precise place.');
    }

    const countryOption = Array.from(countrySelectEl.options).find((option) => option.value.toUpperCase() === countryCode);
    if (!countryOption) {
        throw new Error('Country from selected place is not supported in this checkout form.');
    }

    countrySelectEl.value = countryCode;
    clearFieldError(countrySelectEl);

    await loadCities(countryCode, city || null);
    if (city) {
        upsertCityOption(city);
    }

    if (street) {
        streetFieldEl.value = street;
        clearFieldError(streetFieldEl);
    }

    if (postalCode) {
        postalCodeEl.value = postalCode;
        clearFieldError(postalCodeEl);
    }
}

function openMapPickerModal() {
    initLeafletMapIfNeeded();

    mapPickerOverlay.style.display = 'flex';
    mapPickerUseBtn.disabled = !selectedMapPlace;
    mapPickerResultsEl.style.display = 'none';
    mapPickerResultsEl.innerHTML = '';
    if (mapPickerErrorEl) {
        mapPickerErrorEl.textContent = '';
    }

    setTimeout(() => {
        if (mapPickerSearchEl) {
            mapPickerSearchEl.focus();
        }
        if (mapPickerMap) {
            mapPickerMap.invalidateSize();
        }
    }, 30);
}

function closeMapPickerModal() {
    if (!mapPickerOverlay) {
        return;
    }

    mapPickerOverlay.style.display = 'none';
    if (mapPickerErrorEl) {
        mapPickerErrorEl.textContent = '';
    }
}

function initLeafletMapIfNeeded() {
    if (mapPickerMap || !window.L) {
        return;
    }

    const mapCanvas = document.getElementById('mapPickerCanvas');
    if (!mapCanvas) {
        return;
    }

    mapPickerMap = L.map(mapCanvas, {
        center: [36.8065, 10.1815],
        zoom: 5,
        zoomControl: true,
    });

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap contributors',
    }).addTo(mapPickerMap);

    mapPickerMarker = L.marker([36.8065, 10.1815], {
        draggable: false,
    });

    mapPickerMap.on('click', async (event) => {
        try {
            const lat = event.latlng.lat;
            const lon = event.latlng.lng;
            const response = await fetch('https://nominatim.openstreetmap.org/reverse?format=jsonv2&addressdetails=1&zoom=18&lat=' + encodeURIComponent(lat) + '&lon=' + encodeURIComponent(lon));
            const payload = await response.json();

            if (!payload || !payload.address) {
                throw new Error('No address found for this point.');
            }

            selectedMapPlace = payload;
            mapPickerMarker.setLatLng([lat, lon]).addTo(mapPickerMap);
            mapPickerUseBtn.disabled = false;
            if (mapPickerErrorEl) {
                mapPickerErrorEl.textContent = '';
            }
        } catch (error) {
            if (mapPickerErrorEl) {
                mapPickerErrorEl.textContent = error.message || 'Unable to read address from map point.';
            }
        }
    });
}

function renderMapSearchResults(items) {
    if (!Array.isArray(items) || items.length === 0) {
        mapPickerResultsEl.style.display = 'none';
        mapPickerResultsEl.innerHTML = '';
        return;
    }

    mapPickerResultsEl.innerHTML = items.map((item, index) => {
        const text = String(item.display_name || '').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        return '<div class="map-picker-result-item" data-result-index="' + index + '">' + text + '</div>';
    }).join('');
    mapPickerResultsEl.style.display = 'block';

    mapPickerResultsEl.querySelectorAll('.map-picker-result-item').forEach((node) => {
        node.addEventListener('click', () => {
            const idx = Number(node.getAttribute('data-result-index'));
            const selected = items[idx];
            if (!selected) return;

            selectedMapPlace = selected;
            const lat = Number(selected.lat);
            const lon = Number(selected.lon);

            if (Number.isFinite(lat) && Number.isFinite(lon) && mapPickerMap) {
                mapPickerMap.setView([lat, lon], 15);
                mapPickerMarker.setLatLng([lat, lon]).addTo(mapPickerMap);
            }

            mapPickerSearchEl.value = selected.display_name || mapPickerSearchEl.value;
            mapPickerUseBtn.disabled = false;
            mapPickerResultsEl.style.display = 'none';
            mapPickerResultsEl.innerHTML = '';
            if (mapPickerErrorEl) {
                mapPickerErrorEl.textContent = '';
            }
        });
    });
}

async function searchMapPlaces(query) {
    const q = String(query || '').trim();
    if (q.length < 3) {
        renderMapSearchResults([]);
        return;
    }

    try {
        const response = await fetch('https://nominatim.openstreetmap.org/search?format=jsonv2&addressdetails=1&limit=6&q=' + encodeURIComponent(q));
        const payload = await response.json();
        renderMapSearchResults(Array.isArray(payload) ? payload : []);
    } catch {
        renderMapSearchResults([]);
    }
}

mapPickerOpenBtn?.addEventListener('click', openMapPickerModal);
mapPickerCancelBtn?.addEventListener('click', closeMapPickerModal);
mapPickerOverlay?.addEventListener('click', (event) => {
    if (event.target === mapPickerOverlay) {
        closeMapPickerModal();
    }
});

mapPickerSearchEl?.addEventListener('input', () => {
    clearTimeout(mapSearchDebounceTimer);
    mapSearchDebounceTimer = setTimeout(() => {
        searchMapPlaces(mapPickerSearchEl.value);
    }, 280);
});

mapPickerSearchEl?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
        event.preventDefault();
        searchMapPlaces(mapPickerSearchEl.value);
    }
});

mapPickerUseBtn?.addEventListener('click', async () => {
    if (!selectedMapPlace) {
        if (mapPickerErrorEl) {
            mapPickerErrorEl.textContent = 'Please select a place from the map first.';
        }
        return;
    }

    mapPickerUseBtn.disabled = true;
    try {
