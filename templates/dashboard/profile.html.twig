                    <button type="button" class="toggle-opt {{ axeA and axeA.avecGuide == 'non' ? 'selected' : '' }}" onclick="setToggle(this,'avec_guide','non')">✗ No</button>
                </div>
                <input type="hidden" name="avec_guide" id="avec_guide" value="{{ axeA ? axeA.avecGuide : '' }}">
            </div>
            <div class="field-group" style="margin-top:12px;">
                <label>With Group</label>
                <div class="toggle-group">
                    <button type="button" class="toggle-opt {{ axeA and axeA.avecGroupe == 'oui' ? 'selected' : '' }}" onclick="setToggle(this,'avec_groupe','oui')">✓ Yes</button>
                    <button type="button" class="toggle-opt {{ axeA and axeA.avecGroupe == 'non' ? 'selected' : '' }}" onclick="setToggle(this,'avec_groupe','non')">✗ No</button>
                </div>
                <input type="hidden" name="avec_groupe" id="avec_groupe" value="{{ axeA ? axeA.avecGroupe : '' }}">
            </div>
            <div class="field-group" style="margin-top:12px;"><label>Budget (MAD)</label>
                <div class="budget-row">
                    <input type="number" name="activite_budget_min" value="{{ axeA ? axeA.budgetMin : '' }}" placeholder="Min">
                    <input type="number" name="activite_budget_max" value="{{ axeA ? axeA.budgetMax : '' }}" placeholder="Max">
                </div>
            </div>
        </div>
        <div class="pref-modal-footer">
            <button type="button" class="btn-pref-cancel" onclick="closePrefModal('activite')">Cancel</button>
            <button type="submit" class="btn-pref-save"><i class="fa-solid fa-floppy-disk"></i> Save</button>
        </div>
    </form>
</div></div>

<!-- Voyage -->
<div class="pref-overlay" id="pref-voyage" onclick="if(event.target===this)closePrefModal('voyage')">
<div class="pref-modal">
    <div class="pref-modal-header">
        <div class="pref-modal-icon" style="background:#fdf2f8;color:#ec4899;"><i class="fa-solid fa-earth-americas"></i></div>
        <span class="pref-modal-title">Voyage Preferences</span>
        <button class="pref-modal-close" onclick="closePrefModal('voyage')">✕</button>
    </div>
    <form method="POST" action="{{ path('app_profile') }}">
        <input type="hidden" name="section" value="preferences">
        <input type="hidden" name="axe" value="voyage">
        <div class="pref-modal-body">
            <div class="fields-grid">
                <div class="field-group">
                    <label>Trip Types</label>
                    <input type="text" name="types_voyages" value="{{ axeV ? axeV.typesVoyages : '' }}" placeholder="Adventure, Beach...">
                </div>
                <div class="field-group">
                    <label>Preferred Seasons</label>
                    <input type="text" name="saisons" value="{{ axeV ? axeV.saisonsPreferees : '' }}" placeholder="Summer, Winter...">
                </div>
                <div class="field-group">
                    <label>Destinations</label>
                    <input type="text" name="destinations" value="{{ axeV ? axeV.destinations : '' }}" placeholder="Europe, Asia...">
                </div>
                <div class="field-group">
                    <label>Duration (days)</label>
                    <input type="number" name="duree" value="{{ axeV ? axeV.duree : '' }}" placeholder="e.g. 7" min="1">
                </div>
            </div>
            <div class="field-group" style="margin-top:12px;"><label>Budget (MAD)</label>
                <div class="budget-row">
                    <input type="number" name="voyage_budget_min" value="{{ axeV ? axeV.budgetMin : '' }}" placeholder="Min">
                    <input type="number" name="voyage_budget_max" value="{{ axeV ? axeV.budgetMax : '' }}" placeholder="Max">
                </div>
            </div>
        </div>
        <div class="pref-modal-footer">
            <button type="button" class="btn-pref-cancel" onclick="closePrefModal('voyage')">Cancel</button>
            <button type="submit" class="btn-pref-save"><i class="fa-solid fa-floppy-disk"></i> Save</button>
        </div>
    </form>
</div></div>

<script>
    function openPrefModal(name) {
        document.getElementById('pref-' + name).classList.add('open');
        document.body.style.overflow = 'hidden';
    }
    function closePrefModal(name) {
        document.getElementById('pref-' + name).classList.remove('open');
        document.body.style.overflow = '';
    }
    function setToggle(btn, fieldId, value) {
        btn.closest('.toggle-group').querySelectorAll('.toggle-opt').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
        document.getElementById(fieldId).value = value;
    }

    function previewAvatar(input) {
        if (!input.files || !input.files[0]) return;
        var reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById('avatar-preview').src = e.target.result;
        };
        reader.readAsDataURL(input.files[0]);
        setTimeout(function() { document.getElementById('avatar-form').submit(); }, 400);
    }

    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('avatar-input').addEventListener('change', function() {
            previewAvatar(this);
        });
    });

    function toggleCamMenu(e) {
        e.stopPropagation();
        document.getElementById('cam-menu').classList.toggle('open');
    }
    document.addEventListener('click', function() {
        document.getElementById('cam-menu').classList.remove('open');
    });

    var camStream = null;

    function openCameraCapture() {
        document.getElementById('cam-menu').classList.remove('open');
        document.getElementById('cam-overlay').classList.add('open');
        navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false })
        .then(function(stream) {
            camStream = stream;
            document.getElementById('cam-video').srcObject = stream;
        })
        .catch(function(err) {
            alert('Camera access denied: ' + err.message);
            closeCameraCapture();
        });
    }

    function closeCameraCapture() {
        if (camStream) { camStream.getTracks().forEach(t => t.stop()); camStream = null; }
        document.getElementById('cam-overlay').classList.remove('open');
        document.getElementById('cam-video').srcObject = null;
    }

    function capturePhoto() {
        var video  = document.getElementById('cam-video');
        var canvas = document.getElementById('cam-canvas');
        canvas.width  = video.videoWidth;
        canvas.height = video.videoHeight;
        canvas.getContext('2d').drawImage(video, 0, 0);
        canvas.toBlob(function(blob) {
            closeCameraCapture();
            // Preview immediately
            document.getElementById('avatar-preview').src = URL.createObjectURL(blob);
            // Upload via the avatar form
            var dt = new DataTransfer();
            dt.items.add(new File([blob], 'capture.jpg', { type: 'image/jpeg' }));
            document.getElementById('avatar-input').files = dt.files;
            document.getElementById('avatar-form').submit();
        }, 'image/jpeg', 0.9);
    }

    var editMode = false;
    var editableIds = ['inp-prenom','inp-nom','inp-telephone','inp-nationalite','inp-dob','inp-ville','inp-pays','inp-adresse','inp-bio'];

    function toggleEdit(section) {
        editMode = !editMode;
        editableIds.forEach(function(id) {
            var el = document.getElementById(id);
            if (el) el.readOnly = !editMode;
        });
        document.getElementById('btn-save-personal').style.display = editMode ? 'flex' : 'none';
    }

    const ICONS = { auto:'🌗', light:'☀️', dark:'🌙' };
    function syncThemeNav() {
        const mode = localStorage.getItem('explora-theme') || 'auto';
        const icon = document.getElementById('theme-nav-icon');
        if (icon) icon.textContent = ICONS[mode];
        document.querySelectorAll('.theme-nav-option').forEach(el => el.classList.toggle('active', el.dataset.mode === mode));
    }
    function toggleThemeMenu(e) {
        e.preventDefault();
        const m = document.getElementById('theme-nav-menu');
        m.style.display = m.style.display === 'flex' ? 'none' : 'flex';
    }
    function pickTheme(mode) {
        localStorage.setItem('explora-theme', mode);
        const h = new Date().getHours();
        document.documentElement.setAttribute('data-theme', mode === 'auto' ? (h >= 7 && h < 19 ? 'light' : 'dark') : mode);
        syncThemeNav();
        document.getElementById('theme-nav-menu').style.display = 'none';
    }
    document.addEventListener('DOMContentLoaded', syncThemeNav);
</script>
</body>
</html>
