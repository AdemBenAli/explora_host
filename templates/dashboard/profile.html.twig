<!-- DiceBear Avatar Picker -->
<div class="ai-overlay" id="dicebear-modal" onclick="if(event.target===this)this.classList.remove('open')">
<div class="ai-modal">
    <h3><i class="fa-solid fa-dice" style="color:#7c3aed;"></i> Choose Your Avatar</h3>
    <p>Pick a style and select your favourite avatar.</p>

    <div class="style-grid">
        <button type="button" class="style-opt selected" data-style="adventurer" onclick="selectDiceStyle(this)"><span class="style-emoji">🧑</span>Adventurer</button>
        <button type="button" class="style-opt" data-style="avataaars" onclick="selectDiceStyle(this)"><span class="style-emoji">😊</span>Avataaars</button>
        <button type="button" class="style-opt" data-style="bottts" onclick="selectDiceStyle(this)"><span class="style-emoji">🤖</span>Bottts</button>
        <button type="button" class="style-opt" data-style="fun-emoji" onclick="selectDiceStyle(this)"><span class="style-emoji">😄</span>Fun Emoji</button>
        <button type="button" class="style-opt" data-style="lorelei" onclick="selectDiceStyle(this)"><span class="style-emoji">🧝</span>Lorelei</button>
        <button type="button" class="style-opt" data-style="micah" onclick="selectDiceStyle(this)"><span class="style-emoji">🎨</span>Micah</button>
        <button type="button" class="style-opt" data-style="miniavs" onclick="selectDiceStyle(this)"><span class="style-emoji">👤</span>Miniavs</button>
        <button type="button" class="style-opt" data-style="pixel-art" onclick="selectDiceStyle(this)"><span class="style-emoji">🕹️</span>Pixel Art</button>
    </div>

    <button type="button" class="btn-dice-refresh" onclick="refreshDiceAvatars()">
        <i class="fa-solid fa-rotate-right"></i> Shuffle
    </button>

    <div class="dice-preview-grid" id="dice-grid"></div>

    <div class="ai-footer">
        <button type="button" class="btn-ai-cancel" onclick="document.getElementById('dicebear-modal').classList.remove('open')">Cancel</button>
        <button type="button" class="btn-ai-generate" id="btn-dice-apply" onclick="applyDiceAvatar()" disabled>
            <i class="fa-solid fa-check"></i> Apply Avatar
        </button>
    </div>
</div>
</div>

<script>
    var diceStyle = 'adventurer';
    var selectedDiceUrl = null;

    function selectDiceStyle(el) {
        document.querySelectorAll('.style-opt').forEach(o => o.classList.remove('selected'));
        el.classList.add('selected');
        diceStyle = el.dataset.style;
        refreshDiceAvatars();
    }

    function refreshDiceAvatars() {
        var grid = document.getElementById('dice-grid');
        grid.innerHTML = '';
        selectedDiceUrl = null;
        document.getElementById('btn-dice-apply').disabled = true;
        for (var i = 0; i < 10; i++) {
            var seed = Math.random().toString(36).substring(2, 10);
            var url = 'https://api.dicebear.com/9.x/' + diceStyle + '/svg?seed=' + seed + '&size=80';
            (function(u) {
                var div = document.createElement('div');
                div.className = 'dice-opt';
                div.innerHTML = '<img src="' + u + '" alt="avatar">';
                div.onclick = function() {
                    document.querySelectorAll('.dice-opt').forEach(d => d.classList.remove('selected'));
                    div.classList.add('selected');
                    selectedDiceUrl = u;
                    document.getElementById('btn-dice-apply').disabled = false;
                };
                grid.appendChild(div);
            })(url);
        }
    }

    function applyDiceAvatar() {
        if (!selectedDiceUrl) return;
        var btn = document.getElementById('btn-dice-apply');
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
        var fd = new FormData();
        fd.append('url', selectedDiceUrl);
        fetch('{{ path("app_profile_dicebear") }}', { method: 'POST', body: fd })
        .then(r => {
            const ct = (r.headers.get('content-type') || '');
            if (!ct.includes('application/json')) {
                return r.text().then(t => { throw new Error('Invalid JSON response: ' + t.slice(0, 200)); });
            }
            return r.json();
        })
        .then(data => {
            if (data && data.status === 'done') {
                document.getElementById('avatar-preview').src = selectedDiceUrl;
                document.getElementById('dicebear-modal').classList.remove('open');
            } else {
                alert('Error: ' + (data && data.error ? data.error : 'Unknown'));
            }
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-check"></i> Apply Avatar';
        })
        .catch(err => {
            alert('Request failed: ' + (err && err.message ? err.message : err));
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-check"></i> Apply Avatar';
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('dicebear-modal').addEventListener('click', function(e) {
            if (e.target === this) this.classList.remove('open');
        });
        // Pre-load avatars when modal opens
        document.querySelector('[onclick*="dicebear-modal"]').addEventListener('click', function() {
            if (!document.getElementById('dice-grid').children.length) refreshDiceAvatars();
        });
    });
</script>

