<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agent Dashboard - Explora</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="/css/theme.css">
    <script src="/js/theme.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

        :root {
            --sidebar-bg: #d97706;
            --sidebar-bg-hover: #b45309;
            --sidebar-bg-active: #92400e;
            --bg-body: #f4f7f6;
            --bg-card: #ffffff;
            --text-heading: #1e293b;
            --text-body: #64748b;
            --border-color: #e2e8f0;
            --accent: #fbbf24;
        }

        [data-theme="dark"] {
            --bg-body: #0F172A;
            --bg-card: #1E293B;
            --text-heading: #F1F5F9;
            --text-body: #94A3B8;
            --border-color: #334155;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-body);
            color: var(--text-body);
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        .sidebar {
            width: 260px;
            background: linear-gradient(180deg, #b45309 0%, #d97706 100%);
            color: white;
            display: flex;
            flex-direction: column;
        }

        .sidebar-header {
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid rgba(255,255,255,0.15);
        }

        .logo-box {
            background: white;
            color: #d97706;
            width: 40px;
            height: 40px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .logo-text h2 { font-size: 18px; font-weight: 700; color: white; }
        .logo-text span { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.8; }

        .sidebar-nav { flex: 1; padding: 20px 0; }

        .nav-item {
            display: flex;
            align-items: center;
            padding: 12px 24px;
            color: rgba(255,255,255,0.85);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s;
            border-left: 4px solid transparent;
        }

        .nav-item i { width: 20px; font-size: 16px; margin-right: 12px; }
        .nav-item:hover { background-color: rgba(255,255,255,0.1); color: white; }
        .nav-item.active { background-color: rgba(255,255,255,0.15); color: white; border-left-color: white; }

        .tier-card {
            margin: 20px;
            background: rgba(255,255,255,0.15);
            border-radius: 12px;
            padding: 16px;
        }

        .tier-card-label { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.8; font-weight: 600; margin-bottom: 8px; }

        .tier-card-content { display: flex; align-items: center; gap: 10px; }

        .tier-badge {
            background: white;
            color: #d97706;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
        }

        .tier-card-content span { font-weight: 600; font-size: 14px; }

        .sidebar-footer { padding: 10px 0 20px; }

        .main-content { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

        .topbar {
            height: 70px;
            background-color: var(--bg-card);
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
        }

        .search-bar {
            background-color: var(--bg-body);
            border-radius: 30px;
            padding: 10px 20px;
            display: flex;
            align-items: center;
            width: 350px;
            border: 1px solid transparent;
            transition: all 0.2s;
        }

        .search-bar:focus-within { border-color: #cbd5e1; background: var(--bg-card); box-shadow: 0 2px 4px rgba(0,0,0,.05); }
        .search-bar i { color: #94a3b8; margin-right: 12px; }
        .search-bar input { border: none; background: transparent; outline: none; font-size: 14px; width: 100%; color: var(--text-heading); font-family: 'Inter', sans-serif; }
        .search-bar input::placeholder { color: #94a3b8; }

        .topbar-right { display: flex; align-items: center; gap: 20px; }

        .icon-btn {
            background: var(--bg-body);
            border: none;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #64748b;
            cursor: pointer;
            transition: all 0.2s;
        }

        .icon-btn:hover { background: #e2e8f0; color: #d97706; }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            padding-left: 10px;
            border-left: 1px solid var(--border-color);
        }

        .user-avatar { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
        .user-name { font-weight: 600; color: var(--text-heading); font-size: 14px; }
        .user-role { font-size: 12px; color: #94a3b8; }
        .user-dropdown-icon { color: #94a3b8; font-size: 12px; margin-left: 4px; }

        .content-area {
            flex: 1;
            padding: 30px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

        .breadcrumb { font-size: 13px; color: #94a3b8; margin-bottom: 20px; }
        .breadcrumb span { color: var(--text-heading); font-weight: 600; }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 30px;
            animation: fadeIn .5s ease-out;
        }

        @keyframes fadeIn { from { opacity:0; transform: translateY(10px); } to { opacity:1; transform: translateY(0); } }

        .stat-card {
            background: var(--bg-card);
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 1px 3px rgba(0,0,0,.07);
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .stat-icon.orange { background: #fff7ed; color: #d97706; }
        .stat-icon.blue   { background: #eff6ff; color: #3b82f6; }
        .stat-icon.green  { background: #f0fdf4; color: #22c55e; }
        .stat-icon.purple { background: #faf5ff; color: #a855f7; }

        .stat-info strong { display: block; font-size: 1.5rem; font-weight: 700; color: var(--text-heading); }
        .stat-info span   { font-size: 0.8rem; color: var(--text-body); }

        .empty-state {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .empty-icon { font-size: 70px; color: #cbd5e1; margin-bottom: 20px; }
        .empty-title { font-size: 22px; font-weight: 700; color: var(--text-heading); margin-bottom: 10px; }
        .empty-desc  { font-size: 14px; color: var(--text-body); }

        .theme-nav-option {
            background: none;
            border: none;
            color: rgba(255,255,255,0.85);
            font-size: 13px;
            font-family: 'Inter', sans-serif;
            padding: 9px 24px;
            text-align: left;
            cursor: pointer;
            transition: background 0.15s;
            border-radius: 6px;
        }
        .theme-nav-option:hover { background: rgba(255,255,255,0.1); }
        .theme-nav-option.active { color: white; font-weight: 600; }
    </style>
</head>
<body>

    {% set active_route = app.request.attributes.get('_route') %}
    {{ include('partials/agent_sidebar.html.twig', { active_route: 'agent_dashboard' }) }}

    <main class="main-content">
        {{ include('partials/agent_topbar.html.twig') }}

        <div class="content-area">
            <div class="breadcrumb">Dashboard &gt; <span>Agent Home</span></div>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon orange"><i class="fa-solid fa-suitcase"></i></div>
                    <div class="stat-info"><strong>24</strong><span>Active Packages</span></div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon blue"><i class="fa-regular fa-calendar-check"></i></div>
                    <div class="stat-info"><strong>138</strong><span>Total Bookings</span></div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon green"><i class="fa-solid fa-users"></i></div>
                    <div class="stat-info"><strong>512</strong><span>Clients</span></div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon purple"><i class="fa-solid fa-star"></i></div>
                    <div class="stat-info"><strong>4.8</strong><span>Avg Rating</span></div>
                </div>
            </div>

            <div class="empty-state">
                <div class="empty-icon"><i class="fa-solid fa-building"></i></div>
                <h1 class="empty-title">Welcome to Agent Dashboard</h1>
                <p class="empty-desc">Manage your packages, bookings and clients from the sidebar.</p>
            </div>
        </div>
    </main>

<script>
    const ICONS = { auto: '🌗', light: '☀️', dark: '🌙' };
    function syncThemeNav() {
        const mode = localStorage.getItem('explora-theme') || 'auto';
        const icon = document.getElementById('theme-nav-icon');
        if (icon) icon.textContent = ICONS[mode];
        document.querySelectorAll('.theme-nav-option').forEach(el => {
            el.classList.toggle('active', el.dataset.mode === mode);
        });
    }
    function toggleThemeMenu(e) {
        e.preventDefault();
        const menu = document.getElementById('theme-nav-menu');
        menu.style.display = menu.style.display === 'flex' ? 'none' : 'flex';
    }
    function pickTheme(mode) {
        localStorage.setItem('explora-theme', mode);
        const h = new Date().getHours();
        const resolved = mode === 'auto' ? ((h >= 7 && h < 19) ? 'light' : 'dark') : mode;
        document.documentElement.setAttribute('data-theme', resolved);
        syncThemeNav();
        document.getElementById('theme-nav-menu').style.display = 'none';
    }
    document.addEventListener('DOMContentLoaded', syncThemeNav);
</script>
</body>
</html>
