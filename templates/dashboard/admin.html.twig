<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Explora</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="/css/theme.css">
    <script src="/js/theme.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

        :root {
            --sidebar-bg: #1a2332;
            --sidebar-item-hover: rgba(255,255,255,0.06);
            --sidebar-active-bg: #e53935;
            --bg-body: #f1f5f9;
            --bg-card: #ffffff;
            --text-heading: #0f172a;
            --text-body: #64748b;
            --border-color: #e2e8f0;
            --accent: #e53935;
        }

        [data-theme="dark"] {
            --bg-body: #0F172A;
            --bg-card: #1E293B;
            --text-heading: #F1F5F9;
            --text-body: #94A3B8;
            --border-color: #334155;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-body);
            color: var(--text-body);
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        .sidebar {
            width: 260px;
            background: var(--sidebar-bg);
            color: white;
            display: flex;
            flex-direction: column;
        }

        .sidebar-header {
            margin: 16px;
            background: rgba(255,255,255,0.07);
            border-radius: 12px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-box {
            background: #e53935;
            color: white;
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }

        .logo-text h2 { font-size: 16px; font-weight: 800; color: white; letter-spacing: 0.5px; text-transform: uppercase; }
        .logo-text span { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: rgba(255,255,255,0.45); font-weight: 500; }

        .sidebar-nav { flex: 1; padding: 8px 0; overflow-y: auto; }

        .nav-section-label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: rgba(255,255,255,0.3);
            font-weight: 700;
            padding: 20px 20px 8px;
        }

        .nav-divider {
            height: 1px;
            background: rgba(255,255,255,0.08);
            margin: 8px 20px 4px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            padding: 12px 20px;
            margin: 2px 12px;
            color: rgba(255,255,255,0.65);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s;
            border-radius: 10px;
            gap: 14px;
        }

        .nav-item i { font-size: 16px; width: 20px; text-align: center; }
        .nav-item:hover { background: rgba(255,255,255,0.06); color: white; }
        .nav-item.active {
            background: #e53935;
            color: white;
            font-weight: 600;
            box-shadow: 0 4px 12px rgba(229,57,53,0.4);
        }

        .sidebar-footer { padding: 12px; border-top: 1px solid rgba(255,255,255,0.06); }

        .nav-item.logout { color: #e53935; background: rgba(229,57,53,0.08); }
        .nav-item.logout:hover { background: rgba(229,57,53,0.18); color: #ff6b6b; }

        .main-content { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

        .topbar {
            height: 70px;
            background: var(--bg-card);
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
        }

        .search-bar {
            background: var(--bg-body);
            border-radius: 30px;
            padding: 10px 20px;
            display: flex;
            align-items: center;
            width: 350px;
            border: 1px solid transparent;
            transition: all 0.2s;
        }

        .search-bar:focus-within { border-color: #cbd5e1; background: var(--bg-card); }
        .search-bar i { color: #94a3b8; margin-right: 12px; }
        .search-bar input { border: none; background: transparent; outline: none; font-size: 14px; width: 100%; font-family: inherit; color: var(--text-heading); }
        .search-bar input::placeholder { color: #94a3b8; }

        .topbar-right { display: flex; align-items: center; gap: 20px; }

        .icon-btn {
            background: var(--bg-body);
            border: none;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #64748b;
            cursor: pointer;
            transition: all 0.2s;
        }

        .icon-btn:hover { background: #e2e8f0; color: #6366f1; }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            padding-left: 10px;
            border-left: 1px solid var(--border-color);
        }

        .user-avatar { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
        .user-name { font-weight: 600; color: var(--text-heading); font-size: 14px; }
        .user-role { font-size: 12px; color: #94a3b8; }
        .user-dropdown-icon { color: #94a3b8; font-size: 12px; }

        .content-area {
            flex: 1;
            padding: 30px;
            overflow-y: auto;
        }

        .breadcrumb { font-size: 13px; color: #94a3b8; margin-bottom: 24px; }
        .breadcrumb span { color: var(--text-heading); font-weight: 600; }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 30px;
            animation: fadeIn .5s ease-out;
        }

        @keyframes fadeIn { from { opacity:0; transform: translateY(10px); } to { opacity:1; transform: translateY(0); } }

        .stat-card {
            background: var(--bg-card);
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 1px 3px rgba(0,0,0,.07);
        }

        .stat-card-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 12px;
        }

        .stat-icon {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .stat-icon.indigo { background: #eef2ff; color: #6366f1; }
        .stat-icon.blue   { background: #eff6ff; color: #3b82f6; }
        .stat-icon.green  { background: #f0fdf4; color: #22c55e; }
        .stat-icon.red    { background: #fef2f2; color: #ef4444; }

        .stat-badge {
            font-size: 11px;
            font-weight: 600;
            padding: 3px 8px;
            border-radius: 20px;
            background: #f0fdf4;
            color: #16a34a;
        }

        .stat-value { font-size: 1.75rem; font-weight: 700; color: var(--text-heading); }
        .stat-label { font-size: 0.8rem; color: var(--text-body); margin-top: 4px; }

        .section-title {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-heading);
            margin-bottom: 16px;
        }

        .table-card {
            background: var(--bg-card);
            border-radius: 16px;
            box-shadow: 0 1px 3px rgba(0,0,0,.07);
            overflow: hidden;
            animation: fadeIn .6s ease-out .2s both;
        }

        .table-card table {
            width: 100%;
            border-collapse: collapse;
        }

        .table-card th {
            background: var(--bg-body);
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #94a3b8;
            padding: 12px 20px;
            text-align: left;
        }

        .table-card td {
            padding: 14px 20px;
            font-size: 14px;
            border-top: 1px solid var(--border-color);
            color: var(--text-heading);
        }

        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .badge-green  { background: #dcfce7; color: #16a34a; }
        .badge-orange { background: #fff7ed; color: #d97706; }
        .badge-blue   { background: #dbeafe; color: #2563eb; }
        .badge-red    { background: #fee2e2; color: #dc2626; }

        .theme-nav-option {
            background: none;
            border: none;
            color: rgba(255,255,255,0.85);
            font-size: 13px;
            font-family: 'Inter', sans-serif;
            padding: 9px 24px;
            text-align: left;
            cursor: pointer;
            transition: background 0.15s;
            border-radius: 6px;
        }
        .theme-nav-option:hover { background: rgba(255,255,255,0.08); }
        .theme-nav-option.active { color: #a5b4fc; font-weight: 600; }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="logo-box"><i class="fa-solid fa-shield-halved"></i></div>
            <div class="logo-text">
                <h2>Explora</h2>
                <span>Admin Panel</span>
            </div>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section-label">Main</div>
            <a href="#" class="nav-item active"><i class="fa-solid fa-gauge-high"></i> Dashboard</a>
            <a href="{{ path('app_admin_users') }}" class="nav-item"><i class="fa-solid fa-users"></i> User Management</a>
            <a href="{{ path('app_admin_partnerships') }}" class="nav-item"><i class="fa-solid fa-handshake"></i> Partnerships</a>

            <div class="nav-divider"></div>

            <div class="nav-section-label">Management</div>
            <a href="#" class="nav-item"><i class="fa-solid fa-user-tie"></i> Agents</a>
            <a href="#" class="nav-item"><i class="fa-solid fa-circle-exclamation"></i> Complaints</a>
            <a href="{{ path('app_admin_coupons') }}" class="nav-item"><i class="fa-solid fa-tag"></i> Coupons</a>
        </nav>

        <div class="sidebar-footer">
            <a href="#" class="nav-item" id="theme-nav-btn" onclick="toggleThemeMenu(event)">
                <i class="fa-solid fa-circle-half-stroke"></i> Theme
                <span id="theme-nav-icon" style="margin-left:auto;font-size:1rem;"></span>
            </a>
            <div id="theme-nav-menu" style="display:none; flex-direction:column; background:rgba(255,255,255,0.04); border-radius:8px; margin:0 12px 4px;">
                <button class="theme-nav-option" data-mode="light"  onclick="pickTheme('light')">☀️ Light</button>
                <button class="theme-nav-option" data-mode="dark"   onclick="pickTheme('dark')">🌙 Dark</button>
                <button class="theme-nav-option" data-mode="auto"   onclick="pickTheme('auto')">🌗 Auto</button>
            </div>
            <a href="{{ path('app_logout') }}" class="nav-item logout">
                <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout
            </a>
        </div>
    </aside>

    <main class="main-content">
        <header class="topbar">
            <div class="search-bar">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="Search users, bookings, agencies...">
            </div>
            <div class="topbar-right">
                <button class="icon-btn" title="Reports"><i class="fa-solid fa-chart-simple"></i></button>
                <button class="icon-btn" title="Messages"><i class="fa-regular fa-envelope"></i></button>
                <button class="icon-btn" title="Notifications"><i class="fa-regular fa-bell"></i></button>
                <div class="user-profile">
                    <img src="https://ui-avatars.com/api/?name=Admin+User&background=6366f1&color=fff" alt="Admin Avatar" class="user-avatar">
                    <div>
                        <div class="user-name">Administrator</div>
                        <div class="user-role">Super Admin</div>
                    </div>
                    <i class="fa-solid fa-chevron-down user-dropdown-icon"></i>
                </div>
            </div>
        </header>

        <div class="content-area">
            <div class="breadcrumb">Admin &gt; <span>Dashboard</span></div>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-card-top">
                        <div class="stat-icon indigo"><i class="fa-solid fa-users"></i></div>
                        <span class="stat-badge">+12%</span>
                    </div>
                    <div class="stat-value">3,842</div>
                    <div class="stat-label">Total Users</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card-top">
                        <div class="stat-icon blue"><i class="fa-solid fa-building"></i></div>
                        <span class="stat-badge">+5%</span>
                    </div>
                    <div class="stat-value">148</div>
                    <div class="stat-label">Partner Agencies</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card-top">
                        <div class="stat-icon green"><i class="fa-regular fa-calendar-check"></i></div>
                        <span class="stat-badge">+24%</span>
                    </div>
                    <div class="stat-value">9,210</div>
                    <div class="stat-label">Total Bookings</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card-top">
                        <div class="stat-icon red"><i class="fa-solid fa-triangle-exclamation"></i></div>
                        <span class="stat-badge" style="background:#fee2e2;color:#dc2626;">3 new</span>
                    </div>
                    <div class="stat-value">7</div>
                    <div class="stat-label">Pending Approvals</div>
                </div>
            </div>

            <div class="section-title">Recent Users</div>
            <div class="table-card">
                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td>Louay Ouali</td>
                            <td>louay@example.com</td>
                            <td><span class="badge badge-blue">Voyageur</span></td>
                            <td><span class="badge badge-green">Active</span></td>
                        </tr>
                        <tr>
                            <td>2</td>
                            <td>Sara Ben Ali</td>
                            <td>sara@example.com</td>
                            <td><span class="badge badge-orange">Agent</span></td>
                            <td><span class="badge badge-orange">Pending</span></td>
                        </tr>
                        <tr>
                            <td>3</td>
                            <td>Mohamed Cherif</td>
                            <td>mohamed@example.com</td>
                            <td><span class="badge badge-blue">Voyageur</span></td>
                            <td><span class="badge badge-green">Active</span></td>
                        </tr>
                        <tr>
                            <td>4</td>
                            <td>Yasmine Triki</td>
                            <td>yasmine@example.com</td>
                            <td><span class="badge badge-orange">Agent</span></td>
                            <td><span class="badge badge-red">Blocked</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

<script>
    const ICONS = { auto: '🌗', light: '☀️', dark: '🌙' };
    function syncThemeNav() {
        const mode = localStorage.getItem('explora-theme') || 'auto';
        const icon = document.getElementById('theme-nav-icon');
        if (icon) icon.textContent = ICONS[mode];
        document.querySelectorAll('.theme-nav-option').forEach(el => {
            el.classList.toggle('active', el.dataset.mode === mode);
        });
    }
    function toggleThemeMenu(e) {
        e.preventDefault();
        const menu = document.getElementById('theme-nav-menu');
        menu.style.display = menu.style.display === 'flex' ? 'none' : 'flex';
    }
    function pickTheme(mode) {
        localStorage.setItem('explora-theme', mode);
        const h = new Date().getHours();
        const resolved = mode === 'auto' ? ((h >= 7 && h < 19) ? 'light' : 'dark') : mode;
        document.documentElement.setAttribute('data-theme', resolved);
        syncThemeNav();
        document.getElementById('theme-nav-menu').style.display = 'none';
    }
    document.addEventListener('DOMContentLoaded', syncThemeNav);
</script>
</body>
</html>
