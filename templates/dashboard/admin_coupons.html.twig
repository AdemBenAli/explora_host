<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Coupons - Explora Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="/css/theme.css">
    <script src="/js/theme.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        :root { --sidebar-bg:#1a2332; --bg-body:#f1f5f9; --bg-card:#ffffff; --text-heading:#0f172a; --text-body:#64748b; --border-color:#e2e8f0; }
        [data-theme="dark"] { --bg-body:#0F172A; --bg-card:#1E293B; --text-heading:#F1F5F9; --text-body:#94A3B8; --border-color:#334155; }
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family:'Inter',sans-serif; background:var(--bg-body); color:var(--text-body); display:flex; height:100vh; overflow:hidden; }
        .sidebar { width:260px; background:var(--sidebar-bg); color:white; display:flex; flex-direction:column; flex-shrink:0; }
        .sidebar-header { margin:16px; background:rgba(255,255,255,0.07); border-radius:12px; padding:14px 16px; display:flex; align-items:center; gap:12px; }
        .logo-box { background:#e53935; color:white; width:40px; height:40px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:18px; }
        .logo-text h2 { font-size:16px; font-weight:800; color:white; text-transform:uppercase; }
        .logo-text span { font-size:10px; text-transform:uppercase; color:rgba(255,255,255,0.45); }
        .sidebar-nav { flex:1; padding:8px 0; overflow-y:auto; }
        .nav-section-label { font-size:10px; text-transform:uppercase; letter-spacing:2px; color:rgba(255,255,255,0.3); font-weight:700; padding:20px 20px 8px; }
        .nav-divider { height:1px; background:rgba(255,255,255,0.08); margin:8px 20px 4px; }
        .nav-item { display:flex; align-items:center; gap:14px; padding:12px 20px; margin:2px 12px; color:rgba(255,255,255,0.65); text-decoration:none; font-size:14px; font-weight:500; transition:all 0.2s; border-radius:10px; }
        .nav-item i { font-size:16px; width:20px; text-align:center; }
        .nav-item:hover { background:rgba(255,255,255,0.06); color:white; }
        .nav-item.active { background:#e53935; color:white; font-weight:600; box-shadow:0 4px 12px rgba(229,57,53,0.4); }
        .nav-item.logout { color:#e53935; background:rgba(229,57,53,0.08); }
        .nav-item.logout:hover { background:rgba(229,57,53,0.18); }
        .sidebar-footer { padding:12px; border-top:1px solid rgba(255,255,255,0.06); }
        .theme-nav-option { background:none; border:none; color:rgba(255,255,255,0.65); font-size:13px; font-family:'Inter',sans-serif; padding:9px 20px; text-align:left; cursor:pointer; border-radius:6px; width:100%; }
        .theme-nav-option:hover { background:rgba(255,255,255,0.06); color:white; }
        .theme-nav-option.active { color:#e53935; font-weight:600; }
        .main-content { flex:1; display:flex; flex-direction:column; overflow:hidden; }
        .topbar { height:64px; background:var(--bg-card); border-bottom:1px solid var(--border-color); display:flex; align-items:center; justify-content:space-between; padding:0 28px; flex-shrink:0; }
        .topbar-left h1 { font-size:20px; font-weight:700; color:var(--text-heading); }
        .topbar-left p { font-size:12px; color:var(--text-body); margin-top:1px; }
        .topbar-right { display:flex; align-items:center; gap:16px; }
        .user-profile { display:flex; align-items:center; gap:10px; padding-left:16px; border-left:1px solid var(--border-color); }
        .user-avatar { width:36px; height:36px; border-radius:50%; }
        .user-name { font-weight:600; color:var(--text-heading); font-size:14px; }
        .user-role-label { font-size:11px; color:var(--text-body); }
        .content-area { flex:1; padding:24px 28px; overflow-y:auto; }

        /* Page header */
        .page-header { display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:20px; }
        .page-header-text h2 { font-size:20px; font-weight:700; color:var(--text-heading); }
        .page-header-text p { font-size:13px; color:var(--text-body); margin-top:2px; }
        .btn-create { background:#e53935; color:white; border:none; padding:10px 20px; border-radius:10px; font-size:14px; font-weight:600; cursor:pointer; font-family:'Inter',sans-serif; display:flex; align-items:center; gap:8px; transition:background 0.2s; }
        .btn-create:hover { background:#c62828; }

        /* Stats */
        .stats-row { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:20px; }
        .stat-card { background:var(--bg-card); border:1px solid var(--border-color); border-radius:14px; padding:16px 20px; display:flex; align-items:center; gap:14px; }
        .stat-icon { width:44px; height:44px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0; }
        .stat-icon.blue   { background:#eff6ff; color:#3b82f6; }
        .stat-icon.green  { background:#f0fdf4; color:#22c55e; }
        .stat-icon.red    { background:#fef2f2; color:#ef4444; }
        .stat-icon.yellow { background:#fffbeb; color:#f59e0b; }
        [data-theme="dark"] .stat-icon.blue   { background:rgba(59,130,246,0.15); }
        [data-theme="dark"] .stat-icon.green  { background:rgba(34,197,94,0.15); }
        [data-theme="dark"] .stat-icon.red    { background:rgba(239,68,68,0.15); }
        [data-theme="dark"] .stat-icon.yellow { background:rgba(245,158,11,0.15); }
        .stat-info label { font-size:12px; color:var(--text-body); display:block; }
        .stat-info strong { font-size:1.5rem; font-weight:700; color:var(--text-heading); line-height:1.1; }

        /* Toolbar */
        .toolbar { display:flex; gap:10px; margin-bottom:16px; }
        .search-wrap { flex:1; position:relative; }
        .search-wrap i { position:absolute; left:13px; top:50%; transform:translateY(-50%); color:var(--text-body); font-size:13px; }
        .search-input { width:100%; padding:9px 13px 9px 36px; border:1px solid var(--border-color); border-radius:10px; background:var(--bg-card); color:var(--text-heading); font-size:14px; font-family:'Inter',sans-serif; }
        .search-input:focus { outline:none; border-color:#e53935; }
        .search-input::placeholder { color:var(--text-body); }
        .filter-select { padding:9px 14px; border:1px solid var(--border-color); border-radius:10px; background:var(--bg-card); color:var(--text-heading); font-size:14px; font-family:'Inter',sans-serif; cursor:pointer; min-width:150px; }
        .filter-select:focus { outline:none; border-color:#e53935; }

        /* Table */
        .table-card { background:var(--bg-card); border:1px solid var(--border-color); border-radius:14px; overflow:hidden; }
        .table-wrap { overflow-x:auto; }
        table { width:100%; border-collapse:collapse; }
        thead th { padding:11px 16px; font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.5px; color:var(--text-body); background:var(--bg-body); text-align:left; white-space:nowrap; }
        tbody tr { border-top:1px solid var(--border-color); transition:background 0.15s; }
        tbody tr:hover { background:var(--bg-body); }
        tbody td { padding:13px 16px; font-size:13px; color:var(--text-heading); vertical-align:middle; }
        .code-cell { font-family:monospace; font-weight:700; font-size:13px; color:var(--text-heading); }
        .badge-active   { display:inline-flex; align-items:center; gap:4px; padding:3px 10px; border-radius:20px; font-size:11px; font-weight:600; background:#f0fdf4; color:#16a34a; }
        .badge-inactive { display:inline-flex; align-items:center; gap:4px; padding:3px 10px; border-radius:20px; font-size:11px; font-weight:600; background:#fef2f2; color:#dc2626; }
        .badge-expired  { display:inline-flex; align-items:center; gap:4px; padding:3px 10px; border-radius:20px; font-size:11px; font-weight:600; background:#f1f5f9; color:#64748b; }
        [data-theme="dark"] .badge-active   { background:rgba(22,163,74,0.15); }
        [data-theme="dark"] .badge-inactive { background:rgba(220,38,38,0.15); }
        [data-theme="dark"] .badge-expired  { background:rgba(100,116,139,0.15); }
        .action-btns { display:flex; gap:6px; }
        .act-btn { width:32px; height:32px; border:none; border-radius:8px; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:13px; transition:all 0.2s; }
        .act-btn.assign { background:#dbeafe; color:#2563eb; }
        .act-btn.assign:hover { background:#2563eb; color:white; }
        .act-btn.toggle { background:#fef9c3; color:#ca8a04; }
        .act-btn.toggle:hover { background:#ca8a04; color:white; }
        .act-btn.del { background:#fee2e2; color:#dc2626; }
        .act-btn.del:hover { background:#dc2626; color:white; }
        [data-theme="dark"] .act-btn.assign { background:rgba(37,99,235,0.15); }
        [data-theme="dark"] .act-btn.toggle { background:rgba(202,138,4,0.15); }
        [data-theme="dark"] .act-btn.del    { background:rgba(220,38,38,0.15); }
        .empty-row td { text-align:center; padding:48px; color:var(--text-body); }

        /* Modal */
        .modal-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.45); z-index:1000; align-items:center; justify-content:center; }
        .modal-overlay.open { display:flex; }
        .modal { background:var(--bg-card); border-radius:16px; width:100%; max-width:480px; box-shadow:0 24px 60px rgba(0,0,0,0.2); overflow:hidden; }
        .modal-header { padding:18px 22px; border-bottom:1px solid var(--border-color); display:flex; align-items:center; justify-content:space-between; }
        .modal-header h3 { font-size:15px; font-weight:700; color:var(--text-heading); display:flex; align-items:center; gap:8px; }
        .modal-close { background:none; border:none; font-size:1.1rem; cursor:pointer; color:var(--text-body); padding:4px 8px; border-radius:6px; }
        .modal-close:hover { background:var(--bg-body); }
        .modal-body { padding:22px; }
        .modal-note { font-size:12px; color:var(--text-body); margin-bottom:18px; }
        .mfg { margin-bottom:14px; }
        .mfg label { display:block; font-size:12px; font-weight:600; color:var(--text-heading); margin-bottom:4px; }
        .mfg input, .mfg select { width:100%; padding:9px 12px; border:1.5px solid var(--border-color); border-radius:9px; font-size:13px; color:var(--text-heading); background:var(--bg-card); font-family:'Inter',sans-serif; }
        .mfg input:focus, .mfg select:focus { outline:none; border-color:#e53935; }
        .mfg-row { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
        .mfg-hint { font-size:11px; color:var(--text-body); margin-top:3px; }
        .checkbox-row { display:flex; align-items:center; gap:8px; font-size:13px; color:var(--text-heading); margin-bottom:14px; }
        .checkbox-row input { width:16px; height:16px; accent-color:#e53935; }
        .modal-footer { padding:16px 22px; border-top:1px solid var(--border-color); display:flex; justify-content:flex-end; gap:10px; }
        .btn-cancel { padding:9px 20px; background:var(--bg-body); border:1px solid var(--border-color); border-radius:9px; font-size:13px; font-weight:600; cursor:pointer; font-family:'Inter',sans-serif; color:var(--text-heading); }
        .btn-generate { padding:9px 22px; background:#e53935; border:none; border-radius:9px; font-size:13px; font-weight:600; cursor:pointer; font-family:'Inter',sans-serif; color:white; }
        .btn-generate:hover { background:#c62828; }
    </style>
</head>
<body>

<aside class="sidebar">
    <div class="sidebar-header">
        <div class="logo-box"><i class="fa-solid fa-shield-halved"></i></div>
        <div class="logo-text"><h2>Explora</h2><span>Admin Panel</span></div>
    </div>
    <nav class="sidebar-nav">
        <div class="nav-section-label">Main</div>
        <a href="{{ path('app_admin_dashboard') }}" class="nav-item"><i class="fa-solid fa-gauge-high"></i> Dashboard</a>
        <a href="{{ path('app_admin_users') }}" class="nav-item"><i class="fa-solid fa-users"></i> User Management</a>
        <a href="{{ path('app_admin_partnerships') }}" class="nav-item"><i class="fa-solid fa-handshake"></i> Partnerships</a>
        <div class="nav-divider"></div>
        <div class="nav-section-label">Management</div>
        <a href="#" class="nav-item"><i class="fa-solid fa-user-tie"></i> Agents</a>
        <a href="#" class="nav-item"><i class="fa-solid fa-circle-exclamation"></i> Complaints</a>
        <a href="{{ path('app_admin_coupons') }}" class="nav-item active"><i class="fa-solid fa-tag"></i> Coupons</a>
    </nav>
    <div class="sidebar-footer">
        <a href="#" class="nav-item" id="theme-nav-btn" onclick="toggleThemeMenu(event)">
            <i class="fa-solid fa-circle-half-stroke"></i> Theme
            <span id="theme-nav-icon" style="margin-left:auto;font-size:1rem;"></span>
        </a>
        <div id="theme-nav-menu" style="display:none;flex-direction:column;background:rgba(255,255,255,0.04);border-radius:8px;margin:0 12px 4px;">
            <button class="theme-nav-option" data-mode="light" onclick="pickTheme('light')">☀️ Light</button>
            <button class="theme-nav-option" data-mode="dark"  onclick="pickTheme('dark')">🌙 Dark</button>
            <button class="theme-nav-option" data-mode="auto"  onclick="pickTheme('auto')">🌗 Auto</button>
        </div>
        <a href="{{ path('app_logout') }}" class="nav-item logout"><i class="fa-solid fa-arrow-right-from-bracket"></i> Logout</a>
    </div>
</aside>

<main class="main-content">
    <header class="topbar">
        <div class="topbar-left">
            <h1>Coupons</h1>
            <p>Welcome back, Administrator</p>
        </div>
        <div class="topbar-right">
            <div class="user-profile">
                <img src="https://ui-avatars.com/api/?name=Admin&background=e53935&color=fff" class="user-avatar" alt="Admin">
                <div><div class="user-name">System Admin</div><div class="user-role-label">Administrator</div></div>
            </div>
        </div>
    </header>

    <div class="content-area">
        <div class="page-header">
            <div class="page-header-text">
                <h2>Coupon Management</h2>
                <p>Create and manage discount coupons for clients</p>
            </div>
            <button class="btn-create" onclick="document.getElementById('create-modal').classList.add('open')">
                <i class="fa-solid fa-plus"></i> Create Coupon
            </button>
        </div>

        <!-- Stats -->
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon blue"><i class="fa-solid fa-ticket"></i></div>
                <div class="stat-info"><label>Total Coupons</label><strong>{{ total }}</strong></div>
            </div>
            <div class="stat-card">
                <div class="stat-icon green"><i class="fa-solid fa-circle-check"></i></div>
                <div class="stat-info"><label>Active</label><strong>{{ active }}</strong></div>
            </div>
            <div class="stat-card">
                <div class="stat-icon red"><i class="fa-regular fa-clock"></i></div>
                <div class="stat-info"><label>Expired</label><strong>{{ expired }}</strong></div>
            </div>
            <div class="stat-card">
                <div class="stat-icon yellow"><i class="fa-solid fa-user-tag"></i></div>
                <div class="stat-info"><label>Assigned</label><strong>{{ assigned }}</strong></div>
            </div>
        </div>

        <!-- Toolbar -->
        <form method="GET" action="{{ path('app_admin_coupons') }}" id="filter-form">
            <div class="toolbar">
                <div class="search-wrap">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" name="search" id="search-input" class="search-input"
                           placeholder="Search by code or type..." value="{{ search }}" autocomplete="off">
                </div>
                <select name="filter" class="filter-select" id="filter-select">
                    <option value="">All Coupons</option>
                    <option value="active"   {{ filter == 'active'   ? 'selected' : '' }}>Active</option>
                    <option value="expired"  {{ filter == 'expired'  ? 'selected' : '' }}>Expired</option>
                    <option value="assigned" {{ filter == 'assigned' ? 'selected' : '' }}>Assigned</option>
                </select>
            </div>
        </form>

        <!-- Table -->
        <div class="table-card">
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Type</th>
                            <th>Discount</th>
                            <th>Expiration</th>
                            <th>Status</th>
                            <th>Assigned To</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for coupon in coupons %}
                        {% set now = "now"|date("U") %}
                        {% set exp = coupon.dateExpiration ? coupon.dateExpiration|date("U") : 0 %}
                        {% set isExpired = exp < now %}
                        <tr data-row data-code="{{ coupon.code|lower }}" data-type="{{ coupon.type|lower }}">
                            <td><span class="code-cell">{{ coupon.code }}</span></td>
                            <td>{{ coupon.type ?? 'REDUCTION_POURCENTAGE' }}</td>
                            <td>{{ coupon.valeurReduction }}%</td>
                            <td>{{ coupon.dateExpiration ? coupon.dateExpiration|date('d/m/Y') : '-' }}</td>
                            <td>
                                {% if isExpired %}
                                    <span class="badge-expired"><i class="fa-regular fa-clock"></i> Expired</span>
                                {% elseif coupon.actif == 'oui' %}
                                    <span class="badge-active"><i class="fa-solid fa-circle" style="font-size:7px;"></i> Active</span>
                                {% else %}
                                    <span class="badge-inactive"><i class="fa-solid fa-circle" style="font-size:7px;"></i> Inactive</span>
                                {% endif %}
                            </td>
                            <td>{{ coupon.clientId and coupon.clientId > 0 and users[coupon.clientId] is defined ? users[coupon.clientId] : 'Unassigned' }}</td>
                            <td>
                                <div class="action-btns">
                                    <button class="act-btn assign" title="Assign"><i class="fa-solid fa-user-plus"></i></button>
                                    <form method="POST" action="{{ path('app_admin_coupon_toggle', {id: coupon.id}) }}" style="display:inline;">
                                        <button class="act-btn toggle" type="submit" title="Toggle"><i class="fa-solid fa-power-off"></i></button>
                                    </form>
                                    <form method="POST" action="{{ path('app_admin_coupon_delete', {id: coupon.id}) }}" style="display:inline;" onsubmit="return confirm('Delete this coupon?')">
                                        <button class="act-btn del" type="submit" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr><td colspan="7" class="empty-row" style="text-align:center;padding:48px;color:var(--text-body);">No coupons found.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>

<!-- Create Coupon Modal -->
<div class="modal-overlay" id="create-modal" onclick="if(event.target===this)this.classList.remove('open')">
    <div class="modal">
        <div class="modal-header">
            <h3><i class="fa-solid fa-ticket" style="color:#e53935;"></i> Create Coupons</h3>
            <button class="modal-close" onclick="document.getElementById('create-modal').classList.remove('open')">✕</button>
        </div>
        <form method="POST" action="{{ path('app_admin_coupons') }}">
            <div class="modal-body">
                <p class="modal-note">Generate one or multiple coupons</p>
                <div class="mfg-row">
                    <div class="mfg">
                        <label>Quantity</label>
                        <input type="number" name="quantity" value="1" min="1" max="100">
                    </div>
                    <div class="mfg">
                        <label>Code Prefix</label>
                        <input type="text" name="prefix" value="COUP" maxlength="8">
                    </div>
                </div>
                <div class="mfg">
                    <label>Type</label>
                    <select name="type">
                        <option value="REDUCTION_POURCENTAGE">REDUCTION_POURCENTAGE</option>
                        <option value="REDUCTION_MONTANT">REDUCTION_MONTANT</option>
                    </select>
                </div>
                <div class="mfg-row">
                    <div class="mfg">
                        <label>Discount (%)</label>
                        <input type="number" name="discount" value="10.0" min="1" max="100" step="0.1">
                        <span class="mfg-hint">1% - 100%</span>
                    </div>
                    <div class="mfg">
                        <label>Minimum Order</label>
                        <input type="number" name="min_order" value="0" min="0" step="0.01">
                        <span class="mfg-hint">optional</span>
                    </div>
                </div>
                <div class="mfg">
                    <label>Expiration Date</label>
                    <input type="date" name="expiration" value="{{ defaultExpiry }}">
                </div>
                <div class="checkbox-row">
                    <input type="checkbox" name="actif" id="actif-check" checked>
                    <label for="actif-check">Active (ready to use)</label>
                </div>
                <p class="modal-note">Note: Codes will be auto-generated with format: PREFIX + 6-digit number</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel" onclick="document.getElementById('create-modal').classList.remove('open')">Annuler</button>
                <button type="submit" class="btn-generate"><i class="fa-solid fa-bolt"></i> Generate</button>
            </div>
        </form>
    </div>
</div>

<script>
    // Live search
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('search-input');
        const filterSelect = document.getElementById('filter-select');
        const form = document.getElementById('filter-form');

        searchInput.addEventListener('input', function() {
            clearTimeout(this._t);
            this._t = setTimeout(() => form.submit(), 400);
        });
        filterSelect.addEventListener('change', () => form.submit());
    });

    const ICONS = { auto:'🌗', light:'☀️', dark:'🌙' };
    function syncThemeNav() {
        const mode = localStorage.getItem('explora-theme') || 'auto';
        const icon = document.getElementById('theme-nav-icon');
        if (icon) icon.textContent = ICONS[mode];
        document.querySelectorAll('.theme-nav-option').forEach(el => el.classList.toggle('active', el.dataset.mode === mode));
    }
    function toggleThemeMenu(e) {
        e.preventDefault();
        const m = document.getElementById('theme-nav-menu');
        m.style.display = m.style.display === 'flex' ? 'none' : 'flex';
    }
    function pickTheme(mode) {
        localStorage.setItem('explora-theme', mode);
        const h = new Date().getHours();
        document.documentElement.setAttribute('data-theme', mode === 'auto' ? (h >= 7 && h < 19 ? 'light' : 'dark') : mode);
        syncThemeNav();
        document.getElementById('theme-nav-menu').style.display = 'none';
    }
    document.addEventListener('DOMContentLoaded', syncThemeNav);
</script>
</body>
</html>
