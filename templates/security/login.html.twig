<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Login - Explora</title>
		<!-- Use FontAwesome for icons -->
		<link
		rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
		<style>
			@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Outfit:wght@500;600;700&display=swap');

			:root {
				--primary: #3b82f6;
				--primary-hover: #2563eb;
				--primary-orange: #f97316;
				--secondary: #f97316;
				--bg-color: #f1f5f9;
				--card-bg: #ffffff;
				--text-main: #0f172a;
				--text-muted: #64748b;
				--border: #e2e8f0;
			}

			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			body {
				font-family: 'Inter', sans-serif;
				background: linear-gradient(135deg, #e0e7ff 0%, #ede9fe 100%);
				display: flex;
				align-items: center;
				justify-content: center;
				min-height: 100vh;
				color: var(--text-main);
			}

			.login-wrapper {
				display: flex;
				width: 100%;
				max-width: 1100px;
				background: var(--card-bg);
				border-radius: 24px;
				box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
				overflow: hidden;
				margin: 20px;
				animation: fadeIn 0.6s ease-out;
			}

			@keyframes fadeIn {
				from { opacity: 0; transform: translateY(20px); }
				to { opacity: 1; transform: translateY(0); }
			}

			.login-left {
				flex: 1;
				background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
				color: white;
				padding: 3rem;
				display: flex;
				flex-direction: column;
				position: relative;
				overflow: hidden;
			}

			.login-left::before {
				content: '';
				position: absolute;
				top: -50%;
				left: -50%;
				width: 200%;
				height: 200%;
				background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 60%);
				transform: rotate(30deg);
				pointer-events: none;
			}

			.logo-container {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 4rem;
				animation: slideDown 0.6s ease-out 0.2s both;
			}

			@keyframes slideDown {
				from { opacity: 0; transform: translateY(-20px); }
				to { opacity: 1; transform: translateY(0); }
			}

			.logo-text {
				font-family: 'Outfit', sans-serif;
				font-size: 1.75rem;
				font-weight: 700;
				letter-spacing: -0.025em;
			}

			.welcome-heading {
				font-family: 'Outfit', sans-serif;
				font-size: 3.5rem;
				font-weight: 700;
				line-height: 1.1;
				margin-bottom: 1rem;
				animation: fadeRight 0.6s ease-out 0.3s both;
			}

			@keyframes fadeRight {
				from { opacity: 0; transform: translateX(-20px); }
				to { opacity: 1; transform: translateX(0); }
			}

			.welcome-sub {
				font-size: 1.125rem;
				color: rgba(255, 255, 255, 0.9);
				margin-bottom: 3rem;
				animation: fadeRight 0.6s ease-out 0.4s both;
			}

			.features-list {
				list-style: none;
				margin-bottom: auto;
				animation: fadeRight 0.6s ease-out 0.5s both;
			}

			.features-list li {
				display: flex;
				align-items: center;
				gap: 1rem;
				margin-bottom: 1.2rem;
				font-size: 1.05rem;
				font-weight: 500;
			}

			.check-icon {
				background: rgba(255, 255, 255, 0.2);
				padding: 0.5rem;
				border-radius: 50%;
				font-size: 0.875rem;
				color: #fff;
			}

			.stats-container {
				display: flex;
				gap: 2.5rem;
				margin-top: 3rem;
				padding-top: 2rem;
				border-top: 1px solid rgba(255, 255, 255, 0.2);
				animation: fadeUp 0.6s ease-out 0.6s both;
			}

			@keyframes fadeUp {
				from { opacity: 0; transform: translateY(20px); }
				to { opacity: 1; transform: translateY(0); }
			}

			.stat-item {
				display: flex;
				flex-direction: column;
			}

			.stat-number {
				font-family: 'Outfit', sans-serif;
				font-size: 1.75rem;
				font-weight: 700;
			}

			.stat-label {
				font-size: 0.875rem;
				color: rgba(255, 255, 255, 0.8);
				font-weight: 500;
				margin-top: 0.25rem;
			}

			.login-right {
				flex: 1;
				padding: 4rem;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}

			.login-header h2 {
				font-family: 'Outfit', sans-serif;
				font-size: 2.5rem;
				font-weight: 700;
				margin-bottom: 0.5rem;
				color: var(--text-main);
				animation: fadeDown 0.5s ease-out 0.2s both;
			}

			@keyframes fadeDown {
				from { opacity: 0; transform: translateY(-10px); }
				to { opacity: 1; transform: translateY(0); }
			}

			.login-header p {
				color: var(--text-muted);
				margin-bottom: 2.5rem;
				font-size: 1.05rem;
				animation: fadeDown 0.5s ease-out 0.3s both;
			}

			form {
				animation: fadeIn 0.8s ease-out 0.4s both;
			}

			.form-group {
				margin-bottom: 1.5rem;
			}

			.form-group label {
				display: block;
				font-size: 0.9rem;
				font-weight: 600;
				margin-bottom: 0.5rem;
				color: var(--text-main);
			}

			.input-wrapper {
				position: relative;
			}

			.form-control {
				width: 100%;
				padding: 0.875rem 1rem;
				border: 1px solid var(--border);
				border-radius: 12px;
				font-size: 1rem;
				font-family: inherit;
				transition: all 0.2s ease;
				background: #f8fafc;
				color: var(--text-main);
			}

			.form-control::placeholder {
				color: #94a3b8;
			}

			.form-control:focus {
				outline: none;
				border-color: var(--primary);
				box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15);
				background: white;
			}

			.input-icon-right {
				position: absolute;
				right: 1.25rem;
				top: 50%;
				transform: translateY(-50%);
				color: #94a3b8;
				cursor: pointer;
				transition: color 0.2s;
			}

			.input-icon-right:hover {
				color: var(--text-main);
			}

			.form-options {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 2rem;
				font-size: 0.9rem;
			}

			.remember-me {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				cursor: pointer;
				color: var(--text-muted);
				font-weight: 500;
			}

			.remember-me input {
				width: 1.1rem;
				height: 1.1rem;
				accent-color: var(--primary);
				cursor: pointer;
			}

			.forgot-pw {
				color: var(--primary);
				text-decoration: none;
				font-weight: 600;
				transition: color 0.2s;
			}

			.forgot-pw:hover {
				color: var(--primary-hover);
			}

			.btn-primary {
				width: 100%;
				padding: 1rem;
				background: var(--primary);
				color: white;
				border: none;
				border-radius: 12px;
				font-size: 1.05rem;
				font-weight: 600;
				font-family: 'Outfit', sans-serif;
				cursor: pointer;
				transition: all 0.2s ease;
				box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.3);
			}

			.btn-primary:hover {
				background: var(--primary-hover);
				transform: translateY(-2px);
				box-shadow: 0 8px 12px -1px rgba(59, 130, 246, 0.4);
			}

			.btn-primary:active {
				transform: translateY(1px);
			}

			.divider {
				text-align: center;
				color: #94a3b8;
				font-size: 0.875rem;
				margin: 2rem 0;
				position: relative;
				font-weight: 500;
			}

			.divider::before,
			.divider::after {
				content: '';
				position: absolute;
				top: 50%;
				width: calc(50% - 70px);
				height: 1px;
				background: var(--border);
			}

			.divider::before { left: 0; }
			.divider::after { right: 0; }

			.social-login {
				display: flex;
				gap: 1rem;
				margin-bottom: 2rem;
			}

			.btn-social {
				flex: 1;
				padding: 0.75rem;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.75rem;
				background: white;
				border: 1px solid var(--border);
				border-radius: 12px;
				font-size: 1rem;
				font-weight: 600;
				cursor: pointer;
				transition: all 0.2s ease;
				color: var(--text-main);
			}

			.btn-social:hover {
				background: #f8fafc;
				border-color: #cbd5e1;
				transform: translateY(-1px);
			}

			.signup-link {
				text-align: center;
				font-size: 0.95rem;
				color: var(--text-muted);
			}

			.signup-link a {
				color: var(--primary);
				text-decoration: none;
				font-weight: 600;
				margin-left: 0.25rem;
			}

			.signup-link a:hover {
				text-decoration: underline;
			}

			@media (max-width: 900px) {
				.login-wrapper {
					flex-direction: column;
					margin: 1rem;
				}
				.login-left {
					display: none;
				}
				.login-right {
					padding: 2.5rem;
				}
			}
		</style>
	</head>
	<body>

		<div
			class="login-wrapper">
			<!-- Left Side: Branding and Info -->
			<div class="login-left">
				<div
					class="logo-container">
					<!-- Using a stacked icon approach for a globe/compass look -->
					<span class="fa-stack fa-lg">
						<i class="fa-solid fa-earth-americas fa-stack-1x" style="color: #60A5FA;"></i>
						<i class="fa-solid fa-location-arrow fa-stack-1x fa-inverse" style="transform: rotate(45deg); font-size: 0.8em; color: var(--primary-orange); margin-top: -2px; margin-left: -2px;"></i>
					</span>
					<span class="logo-text">Explora</span>
				</div>

				<h1 class="welcome-heading">Welcome to Explora</h1>
				<p class="welcome-sub">Discover the world's most beautiful destinations</p>

				<ul class="features-list">
					<li>
						<i class="fa-solid fa-check check-icon"></i>
						Exclusive travel deals</li>
					<li>
						<i class="fa-solid fa-check check-icon"></i>
						24/7 customer support</li>
					<li>
						<i class="fa-solid fa-check check-icon"></i>
						Secure booking guarantee</li>
				</ul>

				<div class="stats-container">
					<div class="stat-item">
						<span class="stat-number">500+</span>
						<span class="stat-label">Destinations</span>
					</div>
					<div class="stat-item">
						<span class="stat-number">10K+</span>
						<span class="stat-label">Happy Travelers</span>
					</div>
					<div class="stat-item">
						<span class="stat-number">4.9</span>
						<span class="stat-label">User Rating</span>
					</div>
				</div>
			</div>

			<!-- Right Side: Login Form -->
			<div class="login-right">
				<div class="login-header">
					<h2>Sign In</h2>
					<p>Welcome back! Please enter your details</p>
				</div>

				<form action="{{ path('app_login') }}" method="POST">
					{% if error %}
					<div style="background:#fee2e2; border:1px solid #fca5a5; color:#991b1b; border-radius:10px; padding:0.85rem 1.1rem; margin-bottom:1.25rem; font-size:0.9rem; display:flex; align-items:center; gap:0.6rem;">
						<i class="fa-solid fa-circle-exclamation"></i>
						{{ error }}
					</div>
					{% endif %}
					<div class="form-group">
						<label for="email">Email</label>
						<div class="input-wrapper">
							<input type="email" id="email" name="email" class="form-control" placeholder="Enter your email" required>
						</div>
					</div>

					<div class="form-group">
						<label for="password">Password</label>
						<div class="input-wrapper">
							<input type="password" id="password" name="password" class="form-control" placeholder="Enter your password" required>
							<i class="fa-regular fa-eye input-icon-right" id="togglePassword"></i>
						</div>
					</div>

					<div class="form-options">
						<label class="remember-me">
							<input type="checkbox" name="_remember_me">
							Remember me
						</label>
						<a href="{{ path('app_forgot_password') }}" class="forgot-pw">Forgot password?</a>
					</div>

					<button type="submit" class="btn-primary">Sign In</button>

					<div class="divider">or continue w...</div>

					<div class="social-login">
						<button
							type="button" class="btn-social">
							<!-- Generic G for Google but colored -->
							<span style="font-weight: 600; color: #DB4437; font-family: sans-serif;">G</span>
							Google
						</button>
						<button type="button" class="btn-social">
							<i class="fa-brands fa-facebook-f" style="color: #4267B2;"></i>
							Facebook
						</button>
					</div>

					<div class="signup-link">
						Don't have an account?
						<a href="{{ path('app_signup') }}">Sign up for free</a>
					</div>
				</form>
			</div>
		</div>

		<!-- Optional: JS for the password toggle icon -->
		<script>
			const togglePassword = document.querySelector('#togglePassword');
			const password = document.querySelector('#password');

			togglePassword.addEventListener('click', function () {
				const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
				password.setAttribute('type', type);
				this.classList.toggle('fa-eye-slash');
			});

			// Live validation
			const emailInput = document.getElementById('email');
			const submitBtn  = document.querySelector('.btn-primary');

			function validateEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v); }

			function setFieldState(input, valid, msg) {
				input.style.borderColor = valid ? '#22c55e' : (input.value ? '#ef4444' : '');
				input.style.boxShadow   = valid
					? '0 0 0 4px rgba(34,197,94,0.12)'
					: (input.value ? '0 0 0 4px rgba(239,68,68,0.12)' : '');
				let hint = input.parentElement.querySelector('.field-hint');
				if (!hint) {
					hint = document.createElement('span');
					hint.className = 'field-hint';
					hint.style.cssText = 'font-size:0.75rem;margin-top:4px;display:block;';
					input.parentElement.appendChild(hint);
				}
				hint.textContent = input.value ? msg : '';
				hint.style.color = valid ? '#16a34a' : '#dc2626';
			}

			function checkForm() {
				const eOk = validateEmail(emailInput.value);
				const pOk = password.value.length >= 1;
				submitBtn.disabled = !(eOk && pOk);
				submitBtn.style.opacity = submitBtn.disabled ? '0.6' : '1';
			}

			emailInput.addEventListener('input', () => {
				const ok = validateEmail(emailInput.value);
				setFieldState(emailInput, ok, ok ? '✓ Valid email' : 'Enter a valid email address');
				checkForm();
			});

			password.addEventListener('input', () => {
				const ok = password.value.length >= 1;
				setFieldState(password, ok, ok ? '✓ Looks good' : 'Password is required');
				checkForm();
			});

			checkForm();
		</script>
	</body>
</html>
