<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Password - Explora</title>
    <link rel="stylesheet" href="/css/theme.css">
    <script src="/js/theme.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700&display=swap');
        :root { --primary:#1e5faf; --bg:#F1F5F9; --card:#fff; --text:#1E293B; --muted:#94A3B8; --border:#E2E8F0; }
        [data-theme="dark"] { --bg:#0F172A; --card:#1E293B; --text:#F1F5F9; --muted:#94A3B8; --border:#334155; }
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family:'Inter',sans-serif; background:var(--bg); min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px; color:var(--text); }
        .card { background:var(--card); border-radius:20px; padding:40px 44px; max-width:440px; width:100%; box-shadow:0 20px 50px rgba(0,0,0,0.1); text-align:center; }
        .icon-wrap { width:68px; height:68px; background:#f0fdf4; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 20px; font-size:1.8rem; color:#16a34a; }
        h1 { font-family:'Outfit',sans-serif; font-size:1.5rem; font-weight:700; color:var(--text); margin-bottom:8px; }
        p { font-size:13px; color:var(--muted); margin-bottom:24px; }
        .err { background:#fef2f2; color:#dc2626; border:1px solid #fecaca; border-radius:9px; padding:10px 14px; font-size:13px; margin-bottom:16px; text-align:left; }
        .fg { margin-bottom:14px; text-align:left; position:relative; }
        .fg label { display:block; font-size:12px; font-weight:600; color:var(--text); margin-bottom:4px; }
        .fg input { width:100%; padding:10px 40px 10px 14px; border:1.5px solid var(--border); border-radius:9px; font-size:14px; color:var(--text); background:var(--card); font-family:'Inter',sans-serif; }
        .fg input:focus { outline:none; border-color:var(--primary); }
        .toggle { position:absolute; right:12px; top:30px; background:none; border:none; cursor:pointer; color:var(--muted); font-size:14px; }
        .hint { font-size:0.7rem; margin-top:3px; display:block; }
        .btn { width:100%; padding:12px; background:#16a34a; color:white; border:none; border-radius:10px; font-size:14px; font-weight:600; cursor:pointer; font-family:'Inter',sans-serif; margin-top:8px; }
        .btn:hover { background:#15803d; }
    </style>
</head>
<body>
<div class="card">
    <div class="icon-wrap">🔒</div>
    <h1>Set New Password</h1>
    <p>Choose a strong password for your account.</p>
    {% if error %}<div class="err">{{ error }}</div>{% endif %}
    <form method="POST" action="{{ path('app_reset_new_password') }}">
        <div class="fg">
            <label>New Password</label>
            <input type="password" name="password" id="pw1" placeholder="Min 6 characters" required>
            <button type="button" class="toggle" onclick="togglePw('pw1',this)">👁</button>
            <span class="hint" id="h1"></span>
        </div>
        <div class="fg">
            <label>Confirm Password</label>
            <input type="password" name="confirm" id="pw2" placeholder="Re-enter password" required>
            <button type="button" class="toggle" onclick="togglePw('pw2',this)">👁</button>
            <span class="hint" id="h2"></span>
        </div>
        <button type="submit" class="btn">Update Password</button>
    </form>
</div>
<script>
    function togglePw(id, btn) {
        var el = document.getElementById(id);
        el.type = el.type === 'password' ? 'text' : 'password';
    }
    var pw1 = document.getElementById('pw1');
    var pw2 = document.getElementById('pw2');
    var touched2 = false;
    pw1.addEventListener('input', function() {
        var ok = this.value.length >= 6;
        this.style.borderColor = this.value ? (ok ? '#22c55e' : '#ef4444') : '';
        document.getElementById('h1').textContent = this.value ? (ok ? '✓ Strong enough' : 'Min 6 characters') : '';
        document.getElementById('h1').style.color = ok ? '#16a34a' : '#dc2626';
        if (touched2) checkConfirm();
    });
    pw2.addEventListener('input', function() {
        touched2 = true;
        checkConfirm();
    });
    function checkConfirm() {
        var match = pw2.value === pw1.value && pw2.value.length >= 6;
        pw2.style.borderColor = pw2.value ? (match ? '#22c55e' : '#ef4444') : '';
        document.getElementById('h2').textContent = pw2.value ? (match ? '✓ Passwords match' : 'Passwords do not match') : '';
        document.getElementById('h2').style.color = match ? '#16a34a' : '#dc2626';
    }
</script>
</body>
</html>
