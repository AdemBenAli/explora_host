<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Code - Explora</title>
    <link rel="stylesheet" href="/css/theme.css">
    <script src="/js/theme.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700&display=swap');
        :root { --primary:#1e5faf; --orange:#F39C12; --bg:#F1F5F9; --card:#fff; --text:#1E293B; --muted:#94A3B8; --border:#E2E8F0; }
        [data-theme="dark"] { --bg:#0F172A; --card:#1E293B; --text:#F1F5F9; --muted:#94A3B8; --border:#334155; }
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family:'Inter',sans-serif; background:var(--bg); min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px; color:var(--text); }
        .card { background:var(--card); border-radius:20px; padding:40px 44px; max-width:460px; width:100%; box-shadow:0 20px 50px rgba(0,0,0,0.1); text-align:center; }
        .icon-wrap { width:68px; height:68px; background:#eff6ff; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 20px; font-size:1.8rem; color:var(--primary); }
        h1 { font-family:'Outfit',sans-serif; font-size:1.5rem; font-weight:700; color:var(--text); margin-bottom:8px; }
        .subtitle { font-size:13px; color:var(--muted); margin-bottom:6px; }
        .email-badge { display:inline-block; background:#eff6ff; color:var(--primary); border-radius:20px; padding:4px 14px; font-size:13px; font-weight:600; margin-bottom:24px; }
        .err { background:#fef2f2; color:#dc2626; border:1px solid #fecaca; border-radius:9px; padding:10px 14px; font-size:13px; margin-bottom:16px; text-align:left; }
        .code-inputs { display:flex; gap:10px; justify-content:center; margin-bottom:24px; }
        .code-inputs input { width:52px; height:60px; border:2px solid var(--border); border-radius:12px; text-align:center; font-size:1.6rem; font-weight:700; color:var(--text); background:var(--card); font-family:'Outfit',sans-serif; outline:none; transition:border-color .2s; }
        .code-inputs input:focus { border-color:var(--primary); box-shadow:0 0 0 3px rgba(30,95,175,0.12); }
        .code-inputs input.filled { border-color:var(--primary); }
        .btn { width:100%; padding:12px; background:var(--primary); color:white; border:none; border-radius:10px; font-size:14px; font-weight:600; cursor:pointer; font-family:'Inter',sans-serif; margin-bottom:14px; }
        .btn:disabled { opacity:0.5; cursor:not-allowed; }
        .back { font-size:13px; color:var(--muted); text-decoration:none; }
        .back:hover { color:var(--text); }
    </style>
</head>
<body>
<div class="card">
    <div class="icon-wrap">📧</div>
    <h1>Enter the code</h1>
    <p class="subtitle">We sent a 6-digit code to</p>
    <span class="email-badge">{{ email }}</span>
    {% if error %}<div class="err">{{ error }}</div>{% endif %}
    <form method="POST" action="{{ path('app_reset_verify') }}" id="vform">
        <div class="code-inputs">
            <input type="text" maxlength="1" class="digit-input" inputmode="numeric" autocomplete="off">
            <input type="text" maxlength="1" class="digit-input" inputmode="numeric" autocomplete="off">
            <input type="text" maxlength="1" class="digit-input" inputmode="numeric" autocomplete="off">
            <input type="text" maxlength="1" class="digit-input" inputmode="numeric" autocomplete="off">
            <input type="text" maxlength="1" class="digit-input" inputmode="numeric" autocomplete="off">
            <input type="text" maxlength="1" class="digit-input" inputmode="numeric" autocomplete="off">
        </div>
        <input type="hidden" name="code" id="full-code">
        <button type="submit" class="btn" id="btn-v" disabled>Verify Code</button>
    </form>
    <a href="{{ path('app_forgot_password') }}" class="back">← Try a different email</a>
</div>
<script>
    const inputs = document.querySelectorAll('.digit-input');
    const fc = document.getElementById('full-code');
    const btn = document.getElementById('btn-v');
    inputs.forEach((inp, i) => {
        inp.addEventListener('input', () => {
            inp.value = inp.value.replace(/\D/g,'');
            if (inp.value && i < 5) inputs[i+1].focus();
            inp.classList.toggle('filled', !!inp.value);
            fc.value = Array.from(inputs).map(x=>x.value).join('');
            btn.disabled = fc.value.length < 6;
        });
        inp.addEventListener('keydown', e => { if (e.key==='Backspace' && !inp.value && i>0) inputs[i-1].focus(); });
        inp.addEventListener('paste', e => {
            e.preventDefault();
            const p = (e.clipboardData||window.clipboardData).getData('text').replace(/\D/g,'').slice(0,6);
            p.split('').forEach((c,j)=>{ if(inputs[j]){inputs[j].value=c;inputs[j].classList.add('filled');} });
            inputs[Math.min(p.length,5)].focus();
            fc.value = Array.from(inputs).map(x=>x.value).join('');
            btn.disabled = fc.value.length < 6;
        });
    });
    inputs[0].focus();
</script>
</body>
</html>
