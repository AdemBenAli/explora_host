{% extends 'base_hotels.html.twig' %}

{% block title %}Edit Reservation | Explora{% endblock %}

{% block stylesheets %}
<style>
    * { box-sizing: border-box; }
    body { margin: 0; padding: 0; background: #f3f4f6; font-family: 'Segoe UI', Roboto, sans-serif; }

    .front-navbar { background: #ffffff !important; border-bottom: 1px solid rgba(26,58,92,0.08) !important; }
    .front-navbar-inner {
        width: calc(100% - 80px) !important; max-width: 1680px !important; margin: 0 auto !important;
        display: grid !important; grid-template-columns: 240px 1fr auto !important;
        align-items: center !important; min-height: 90px !important; gap: 20px !important;
        padding: 0 !important; justify-items: unset !important;
    }
    .front-brand-logo { width: 200px !important; height: auto !important; }
    .front-center-nav {
        display: flex !important; flex-direction: row !important; flex-wrap: nowrap !important;
        justify-content: center !important; align-items: center !important; gap: 10px !important;
    }
    .front-nav-pill {
        white-space: nowrap !important; flex-shrink: 0 !important; min-width: 90px !important;
        padding: 10px 16px !important; border: 1px solid #d4dbe3 !important; border-radius: 12px !important;
        background: #fafafa !important; color: #1a3a5c !important; font-size: 13px !important;
        font-weight: 800 !important; text-align: center !important; text-decoration: none !important;
        transition: 0.2s ease !important;
    }
    .front-nav-pill:hover { border-color: rgba(26,58,92,0.22) !important; background: #ffffff !important; }
    .front-right-nav {
        display: flex !important; flex-direction: row !important; flex-wrap: nowrap !important;
        justify-content: flex-end !important; align-items: center !important; gap: 10px !important;
    }
    .front-outline-pill {
        white-space: nowrap !important; min-width: 110px !important; height: 46px !important;
        padding: 0 20px !important; border: 2px solid #1a3a5c !important; border-radius: 999px !important;
        background: #ffffff !important; color: #1a3a5c !important; font-size: 13px !important;
        font-weight: 800 !important; text-decoration: none !important;
        display: inline-flex !important; align-items: center !important; justify-content: center !important;
        transition: 0.2s ease !important;
    }
    .front-outline-pill:hover { background: #1a3a5c !important; color: #ffffff !important; }
    .front-accent-pill {
        white-space: nowrap !important; min-width: 90px !important; height: 46px !important;
        padding: 0 20px !important; border-radius: 999px !important; background: #f7941d !important;
        color: #ffffff !important; border: none !important; font-size: 13px !important;
        font-weight: 800 !important; text-decoration: none !important;
        display: inline-flex !important; align-items: center !important; justify-content: center !important;
    }

    .front-hero-hotels {
        background: linear-gradient(90deg, #14988f 0%, #39df74 100%) !important;
        padding: 58px 20px 130px !important; text-align: center !important;
    }
    .front-hero-content h1 { margin: 0 0 14px !important; color: #ffffff !important; font-size: 64px !important; font-weight: 800 !important; }
    .front-hero-content p  { margin: 0 !important; color: rgba(255,255,255,0.96) !important; font-size: 20px !important; }

    .front-btn-primary {
        min-width: 120px !important; height: 50px !important; border: none !important;
        padding: 0 24px !important; background: #f7941d !important; color: #ffffff !important;
        font-size: 15px !important; font-weight: 800 !important; border-radius: 999px !important;
        cursor: pointer !important; display: inline-flex !important; align-items: center !important;
        justify-content: center !important; text-decoration: none !important; transition: 0.2s ease !important;
    }
    .front-btn-primary:hover { background: #e0820a !important; }
    .front-btn-outline {
        min-width: 100px !important; height: 50px !important; padding: 0 24px !important;
        border: 2px solid #1a3a5c !important; background: transparent !important; color: #1a3a5c !important;
        font-size: 15px !important; font-weight: 800 !important; border-radius: 999px !important;
        cursor: pointer !important; display: inline-flex !important; align-items: center !important;
        justify-content: center !important; text-decoration: none !important; transition: 0.2s ease !important;
    }
    .front-btn-outline:hover { background: #1a3a5c !important; color: #ffffff !important; }

    .edit-shell {
        width: calc(100% - 60px);
        max-width: 900px;
        margin: -65px auto 56px;
        position: relative;
        z-index: 2;
    }
</style>
{% endblock %}

{% block body %}
<div class="front-hotels-shell">

    <header class="front-navbar">
        <div class="front-navbar-inner">
            <a href="{{ path('app_hebergement_front') }}" class="front-brand">
                <img src="{{ asset('images/Explora.png') }}" alt="Explora" class="front-brand-logo">
            </a>

            <nav class="front-center-nav">
                <a href="#" class="front-nav-pill">Home</a>
                <a href="#" class="front-nav-pill">Voyages</a>
                <a href="#" class="front-nav-pill">Transport</a>
                <a href="{{ path('app_hebergement_front') }}" class="front-nav-pill">Hotels</a>
            </nav>

            <div class="front-right-nav">
                <a href="{{ path('app_hebergement_index') }}" class="front-outline-pill">Dashboard</a>
                <a href="{{ path('app_reservation_history') }}" class="front-outline-pill">History</a>
                <a href="#" class="front-accent-pill">Profile</a>
            </div>
        </div>
    </header>

    <section class="front-hero-hotels">
        <div class="front-hero-content">
            <h1>Edit Reservation</h1>
            <p>Update reservation details</p>
        </div>
    </section>

    <div class="edit-shell">

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div style="margin-bottom:18px;padding:14px 16px;border-radius:14px;font-weight:700;background:{{ label == 'success' ? '#e9f8ee' : '#fdeceb' }};color:{{ label == 'success' ? '#1f7a39' : '#b42318' }};border:1px solid {{ label == 'success' ? '#b7e4c7' : '#f5c2c7' }};">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div style="background:#ffffff;border-radius:24px;box-shadow:0 8px 20px rgba(0,0,0,0.08);padding:28px;">

            <h2 style="margin:0 0 24px;color:#1a3a5c;font-size:30px;font-weight:800;">
                {{ reservation.hebergement ? reservation.hebergement.nom : 'Reservation' }}
            </h2>

            <form method="post" action="{{ path('app_reservation_edit', {'id': reservation.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('edit_reservation_' ~ reservation.id) }}">

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;">
                    <div>
                        <label style="display:block;margin-bottom:8px;color:#1a3a5c;font-size:14px;font-weight:800;">Full name</label>
                        <input
                            type="text"
                            name="nomClient"
                            value="{{ reservation.nomClient }}"
                            required
                            style="width:100%;height:44px;border:1px solid #cfd7e2;border-radius:10px;padding:0 14px;font-size:14px;background:#ffffff;"
                        >
                    </div>

                    <div>
                        <label style="display:block;margin-bottom:8px;color:#1a3a5c;font-size:14px;font-weight:800;">Email</label>
                        <input
                            type="email"
                            name="emailClient"
                            value="{{ reservation.emailClient }}"
                            style="width:100%;height:44px;border:1px solid #cfd7e2;border-radius:10px;padding:0 14px;font-size:14px;background:#ffffff;"
                        >
                    </div>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:18px;">
                    <div>
                        <label style="display:block;margin-bottom:8px;color:#1a3a5c;font-size:14px;font-weight:800;">Check-in</label>
                        <input
                            type="date"
                            name="dateCheckin"
                            value="{{ reservation.dateCheckin ? reservation.dateCheckin|date('Y-m-d') : '' }}"
                            required
                            style="width:100%;height:44px;border:1px solid #cfd7e2;border-radius:10px;padding:0 14px;font-size:14px;background:#ffffff;"
                        >
                    </div>

                    <div>
                        <label style="display:block;margin-bottom:8px;color:#1a3a5c;font-size:14px;font-weight:800;">Check-out</label>
                        <input
                            type="date"
                            name="dateCheckout"
                            value="{{ reservation.dateCheckout ? reservation.dateCheckout|date('Y-m-d') : '' }}"
                            required
                            style="width:100%;height:44px;border:1px solid #cfd7e2;border-radius:10px;padding:0 14px;font-size:14px;background:#ffffff;"
                        >
                    </div>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:18px;margin-top:18px;">
                    <div>
                        <label style="display:block;margin-bottom:8px;color:#1a3a5c;font-size:14px;font-weight:800;">Guests</label>
                        <input
                            type="number"
                            name="guestsCount"
                            min="1"
                            value="{{ reservation.guestsCount }}"
                            required
                            style="width:100%;height:44px;border:1px solid #cfd7e2;border-radius:10px;padding:0 14px;font-size:14px;background:#ffffff;"
                        >
                    </div>

                    <div>
                        <label style="display:block;margin-bottom:8px;color:#1a3a5c;font-size:14px;font-weight:800;">Rooms</label>
                        <input
                            type="number"
                            name="roomsCount"
                            min="1"
                            value="{{ reservation.roomsCount }}"
                            required
                            style="width:100%;height:44px;border:1px solid #cfd7e2;border-radius:10px;padding:0 14px;font-size:14px;background:#ffffff;"
                        >
                    </div>

                    <div>
                        <label style="display:block;margin-bottom:8px;color:#1a3a5c;font-size:14px;font-weight:800;">Occupancy</label>
                        <select
                            name="occupancy"
                            style="width:100%;height:44px;border:1px solid #cfd7e2;border-radius:10px;padding:0 14px;font-size:14px;background:#ffffff;"
                        >
                            <option value="SINGLE" {{ reservation.occupancy == 'SINGLE' ? 'selected' : '' }}>Single</option>
                            <option value="DOUBLE" {{ reservation.occupancy == 'DOUBLE' ? 'selected' : '' }}>Double</option>
                        </select>
                    </div>

                    <div>
                        <label style="display:block;margin-bottom:8px;color:#1a3a5c;font-size:14px;font-weight:800;">Room type</label>
                        <select
                            name="roomType"
                            style="width:100%;height:44px;border:1px solid #cfd7e2;border-radius:10px;padding:0 14px;font-size:14px;background:#ffffff;"
                        >
                            <option value="Standard" {{ reservation.roomType == 'Standard' ? 'selected' : '' }}>Standard</option>
                            <option value="Deluxe" {{ reservation.roomType == 'Deluxe' ? 'selected' : '' }}>Deluxe</option>
                            <option value="Suite" {{ reservation.roomType == 'Suite' ? 'selected' : '' }}>Suite</option>
                        </select>
                    </div>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:18px;">
                    <div>
                        <label style="display:block;margin-bottom:8px;color:#1a3a5c;font-size:14px;font-weight:800;">Status</label>
                        <select
                            name="statut"
                            style="width:100%;height:44px;border:1px solid #cfd7e2;border-radius:10px;padding:0 14px;font-size:14px;background:#ffffff;"
                        >
                            <option value="CONFIRMED" {{ reservation.statut == 'CONFIRMED' ? 'selected' : '' }}>CONFIRMED</option>
                            <option value="PENDING" {{ reservation.statut == 'PENDING' ? 'selected' : '' }}>PENDING</option>
                            <option value="CANCELLED" {{ reservation.statut == 'CANCELLED' ? 'selected' : '' }}>CANCELLED</option>
                        </select>
                    </div>

                    <div>
                        <label style="display:block;margin-bottom:8px;color:#1a3a5c;font-size:14px;font-weight:800;">Current total</label>
                        <input
                            type="text"
                            value="${{ reservation.prixTotal is not null ? reservation.prixTotal|number_format(1, '.', '') : '0.0' }}"
                            disabled
                            style="width:100%;height:44px;border:1px solid #cfd7e2;border-radius:10px;padding:0 14px;font-size:14px;background:#f8f9fb;color:#1a3a5c;font-weight:700;"
                        >
                    </div>
                </div>

                <div style="display:flex;justify-content:flex-end;gap:14px;margin-top:28px;flex-wrap:wrap;">
                    <a href="{{ path('app_reservation_history') }}" class="front-btn-outline">Cancel</a>
                    <button type="submit" class="front-btn-primary">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
