<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
<style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --sidebar-bg: #1e3a5f;
        --sidebar-bg-hover: #2a4f80;
        --bg-body: #f5f7fa;
        --bg-card: #ffffff;
        --text-heading: #1e3a5f;
        --text-body: #8492a6;
        --border-color: #e0e6ed;
        --accent: #ff8c42;
        --accent-hover: #e67a2e;
        --accent-subtle: rgba(255,140,66,0.15);
        --accent-border: #ff8c42;
        --red: #e74c3c;
        --green: #27ae60;
    }

    [data-theme="dark"] {
        --bg-body: #0d1f35;
        --bg-card: #142840;
        --text-heading: #e8edf5;
        --text-body: #8492a6;
        --border-color: #1e3a5f;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
        font-family: 'Inter', sans-serif;
        background-color: var(--bg-body);
        color: var(--text-body);
        display: flex;
        height: 100vh;
        overflow: hidden;
    }

    .sidebar {
        width: 240px;
        min-width: 240px;
        background: var(--sidebar-bg);
        color: white;
        display: flex;
        flex-direction: column;
        box-shadow: 4px 0 20px rgba(30,58,95,0.15);
    }

    .sidebar-header {
        padding: 24px 30px;
        display: flex;
        align-items: center;
        gap: 12px;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .logo-box {
        font-size: 30px;
        color: #ff8c42;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }

    .logo-text h2 { font-size: 18px; font-weight: bold; color: white; }
    .logo-text span { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: rgba(255,255,255,0.5); }

    .sidebar-nav { flex: 1; padding: 20px 0; overflow-y: auto; }

    .nav-section-label {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: rgba(255,255,255,0.35);
        font-weight: 600;
        padding: 16px 24px 6px;
    }

    .nav-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 15px;
        color: rgba(255,255,255,0.75);
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
        transition: all 0.2s;
        border-left: 3px solid transparent;
        border-radius: 0 8px 8px 0;
        margin-right: 12px;
    }

    .nav-item i { font-size: 14px; width: 16px; flex-shrink: 0; }
    .nav-item:hover { background: rgba(255,255,255,0.08); color: white; }
    .nav-item.active {
        background: rgba(255,140,66,0.18);
        color: white;
        border-left-color: #ff8c42;
        font-weight: bold;
    }

    .sidebar-footer { padding: 10px 0 16px; border-top: 1px solid rgba(255,255,255,0.08); }

    .main-content { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

    .topbar {
        background: white;
        padding: 18px 36px;
        border-bottom: 1px solid #e0e6ed;
        display: flex;
        align-items: center;
        gap: 16px;
        justify-content: space-between;
        flex-shrink: 0;
    }

    .search-bar {
        flex: 1;
        min-width: 180px;
        max-width: 340px;
        background: #f5f7fa;
        border-radius: 30px;
        padding: 9px 18px;
        display: flex;
        align-items: center;
        border: 1px solid #e0e6ed;
        transition: all 0.2s;
    }

    .search-bar:focus-within { border-color: #ff8c42; background: white; box-shadow: 0 0 0 3px rgba(255,140,66,0.1); }
    .search-bar i { color: #8492a6; margin-right: 10px; font-size: 13px; }
    .search-bar input { border: none; background: transparent; outline: none; font-size: 13px; width: 100%; font-family: inherit; color: var(--text-heading); }
    .search-bar input::placeholder { color: #8492a6; }

    .topbar-right { display: flex; align-items: center; gap: 16px; margin-left: auto; }

    .icon-btn {
        background: #f0f2f5;
        border: none;
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #8492a6;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
    }

    .icon-btn:hover { background: #ffe8d6; color: #ff8c42; }

    .user-profile {
        display: flex;
        align-items: center;
        gap: 12px;
        cursor: pointer;
        padding-left: 16px;
        border-left: 1px solid #e0e6ed;
    }

    .user-avatar { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
    .user-name { font-weight: bold; color: #1e3a5f; font-size: 14px; }
    .user-role { font-size: 11px; color: #8492a6; }
    .user-dropdown-icon { color: #8492a6; font-size: 12px; }

    .content-area {
        flex: 1;
        padding: 30px;
        overflow-y: auto;
    }

    .breadcrumb { font-size: 13px; color: #94a3b8; margin-bottom: 24px; }
    .breadcrumb span { color: var(--text-heading); font-weight: 600; }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: var(--bg-card);
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 1px 3px rgba(0,0,0,.07);
    }

    .stat-card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 12px;
    }

    .stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .stat-icon.indigo { background: #eef2ff; color: #6366f1; }
    .stat-icon.blue   { background: #eff6ff; color: #3b82f6; }
    .stat-icon.green  { background: #f0fdf4; color: #22c55e; }
    .stat-icon.red    { background: #fef2f2; color: #ef4444; }

    .stat-badge {
        font-size: 11px;
        font-weight: 600;
        padding: 3px 8px;
        border-radius: 20px;
        background: #f0fdf4;
        color: #16a34a;
    }

    .stat-value { font-size: 1.75rem; font-weight: 700; color: var(--text-heading); }
    .stat-label { font-size: 0.8rem; color: var(--text-body); margin-top: 4px; }

    .section-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--text-heading);
        margin-bottom: 16px;
    }

    .table-card {
        background: var(--bg-card);
        border-radius: 16px;
        box-shadow: 0 1px 3px rgba(0,0,0,.07);
        overflow: hidden;
    }

    .table-card table {
        width: 100%;
        border-collapse: collapse;
    }

    .table-card th {
        background: var(--bg-body);
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #94a3b8;
        padding: 12px 20px;
        text-align: left;
    }

    .table-card td {
        padding: 14px 20px;
        font-size: 14px;
        border-top: 1px solid var(--border-color);
        color: var(--text-heading);
    }

    .badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .badge-green  { background: #dcfce7; color: #16a34a; }
    .badge-orange { background: #fff7ed; color: #d97706; }
    .badge-blue   { background: #dbeafe; color: #2563eb; }
    .badge-red    { background: #fee2e2; color: #dc2626; }

    .theme-nav-option {
        background: none;
        border: none;
        color: rgba(255,255,255,0.85);
        font-size: 13px;
        font-family: 'Inter', sans-serif;
        padding: 9px 24px;
        text-align: left;
        cursor: pointer;
        transition: background 0.15s;
        border-radius: 6px;
        width: 100%;
    }
    .theme-nav-option:hover { background: rgba(255,255,255,0.08); }
    .theme-nav-option.active { color: #a5b4fc; font-weight: 600; }

    .btn-ia {
        background: #ff8c42;
        color: white;
        border: none;
        padding: 9px 18px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: bold;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        font-family: inherit;
        box-shadow: 0 4px 12px rgba(255,140,66,0.35);
        transition: all 0.2s;
    }
    .btn-ia:hover { background: #e67a2e; transform: translateY(-1px); }

    /* LOADING OVERLAY */
    .overlay{display:none;position:fixed;inset:0;background:rgba(15,23,42,.6);z-index:999;align-items:center;justify-content:center;flex-direction:column;}
    .overlay.show{display:flex;}
    .overlay-box{background:var(--bg-card);border-radius:16px;padding:40px;text-align:center;max-width:400px;}
    .overlay-icon{font-size:48px;animation:spin 2s linear infinite;display:block;margin-bottom:20px;color:#6366f1;}
    @keyframes spin{0%{transform:rotate(0)}100%{transform:rotate(360deg)}}
    .overlay-title{font-family:'Inter',sans-serif;font-size:18px;font-weight:700;color:var(--text-heading);margin-bottom:8px;}
    .overlay-sub{font-size:14px;color:var(--text-body);}
    .progress{height:6px;background:var(--border-color);border-radius:10px;margin-top:20px;overflow:hidden;}
    .progress-bar{height:100%;background:#6366f1;border-radius:10px;width:0;transition:width .5s;}
</style>
