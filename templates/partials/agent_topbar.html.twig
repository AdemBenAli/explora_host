<header class="topbar">
    <div class="search-bar">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" placeholder="Search bookings, clients, packages...">
    </div>
    <div class="topbar-right">
        <button class="icon-btn" title="Reports"><i class="fa-solid fa-chart-simple"></i></button>
        <button class="icon-btn" title="Messages"><i class="fa-regular fa-envelope"></i></button>
        <button class="icon-btn" title="Notifications"><i class="fa-regular fa-bell"></i></button>
        <div class="user-profile">
            <img src="https://ui-avatars.com/api/?name=Travel+Agent&background=d97706&color=fff" alt="Agent Avatar" class="user-avatar">
            <div>
                <div class="user-name">Travel Agent</div>
                <div class="user-role">Agent Account</div>
            </div>
            <i class="fa-solid fa-chevron-down user-dropdown-icon"></i>
        </div>
    </div>
</header>
