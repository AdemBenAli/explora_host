{% extends 'base.html.twig' %}

{% block title %}{{ 'tickets.title'|trans }} - Explora{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
/* ----------------------------------------------------
   EXPLORA — Mes Billets  (identique FXML BilletController)
---------------------------------------------------- */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

:root{
  --navy:#1a3a5c; --navy-dark:#0f2540; --navy-mid:#2d5a8a;
  --orange:#f7941d; --orange-dk:#e07800; --orange-lt:#fff3e0;
  --white:#fff; --bg:#f5f7fa; --bg-card:#fff;
  --gray-lt:#f8f9fa; --gray-md:#e9ecef; --gray:#8492a6;
  --text:#212529; --text-m:#6c757d;
  --green:#28a745; --green-lt:#d4edda;
  --red:#dc3545;   --red-lt:#fde8ea;
  --blue:#17a2b8;  --blue-lt:#d1ecf1;
  --r-sm:8px; --r:12px; --r-lg:16px;
  --sh-sm:0 2px 8px rgba(0,0,0,.08);
  --sh:0 4px 20px rgba(0,0,0,.10);
  --tr:.22s ease;
  --fd:'Plus Jakarta Sans',sans-serif;
  --fb:'DM Sans',sans-serif;
}

/* -- DARK MODE -- */
body.dark-mode{
  --navy:#a8c4e0; --navy-dark:#e8f0f8;
  --white:#1e2d40; --bg:#0f1923; --bg-card:#162032;
  --gray-lt:#1e2d40; --gray-md:#2a3d52; --gray:#7a8fa3;
  --text:#e8edf3; --text-m:#8ca0b5;
  --orange-lt:rgba(247,148,29,.12);
  --sh-sm:0 2px 8px rgba(0,0,0,.3);
  --sh:0 4px 20px rgba(0,0,0,.4);
}
body.dark-mode .mb-header,
body.dark-mode .mb-tabs-bar,
body.dark-mode .mb-table-wrap,
body.dark-mode .mb-stat-card{ background:#162032; }
body.dark-mode .mb-table th{ background:#1a3a5c; }
body.dark-mode .mb-table td{ border-color:#2a3d52; }
body.dark-mode .mb-table tr:hover td{ background:#1e2d40; }
body.dark-mode .mb-input{ background:#1e2d40; border-color:#2a3d52; color:#e8edf3; }
body.dark-mode .mb-modal-box{ background:#162032; }

/* PAGE */
body{ font-family:var(--fb); background:var(--bg); color:var(--text); min-height:100vh; transition:background var(--tr),color var(--tr); }
.mb-page{ max-width:1280px; margin:0 auto; padding:30px; }

/* -- RTL SUPPORT -- */
[dir="rtl"] .mb-header-left{ text-align:right; }
[dir="rtl"] .mb-header-right{ flex-direction:row-reverse; }
[dir="rtl"] .mb-table th{ text-align:right; }
[dir="rtl"] .mb-tabs-bar{ flex-direction:row-reverse; }
[dir="rtl"] .mb-search-row{ flex-direction:row-reverse; }
[dir="rtl"] .mb-stat-inner{ flex-direction:row-reverse; text-align:right; }
[dir="rtl"] .mb-actions{ flex-direction:row-reverse; }

/* -- HEADER -- */
.mb-header{
  background:var(--bg-card); border-radius:var(--r-lg);
  box-shadow:var(--sh-sm); padding:24px 30px;
  display:flex; align-items:center; justify-content:space-between;
  margin-bottom:24px;
}
.mb-header-left h1{ font-family:var(--fd); font-size:24px; font-weight:800; color:var(--navy); }
.mb-header-left p{ font-size:13px; color:var(--gray); margin-top:4px; }
.mb-header-right{ display:flex; align-items:center; gap:12px; }

/* Buttons */
.mb-btn{ display:inline-flex; align-items:center; gap:7px; font-family:var(--fd); font-weight:700; font-size:13px; padding:10px 20px; border-radius:25px; border:none; cursor:pointer; text-decoration:none; transition:var(--tr); white-space:nowrap; }
.mb-btn--orange{ background:var(--orange); color:#fff; box-shadow:0 3px 10px rgba(247,148,29,.3); }
.mb-btn--orange:hover{ background:var(--orange-dk); transform:translateY(-1px); }
.mb-btn--gray{ background:var(--gray-lt); color:var(--navy); border:1.5px solid var(--gray-md); }
.mb-btn--gray:hover{ background:var(--gray-md); }
.mb-btn--red{ background:var(--red); color:#fff; }
.mb-btn--red:hover{ background:#c82333; }
.mb-btn--blue{ background:var(--blue); color:#fff; }
.mb-btn--blue:hover{ background:#138496; }
.mb-btn--sm{ padding:7px 14px; font-size:12px; border-radius:20px; }
.mb-theme-btn{ background:var(--gray-lt); border:none; border-radius:50%; width:42px; height:42px; font-size:16px; cursor:pointer; display:flex; align-items:center; justify-content:center; color:var(--navy); transition:var(--tr); }
.mb-theme-btn:hover{ background:var(--gray-md); transform:rotate(15deg); }

/* -- STAT CARDS (identique FXML GridPane 3 cartes) -- */
.mb-stats{ display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-bottom:24px; }
.mb-stat-card{ background:var(--bg-card); border-radius:var(--r-lg); box-shadow:var(--sh-sm); padding:20px; transition:var(--tr); }
.mb-stat-card:hover{ box-shadow:var(--sh); }
.mb-stat-inner{ display:flex; align-items:center; gap:16px; margin-bottom:10px; }
.mb-stat-icon{ width:55px; height:55px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:22px; flex-shrink:0; }
.mb-stat-icon--blue{ background:#e3f2fd; color:#1565c0; }
.mb-stat-icon--green{ background:var(--green-lt); color:var(--green); }
.mb-stat-icon--orange{ background:var(--orange-lt); color:var(--orange); }
.mb-stat-val{ font-family:var(--fd); font-size:28px; font-weight:800; color:var(--navy); line-height:1; }
.mb-stat-label{ font-size:13px; color:var(--gray); margin-top:3px; }
.mb-stat-sub{ font-size:11px; font-weight:600; color:var(--gray); }
.mb-stat-sub--orange{ color:var(--orange); }

/* -- TABLE WRAPPER -- */
.mb-table-wrap{ background:var(--bg-card); border-radius:var(--r-lg); box-shadow:var(--sh-sm); overflow:hidden; }

/* -- TABS BAR (identique FXML tabTous / tabActifs / tabAnnules) -- */
.mb-tabs-bar{
  display:flex; align-items:center;
  border-bottom:2px solid var(--gray-md);
  padding:15px 25px 0;
  background:var(--bg-card);
  gap:4px;
}
.mb-tab{
  display:flex; align-items:center; gap:7px;
  padding:12px 22px; height:45px;
  font-family:var(--fd); font-size:14px; font-weight:700;
  color:var(--gray); text-decoration:none;
  border-bottom:3px solid transparent;
  transition:var(--tr); cursor:pointer; white-space:nowrap;
}
.mb-tab:hover{ color:var(--navy); background:var(--gray-lt); }
.mb-tab--active{ color:var(--orange); border-bottom-color:var(--orange); }
.mb-tabs-spacer{ flex:1; }
.mb-refresh-btn{ background:var(--gray-lt); border:none; border-radius:var(--r-sm); width:36px; height:36px; font-size:15px; cursor:pointer; display:flex; align-items:center; justify-content:center; color:var(--navy); transition:var(--tr); margin-bottom:4px; }
.mb-refresh-btn:hover{ background:var(--gray-md); transform:rotate(180deg); }

/* -- SEARCH + SORT ROW -- */
.mb-search-row{ display:flex; align-items:center; gap:12px; padding:14px 25px; flex-wrap:wrap; }
.mb-input{
  height:40px; padding:0 14px;
  background:var(--gray-lt); border:1.5px solid var(--gray-md);
  border-radius:var(--r-sm); font-family:var(--fb); font-size:14px;
  color:var(--text); outline:none; transition:var(--tr);
}
.mb-input:focus{ border-color:var(--orange); background:var(--white); }
.mb-input--search{ width:220px; }
.mb-sort-label{ font-family:var(--fd); font-weight:700; font-size:13px; color:var(--gray); }
.mb-input--sort{ width:180px; cursor:pointer; }
.mb-search-spacer{ flex:1; }

/* -- TABLE -- */
.mb-table{ width:100%; border-collapse:collapse; }
.mb-table th{
  background:#2c3e50; color:#fff;
  font-family:var(--fd); font-weight:700; font-size:13px;
  padding:14px 12px; text-align:left;
  border-bottom:2px solid #1a252f;
}
.mb-table td{ padding:13px 12px; border-bottom:1px solid var(--gray-md); font-size:13px; color:var(--text); vertical-align:middle; }
.mb-table tr:hover td{ background:var(--gray-lt); cursor:pointer; }

/* -- BADGES STATUT -- */
.mb-badge{ display:inline-flex; align-items:center; gap:5px; padding:4px 12px; border-radius:20px; font-family:var(--fd); font-weight:700; font-size:11px; text-transform:uppercase; letter-spacing:.4px; }
.mb-badge--attente{ background:#fff3cd; color:#856404; }
.mb-badge--confirme{ background:var(--green-lt); color:var(--green); }
.mb-badge--paye{ background:#cce5ff; color:#004085; }
.mb-badge--annule{ background:var(--red-lt); color:var(--red); }

/* Prix en orange */
.mb-prix{ font-family:var(--fd); font-weight:800; color:var(--orange); }

/* -- ACTIONS -- */
.mb-actions{ display:flex; align-items:center; gap:6px; flex-wrap:nowrap; }

/* -- EMPTY STATE -- */
.mb-empty{ padding:60px; text-align:center; }
.mb-empty i{ font-size:48px; color:var(--gray); margin-bottom:16px; display:block; }
.mb-empty p{ font-family:var(--fd); font-size:17px; font-weight:700; color:var(--navy); }
.mb-empty span{ font-size:14px; color:var(--gray); }

/* -- MODAL MODIFIER -- */
.mb-modal-overlay{ position:fixed; inset:0; background:rgba(0,0,0,.55); z-index:500; display:none; align-items:center; justify-content:center; }
.mb-modal-overlay.open{ display:flex; }
.mb-modal-box{ background:var(--bg-card); border-radius:var(--r-lg); padding:36px 40px; max-width:460px; width:90%; box-shadow:0 20px 60px rgba(0,0,0,.3); position:relative; animation:slideUp .25s ease; }
@keyframes slideUp{ from{transform:translateY(20px);opacity:0} to{transform:translateY(0);opacity:1} }
.mb-modal-close{ position:absolute; top:16px; right:16px; background:var(--gray-lt); border:none; border-radius:50%; width:34px; height:34px; font-size:16px; cursor:pointer; display:flex; align-items:center; justify-content:center; color:var(--navy); transition:var(--tr); }
.mb-modal-close:hover{ background:var(--red-lt); color:var(--red); }
.mb-modal-title{ font-family:var(--fd); font-size:20px; font-weight:800; color:var(--navy); margin-bottom:6px; }
.mb-modal-sub{ font-size:14px; color:var(--gray); margin-bottom:22px; }
.mb-modal-field{ margin-bottom:18px; }
.mb-modal-field label{ display:block; font-family:var(--fd); font-weight:700; font-size:13px; color:var(--navy); margin-bottom:8px; }
.mb-modal-field input{ width:100%; height:50px; padding:0 16px; border:2px solid var(--gray-md); border-radius:var(--r-sm); font-family:var(--fd); font-size:18px; font-weight:700; color:var(--text); background:var(--gray-lt); outline:none; transition:var(--tr); text-align:center; }
.mb-modal-total{ background:var(--orange-lt); border-radius:var(--r-sm); padding:14px 16px; margin-bottom:20px; display:flex; justify-content:space-between; align-items:center; }
.mb-modal-total-label{ font-family:var(--fd); font-weight:700; color:var(--navy); }
.mb-modal-total-val{ font-family:var(--fd); font-size:22px; font-weight:800; color:var(--orange); }
.mb-modal-actions{ display:flex; gap:12px; justify-content:flex-end; }

/* -- CONFIRM MODAL (Supprimer) -- */
.mb-confirm-box{ background:var(--bg-card); border-radius:var(--r-lg); padding:36px 40px; max-width:460px; width:90%; box-shadow:0 20px 60px rgba(0,0,0,.3); text-align:center; animation:slideUp .25s ease; }
.mb-confirm-icon{ font-size:52px; margin-bottom:16px; }
.mb-confirm-title{ font-family:var(--fd); font-size:20px; font-weight:800; color:var(--red); margin-bottom:10px; }
.mb-confirm-text{ font-size:14px; color:var(--text-m); margin-bottom:24px; line-height:1.6; }
.mb-confirm-actions{ display:flex; gap:12px; justify-content:center; }

/* -- TOAST -- */
.mb-toast{ position:fixed; bottom:30px; right:30px; z-index:600; background:var(--navy-dark); color:#fff; font-family:var(--fd); font-weight:700; font-size:14px; padding:14px 22px; border-radius:12px; box-shadow:0 8px 24px rgba(0,0,0,.25); display:none; align-items:center; gap:10px; max-width:380px; }
.mb-toast.show{ display:flex; animation:slideUp .3s ease; }
.mb-toast.success{ background:var(--green); }
.mb-toast.error{ background:var(--red); }

/* -- RESPONSIVE -- */
@media(max-width:900px){
  .mb-stats{ grid-template-columns:1fr 1fr; }
  .mb-page{ padding:16px; }
  .mb-table-wrap{ overflow-x:auto; }
  .mb-table{ min-width:800px; }
}
@media(max-width:600px){
  .mb-stats{ grid-template-columns:1fr; }
  .mb-header{ flex-direction:column; gap:16px; align-items:flex-start; }
}
</style>
{% endblock %}

{% block body %}
<div class="mb-page" {{ app.request.locale == 'ar' ? 'dir="rtl"' : '' }}>

{# ---------- HEADER ---------- #}
<div class="mb-header">
    <div class="mb-header-left">
        <h1>{{ 'tickets.title'|trans }}</h1>
        <p>{{ 'tickets.subtitle'|trans }}</p>
    </div>
    <div class="mb-header-right">
        <button class="mb-theme-btn" id="btnTheme" title="{{ 'prefs.theme_toggle'|default('Mode nuit / jour') }}">
            <i class="fas fa-moon" id="themeIcon"></i>
        </button>
        <a href="{{ path('user_billets') }}" class="mb-btn mb-btn--orange" id="btnRefresh">
            <i class="fas fa-sync-alt"></i> {{ 'btn.refresh'|trans }}
        </a>
        <a href="{{ path('user_transport') }}" class="mb-btn mb-btn--gray">
            <i class="fas fa-plane"></i> {{ 'tickets.btn_reserve'|trans }}
        </a>
    </div>
</div>

{# ---------- STAT CARDS ---------- #}
<div class="mb-stats">
    <div class="mb-stat-card">
        <div class="mb-stat-inner">
            <div class="mb-stat-icon mb-stat-icon--blue">
                <i class="fas fa-ticket-alt"></i>
            </div>
            <div>
                <div class="mb-stat-val">{{ totalBillets }}</div>
                <div class="mb-stat-label">{{ 'tickets.stat_total'|trans }}</div>
            </div>
        </div>
        <div class="mb-stat-sub">{{ 'tickets.stat_total_sub'|trans }}</div>
    </div>

    <div class="mb-stat-card">
        <div class="mb-stat-inner">
            <div class="mb-stat-icon mb-stat-icon--green">
                <i class="fas fa-check-circle"></i>
            </div>
            <div>
                <div class="mb-stat-val">{{ billetsActifs }}</div>
                <div class="mb-stat-label">{{ 'tickets.stat_active'|trans }}</div>
            </div>
        </div>
        <div class="mb-stat-sub">{{ 'tickets.stat_active_sub'|trans }}</div>
    </div>

    <div class="mb-stat-card">
        <div class="mb-stat-inner">
            <div class="mb-stat-icon mb-stat-icon--orange">
                <i class="fas fa-wallet"></i>
            </div>
            <div>
                <div class="mb-stat-val">{{ totalDepense|number_format(2, ".", " ") }}</div>
                <div class="mb-stat-label">{{ 'tickets.stat_spent'|trans }} ({{ current_currency_symbol() }})</div>
            </div>
        </div>
        <div class="mb-stat-sub mb-stat-sub--orange">{{ 'tickets.stat_spent_sub'|trans }}</div>
    </div>
</div>

{# ---------- TABLE WRAPPER ---------- #}
<div class="mb-table-wrap">

    {# -- TABS -- #}
    <div class="mb-tabs-bar">
        <a href="{{ path('user_billets', {statut:'tous',   recherche:recherche, sort:sort}) }}"
           class="mb-tab {{ statut == 'tous'    ? 'mb-tab--active' : '' }}">
            <i class="fas fa-list"></i> {{ 'tickets.tab_all'|trans }}
        </a>
        <a href="{{ path('user_billets', {statut:'actifs', recherche:recherche, sort:sort}) }}"
           class="mb-tab {{ statut == 'actifs'  ? 'mb-tab--active' : '' }}">
            <i class="fas fa-check-circle"></i> {{ 'tickets.tab_active'|trans }}
        </a>
        <a href="{{ path('user_billets', {statut:'annules',recherche:recherche, sort:sort}) }}"
           class="mb-tab {{ statut == 'annules' ? 'mb-tab--active' : '' }}">
            <i class="fas fa-times-circle"></i> {{ 'tickets.tab_canceled'|trans }}
        </a>
        <div class="mb-tabs-spacer"></div>
        <a href="{{ path('user_billets') }}" class="mb-refresh-btn" title="{{ 'btn.refresh'|trans }}">
            <i class="fas fa-sync-alt"></i>
        </a>
    </div>

    {# -- RECHERCHE + TRI -- #}
    <form method="get" action="{{ path('user_billets') }}" id="searchForm">
        <input type="hidden" name="statut" value="{{ statut }}">
        <div class="mb-search-row">
            <input type="text"
                   name="recherche"
                   id="inputRecherche"
                   value="{{ recherche }}"
                   placeholder="{{ 'search.origin_placeholder'|trans }}"
                   class="mb-input mb-input--search">
            <button type="submit" class="mb-btn mb-btn--orange mb-btn--sm">
                <i class="fas fa-search"></i> {{ 'btn.search'|trans }}
            </button>
            <a href="{{ path('user_billets') }}" class="mb-btn mb-btn--gray mb-btn--sm">
                <i class="fas fa-undo"></i> {{ 'tickets.btn_reset'|trans }}
            </a>
            <div class="mb-search-spacer"></div>
            <span class="mb-sort-label">{{ 'search.sort_by'|trans }} :</span>
            <select name="sort" class="mb-input mb-input--sort" id="sortSelect">
                <option value="date_desc" {{ sort == 'date_desc' ? 'selected' : '' }}>{{ 'tickets.sort_recent'|trans }}</option>
                <option value="date_asc"  {{ sort == 'date_asc'  ? 'selected' : '' }}>{{ 'tickets.sort_oldest'|trans }}</option>
                <option value="prix_asc"  {{ sort == 'prix_asc'  ? 'selected' : '' }}>{{ 'tickets.sort_price_asc'|trans }}</option>
                <option value="prix_desc" {{ sort == 'prix_desc' ? 'selected' : '' }}>{{ 'tickets.sort_price_desc'|trans }}</option>
            </select>
        </div>
    </form>

    {# -- TABLEAU BILLETS -- #}
    <table class="mb-table">
        <thead>
            <tr>
                <th>{{ 'tickets.col_id'|trans }}</th>
                <th>{{ 'tickets.col_type'|trans }}</th>
                <th>{{ 'tickets.col_origin'|trans }}</th>
                <th>{{ 'tickets.col_destination'|trans }}</th>
                <th>{{ 'tickets.col_date'|trans }}</th>
                <th>{{ 'tickets.col_time'|trans }}</th>
                <th>{{ 'tickets.col_places'|trans }}</th>
                <th>{{ 'tickets.col_price'|trans }}</th>
                <th>{{ 'tickets.col_status'|trans }}</th>
                <th>{{ 'tickets.col_actions'|trans }}</th>
            </tr>
        </thead>
        <tbody>
        {% if billets is empty %}
            <tr>
                <td colspan="10">
                    <div class="mb-empty">
                        <i class="fas fa-ticket-alt"></i>
                        <p>{{ 'tickets.empty'|trans }}</p>
                        <span>{{ 'tickets.empty_sub'|trans }}</span>
                    </div>
                </td>
            </tr>
        {% else %}
            {% for billet in billets %}
            {% set t = billet.transport %}
            <tr>
                <td><strong>#{{ billet.id }}</strong></td>
                <td>
                    {% set typeKey = 'type.' ~ (t.type.value|lower == 'voiture' ? 'voiture' : t.type.value|lower) %}
                    {% if t.type.value == 'AVION' %}<i class="fas fa-plane" style="color:var(--navy)"></i>
                    {% elseif t.type.value == 'BATEAU' %}<i class="fas fa-ship" style="color:var(--navy)"></i>
                    {% elseif t.type.value == 'TRAIN' %}<i class="fas fa-train" style="color:var(--navy)"></i>
                    {% elseif t.type.value == 'VOITURE' %}<i class="fas fa-car" style="color:var(--navy)"></i>
                    {% elseif t.type.value == 'BUS' %}<i class="fas fa-bus" style="color:var(--navy)"></i>
                    {% else %}<i class="fas fa-taxi" style="color:var(--navy)"></i>
                    {% endif %}
                    {{ typeKey|trans }}
                </td>
                <td>{{ t.origine|trans }}</td>
                <td>{{ t.destination|trans }}</td>
                <td>{{ t.dateDepart ? t.dateDepart|date('d/m/Y') : '--' }}</td>
                <td>{{ t.heureDepart ? t.heureDepart|date('H:i') : '--' }}</td>
                <td style="text-align:center">{{ billet.nombrePlaces }}</td>
                <td><span class="mb-prix">{{ (billet.prixTotal * currency_rate())|number_format(2, ".", " ") }} {{ current_currency_symbol() }}</span></td>
                <td>
                    {% if billet.statut.value == 'EN_ATTENTE' %}
                        <span class="mb-badge mb-badge--attente"><i class="fas fa-clock"></i> {{ 'tickets.status_pending'|trans }}</span>
                    {% elseif billet.statut.value == 'CONFIRME' %}
                        <span class="mb-badge mb-badge--confirme"><i class="fas fa-check"></i> {{ 'tickets.status_confirmed'|trans }}</span>
                    {% elseif billet.statut.value == 'PAYE' %}
                        <span class="mb-badge mb-badge--paye"><i class="fas fa-money-bill"></i> {{ 'tickets.status_paid'|trans }}</span>
                    {% elseif billet.statut.value == 'ANNULE' %}
                        <span class="mb-badge mb-badge--annule"><i class="fas fa-times"></i> {{ 'tickets.status_canceled'|trans }}</span>
                    {% else %}
                        <span class="mb-badge mb-badge--attente">{{ billet.statut.value }}</span>
                    {% endif %}
                </td>
                <td>
                    <div class="mb-actions">
                        {% if billet.statut.value == 'EN_ATTENTE' %}
                        <button type="button"
                                class="mb-btn mb-btn--orange mb-btn--sm btn-modifier"
                                title="{{ 'btn.book'|trans }}"
                                data-id="{{ billet.id }}"
                                data-places="{{ billet.nombrePlaces }}"
                                data-prix="{{ billet.transport.prix }}"
                                data-origine="{{ billet.transport.origine|trans }}"
                                data-destination="{{ billet.transport.destination|trans }}"
                                data-token="{{ csrf_token('modifier_' ~ billet.id) }}">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button type="button"
                                class="mb-btn mb-btn--red mb-btn--sm btn-supprimer"
                                title="{{ 'tickets.modal_btn_supp_confirm'|trans }}"
                                data-id="{{ billet.id }}"
                                data-origine="{{ billet.transport.origine|trans }}"
                                data-destination="{{ billet.transport.destination|trans }}"
                                data-token="{{ csrf_token('supprimer_' ~ billet.id) }}">
                            <i class="fas fa-trash"></i>
                        </button>
                        {% endif %}

                        {% if billet.statut.value == 'CONFIRME' %}
                        <a href="{{ path('user_billet_ticket_pdf', {id: billet.id}) }}"
                           class="mb-btn mb-btn--blue mb-btn--sm"
                           title="PDF"
                           target="_blank">
                            <i class="fas fa-file-pdf"></i>
                        </a>
                        {% endif %}
                    </div>
                </td>
            </tr>
            {% endfor %}
        {% endif %}
        </tbody>
    </table>

</div>{# /mb-table-wrap #}
</div>{# /mb-page #}

{# ---------- MODAL MODIFIER ---------- #}
<div class="mb-modal-overlay" id="modalModifier">
    <div class="mb-modal-box">
        <button class="mb-modal-close" id="modalModClose"><i class="fas fa-times"></i></button>
        <h3 class="mb-modal-title">{{ 'tickets.modal_mod_title'|trans }} <span id="modBilletId"></span></h3>
        <p class="mb-modal-sub" id="modRoute"></p>

        <form method="post" id="formModifier">
            <input type="hidden" name="_token" id="modToken">
            <div class="mb-modal-field">
                <label for="modPlaces">{{ 'tickets.modal_mod_label_places'|trans }}</label>
                <input type="number" id="modPlaces" name="nombrePlaces" min="1" value="1">
            </div>
            <div class="mb-modal-total">
                <span class="mb-modal-total-label">{{ 'tickets.modal_mod_new_total'|trans }}</span>
                <span class="mb-modal-total-val" id="modTotal">0 {{ current_currency_symbol() }}</span>
            </div>
            <div class="mb-modal-actions">
                <button type="button" class="mb-btn mb-btn--gray" id="modalModCancel">{{ 'tickets.modal_btn_cancel'|trans }}</button>
                <button type="submit" class="mb-btn mb-btn--orange">
                    <i class="fas fa-check"></i> {{ 'btn.book'|trans }}
                </button>
            </div>
        </form>
    </div>
</div>

{# ---------- MODAL SUPPRIMER ---------- #}
<div class="mb-modal-overlay" id="modalSupprimer">
    <div class="mb-confirm-box">
        <div class="mb-confirm-icon"><i class="fas fa-exclamation-triangle" style="color:var(--red)"></i></div>
        <h3 class="mb-confirm-title">{{ 'tickets.modal_supp_title'|trans }}</h3>
        <p class="mb-confirm-text" id="supprimerText">
            {{ 'tickets.modal_supp_text'|trans }}<br>
            <strong id="supprimerRoute"></strong><br><br>
            {{ 'tickets.modal_supp_warning'|trans|raw }}
        </p>
        <div class="mb-confirm-actions">
            <button type="button" class="mb-btn mb-btn--gray" id="modalSuppCancel">{{ 'tickets.modal_btn_cancel'|trans }}</button>
            <form method="post" id="formSupprimer" style="display:inline">
                <input type="hidden" name="_token" id="suppToken">
                <button type="submit" class="mb-btn mb-btn--red">
                    <i class="fas fa-trash"></i> {{ 'tickets.modal_btn_supp_confirm'|trans }}
                </button>
            </form>
        </div>
    </div>
</div>

{# ---------- TOAST ---------- #}
<div class="mb-toast" id="mbToast"><i class="fas fa-check-circle" id="toastIcon"></i><span id="toastText"></span></div>

{% endblock %}

{% block javascripts %}
<script>
const MB_CURRENCY_RATE = {{ currency_rate()|number_format(6, '.', '') }};
const MB_CURRENCY_SYMBOL = '{{ current_currency_symbol()|e('js') }}';

(function(){
    const btn = document.getElementById('btnTheme'), icon = document.getElementById('themeIcon');
    let dark = localStorage.getItem('mb-dark') === '1';
    function apply(){ document.body.classList.toggle('dark-mode', dark); icon.className = dark ? 'fas fa-sun' : 'fas fa-moon'; }
    apply();
    if(btn) btn.addEventListener('click', () => { dark = !dark; localStorage.setItem('mb-dark', dark ? '1' : '0'); apply(); });
})();

(function(){
    const sel = document.getElementById('sortSelect'), form = document.getElementById('searchForm');
    if(sel && form) sel.addEventListener('change', () => form.submit());
})();

(function(){
    const overlay = document.getElementById('modalModifier'), closeBtn = document.getElementById('modalModClose'), cancelBtn = document.getElementById('modalModCancel'), form = document.getElementById('formModifier'), inputPlaces = document.getElementById('modPlaces');
    let prixUnit = 0;
    document.querySelectorAll('.btn-modifier').forEach(btn => {
        btn.addEventListener('click', () => {
            const d = btn.dataset; prixUnit = parseFloat(d.prix);
            document.getElementById('modBilletId').textContent = '#' + d.id;
            document.getElementById('modRoute').textContent = d.origine + ' → ' + d.destination;
            inputPlaces.value = d.places;
            document.getElementById('modToken').value = d.token;
            form.action = '/user/billets/' + d.id + '/modifier';
            updateModTotal();
            overlay.classList.add('open');
        });
    });
    function updateModTotal(){ const nb = parseInt(inputPlaces.value) || 1; document.getElementById('modTotal').textContent = ((prixUnit * nb) * MB_CURRENCY_RATE).toFixed(2) + ' ' + MB_CURRENCY_SYMBOL; }
    inputPlaces.addEventListener('input', updateModTotal);
    function closeModal(){ overlay.classList.remove('open'); }
    closeBtn.addEventListener('click', closeModal); cancelBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', e => { if(e.target === overlay) closeModal(); });
})();

(function(){
    const overlay = document.getElementById('modalSupprimer'), cancelBtn = document.getElementById('modalSuppCancel'), form = document.getElementById('formSupprimer');
    document.querySelectorAll('.btn-supprimer').forEach(btn => {
        btn.addEventListener('click', () => {
            const d = btn.dataset;
            document.getElementById('supprimerRoute').textContent = 'Ticket #' + d.id + ' — ' + d.origine + ' → ' + d.destination;
            document.getElementById('suppToken').value = d.token;
            form.action = '/user/billets/' + d.id + '/supprimer';
            overlay.classList.add('open');
        });
    });
    function closeModal(){ overlay.classList.remove('open'); }
    cancelBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', e => { if(e.target === overlay) closeModal(); });
})();

(function(){
    function showToast(msg, type){
        const toast = document.getElementById('mbToast'), icon = document.getElementById('toastIcon');
        document.getElementById('toastText').textContent = msg;
        toast.className = 'mb-toast show ' + (type || '');
        icon.className = type === 'success' ? 'fas fa-check-circle' : 'fas fa-exclamation-circle';
        setTimeout(() => toast.classList.remove('show'), 4500);
    }
    {% for msg in app.flashes('success') %} showToast('{{ msg|e('js') }}', 'success'); {% endfor %}
    {% for msg in app.flashes('error') %} showToast('{{ msg|e('js') }}', 'error'); {% endfor %}
})();
</script>
{% endblock %}



