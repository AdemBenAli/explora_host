{% extends 'base.html.twig' %}
{% block title %}{{ activite.nom }} | Détail Activité{% endblock %}

{% block stylesheets %}
    {% include 'partials/admin_styles.html.twig' %}
    <style>
        .detail-card { background: var(--bg-card); border-radius: 20px; border: 1px solid var(--border-color); overflow: hidden; margin-bottom: 24px; }
        .detail-header { padding: 30px; border-bottom: 1px solid var(--border-color); display: flex; gap: 30px; }
        .detail-img { width: 300px; height: 200px; border-radius: 15px; object-fit: cover; box-shadow: 0 10px 25px rgba(0,0,0,0.1); }
        .detail-info { flex: 1; }
        .detail-title { font-size: 28px; font-weight: 800; color: var(--text-heading); margin-bottom: 10px; }
        .detail-meta { display: flex; gap: 20px; color: var(--text-body); font-size: 14px; margin-bottom: 20px; }
        .detail-meta i { color: var(--accent); }
        .info-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; padding: 30px; background: var(--bg-body); }
        .info-item { text-align: center; }
        .info-label { font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-body); margin-bottom: 5px; }
        .info-value { font-size: 18px; font-weight: 700; color: var(--text-heading); }
        .avis-section { padding: 30px; }
        .avis-item { background: var(--bg-body); padding: 20px; border-radius: 12px; margin-bottom: 15px; border-left: 4px solid var(--accent); }
        .avis-header { display: flex; justify-content: space-between; margin-bottom: 10px; }
        .avis-user { font-weight: 700; color: var(--text-heading); }
        .avis-date { font-size: 12px; color: var(--text-body); }
        .avis-content { font-size: 14px; color: var(--text-body); line-height: 1.6; }
        .rating { color: #f59e0b; }
    </style>
{% endblock %}

{% block body %}
    {% set active_route = app.request.attributes.get('_route') %}
    {% include 'partials/agent_sidebar.html.twig' with { active: 'agents' } %}

    <main class="main-content">
        {% include 'partials/agent_topbar.html.twig' %}

        <div class="content-area">
            <div class="breadcrumb">Admin &gt; Activités &gt; <span>{{ activite.nom }}</span></div>

            <div style="margin-bottom: 20px;">
                <a href="javascript:history.back()" style="color:var(--text-body); text-decoration:none; font-weight:600;"><i class="fa-solid fa-arrow-left"></i> Retour</a>
            </div>

            <div class="detail-card">
                <div class="detail-header">
                    {% if activite.image %}
                        {% set imagePath = activite.image starts with('/uploads/') or activite.image starts with('uploads/') ? activite.image : 'uploads/images/' ~ activite.image %}
                        <img src="{{ asset(imagePath) }}" class="detail-img">
                    {% else %}
                        <div class="detail-img" style="background:var(--bg-body); display:grid; place-items:center; font-size:50px">🎯</div>
                    {% endif %}
                    <div class="detail-info">
                        <h1 class="detail-title">{{ activite.nom }}</h1>
                        <div class="detail-meta">
                            <span><i class="fa-solid fa-tag"></i> {{ activite.categorie }}</span>
                            <span><i class="fa-solid fa-location-dot"></i> {{ activite.ville }}, {{ activite.lieu }}</span>
                            {% if activite.dateActivite %}
                                <span><i class="fa-solid fa-calendar"></i> {{ activite.dateActivite|date('d/m/Y') }}</span>
                            {% endif %}
                        </div>
                        <p style="color:var(--text-body); line-height:1.7">{{ activite.description }}</p>
                    </div>
                </div>

                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Prix</div>
                        <div class="info-value" style="color:var(--accent)">{{ activite.prix|number_format(2) }} TND</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Places</div>
                        <div class="info-value">{{ activite.nombrePlaces }}</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Statut</div>
                        <div class="info-value">
                            {% if activite.disponible %}
                                <span style="color:var(--green)">Disponible</span>
                            {% else %}
                                <span style="color:var(--red)">Complet</span>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="avis-section">
                    <div class="section-title">💬 Avis des voyageurs ({{ nbAvis }})</div>
                    {% if nbAvis > 0 %}
                        <div style="margin-bottom: 20px; font-size: 20px; font-weight: 800; color: var(--text-heading);">
                            Moyenne : <span class="rating">{{ moyenne|number_format(1) }} ★</span>
                        </div>
                    {% endif %}

                    {% for a in avis %}
                        <div class="avis-item">
                            <div class="avis-header">
                                <span class="avis-user">{{ a.nomVoyageur }}</span>
                                <div style="display:flex; align-items:center; gap:10px">
                                    <span class="rating">{{ a.note }} ★</span>
                                    <span class="avis-date">{{ a.dateAvis|date('d/m/Y H:i') }}</span>
                                    <form method="post" action="{{ path('admin_avis_supprimer', {'id': a.idAvis}) }}" onsubmit="return confirm('Supprimer cet avis ?');" style="margin:0">
                                        <button class="icon-btn" style="color:var(--red); padding:4px"><i class="fa-solid fa-trash-can"></i></button>
                                    </form>
                                </div>
                            </div>
                            <p class="avis-content">{{ a.commentaire }}</p>
                        </div>
                    {% else %}
                        <p style="text-align:center; padding:30px; color:var(--text-body)">Aucun avis pour cette activité.</p>
                    {% endfor %}
                </div>
            </div>
        </div>
    </main>

    {% block javascripts %}
        {% include 'partials/admin_scripts.html.twig' %}
    {% endblock %}
{% endblock %}