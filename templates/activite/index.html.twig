</nav>

<div class="mb-page">

<div class="mb-header">
    <div class="mb-header-left">
        <h1>Activités Disponibles</h1>
        <p>Explorez et réservez des expériences uniques</p>
    </div>
    <div class="mb-header-right">
        <a href="{{ path('activite_index') }}" class="mb-btn mb-btn--orange">
            <i class="fas fa-sync-alt"></i> Actualiser
        </a>
    </div>
</div>

<div class="mb-stats">
    <div class="mb-stat-card">
        <div class="mb-stat-inner">
            <div class="mb-stat-icon mb-stat-icon--blue">
                <i class="fas fa-list"></i>
            </div>
            <div>
                <div class="mb-stat-val">{{ activites|length }}</div>
                <div class="mb-stat-label">Total Activités</div>
            </div>
        </div>
        <div class="mb-stat-sub">Disponibles dans notre catalogue</div>
    </div>
    <div class="mb-stat-card">
        <div class="mb-stat-inner">
            <div class="mb-stat-icon mb-stat-icon--orange">
                <i class="fas fa-globe"></i>
            </div>
            <div>
                <div class="mb-stat-val">Destinations</div>
                <div class="mb-stat-label">Partout dans le monde</div>
            </div>
        </div>
        <div class="mb-stat-sub" style="color:var(--orange);">Explorez sans limites</div>
    </div>
</div>

<div class="mb-table-wrap">

    <div class="mb-tabs-bar">
        <a href="#" class="mb-tab mb-tab--active">
            <i class="fas fa-th-list"></i> Toutes les activités
        </a>
    </div>

    <form method="get" action="{{ path('activite_index') }}" class="mb-search-row">
        <input type="text" name="q" value="{{ app.request.query.get('q') }}" placeholder="Rechercher une activité..." class="mb-input mb-input--search">
        <button type="submit" class="mb-btn mb-btn--orange mb-btn--sm">
            <i class="fas fa-search"></i> Rechercher
        </button>
        <a href="{{ path('activite_index') }}" class="mb-btn mb-btn--gray mb-btn--sm">
            <i class="fas fa-undo"></i> Réinitialiser
        </a>
    </form>

    <table class="mb-table">
        <thead>
            <tr>
                <th>Photo</th>
                <th>Activité</th>
                <th>Lieu / Ville</th>
                <th>Catégorie</th>
                <th>Date</th>
                <th>Places Restantes</th>
                <th>Prix</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% if activites is empty %}
            <tr>
                <td colspan="9">
                    <div class="mb-empty" style="text-align: center; padding: 40px;">
                        <i class="fas fa-folder-open" style="font-size: 40px; color: var(--gray); margin-bottom: 15px;"></i>
                        <p style="font-size: 18px; font-weight: bold; color: var(--navy);">Aucune activité trouvée</p>
                        <span style="color: var(--text-m);">Modifiez vos critères de recherche</span>
                    </div>
                </td>
            </tr>
        {% else %}
            {% for activite in activites %}
            <tr>
                <td>
                    {% if activite.image %}
                        {% set imagePath = activite.image starts with('/uploads/') or activite.image starts with('uploads/') ? activite.image : 'uploads/images/' ~ activite.image %}
                        <img src="{{ asset(imagePath) }}" style="width:60px;height:45px;object-fit:cover;border-radius:4px;">
                    {% else %}
                        <div style="width:60px;height:45px;background:#eee;border-radius:4px;display:flex;align-items:center;justify-content:center;"><i class="fas fa-image" style="color:#aaa;"></i></div>
                    {% endif %}
                </td>
                <td><strong>{{ activite.nom }}</strong></td>
                <td>{{ activite.lieu }} <br><small style="color:var(--gray);">{{ activite.ville }}</small></td>
                <td>{{ activite.categorie }}</td>
                <td>{{ activite.dateActivite ? activite.dateActivite|date('d/m/Y') : '--' }}</td>
                <td style="text-align:center;">{{ activite.nombrePlaces }}</td>
                <td><span class="mb-prix">{{ activite.prix|number_format(2, '.', '') }} TND</span></td>
                <td>
                    {% if activite.disponible %}
                        <span class="mb-badge mb-badge--confirme"><i class="fas fa-check"></i> Disponible</span>
                    {% else %}
                        <span class="mb-badge mb-badge--annule"><i class="fas fa-times"></i> Complet</span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('activite_show', {id: activite.idActivite}) }}" class="mb-btn mb-btn--blue mb-btn--sm">
                        <i class="fas fa-eye"></i> Voir l'offre
                    </a>
                </td>
            </tr>
            {% endfor %}
        {% endif %}
        </tbody>
    </table>

</div>
</div>

</div>

<script>
(function() {
    const q = id => document.getElementById(id);

    // — Dark Mode (clé unifiée) —
    const btn = q('btnThemeGlobal'), icon = q('themeIconGlobal');
    let dark = localStorage.getItem('explora-dark') === '1';
    function applyTheme() {
        document.body.classList.toggle('dark-mode', dark);
        if (icon) icon.className = dark ? 'fas fa-sun' : 'fas fa-moon';
    }
    applyTheme();
    if (btn) btn.addEventListener('click', () => {
        dark = !dark;
        localStorage.setItem('explora-dark', dark ? '1' : '0');
        applyTheme();
    });

    // — User Dropdown —
    const userWrap = q('userWrap'), userToggle = q('userToggle');
    if (userToggle) {
        userToggle.addEventListener('click', e => { e.stopPropagation(); userWrap.classList.toggle('open'); });
        document.addEventListener('click', () => { if(userWrap) userWrap.classList.remove('open'); });
    }

    // — Météo (Open-Meteo, sans clé API) —
    const weatherBtn = q('btnWeatherApi'), weatherOv = q('weatherOverlay');
    const weatherCityInput = q('weatherCityInput'), weatherSearchBtn = q('weatherSearchBtn');

    function getWeatherIcon(code) {
        if (code <= 1) return '☀️';
        if (code <= 3) return '⛅';
        if (code <= 48) return '🌫️';
        if (code <= 82) return '🌧️';
        return '⛈️';
    }

    async function fetchWeather() {
        const city = weatherCityInput?.value.trim() || 'Tunis';
        try {
            const geoRes = await fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(city)}&count=1&language=fr`);
            const geoData = await geoRes.json();
            if (!geoData.results?.length) {
                if(q('weatherMainCity')) q('weatherMainCity').textContent = 'Ville introuvable';
                return;
            }
            const { latitude, longitude, name, country } = geoData.results[0];
            const metRes = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${latitude}&longitude=${longitude}&current=temperature_2m,weathercode&daily=weathercode,temperature_2m_max&timezone=auto&forecast_days=6`);
            const metData = await metRes.json();

            if(q('weatherMainTemp')) q('weatherMainTemp').textContent = Math.round(metData.current.temperature_2m) + '°C';
            if(q('weatherMainCity')) q('weatherMainCity').textContent = `${name}, ${country}`;
            if(q('weatherMainIcon')) q('weatherMainIcon').textContent = getWeatherIcon(metData.current.weathercode);

            const fore = q('weatherForecast');
            if (fore) {
                fore.innerHTML = '';
                metData.daily.time.forEach((date, i) => {
                    const d = document.createElement('div');
                    d.className = 'ut-weather-day';
                    const label = new Date(date).toLocaleDateString('fr-FR', {weekday:'short'});
                    d.innerHTML = `<div style="font-size:10px;opacity:.85">${label}</div><div style="font-size:28px;margin:4px 0">${getWeatherIcon(metData.daily.weathercode[i])}</div><div style="font-weight:700">${Math.round(metData.daily.temperature_2m_max[i])}°</div>`;
                    fore.appendChild(d);
                });
            }
        } catch(e) { console.error('Météo error', e); }
    }

    if (weatherBtn && weatherOv) {
        weatherBtn.addEventListener('click', () => { weatherOv.classList.add('open'); fetchWeather(); });
        if(weatherSearchBtn) weatherSearchBtn.addEventListener('click', fetchWeather);
        if(weatherCityInput) weatherCityInput.addEventListener('keypress', e => { if(e.key==='Enter') fetchWeather(); });
        if(q('weatherClose')) q('weatherClose').addEventListener('click', () => weatherOv.classList.remove('open'));
        weatherOv.addEventListener('click', e => { if(e.target===weatherOv) weatherOv.classList.remove('open'); });
    }

    // — Eco Score —
    const ecoBtn = q('btnEcoScore'), ecoOv = q('ecoScoreModalOverlay');
    if (ecoBtn && ecoOv) {
        ecoBtn.addEventListener('click', () => ecoOv.classList.add('open'));
        if(q('ecoScoreModalClose')) q('ecoScoreModalClose').addEventListener('click', () => ecoOv.classList.remove('open'));
        if(q('ecoScoreDone')) q('ecoScoreDone').addEventListener('click', () => ecoOv.classList.remove('open'));
        ecoOv.addEventListener('click', e => { if(e.target===ecoOv) ecoOv.classList.remove('open'); });
    }
})();
</script>
{% endblock %}