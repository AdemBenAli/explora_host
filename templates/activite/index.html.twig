{% extends 'base.html.twig' %}

{% block title %}Activités - Explora{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
/* ════════════════════════════════════════════════════════
   EXPLORA VOYAGEUR — Activités
   Basé sur le design Mes Billets fourni
════════════════════════════════════════════════════════ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

:root{
  --navy:#1a3a5c; --navy-dark:#0f2540; --navy-mid:#2d5a8a;
  --orange:#f7941d; --orange-dk:#e07800; --orange-lt:#fff3e0;
  --white:#fff; --bg:#f5f7fa; --bg-card:#fff;
  --gray-lt:#f8f9fa; --gray-md:#e9ecef; --gray:#8492a6;
  --text:#212529; --text-m:#6c757d;
  --green:#28a745; --green-lt:#d4edda;
  --red:#dc3545;   --red-lt:#fde8ea;
  --blue:#17a2b8;  --blue-lt:#d1ecf1;
  --r-sm:8px; --r:12px; --r-lg:16px;
  --sh-sm:0 2px 8px rgba(0,0,0,.08);
  --sh:0 4px 20px rgba(0,0,0,.10);
  --tr:.22s ease;
  --fd:'Plus Jakarta Sans',sans-serif;
  --fb:'DM Sans',sans-serif;
  --border-color: #e2e8f0;
}

/* -- DARK MODE -- */
body.dark-mode{
  --navy:#a8c4e0; --navy-dark:#e8f0f8;
  --white:#1e2d40; --bg:#0f1923; --bg-card:#162032;
  --gray-lt:#1e2d40; --gray-md:#2a3d52; --gray:#7a8fa3;
  --text:#e8edf3; --text-m:#8ca0b5;
  --border-color:#334155;
  --orange-lt:rgba(247,148,29,.12);
  --sh-sm:0 2px 8px rgba(0,0,0,.3);
  --sh:0 4px 20px rgba(0,0,0,.4);
}
body.dark-mode .mb-header,
body.dark-mode .mb-tabs-bar,
body.dark-mode .mb-table-wrap,
body.dark-mode .mb-stat-card{ background:#162032; }
body.dark-mode .mb-table th{ background:#1a3a5c; }
body.dark-mode .mb-table td{ border-color:#2a3d52; }
body.dark-mode .mb-table tr:hover td{ background:#1e2d40; }
body.dark-mode .mb-input{ background:#1e2d40; border-color:#2a3d52; color:#e8edf3; }
body.dark-mode .ut-navbar { background:#162032; border-bottom: 1px solid #2a3d52; }
body.dark-mode .dropdown-item:hover{ background:var(--gray-md); }
body.dark-mode .dropdown-item--danger:hover{ background:rgba(220,53,69,0.1); }

/* PAGE */
body{ font-family:var(--fb); background:var(--bg); color:var(--text); min-height:100vh; transition:background var(--tr),color var(--tr); }
.ut-page { display:flex; flex-direction:column; min-height:100vh; }
.mb-page{ max-width:1280px; margin:0 auto; padding:30px; width: 100%; flex:1; }

/* ── NAVBAR ── */
.ut-navbar{
    background:var(--white);
    box-shadow:var(--sh-sm);
    position:sticky;
    top:0;
    z-index:200;
    transition:background var(--tr);
}
.ut-navbar__inner{
    max-width:1440px;
    margin:0 auto;
    padding:0 25px;
    height:64px;
    display:flex;
    align-items:center;
    gap:12px;
}
.ut-navbar__logo{
    display:flex;
    align-items:center;
    gap:10px;
    text-decoration:none;
    font-family:var(--fd);
    font-weight:800;
    font-size:20px;
    color:var(--navy);
    flex-shrink:0;
}
.logo-globe{
    width:38px; height:38px;
    border-radius:50%;
    background:var(--navy);
    display:flex; align-items:center; justify-content:center;
    flex-shrink:0;
}
.logo-globe i{ color:#fff; font-size:16px; }
.logo-name em{ color:var(--orange); font-style:normal; }

/* Nav links */
.ut-navbar__links{
    display:flex;
    gap:4px;
    margin-left:auto;
}
.ut-nav-link{
    font-family:var(--fd);
    font-weight:600;
    font-size:13px;
    color:var(--navy);
    text-decoration:none;
    padding:8px 14px;
    border-radius:var(--r-sm);
    transition:var(--tr);
    white-space:nowrap;
    position:relative;
    padding-bottom:10px;
}
.ut-nav-link:hover{ color:var(--orange); }

/* Soulignement orange actif */
.ut-nav-link--active{
    color:var(--orange);
}
.ut-nav-link--active::after{
    content:'';
    position:absolute;
    bottom:0;
    left:14px;
    right:14px;
    height:3px;
    background:var(--orange);
    border-radius:3px 3px 0 0;
}

.ut-navbar__actions{
    display:flex;
    align-items:center;
    gap:8px;
    margin-left:10px;
}
.ut-theme-btn{
    background:var(--gray-lt);
    border:none;
    border-radius:50%;
    width:40px; height:40px;
    font-size:15px;
    cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    color:var(--navy);
    transition:var(--tr);
    flex-shrink:0;
}
.ut-theme-btn:hover{ background:var(--gray-md); transform:rotate(15deg); }

/* Buttons */
.ut-btn{
    display:inline-flex;
    align-items:center;
    gap:6px;
    font-family:var(--fd);
    font-weight:700;
    font-size:12px;
    padding:9px 16px;
    border-radius:25px;
    border:none;
    cursor:pointer;
    text-decoration:none;
    transition:var(--tr);
    white-space:nowrap;
}
.ut-btn--primary{ background:var(--orange); color:#fff; box-shadow:0 4px 14px rgba(247,148,29,.35); }
.ut-btn--primary:hover{ background:var(--orange-dk); transform:translateY(-1px); }
.ut-btn--secondary{ background:transparent; color:var(--navy); border:1.5px solid var(--navy); }
.ut-btn--secondary:hover{ background:var(--navy); color:#fff; }
.ut-btn--sm{ padding:8px 14px; font-size:12px; }

/* ══════════════ USER DROPDOWN ══════════════ */
.user-profile-wrap{
    position:relative;
}
.user-profile{
    display:flex;
    align-items:center;
    gap:10px;
    cursor:pointer;
    padding-left:14px;
    border-left:1px solid var(--border-color);
    padding:8px 10px 8px 14px;
    border-radius:var(--r-sm);
    transition:var(--tr);
}
.user-profile:hover{ background:var(--gray-lt); }
.user-avatar{
    width:36px; height:36px;
    border-radius:50%;
    object-fit:cover;
}
.user-name{ font-weight:600; color:var(--text); font-size:13px; font-family:var(--fd); }
.user-role{ font-size:11px; color:#94a3b8; }
.user-dropdown-icon{ color:#94a3b8; font-size:11px; transition:transform .2s; }
.user-profile-wrap.open .user-dropdown-icon{ transform:rotate(180deg); }

/* Dropdown menu */
.user-dropdown{
    display:none;
    position:absolute;
    top:calc(100% + 8px);
    right:0;
    background:var(--bg-card);
    border:1px solid var(--border-color);
    border-radius:var(--r-lg);
    box-shadow:var(--sh);
    min-width:200px;
    z-index:300;
    overflow:hidden;
    animation:dropIn .18s ease;
}
@keyframes dropIn{ from{opacity:0;transform:translateY(-6px)} to{opacity:1;transform:translateY(0)} }
.user-profile-wrap.open .user-dropdown{ display:block; }

.dropdown-header{
    padding:14px 16px;
    border-bottom:1px solid var(--border-color);
    display:flex;
    align-items:center;
    gap:10px;
}
.dropdown-header img{ width:38px; height:38px; border-radius:50%; object-fit:cover; }
.dropdown-header-name{ font-weight:700; font-size:13px; color:var(--text); font-family:var(--fd); }
.dropdown-header-role{ font-size:11px; color:#94a3b8; }

.dropdown-item{
    display:flex;
    align-items:center;
    gap:10px;
    padding:11px 16px;
    font-size:13px;
    color:var(--text);
    text-decoration:none;
    font-family:var(--fd);
    font-weight:500;
    transition:var(--tr);
    cursor:pointer;
    background:none;
    border:none;
    width:100%;
    text-align:left;
}
.dropdown-item i{ width:16px; color:var(--gray); font-size:13px; text-align:center; }
.dropdown-item:hover{ background:var(--gray-lt); color:var(--orange); }
.dropdown-item:hover i{ color:var(--orange); }
.dropdown-item--danger{ color:var(--red); }
.dropdown-item--danger i{ color:var(--red); }
.dropdown-item--danger:hover{ background:#fff5f5; color:#c0392b; }
.dropdown-divider{ height:1px; background:var(--border-color); margin:4px 0; }

/* -- HEADER -- */
.mb-header{
  background:var(--bg-card); border-radius:var(--r-lg);
  box-shadow:var(--sh-sm); padding:24px 30px;
  display:flex; align-items:center; justify-content:space-between;
  margin-bottom:24px;
}
.mb-header-left h1{ font-family:var(--fd); font-size:24px; font-weight:800; color:var(--navy); }
.mb-header-left p{ font-size:13px; color:var(--gray); margin-top:4px; }
.mb-header-right{ display:flex; align-items:center; gap:12px; }

.mb-btn{ display:inline-flex; align-items:center; gap:7px; font-family:var(--fd); font-weight:700; font-size:13px; padding:10px 20px; border-radius:25px; border:none; cursor:pointer; text-decoration:none; transition:var(--tr); white-space:nowrap; }
.mb-btn--orange{ background:var(--orange); color:#fff; box-shadow:0 3px 10px rgba(247,148,29,.3); }
.mb-btn--orange:hover{ background:var(--orange-dk); transform:translateY(-1px); }
.mb-btn--gray{ background:var(--gray-lt); color:var(--navy); border:1.5px solid var(--gray-md); }
.mb-btn--gray:hover{ background:var(--gray-md); }
.mb-btn--blue{ background:var(--blue); color:#fff; }
.mb-btn--sm{ padding:7px 14px; font-size:12px; border-radius:20px; }

/* -- STAT CARDS -- */
.mb-stats{ display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-bottom:24px; }
.mb-stat-card{ background:var(--bg-card); border-radius:var(--r-lg); box-shadow:var(--sh-sm); padding:20px; transition:var(--tr); }
.mb-stat-card:hover{ box-shadow:var(--sh); }
.mb-stat-inner{ display:flex; align-items:center; gap:16px; margin-bottom:10px; }
.mb-stat-icon{ width:55px; height:55px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:22px; flex-shrink:0; }
.mb-stat-icon--blue{ background:#e3f2fd; color:#1565c0; }
.mb-stat-icon--orange{ background:var(--orange-lt); color:var(--orange); }
.mb-stat-val{ font-family:var(--fd); font-size:28px; font-weight:800; color:var(--navy); line-height:1; }
.mb-stat-label{ font-size:13px; color:var(--gray); margin-top:3px; }
.mb-stat-sub{ font-size:11px; font-weight:600; color:var(--gray); }

/* -- TABLE WRAPPER -- */
.mb-table-wrap{ background:var(--bg-card); border-radius:var(--r-lg); box-shadow:var(--sh-sm); overflow:hidden; }

.mb-tabs-bar{
  display:flex; align-items:center;
  border-bottom:2px solid var(--gray-md);
  padding:15px 25px 0;
  background:var(--bg-card);
  gap:4px;
}
.mb-tab{
  display:flex; align-items:center; gap:7px;
  padding:12px 22px; height:45px;
  font-family:var(--fd); font-size:14px; font-weight:700;
  color:var(--gray); text-decoration:none;
  border-bottom:3px solid transparent;
  transition:var(--tr); cursor:pointer; white-space:nowrap;
}
.mb-tab:hover{ color:var(--navy); background:var(--gray-lt); }
.mb-tab--active{ color:var(--orange); border-bottom-color:var(--orange); }

.mb-search-row{ display:flex; align-items:center; gap:12px; padding:14px 25px; flex-wrap:wrap; }
.mb-input{
  height:40px; padding:0 14px;
  background:var(--gray-lt); border:1.5px solid var(--gray-md);
  border-radius:var(--r-sm); font-family:var(--fb); font-size:14px;
  color:var(--text); outline:none; transition:var(--tr);
}
.mb-input:focus{ border-color:var(--orange); background:var(--white); }
.mb-input--search{ width:220px; }

.mb-table{ width:100%; border-collapse:collapse; }
.mb-table th{
  background:#2c3e50; color:#fff;
  font-family:var(--fd); font-weight:700; font-size:13px;
  padding:14px 12px; text-align:left;
  border-bottom:2px solid #1a252f;
}
.mb-table td{ padding:13px 12px; border-bottom:1px solid var(--gray-md); font-size:13px; color:var(--text); vertical-align:middle; }
.mb-table tr:last-child td{ border-bottom:none; }
.mb-table tr:nth-child(odd) td{ background:rgba(0,0,0,.015); }
.mb-table tr:hover td{ background:var(--gray-lt); }

.mb-prix{ font-family:var(--fd); font-weight:800; color:var(--orange); }

.mb-badge{ display:inline-flex; align-items:center; gap:5px; padding:4px 12px; border-radius:20px; font-family:var(--fd); font-weight:700; font-size:11px; text-transform:uppercase; letter-spacing:.4px; }
.mb-badge--confirme{ background:var(--green-lt); color:var(--green); }
.mb-badge--annule{ background:var(--red-lt); color:var(--red); }

@media(max-width:900px){
  .mb-stats{ grid-template-columns:1fr 1fr; }
  .mb-page{ padding:16px; }
  .mb-table-wrap{ overflow-x:auto; }
  .mb-table{ min-width:800px; }
}
@media(max-width:768px){
  .ut-navbar__links{display:none}
}

/* Active nav link underline */
.ut-nav-link--active { color: var(--orange); }
.ut-nav-link--active::after {
    content: '';
    position: absolute;
    bottom: 0; left: 14px; right: 14px;
    height: 3px;
    background: var(--orange);
    border-radius: 3px 3px 0 0;
}
/* Météo + Modal overlays */
.ut-weather-overlay{position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:9999;display:none;align-items:center;justify-content:center;backdrop-filter:blur(4px);}
.ut-weather-overlay.open{display:flex!important;}
.ut-weather-box{background:linear-gradient(150deg,#1a3a5c,#2d5a8a);color:#fff;border-radius:20px;width:min(760px,94vw);max-height:88vh;overflow:auto;padding:26px;box-shadow:0 24px 60px rgba(0,0,0,.35);}
.ut-weather-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:18px;}
.ut-weather-title{font-family:var(--fd);font-size:24px;font-weight:800;}
.ut-weather-close{width:34px;height:34px;border-radius:50%;border:0;cursor:pointer;color:#1a3a5c;background:#fff;font-weight:700;font-size:18px;}
.ut-weather-search{display:flex;gap:10px;margin-bottom:14px;}
.ut-weather-search input{flex:1;height:44px;border:0;border-radius:10px;padding:0 12px;font-size:14px;color:#333;}
.ut-weather-search button{height:44px;border:0;border-radius:10px;background:#f7941d;color:#fff;font-weight:700;padding:0 14px;cursor:pointer;}
.ut-weather-main{display:flex;align-items:center;gap:16px;margin-bottom:16px;}
.ut-weather-icon{font-size:58px;}
.ut-weather-temp{font-size:48px;font-weight:800;line-height:1;}
.ut-weather-city{font-size:18px;opacity:.95;}
.ut-weather-forecast{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:10px;}
.ut-weather-day{background:rgba(255,255,255,.13);border-radius:12px;padding:10px;text-align:center;}
.ut-modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:9999;display:none;align-items:center;justify-content:center;backdrop-filter:blur(4px);}
.ut-modal-overlay.open{display:flex!important;}
.ut-modal-box{background:var(--bg-card);border-radius:var(--r-lg);padding:36px 40px;max-width:480px;width:90%;box-shadow:0 30px 80px rgba(0,0,0,.4);position:relative;}
.ut-modal-close{position:absolute;top:16px;right:16px;background:var(--gray-lt);border:none;border-radius:50%;width:34px;height:34px;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--navy);}
.ut-modal-title{font-family:var(--fd);font-size:20px;font-weight:800;color:var(--navy);margin-bottom:6px;}
.ut-btn--primary{background:var(--orange);color:#fff;border:none;}
.ut-btn--primary:hover{background:var(--orange-dk);}
</style>
{% endblock %}

{% block body %}
