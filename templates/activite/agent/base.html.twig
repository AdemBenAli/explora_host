{% extends 'base.html.twig' %}
{% block title %}Mes Activités | Explora Agent{% endblock %}

{% block body %}
<div style="display:flex;min-height:100vh;background:#f5f7fa;">

  {# ═══ SIDEBAR ═══ #}
  <aside style="width:240px;min-width:240px;background:#1e3a5f;
                display:flex;flex-direction:column;padding:20px 0;">

    <div style="display:flex;align-items:center;gap:10px;padding:10px 30px 30px;">
      <span style="font-size:28px;color:#ff8c42;">🎯</span>
      <span style="color:white;font-size:18px;font-weight:bold;">Explora Agent</span>
    </div>

    <nav style="padding:0 15px;display:flex;flex-direction:column;gap:4px;">
      <span style="color:rgba(255,255,255,.5);font-size:10px;font-weight:bold;
                   padding:10px 10px 5px;text-transform:uppercase;">
        Mes Données
      </span>

      {# Activités — actif #}
      <a href="{{ path('agent_activite_index') }}"
         style="display:flex;align-items:center;gap:10px;padding:12px 15px;
                background:rgba(102,126,234,.20);border-left:3px solid #667eea;
                color:white;font-weight:bold;text-decoration:none;
                border-radius:0 8px 8px 0;font-size:13px;">
        🎯 Mes Activités
      </a>

      <span style="color:rgba(255,255,255,.5);font-size:10px;font-weight:bold;
                   padding:14px 10px 5px;text-transform:uppercase;">
        Navigation
      </span>
      <a href="#"
         style="display:flex;align-items:center;gap:10px;padding:12px 15px;
                color:rgba(255,255,255,.75);text-decoration:none;font-size:13px;
                border-radius:8px;">
        📊 Tableau de bord
      </a>
    </nav>

    <div style="margin-top:auto;padding:0 15px 16px;">
      <div style="background:rgba(255,255,255,.07);border-radius:12px;padding:14px 16px;">
        <div style="font-size:12px;color:rgba(255,255,255,.5);margin-bottom:4px;">Connecté en tant que</div>
        <div style="font-size:14px;font-weight:bold;color:white;">
          {{ agent.prenom }} {{ agent.nom }}
        </div>
        <div style="font-size:11px;color:rgba(255,255,255,.5);">Agent</div>
      </div>
    </div>
  </aside>

  {# ═══ CONTENU PRINCIPAL ═══ #}
  <div style="flex:1;display:flex;flex-direction:column;overflow:hidden;">

    {# Header #}
    <div style="background:white;padding:20px 36px;
                border-bottom:1px solid #e0e6ed;
                display:flex;align-items:center;gap:16px;">
      <div>
        <div style="font-size:22px;font-weight:bold;color:#1e3a5f;">
          🎯 Mes Activités
        </div>
        <div style="font-size:12px;color:#8492a6;margin-top:2px;">
          Gérez vos activités : ajout, modification, suppression
        </div>
      </div>
      <div style="margin-left:auto;">
        <a href="{{ path('agent_activite_new') }}"
           style="background:#ff8c42;color:white;padding:11px 22px;
                  border-radius:10px;text-decoration:none;font-weight:bold;
                  font-size:13px;box-shadow:0 4px 12px rgba(255,140,66,.4);">
          ➕ Nouvelle Activité
        </a>
      </div>
    </div>

    <div style="flex:1;overflow-y:auto;padding:28px 36px;">

      {# Flash #}
      {% for msg in app.flashes('success') %}
        <div style="background:#d6f5e3;color:#1a7a45;padding:12px 18px;
                    border-left:4px solid #1a7a45;border-radius:6px;margin-bottom:16px;">
          ✔ {{ msg }}
        </div>
      {% endfor %}
      {% for msg in app.flashes('error') %}
        <div style="background:#fde8e8;color:#c0392b;padding:12px 18px;
                    border-left:4px solid #c0392b;border-radius:6px;margin-bottom:16px;">
          ⚠ {{ msg }}
        </div>
      {% endfor %}

      {# Stats #}
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:26px;">

        <div style="background:white;border-radius:12px;padding:20px 22px;
                    box-shadow:0 2px 12px rgba(0,0,0,.07);
                    display:flex;align-items:center;gap:14px;">
          <div style="background:#fff3e0;border-radius:50%;width:50px;height:50px;
                      display:flex;align-items:center;justify-content:center;font-size:22px;">🎯</div>
          <div>
            <div style="font-size:28px;font-weight:bold;color:#1e3a5f;">{{ stats.total }}</div>
            <div style="font-size:12px;color:#8492a6;">Total</div>
          </div>
        </div>

        <div style="background:white;border-radius:12px;padding:20px 22px;
                    box-shadow:0 2px 12px rgba(0,0,0,.07);
                    display:flex;align-items:center;gap:14px;">
          <div style="background:#e3f2fd;border-radius:50%;width:50px;height:50px;
                      display:flex;align-items:center;justify-content:center;font-size:22px;">✅</div>
          <div>
            <div style="font-size:28px;font-weight:bold;color:#1e3a5f;">{{ stats.disponible }}</div>
            <div style="font-size:12px;color:#8492a6;">Disponibles</div>
          </div>
        </div>

        <div style="background:white;border-radius:12px;padding:20px 22px;
                    box-shadow:0 2px 12px rgba(0,0,0,.07);
                    display:flex;align-items:center;gap:14px;">
          <div style="background:#fce4ec;border-radius:50%;width:50px;height:50px;
                      display:flex;align-items:center;justify-content:center;font-size:22px;">❌</div>
          <div>
            <div style="font-size:28px;font-weight:bold;color:#1e3a5f;">{{ stats.completes }}</div>
            <div style="font-size:12px;color:#8492a6;">Complètes</div>
          </div>
        </div>
      </div>

      {# Filtres #}
      <form method="get" action="{{ path('agent_activite_index') }}"
            style="background:white;border-radius:12px;padding:16px 22px;
                   box-shadow:0 2px 10px rgba(0,0,0,.06);margin-bottom:22px;
                   display:flex;flex-wrap:wrap;gap:12px;align-items:center;">
        <span style="font-size:15px;color:#667eea;">🔍</span>
        <input type="text" name="q" value="{{ search }}"
               placeholder="Rechercher…"
               style="flex:1;min-width:180px;padding:9px 14px;
                      border:1px solid #e0e6ed;border-radius:8px;font-size:13px;">

        <select name="categorie"
                style="padding:9px 14px;border:1px solid #e0e6ed;border-radius:8px;
                       font-size:13px;background:white;color:#2c3e50;">
          <option value="">Toutes catégories</option>
          {% for cat in categories %}
            <option value="{{ cat }}" {{ categorie == cat ? 'selected' : '' }}>{{ cat }}</option>
          {% endfor %}
        </select>

        <select name="disponibilite"
                style="padding:9px 14px;border:1px solid #e0e6ed;border-radius:8px;
                       font-size:13px;background:white;color:#2c3e50;">
          <option value="toutes"      {{ disponibilite == 'toutes'      ? 'selected' : '' }}>Toutes</option>
          <option value="disponibles" {{ disponibilite == 'disponibles' ? 'selected' : '' }}>Disponibles</option>
          <option value="completes"   {{ disponibilite == 'completes'   ? 'selected' : '' }}>Complètes</option>
        </select>

        <button type="submit"
                style="background:#667eea;color:white;border:none;border-radius:8px;
                       padding:9px 18px;cursor:pointer;font-weight:bold;font-size:13px;">
          Filtrer
        </button>
        <a href="{{ path('agent_activite_index') }}"
           style="background:#f0f2f5;color:#1e3a5f;border-radius:8px;padding:9px 14px;
                  text-decoration:none;font-size:13px;font-weight:bold;">
          ↺
        </a>
      </form>

      {# Grille d'activités #}
      {% if activites is empty %}
        <div style="text-align:center;padding:80px 20px;background:white;border-radius:16px;">
          <div style="font-size:60px;margin-bottom:16px;">🎯</div>
          <div style="font-size:18px;font-weight:bold;color:#7f8c8d;margin-bottom:8px;">
            Aucune activité pour le moment
          </div>
          <div style="font-size:13px;color:#b0bec5;margin-bottom:24px;">
            Commencez par créer votre première activité
          </div>
          <a href="{{ path('agent_activite_new') }}"
             style="background:#ff8c42;color:white;padding:12px 28px;
                    border-radius:10px;text-decoration:none;font-weight:bold;">
            ➕ Créer une activité
          </a>
        </div>

      {% else %}
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px;">
          {% for activite in activites %}

            <div style="background:white;border-radius:16px;overflow:hidden;
                        box-shadow:0 3px 12px rgba(0,0,0,.09);
                        transition:transform .2s,box-shadow .2s;"
                 onmouseenter="this.style.transform='translateY(-3px)';
                               this.style.boxShadow='0 8px 24px rgba(102,126,234,.22)'"
                 onmouseleave="this.style.transform='';
                               this.style.boxShadow='0 3px 12px rgba(0,0,0,.09)'">

              {# Image #}
              {% if activite.image %}
                {% set imagePath = activite.image starts with('/uploads/') or activite.image starts with('uploads/') ? activite.image : 'uploads/images/' ~ activite.image %}
                <img src="{{ asset(imagePath) }}"
                     alt="{{ activite.nom }}"
                     style="width:100%;height:175px;object-fit:cover;display:block;">
              {% else %}
                <div style="width:100%;height:175px;
                            background:linear-gradient(135deg,#ecf0f1,#bdc3c7);
                            display:flex;align-items:center;justify-content:center;
                            font-size:60px;">🎯</div>
              {% endif %}

              {# Badge dispo #}
              <div style="padding:0 14px;margin-top:-14px;position:relative;z-index:1;">
                <span style="background:{{ activite.disponible ? '#27ae60' : '#e74c3c' }};
                             color:white;padding:4px 10px;border-radius:20px;
                             font-size:10px;font-weight:bold;">
                  {{ activite.disponible ? '✅ Disponible' : '❌ Complet' }}
                </span>
              </div>

              {# Infos #}
              <div style="padding:10px 14px 6px;">
                <div style="font-weight:bold;font-size:15px;color:#2c3e50;margin-bottom:4px;">
                  {{ activite.nom }}
                </div>
                <div style="font-size:11px;color:#667eea;margin-bottom:8px;">
                  🏷️ {{ activite.categorie }} · 📍 {{ activite.ville }}
                </div>
                {% if activite.dateActivite %}
                  <div style="font-size:11px;color:#95a5a6;margin-bottom:6px;">
                    📅 {{ activite.dateActivite|date('d/m/Y') }}
                    {% if activite.heureDebut %}
                      · ⏰ {{ activite.heureDebut|date('H:i') }}
                      {% if activite.heureFin %}– {{ activite.heureFin|date('H:i') }}{% endif %}
                    {% endif %}
                  </div>
                {% endif %}
                <div style="display:flex;justify-content:space-between;align-items:center;">
                  <span style="color:#27ae60;font-weight:bold;font-size:17px;">
                    {{ activite.prix|number_format(2,'.') }} TND
                  </span>
                  <span style="color:#3498db;font-size:11px;font-weight:bold;">
                    👥 {{ activite.nombrePlaces }} places
                  </span>
                </div>
              </div>

              {# Actions CRUD #}
              <div style="display:grid;grid-template-columns:1fr 1fr 1fr;
                          border-top:1px solid #f0f0f0;margin-top:8px;">

                <a href="{{ path('agent_activite_show', {id: activite.idActivite}) }}"
                   style="display:flex;align-items:center;justify-content:center;gap:5px;
                          padding:11px 0;color:#4a90d9;text-decoration:none;
                          font-size:12px;font-weight:bold;
                          border-right:1px solid #f0f0f0;"
                   onmouseenter="this.style.background='#f0f6ff'"
                   onmouseleave="this.style.background=''">
                  👁 Voir
                </a>

                <a href="{{ path('agent_activite_edit', {id: activite.idActivite}) }}"
                   style="display:flex;align-items:center;justify-content:center;gap:5px;
                          padding:11px 0;color:#ff8c42;text-decoration:none;
                          font-size:12px;font-weight:bold;
                          border-right:1px solid #f0f0f0;"
                   onmouseenter="this.style.background='#fff8f3'"
                   onmouseleave="this.style.background=''">
                  ✏️ Modifier
                </a>

                <form method="post"
                      action="{{ path('agent_activite_delete', {id: activite.idActivite}) }}"
                      onsubmit="return confirm('Supprimer « {{ activite.nom }} » ?');"
                      style="margin:0;">
                  <input type="hidden" name="_token"
                         value="{{ csrf_token('delete_agent_' ~ activite.idActivite) }}">
                  <button type="submit"
                          style="width:100%;height:100%;padding:11px 0;
                                 background:transparent;border:none;cursor:pointer;
                                 color:#e74c3c;font-size:12px;font-weight:bold;"
                          onmouseenter="this.style.background='#fff5f5'"
                          onmouseleave="this.style.background='transparent'">
                    🗑 Suppr.
                  </button>
                </form>

              </div>
            </div>

          {% endfor %}
        </div>
      {% endif %}

    </div>{# /padding #}
  </div>{# /contenu #}
</div>
{% endblock %}