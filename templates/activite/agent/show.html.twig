{% extends 'base.html.twig' %}
{% block title %}{{ activite.nom }} | Explora Agent{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --primary:    #1e3a5f;
            --accent:     #f7941d;
            --bg:         #f5f7fa;
            --bg-card:    #ffffff;
            --border:     #e0e6ed;
            --muted:      #8492a6;
            --sidebar-w:  255px;
            --radius-sm:  8px;
            --font:       'Plus Jakarta Sans', sans-serif;
            --font-body:  'DM Sans', sans-serif;
            --shadow-sm:  0 2px 8px rgba(0,0,0,.07);
        }
        body { font-family: var(--font-body); background: var(--bg); color: var(--primary); min-height: 100vh; display: flex; }
        .sidebar { width: var(--sidebar-w); min-height: 100vh; background: #1e3a5f; display: flex; flex-direction: column; position: fixed; left: 0; top: 0; bottom: 0; z-index: 100; overflow-y: auto; }
        .sidebar-logo { display: flex; align-items: center; gap: 12px; padding: 24px 20px 28px; border-bottom: 1px solid rgba(255,255,255,.08); }
        .sidebar-nav { padding: 14px 10px; flex: 1; display: flex; flex-direction: column; }
        .nav-section-label { font-size: 10px; font-weight: 700; letter-spacing: .12em; color: rgba(255,255,255,.32); text-transform: uppercase; padding: 14px 12px 4px; display: block; }
        .nav-item { display: flex; align-items: center; gap: 11px; padding: 10px 14px; border-radius: var(--radius-sm); color: rgba(255,255,255,.68); font-size: 13.5px; font-weight: 500; text-decoration: none; transition: all .18s; font-family: var(--font); }
        .nav-item:hover { background: rgba(247,148,29,.15); color: #fff; }
        .nav-item.active { background: rgba(247,148,29,.18); color: var(--accent); font-weight: 700; border-left: 3px solid var(--accent); padding-left: 11px; }
        .nav-item i { font-size: 15px; width: 20px; text-align: center; flex-shrink: 0; }
        .nav-item-danger { color: rgba(231,76,60,.8) !important; }
        .nav-item-danger:hover { background: rgba(231,76,60,.12) !important; color: #e74c3c !important; }
        .nav-spacer { flex: 1; }
        .nav-bottom { border-top: 1px solid rgba(255,255,255,.08); padding-top: 10px; margin-top: 10px; }
        .main-content { margin-left: var(--sidebar-w); flex: 1; min-height: 100vh; background: var(--bg); display: flex; flex-direction: column; }
        .topbar { height: 70px; background: var(--bg-card); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; padding: 0 36px; position: sticky; top: 0; z-index: 50; box-shadow: var(--shadow-sm); }
        .topbar-title { font-family: var(--font); font-size: 22px; font-weight: 800; color: var(--primary); }
        .topbar-right { display: flex; align-items: center; gap: 14px; }
        .user-profile { display: flex; align-items: center; gap: 10px; padding-left: 14px; border-left: 1px solid var(--border); cursor: pointer; }
        .user-avatar { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; }
        .user-name { font-family: var(--font); font-weight: 700; font-size: 13.5px; color: var(--primary); }
        .user-role { font-size: 11.5px; color: var(--muted); }
        .content-area { flex: 1; padding: 30px 36px; overflow-y: auto; }
        .breadcrumb { font-size: 13px; color: var(--muted); margin-bottom: 24px; font-family: var(--font); }
        .breadcrumb span { color: var(--primary); font-weight: 700; }
        @media (max-width: 768px) { :root { --sidebar-w: 0px; } .sidebar { transform: translateX(-100%); } .content-area { padding: 18px 14px; } }
    </style>
{% endblock %}

{% block body %}
<aside class="sidebar">
    <div class="sidebar-logo">
        <div>{{ include('partials/explora_brand.html.twig', {admin: true, logoHeight: 30}) }}</div>
    </div>
    <nav class="sidebar-nav">
        <span class="nav-section-label">Principal</span>
        <a href="{{ path('agent_dashboard') }}" class="nav-item">
            <i class="fas fa-home"></i> Accueil
        </a>
        <a href="#" class="nav-item">
            <i class="fas fa-users"></i> Clients
        </a>
        <a href="#" class="nav-item">
            <i class="fas fa-calendar-check"></i> Bookings
        </a>
        <a href="#" class="nav-item">
            <i class="fas fa-map-marked-alt"></i> Voyages
        </a>
        <span class="nav-section-label">Inventaire</span>
        <a href="{{ path('agent_activite_index') }}" class="nav-item active">
            <i class="fas fa-person-hiking"></i> Activités
        </a>
        <a href="#" class="nav-item">
            <i class="fas fa-train"></i> Transport
        </a>
        <a href="#" class="nav-item">
            <i class="fas fa-hotel"></i> Hôtels
        </a>
        <span class="nav-section-label">Rapports</span>
        <a href="#" class="nav-item">
            <i class="fas fa-chart-line"></i> Analytique
        </a>
        <a href="#" class="nav-item">
            <i class="fas fa-bullhorn"></i> Réclamations
        </a>
        <div class="nav-spacer"></div>
        <div class="nav-bottom">
            <span class="nav-section-label">Système</span>
            <a href="#" class="nav-item">
                <i class="fas fa-cog"></i> Paramètres
            </a>
            <a href="{{ path('app_logout') }}" class="nav-item nav-item-danger">
                <i class="fas fa-sign-out-alt"></i> Déconnexion
            </a>
        </div>
    </nav>
</aside>

<div class="main-content">
    <header class="topbar">
        <div class="topbar-title">Détails de l'Activité</div>
        <div class="topbar-right">
            <div class="user-profile">
                <img src="https://ui-avatars.com/api/?name={{ agent.prenom }}+{{ agent.nom }}&background=f7941d&color=fff"
                     alt="Agent Avatar" class="user-avatar">
                <div>
                    <div class="user-name">{{ agent.prenom }} {{ agent.nom }}</div>
                    <div class="user-role">Agent Account</div>
                </div>
                <i class="fa-solid fa-chevron-down" style="color:#8492a6; font-size:11px; margin-left:4px;"></i>
            </div>
        </div>
    </header>

    <div class="content-area">
        <div class="breadcrumb">Dashboard &gt; Activités &gt; <span>Détails</span></div>

        <div style="background:#252B3B;padding:16px 32px; border-radius: 12px 12px 0 0;
                    display:flex;align-items:center;gap:14px;">
            <div style="background:#f5a623;border-radius:9px;padding:9px 12px;font-size:20px;">👁</div>
            <div>
                <div style="font-size:18px;font-weight:bold;color:white;">{{ activite.nom }}</div>
                <div style="font-size:11px;color:rgba(255,255,255,.5);">Détails de l'activité</div>
            </div>
            <div style="margin-left:auto;display:flex;gap:10px;">
                <a href="{{ path('agent_activite_edit', {id: activite.idActivite}) }}"
                   style="background:#ff8c42;color:white;border-radius:8px;
                          padding:8px 18px;font-size:12px;font-weight:bold;text-decoration:none;">
                  ✏️ Modifier
                </a>
                <a href="{{ path('agent_activite_index') }}"
                   style="background:rgba(255,255,255,.12);color:white;border:1px solid rgba(255,255,255,.2);
                          border-radius:8px;padding:8px 16px;font-size:12px;font-weight:bold;text-decoration:none;">
                  ← Retour
                </a>
            </div>
        </div>
        <div style="background:#ffffff; border-radius: 0 0 12px 12px; padding:28px 36px; box-shadow:0 3px 12px rgba(0,0,0,.08); border: 1px solid #e0e6f0;">
             <div style="display:flex;gap:20px;margin-bottom:20px; flex-wrap:wrap;">

                {# Photo #}
                <div style="background:white;border-radius:14px;overflow:hidden;flex-shrink:0;
                            width:260px;box-shadow:0 3px 12px rgba(0,0,0,.08);border:1px solid #e0e6f0;">
                  {% if activite.image %}
                    {% set imagePath = activite.image starts with('/uploads/') or activite.image starts with('uploads/') ? activite.image : 'uploads/images/' ~ activite.image %}
                    <img src="{{ asset(imagePath) }}"
                         alt="{{ activite.nom }}"
                         style="width:100%;height:185px;object-fit:cover;display:block;">
                  {% else %}
                    <div style="width:100%;height:185px;background:#edf0f7;
                                display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;">
                      <span style="font-size:42px;color:#c8d0e0;">🖼</span>
                      <span style="font-size:11px;color:#c8d0e0;">Aucune photo</span>
                    </div>
                  {% endif %}
                  <div style="padding:10px;text-align:center;">
                    <span style="background:#eef0fd;color:#667eea;border-radius:20px;
                                 padding:4px 14px;font-size:12px;font-weight:bold;
                                 border:1px solid #d0d5f8;">
                      {{ activite.categorie }}
                    </span>
                  </div>
                </div>

                {# Infos #}
                <div style="flex:1; min-width: 300px; background:white;border-radius:14px;overflow:hidden;
                            box-shadow:0 3px 12px rgba(0,0,0,.07);border:1px solid #e0e6f0;">

                  <div style="padding:18px 20px 14px;border-bottom:1px solid #f0f3f8;">
                    <div style="font-size:22px;font-weight:bold;color:#1a1f2e;margin-bottom:6px;">
                      {{ activite.nom }}
                    </div>
                    <div style="font-size:13px;color:#6b7a90;">
                      📍 {{ activite.lieu }}, {{ activite.ville }}
                    </div>
                  </div>

                  <div style="display:grid;grid-template-columns:1fr 1fr;">
                    <div style="padding:16px 20px;border-right:1px solid #f0f3f8;border-bottom:1px solid #f0f3f8;">
                      <div style="font-size:10px;font-weight:bold;color:#9aaabb;margin-bottom:4px;">PRIX</div>
                      <div style="font-size:26px;font-weight:bold;color:#27ae60;">
                        {{ activite.prix|number_format(2, '.') }} TND
                      </div>
                    </div>
                    <div style="padding:16px 20px;border-bottom:1px solid #f0f3f8;">
                      <div style="font-size:10px;font-weight:bold;color:#9aaabb;margin-bottom:4px;">PLACES</div>
                      <div style="font-size:26px;font-weight:bold;color:#4a90d9;">
                        {{ activite.nombrePlaces }}
                      </div>
                    </div>
                    <div style="padding:16px 20px;border-right:1px solid #f0f3f8;">
                      <div style="font-size:10px;font-weight:bold;color:#9aaabb;margin-bottom:4px;">DURÉE</div>
                      <div style="font-size:20px;font-weight:bold;color:#1a1f2e;">{{ activite.duree }} min</div>
                    </div>
                    <div style="padding:16px 20px;">
                      <div style="font-size:10px;font-weight:bold;color:#9aaabb;margin-bottom:4px;">STATUT</div>
                      {% if activite.disponible %}
                        <span style="background:#d6f5e3;color:#1a7a45;padding:4px 12px;
                                     border-radius:20px;font-size:12px;font-weight:bold;">✔ Disponible</span>
                      {% else %}
                        <span style="background:#fde8e8;color:#c0392b;padding:4px 12px;
                                     border-radius:20px;font-size:12px;font-weight:bold;">✖ Complet</span>
                      {% endif %}
                    </div>
                  </div>

                  <div style="padding:14px 20px;border-top:1px solid #f0f3f8;">
                    <div style="font-size:10px;font-weight:bold;color:#9aaabb;margin-bottom:3px;">DATE & HORAIRES</div>
                    <div style="font-size:13px;font-weight:bold;color:#2c3e50;">
                      {% if activite.dateActivite %}
                        🗓 {{ activite.dateActivite|date('d/m/Y') }}
                      {% else %}—{% endif %}
                      {% if activite.heureDebut and activite.heureFin %}
                        · ⏰ {{ activite.heureDebut|date('H:i') }} → {{ activite.heureFin|date('H:i') }}
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>

              {# Description #}
              <div style="background:white;border-radius:14px;padding:18px 22px;
                          margin-bottom:18px;box-shadow:0 3px 8px rgba(0,0,0,.07);border:1px solid #e0e6f0;">
                <div style="font-size:14px;font-weight:bold;color:#1a1f2e;margin-bottom:10px;">📋 Description</div>
                <hr style="border:none;border-top:1px solid #f0f3f8;margin-bottom:12px;">
                <p style="font-size:13px;color:#4a5568;line-height:1.7;margin:0;">
                  {{ activite.description ?: 'Aucune description.' }}
                </p>
              </div>

              {# Voyages #}
              <div style="background:white;border-radius:14px;padding:18px 22px;
                          box-shadow:0 3px 8px rgba(0,0,0,.07);border:1px solid #e0e6f0;">
                <div style="font-size:14px;font-weight:bold;color:#1a1f2e;margin-bottom:10px;">✈️ Voyages associés</div>
                <hr style="border:none;border-top:1px solid #f0f3f8;margin-bottom:14px;">
                {% if activite.voyages|length > 0 %}
                  <div style="display:flex;flex-wrap:wrap;gap:10px;">
                    {% for voyage in activite.voyages %}
                      <span style="background:#f0f3ff;color:#3a4fa8;border:1px solid #c7d0f8;
                                   border-radius:8px;padding:8px 14px;font-size:12px;font-weight:600;">
                        ✈ {{ voyage.nom }}
                        <span style="color:#8896c8;font-weight:normal;">
                          ({{ voyage.villeDepart }} → {{ voyage.villeArrivee }})
                        </span>
                      </span>
                    {% endfor %}
                  </div>
                {% else %}
                  <p style="font-size:13px;color:#a0aec0;font-style:italic;margin:0;">
                    Aucun voyage associé.
                  </p>
                {% endif %}
              </div>

              {# Actions bas #}
              <div style="display:flex;justify-content:flex-end;gap:12px;
                          padding-top:20px;margin-top:10px;">
                <a href="{{ path('agent_activite_index') }}"
                   style="background:#ecf0f1;color:#7f8c8d;border-radius:9px;
                          padding:11px 24px;font-weight:bold;font-size:13px;text-decoration:none;">
                  ← Retour
                </a>
                <a href="{{ path('agent_activite_edit', {id: activite.idActivite}) }}"
                   style="background:linear-gradient(to right,#667eea,#764ba2);color:white;
                          border-radius:9px;padding:11px 24px;font-weight:bold;
                          font-size:13px;text-decoration:none;">
                  ✎ Modifier
                </a>
                <form method="post"
                      action="{{ path('agent_activite_delete', {id: activite.idActivite}) }}"
                      onsubmit="return confirm('Supprimer définitivement ?');"
                      style="display:inline;">
                  <input type="hidden" name="_token"
                         value="{{ csrf_token('delete_agent_' ~ activite.idActivite) }}">
                  <button style="background:#e74c3c;color:white;border:none;border-radius:9px;
                                 padding:11px 24px;font-weight:bold;font-size:13px;cursor:pointer;">
                    🗑 Supprimer
                  </button>
                </form>
              </div>
        </div>
    </div>
</div>
{% endblock %}