{% extends 'base.html.twig' %}

{% block title %}{{ activite.nom|default('Activité') }} | Explora{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
/* ════════════════════════════════════════════════════════
   EXPLORA VOYAGEUR — Détails de l'activité
════════════════════════════════════════════════════════ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

:root{
  --navy:#1a3a5c; --navy-dark:#0f2540; --navy-mid:#2d5a8a;
  --orange:#f7941d; --orange-dk:#e07800; --orange-lt:#fff3e0;
  --white:#fff; --bg:#f5f7fa; --bg-card:#fff;
  --gray-lt:#f8f9fa; --gray-md:#e9ecef; --gray:#8492a6;
  --text:#212529; --text-m:#6c757d;
  --green:#28a745; --green-lt:#d4edda;
  --red:#dc3545;   --red-lt:#fde8ea;
  --blue:#17a2b8;  --blue-lt:#d1ecf1;
  --r-sm:8px; --r:12px; --r-lg:16px;
  --sh-sm:0 2px 8px rgba(0,0,0,.08);
  --sh:0 4px 20px rgba(0,0,0,.10);
  --tr:.22s ease;
  --fd:'Plus Jakarta Sans',sans-serif;
  --fb:'DM Sans',sans-serif;
  --border-color: #e2e8f0;
}

/* -- DARK MODE -- */
body.dark-mode{
  --navy:#a8c4e0; --navy-dark:#e8f0f8;
  --white:#1e2d40; --bg:#0f1923; --bg-card:#162032;
  --gray-lt:#1e2d40; --gray-md:#2a3d52; --gray:#7a8fa3;
  --text:#e8edf3; --text-m:#8ca0b5;
  --border-color:#334155;
  --orange-lt:rgba(247,148,29,.12);
  --sh-sm:0 2px 8px rgba(0,0,0,.3);
  --sh:0 4px 20px rgba(0,0,0,.4);
}

body.dark-mode .ut-navbar { background:#162032; border-bottom: 1px solid #2a3d52; }
body.dark-mode .dropdown-item:hover{ background:var(--gray-md); }
body.dark-mode .dropdown-item--danger:hover{ background:rgba(220,53,69,0.1); }
body.dark-mode .admin-main-card { background:#162032 !important; border-color:#2a3d52 !important; }
body.dark-mode .dark-box { background:#1e2d40 !important; border-color:#2a3d52 !important; color:#fff !important; }
body.dark-mode .dark-text { color:#e8edf3 !important; }

/* PAGE */
body{ font-family:var(--fb); background:var(--bg); color:var(--text); min-height:100vh; transition:background var(--tr),color var(--tr); }
.ut-page { display:flex; flex-direction:column; min-height:100vh; }
.mb-page{ max-width:1100px; margin:0 auto; padding:30px; width: 100%; flex:1; }

/* ── NAVBAR ── */
.ut-navbar{
    background:var(--white);
    box-shadow:var(--sh-sm);
    position:sticky;
    top:0;
    z-index:200;
    transition:background var(--tr);
}
.ut-navbar__inner{
    max-width:1440px;
    margin:0 auto;
    padding:0 25px;
    height:64px;
    display:flex;
    align-items:center;
    gap:12px;
}
.ut-navbar__logo{
    display:flex;
    align-items:center;
    gap:10px;
    text-decoration:none;
    font-family:var(--fd);
    font-weight:800;
    font-size:20px;
    color:var(--navy);
    flex-shrink:0;
}
.logo-globe{
    width:38px; height:38px;
    border-radius:50%;
    background:var(--navy);
    display:flex; align-items:center; justify-content:center;
    flex-shrink:0;
}
.logo-globe i{ color:#fff; font-size:16px; }
.logo-name em{ color:var(--orange); font-style:normal; }

/* Nav links */
.ut-navbar__links{
    display:flex;
    gap:4px;
    margin-left:auto;
}
.ut-nav-link{
    font-family:var(--fd);
    font-weight:600;
    font-size:13px;
    color:var(--navy);
    text-decoration:none;
    padding:8px 14px;
    border-radius:var(--r-sm);
    transition:var(--tr);
    white-space:nowrap;
    position:relative;
    padding-bottom:10px;
}
.ut-nav-link:hover{ color:var(--orange); }

/* Soulignement orange actif */
.ut-nav-link--active{
    color:var(--orange);
}
.ut-nav-link--active::after{
    content:'';
    position:absolute;
    bottom:0;
    left:14px;
    right:14px;
    height:3px;
    background:var(--orange);
    border-radius:3px 3px 0 0;
}

.ut-navbar__actions{
    display:flex;
    align-items:center;
    gap:8px;
    margin-left:10px;
}
.ut-theme-btn{
    background:var(--gray-lt);
    border:none;
    border-radius:50%;
    width:40px; height:40px;
    font-size:15px;
    cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    color:var(--navy);
    transition:var(--tr);
    flex-shrink:0;
}
.ut-theme-btn:hover{ background:var(--gray-md); transform:rotate(15deg); }

/* Buttons */
.ut-btn{
    display:inline-flex;
    align-items:center;
    gap:6px;
    font-family:var(--fd);
    font-weight:700;
    font-size:12px;
    padding:9px 16px;
    border-radius:25px;
    border:none;
    cursor:pointer;
    text-decoration:none;
    transition:var(--tr);
    white-space:nowrap;
}
.ut-btn--primary{ background:var(--orange); color:#fff; box-shadow:0 4px 14px rgba(247,148,29,.35); }
.ut-btn--primary:hover{ background:var(--orange-dk); transform:translateY(-1px); }
.ut-btn--secondary{ background:transparent; color:var(--navy); border:1.5px solid var(--navy); }
.ut-btn--secondary:hover{ background:var(--navy); color:#fff; }
.ut-btn--sm{ padding:8px 14px; font-size:12px; }

/* ══════════════ USER DROPDOWN ══════════════ */
.user-profile-wrap{
    position:relative;
}
.user-profile{
    display:flex;
    align-items:center;
    gap:10px;
    cursor:pointer;
    padding-left:14px;
    border-left:1px solid var(--border-color);
    padding:8px 10px 8px 14px;
    border-radius:var(--r-sm);
    transition:var(--tr);
}
.user-profile:hover{ background:var(--gray-lt); }
.user-avatar{
    width:36px; height:36px;
    border-radius:50%;
    object-fit:cover;
}
.user-name{ font-weight:600; color:var(--text); font-size:13px; font-family:var(--fd); }
.user-role{ font-size:11px; color:#94a3b8; }
.user-dropdown-icon{ color:#94a3b8; font-size:11px; transition:transform .2s; }
.user-profile-wrap.open .user-dropdown-icon{ transform:rotate(180deg); }

/* Dropdown menu */
.user-dropdown{
    display:none;
    position:absolute;
    top:calc(100% + 8px);
    right:0;
    background:var(--bg-card);
    border:1px solid var(--border-color);
    border-radius:var(--r-lg);
    box-shadow:var(--sh);
    min-width:200px;
    z-index:300;
    overflow:hidden;
    animation:dropIn .18s ease;
}
@keyframes dropIn{ from{opacity:0;transform:translateY(-6px)} to{opacity:1;transform:translateY(0)} }
.user-profile-wrap.open .user-dropdown{ display:block; }

.dropdown-header{
    padding:14px 16px;
    border-bottom:1px solid var(--border-color);
    display:flex;
    align-items:center;
    gap:10px;
}
.dropdown-header img{ width:38px; height:38px; border-radius:50%; object-fit:cover; }
.dropdown-header-name{ font-weight:700; font-size:13px; color:var(--text); font-family:var(--fd); }
.dropdown-header-role{ font-size:11px; color:#94a3b8; }

.dropdown-item{
    display:flex;
    align-items:center;
    gap:10px;
    padding:11px 16px;
    font-size:13px;
    color:var(--text);
    text-decoration:none;
    font-family:var(--fd);
    font-weight:500;
    transition:var(--tr);
    cursor:pointer;
    background:none;
    border:none;
    width:100%;
    text-align:left;
}
.dropdown-item i{ width:16px; color:var(--gray); font-size:13px; text-align:center; }
.dropdown-item:hover{ background:var(--gray-lt); color:var(--orange); }
.dropdown-item:hover i{ color:var(--orange); }
.dropdown-item--danger{ color:var(--red); }
.dropdown-item--danger i{ color:var(--red); }
.dropdown-item--danger:hover{ background:#fff5f5; color:#c0392b; }
.dropdown-divider{ height:1px; background:var(--border-color); margin:4px 0; }

@media(max-width:768px){
  .ut-navbar__links{display:none}
}
</style>
{% endblock %}

{% block body %}
<div class="ut-page">

<nav class="ut-navbar">
    <div class="ut-navbar__inner">

        <!-- Logo -->
        <a href="#" class="ut-navbar__logo">
            {{ include('partials/explora_brand.html.twig', {admin: false, logoHeight: 52}) }}
        </a>

        <!-- Nav links -->
        <div class="ut-navbar__links">
            <a href="#" class="ut-nav-link">{{ 'nav.home'|trans|default('Accueil') }}</a>
            <a href="#" class="ut-nav-link">{{ 'nav.voyages'|trans|default('Voyages') }}</a>
            <a href="#" class="ut-nav-link">{{ 'nav.transport'|trans|default('Transport') }}</a>
            <a href="#" class="ut-nav-link">{{ 'nav.hotels'|trans|default('Hôtels') }}</a>
            <a href="{{ path('activite_index') }}" class="ut-nav-link ut-nav-link--active">Activités</a>
        </div>

        <!-- Actions -->
        <div class="ut-navbar__actions">
            <button class="ut-theme-btn" id="btnThemeGlobal" title="Mode nuit / jour">
                <i class="fas fa-moon" id="themeIconGlobal"></i>
            </button>
            <button type="button" class="ut-btn ut-btn--secondary ut-btn--sm"
                    style="color:#059669;border-color:#059669;background:rgba(5,150,105,.07)">
                🌿 <span>{{ ecoScore.pointsActuels ?? 0 }}</span> PTS
            </button>
            <button type="button" class="ut-btn ut-btn--secondary ut-btn--sm">
                <i class="fas fa-cloud-sun"></i> Météo
            </button>
            <a href="#" class="ut-btn ut-btn--secondary ut-btn--sm">
                <i class="fas fa-map-marked-alt"></i> Carte
            </a>
            <a href="#" class="ut-btn ut-btn--secondary ut-btn--sm">
                <i class="fas fa-plane-departure"></i> Carte Vols
            </a>
            <a href="#" class="ut-btn ut-btn--primary">
                <i class="fas fa-ticket-alt"></i> Mes Réservations
            </a>

            <!-- User dropdown -->
            <div class="user-profile-wrap" id="userWrap">
                <div class="user-profile" id="userToggle">
                    <img src="https://ui-avatars.com/api/?name={{ app.user.nom|default('Louay') }}+{{ app.user.prenom|default('Ouali') }}&background=1e293b&color=fff"
                         alt="Avatar" class="user-avatar">
                    <div>
                        <div class="user-name">{{ app.user.nom|default('Louay Ouali') }}</div>
                        <div class="user-role">{{ app.user.roles[0]|default('Bronze Member') }}</div>
                    </div>
                    <i class="fas fa-chevron-down user-dropdown-icon"></i>
                </div>

                <div class="user-dropdown" id="userDropdown">
                    <div class="dropdown-header">
                        <img src="https://ui-avatars.com/api/?name={{ app.user.nom|default('Louay') }}+{{ app.user.prenom|default('Ouali') }}&background=1e293b&color=fff" alt="Avatar">
                        <div>
                            <div class="dropdown-header-name">{{ app.user.nom|default('Louay Ouali') }}</div>
                            <div class="dropdown-header-role">{{ app.user.roles[0]|default('Bronze Member') }}</div>
                        </div>
                    </div>
                    <a href="#" class="dropdown-item">
                        <i class="fas fa-user"></i> Mon profil
                    </a>
                    <a href="#" class="dropdown-item">
                        <i class="fas fa-cog"></i> Paramètres
                    </a>
                    <div class="dropdown-divider"></div>
                    <a href="{{ path('app_logout') }}" class="dropdown-item dropdown-item--danger">
                        <i class="fas fa-sign-out-alt"></i> Se déconnecter
                    </a>
                </div>
            </div>

        </div>
    </div>
</nav>

<div class="mb-page">

        <div class="admin-main-card" style="padding:0;overflow:hidden;background:#fff;border-radius:16px;box-shadow:var(--sh-sm);">

            {# ══════════════════════════════════════════════ #}
            {# HEADER — identique au BorderPane top en FXML  #}
            {# ══════════════════════════════════════════════ #}
            <div style="background:#252B3B;padding:18px 28px;
                        display:flex;align-items:center;gap:14px;">
                <div style="background:#f5a623;border-radius:10px;padding:9px 12px;
                            font-size:22px;box-shadow:0 0 12px rgba(245,166,35,.5);">👁</div>
                <div>
                    <div style="font-size:18px;font-weight:bold;color:white;">
                        Détails de l'activité
                    </div>
                    <div style="font-size:11px;color:rgba(255,255,255,.55);">
                        Informations complètes · Voyages associés
                    </div>
                </div>
                <div style="margin-left:auto;display:flex;align-items:center;gap:12px;">
                    <a href="{{ path('activite_index') }}"
                       style="background:rgba(255,255,255,.12);color:white;border:1px solid rgba(255,255,255,.2);
                              border-radius:8px;padding:8px 18px;font-weight:bold;font-size:12px;
                              text-decoration:none;">
                        ← Retour aux activités
                    </a>
                </div>
            </div>

            <div style="padding:24px;background:transparent;">

                {# ══════════════════════════════════════════════ #}
                {# LIGNE 1 : Photo + Infos clés (grille 2 stats) #}
                {# ══════════════════════════════════════════════ #}
                <div style="display:flex;gap:20px;margin-bottom:20px;flex-wrap:wrap;">

                    {# ── Photo compacte ── #}
                    <div class="dark-box" style="background:white;border-radius:14px;
                                box-shadow:0 4px 12px rgba(0,0,0,.08);
                                border:1px solid #e0e6f0;flex-shrink:0;width:300px;">
                        {% if activite.image %}
                            {% set imagePath = activite.image starts with('/uploads/') or activite.image starts with('uploads/') ? activite.image : 'uploads/images/' ~ activite.image %}
                            <img src="{{ asset(imagePath) }}"
                                 alt="{{ activite.nom }}"
                                 style="width:100%;height:220px;object-fit:cover;
                                        border-radius:14px 14px 0 0;display:block;">
                        {% else %}
                            <div style="width:100%;height:220px;background:#edf0f7;
                                        border-radius:14px 14px 0 0;display:flex;
                                        flex-direction:column;align-items:center;
                                        justify-content:center;gap:6px;">
                                <span style="font-size:42px;color:#c8d0e0;">🖼</span>
                                <span style="font-size:11px;color:#c8d0e0;">Aperçu photo</span>
                            </div>
                        {% endif %}
                        {# Badge catégorie #}
                        <div style="padding:14px;text-align:center;">
                            <span style="font-size:13px;font-weight:bold;color:#667eea;
                                         background:#eef0fd;border-radius:20px;padding:6px 16px;
                                         border:1px solid #d0d5f8; display:inline-block;">
                                {{ activite.categorie }}
                            </span>
                        </div>
                    </div>

                    {# ── Infos principales ── #}
                    <div class="dark-box" style="flex:1;background:white;border-radius:14px;
                                box-shadow:0 4px 12px rgba(0,0,0,.07);min-width:300px;
                                border:1px solid #e0e6f0;overflow:hidden;">

                        {# Titre + lieu #}
                        <div style="padding:22px 24px 18px;border-bottom:1px solid rgba(0,0,0,.05);">
                            <div class="dark-text" style="font-size:26px;font-weight:bold;color:#1a1f2e;margin-bottom:8px;">
                                {{ activite.nom }}
                            </div>
                            <div style="font-size:14px;color:#6b7a90;">
                                📍 {{ activite.lieu }}, {{ activite.ville }}
                            </div>
                        </div>

                        {# Grille 2×2 de stats #}
                        <div style="display:grid;grid-template-columns:1fr 1fr;">

                            <div style="padding:20px 24px;border-right:1px solid rgba(0,0,0,.05);border-bottom:1px solid rgba(0,0,0,.05);">
                                <div style="font-size:11px;font-weight:bold;color:#9aaabb;margin-bottom:6px;">PRIX</div>
                                <div style="font-size:28px;font-weight:bold;color:#27ae60;">
                                    {{ activite.prix|number_format(2,'.', ' ') }} TND
                                </div>
                            </div>

                            <div style="padding:20px 24px;border-bottom:1px solid rgba(0,0,0,.05);">
                                <div style="font-size:11px;font-weight:bold;color:#9aaabb;margin-bottom:6px;">PLACES RESTANTES</div>
                                <div style="font-size:28px;font-weight:bold;color:#4a90d9;">
                                    {{ activite.nombrePlaces }}
                                </div>
                            </div>

                            <div style="padding:20px 24px;border-right:1px solid rgba(0,0,0,.05);">
                                <div style="font-size:11px;font-weight:bold;color:#9aaabb;margin-bottom:6px;">DURÉE</div>
                                <div class="dark-text" style="font-size:22px;font-weight:bold;color:#1a1f2e;">
                                    {{ activite.duree }} min
                                </div>
                            </div>

                            <div style="padding:20px 24px;">
                                <div style="font-size:11px;font-weight:bold;color:#9aaabb;margin-bottom:6px;">STATUT</div>
                                {% if activite.disponible %}
                                    <span style="background:#d6f5e3;color:#1a7a45;padding:6px 14px;
                                                 border-radius:20px;font-size:13px;font-weight:bold;display:inline-block;margin-top:4px;">
                                        ✔ Disponible
                                    </span>
                                {% else %}
                                    <span style="background:#fde8e8;color:#c0392b;padding:6px 14px;
                                                 border-radius:20px;font-size:13px;font-weight:bold;display:inline-block;margin-top:4px;">
                                        ✖ Indisponible
                                    </span>
                                {% endif %}
                            </div>
                        </div>

                        {# Type + Date/Horaires #}
                        <div style="display:grid;grid-template-columns:1fr 1fr;
                                    border-top:1px solid rgba(0,0,0,.05);">
                            <div style="padding:18px 24px;border-right:1px solid rgba(0,0,0,.05);">
                                <div style="font-size:11px;font-weight:bold;color:#9aaabb;margin-bottom:6px;">TYPE</div>
                                <div class="dark-text" style="font-size:15px;font-weight:bold;color:#2c3e50;">
                                    {{ activite.type ?: '—' }}
                                </div>
                            </div>
                            <div style="padding:18px 24px;">
                                <div style="font-size:11px;font-weight:bold;color:#9aaabb;margin-bottom:6px;">DATE &amp; HORAIRES</div>
                                <div class="dark-text" style="font-size:15px;font-weight:bold;color:#2c3e50;">
                                    {% if activite.dateActivite %}
                                        🗓 {{ activite.dateActivite|date('d/m/Y') }}
                                    {% else %}—{% endif %}
                                    {% if activite.heureDebut and activite.heureFin %}
                                        <br>
                                        ⏰ {{ activite.heureDebut|date('H:i') }} → {{ activite.heureFin|date('H:i') }}
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# ══════════════════════════════════════════════ #}
                {# LIGNE 2 : Description                          #}
                {# ══════════════════════════════════════════════ #}
                <div class="dark-box" style="background:white;border-radius:14px;padding:24px;
                            margin-bottom:20px;box-shadow:0 3px 8px rgba(0,0,0,.07);
                            border:1px solid #e0e6f0;">
                    <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
                        <span style="font-size:18px;">📋</span>
                        <span class="dark-text" style="font-size:16px;font-weight:bold;color:#1a1f2e;">Description</span>
                    </div>
                    <hr style="border:none;border-top:1px solid rgba(0,0,0,.05);margin-bottom:16px;">
                    <p class="dark-text" style="font-size:14px;color:#4a5568;line-height:1.8;margin:0;">
                        {{ activite.description|default('Aucune description disponible.')|nl2br }}
                    </p>
                </div>

                {# ══════════════════════════════════════════════ #}
                {# LIGNE 3 : Voyages associés                     #}
                {# ══════════════════════════════════════════════ #}
                <div class="dark-box" style="background:white;border-radius:14px;padding:24px;
                            margin-bottom:20px;box-shadow:0 3px 8px rgba(0,0,0,.07);
                            border:1px solid #e0e6f0;">
                    <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
                        <span style="font-size:18px;">✈️</span>
                        <span class="dark-text" style="font-size:16px;font-weight:bold;color:#1a1f2e;">Voyages associés</span>
                        <span style="background:#eef0fd;color:#667eea;border-radius:20px;
                                     padding:4px 12px;font-size:12px;font-weight:bold;
                                     border:1px solid #d0d5f8;margin-left:6px;">
                            {{ activite.voyages|length }}
                        </span>
                    </div>
                    <hr style="border:none;border-top:1px solid rgba(0,0,0,.05);margin-bottom:18px;">

                    {% if activite.voyages|length > 0 %}
                        <div style="display:flex;flex-wrap:wrap;gap:12px;">
                            {% for voyage in activite.voyages %}
                                <span style="background:#f0f3ff;color:#3a4fa8;border:1px solid #c7d0f8;
                                             border-radius:8px;padding:10px 16px;font-size:13px;
                                             font-weight:600;display:inline-flex;align-items:center;gap:8px;">
                                    ✈ {{ voyage.nom }}
                                    <span style="color:#8896c8;font-weight:normal;">
                                        ({{ voyage.villeDepart }} → {{ voyage.villeArrivee }})
                                    </span>
                                </span>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p style="font-size:14px;color:#a0aec0;font-style:italic;margin:0;">
                            Aucun voyage associé à cette activité.
                        </p>
                    {% endif %}
                </div>

                {# ══════════════════════════════════════════════ #}
                {# ACTIONS BAS DE PAGE                            #}
                {# ══════════════════════════════════════════════ #}
                <div style="display:flex;justify-content:space-between;align-items:center;
                            padding-top:20px;border-top:1px solid rgba(0,0,0,.1);">
                    <a href="{{ path('activite_index') }}"
                       class="ut-btn ut-btn--ghost" style="padding:12px 24px;font-size:14px;">
                        ← Retour à la liste
                    </a>
                    
                    {% if activite.disponible and activite.nombrePlaces > 0 %}
                        <button class="ut-btn ut-btn--primary" style="padding:12px 30px;font-size:15px;box-shadow:0 4px 15px rgba(247,148,29,.4);">
                            <i class="fas fa-ticket-alt"></i> Réserver cette activité
                        </button>
                    {% else %}
                        <button class="ut-btn ut-btn--secondary" disabled style="padding:12px 30px;font-size:15px;opacity:0.6;cursor:not-allowed;">
                            Complet
                        </button>
                    {% endif %}
                </div>

            </div>{# /padding #}
        </div>{# /admin-main-card #}

</div>
</div>

<script>
    const btn = document.getElementById('btnThemeGlobal');
    const icon = document.getElementById('themeIconGlobal');
    let dark = localStorage.getItem('mb-dark') === '1';
    function apply() {
        document.body.classList.toggle('dark-mode', dark);
        if (icon) icon.className = dark ? 'fas fa-sun' : 'fas fa-moon';
    }
    apply();
    if (btn) btn.addEventListener('click', () => {
        dark = !dark;
        localStorage.setItem('mb-dark', dark ? '1' : '0');
        apply();
    });

    // User dropdown toggle
    const userWrap = document.getElementById('userWrap');
    const userToggle = document.getElementById('userToggle');
    if (userToggle) {
        userToggle.addEventListener('click', (e) => {
            e.stopPropagation();
            userWrap.classList.toggle('open');
        });
        document.addEventListener('click', () => {
            if(userWrap) userWrap.classList.remove('open');
        });
    }
</script>
{% endblock %}