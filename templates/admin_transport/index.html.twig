                <th rowspan="2">Trajet</th>
                <th colspan="2" class="group-header"><i class="fas fa-plane-departure"></i> Départ</th>
                <th colspan="2" class="group-header"><i class="fas fa-plane-arrival"></i> Arrivée</th>
                <th rowspan="2">Prix</th>
                <th rowspan="2">Places</th>
                <th rowspan="2">N&deg; Vol</th>
                <th rowspan="2"><i class="fas fa-robot"></i> Retard IA</th>
                <th rowspan="2">Saturation</th>
                <th rowspan="2">Actions</th>
            </tr>
            <tr>
                <th>Date</th>
                <th>Heure</th>
                <th>Date</th>
                <th>Heure</th>
            </tr>
        </thead>
        <tbody>
                {% set totalTransports = 0 %}
                {% set totalBilletsActifs = 0 %}
        {% if transports is empty %}
            <tr>
                <td colspan="11">
                    <div class="at-empty">
