{% block javascripts %}
<script>
/* ••••••••••••••••••••••••••••••••••••••••••••••••••
   EXPLORA ADMIN — JavaScript
   Identique AdminTransportController Java
•••••••••••••••••••••••••••••••••••••••••••••••••• */

/* àƒÂ¢à¢â‚¬Âà¢â€šÂ¬àƒÂ¢à¢â‚¬Âà¢â€šÂ¬ 1. MODE NUIT/JOUR (identique Java toggleTheme()) àƒÂ¢à¢â‚¬Âà¢â€šÂ¬àƒÂ¢à¢â‚¬Âà¢â€šÂ¬ */
(function(){
    const btn  = document.getElementById('btnTheme');
    const icon = document.getElementById('themeIcon');
    let dark = localStorage.getItem('at-dark') === '1';
    function apply(){
        document.body.classList.toggle('dark-mode', dark);
        icon.className = dark ? 'fas fa-sun' : 'fas fa-moon';
    }
    apply();
    if(btn) btn.addEventListener('click', () => {
        dark = !dark;
        localStorage.setItem('at-dark', dark ? '1' : '0');
        apply();
    });
})();

/* àƒÂ¢à¢â‚¬Âà¢â€šÂ¬àƒÂ¢à¢â‚¬Âà¢â€šÂ¬ 2. TRI INSTANTANÉ (identique Java comboTri.setOnAction) àƒÂ¢à¢â‚¬Âà¢â€šÂ¬àƒÂ¢à¢â‚¬Âà¢â€šÂ¬ */
(function(){
    const sel  = document.getElementById('sortSelect');
    const form = document.getElementById('searchForm');
    if(sel && form) sel.addEventListener('change', () => form.submit());
})();

/* àƒÂ¢à¢â‚¬Âà¢â€šÂ¬àƒÂ¢à¢â‚¬Âà¢â€šÂ¬ 3. MODAL SUPPRIMER (identique Java supprimerTransport + StyledDialogs.showDeleteConfirmation()) àƒÂ¢à¢â‚¬Âà¢â€šÂ¬àƒÂ¢à¢â‚¬Âà¢â€šÂ¬ */
(function(){
    const overlay  = document.getElementById('modalSupprimer');
    const cancelBtn= document.getElementById('modalSuppCancel');
    const form     = document.getElementById('formSupprimer');

    document.querySelectorAll('.btn-supprimer').forEach(btn => {
        btn.addEventListener('click', () => {
            const d = btn.dataset;
            document.getElementById('supprimerTrajet').textContent =
                'Transport #' + d.id + ' — ' + d.trajet;
            document.getElementById('suppToken').value = d.token;
            form.action = '/admin/transport/' + d.id + '/supprimer';
            overlay.classList.add('open');
        });
    });

    function close(){ overlay.classList.remove('open'); }
    cancelBtn.addEventListener('click', close);
    overlay.addEventListener('click', e => { if(e.target === overlay) close(); });
    document.addEventListener('keydown', e => { if(e.key === 'Escape') close(); });
})();

/* àƒÂ¢à¢â‚¬Âà¢â€šÂ¬àƒÂ¢à¢â‚¬Âà¢â€šÂ¬ 4. MODAL STATISTIQUES + PIE CHART (identique Java afficherStatistiques() + PieChart) àƒÂ¢à¢â‚¬Âà¢â€šÂ¬àƒÂ¢à¢â‚¬Âà¢â€šÂ¬ */
(function(){
    const btnStats   = document.getElementById('btnStats');
    const overlay    = document.getElementById('modalStats');
    const closeBtn   = document.getElementById('statsClose');
    const closeBtnBottom = document.getElementById('statsCloseBtn');

    // Donn\u00e9es du PieChart depuis PHP/Twig
    const pieData = {{ pieData|json_encode|raw }};
    const colors  = {
        'AVION':'#3498db','TRAIN':'#e74c3c','BUS':'#f39c12',
        'BATEAU':'#1abc9c','TAXI':'#f7941d','VOITURE':'#9b59b6'
    };

    // Dessiner le PieChart sur Canvas (identique Java PieChart JavaFX)
    function drawPie(){
        const canvas = document.getElementById('pieCanvas');
        if(!canvas || !pieData.length) return;

        const ctx = canvas.getContext('2d');
        const cx = canvas.width / 2, cy = canvas.height / 2, r = 90;
        let startAngle = -Math.PI / 2;
        const total = pieData.reduce((s, d) => s + d.value, 0);

        ctx.clearRect(0, 0, canvas.width, canvas.height);

        pieData.forEach(d => {
            const slice = (d.value / total) * 2 * Math.PI;
            ctx.beginPath();
            ctx.moveTo(cx, cy);
            ctx.arc(cx, cy, r, startAngle, startAngle + slice);
            ctx.closePath();
            ctx.fillStyle = colors[d.label] || '#8492a6';
            ctx.fill();
            ctx.strokeStyle = '#fff';
            ctx.lineWidth = 2;
            ctx.stroke();

            // Label pourcentage
            const midAngle = startAngle + slice / 2;
            const lx = cx + (r * 0.65) * Math.cos(midAngle);
            const ly = cy + (r * 0.65) * Math.sin(midAngle);
            ctx.fillStyle = '#fff';
            ctx.font = 'bold 12px Plus Jakarta Sans, sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            if(d.percent >= 8) ctx.fillText(d.percent + '%', lx, ly);

            startAngle += slice;
        });

        // Cercle central (donut)
        ctx.beginPath();
        ctx.arc(cx, cy, r * 0.42, 0, 2 * Math.PI);
        ctx.fillStyle = getComputedStyle(document.body).getPropertyValue('--bg-card') || '#fff';
        ctx.fill();
    }

    function openModal(){ overlay.classList.add('open'); setTimeout(drawPie, 100); }
    function closeModal(){ overlay.classList.remove('open'); }

    if(btnStats) btnStats.addEventListener('click', (e) => { e.preventDefault(); openModal(); });
    if(closeBtn) closeBtn.addEventListener('click', closeModal);
    if(closeBtnBottom) closeBtnBottom.addEventListener('click', closeModal);
    overlay.addEventListener('click', e => { if(e.target === overlay) closeModal(); });
    document.addEventListener('keydown', e => { if(e.key === 'Escape') closeModal(); });
})();

/* àƒÂ¢à¢â‚¬Âà¢â€šÂ¬àƒÂ¢à¢â‚¬Âà¢â€šÂ¬ 5. TOAST FLASH SYMFONY àƒÂ¢à¢â‚¬Âà¢â€šÂ¬àƒÂ¢à¢â‚¬Âà¢â€šÂ¬ */
(function(){
    function showToast(msg, type){
        const toast = document.getElementById('atToast');
        const icon  = document.getElementById('toastIcon');
        document.getElementById('toastText').textContent = msg;
        toast.className = 'at-toast show ' + (type || '');
        icon.className  = type === 'success' ? 'fas fa-check-circle' : 'fas fa-exclamation-circle';
        setTimeout(() => toast.classList.remove('show'), 4500);
    }

    {% for msg in app.flashes('success') %}
        showToast('{{ msg|e('js') }}', 'success');
    {% endfor %}
    {% for msg in app.flashes('error') %}
        showToast('{{ msg|e('js') }}', 'error');
    {% endfor %}
})();

/* àƒÂ¢à¢â‚¬Âà¢â€šÂ¬àƒÂ¢à¢â‚¬Âà¢â€šÂ¬ 6. ANALYSE IA TRAFIC (identique Java analyserTrafic()) àƒÂ¢à¢â‚¬Âà¢â€šÂ¬àƒÂ¢à¢â‚¬Âà¢â€šÂ¬ */
(function(){
    const fileInput = document.getElementById('iaFileInput');
    const modal     = document.getElementById('modalIA');
    const loader    = document.getElementById('iaLoader');
    const resultDiv = document.getElementById('iaResult');
    let currentTransportId = null;

    const colors = {
        'EMBOUTEILLAGE': { bg: '#fee2e2', text: '#dc2626' },
        'DENSE': { bg: '#ffedd5', text: '#ea580c' },
        'MODERE': { bg: '#fef9c3', text: '#ca8a04' },
        'FLUIDE': { bg: '#d1fae5', text: '#16a34a' }
    };

    // Cliquer sur le robot d'un transport sp\u00e9cifique
    document.querySelectorAll('.btn-ia-analyse').forEach(btn => {
        btn.addEventListener('click', () => {
            currentTransportId = btn.dataset.id;
            fileInput.click();
        });
    });

    fileInput.addEventListener('change', async function() {
        if (!this.files || !this.files[0] || !currentTransportId) return;

        const file = this.files[0];
        modal.classList.add('open');
        loader.style.display = 'block';
        resultDiv.style.display = 'none';

        const formData = new FormData();
        formData.append('image', file);

        try {
            // URL dynamique avec l'ID du transport
            const url = '/admin/transport/' + currentTransportId + '/analyser-ia';
            const resp = await fetch(url, {
                method: 'POST',
                body: formData
            });
            const data = await resp.json();

            loader.style.display = 'none';
            resultDiv.style.display = 'block';

            if (data.success) {
                document.getElementById('iaIcon').textContent = data.icone;
                document.getElementById('iaBadge').textContent = data.label.toUpperCase();
                document.getElementById('iaBadge').style.backgroundColor = colors[data.etat].bg;
                document.getElementById('iaBadge').style.color = colors[data.etat].text;
                document.getElementById('iaJustification').textContent = data.justification;

                // 🔥 MISE À JOUR DYNAMIQUE DU RETARD DANS LE TABLEAU
                const delayCell = document.getElementById('delay-cell-' + currentTransportId);
                if (delayCell && data.delay) {
                    delayCell.innerHTML = `
                        <div class="delay-badge" title="${data.delay.justification}"
                             style="color: ${data.delay.color}; border-radius: 4px; padding: 2px 6px; background: ${data.delay.color}11; font-size: 11px; font-weight: 700; display: inline-flex; align-items: center; gap: 4px; cursor: help;">
                             ${data.delay.icon} ${data.delay.label}
                        </div>
                    `;
                }
            } else {
                document.getElementById('iaIcon').textContent = 'àƒÂ¢à…Â¡à‚Â àƒÂ¯à‚Â¸à‚Â';
                document.getElementById('iaBadge').textContent = 'ERREUR';
                document.getElementById('iaBadge').style.backgroundColor = '#f1f1f1';
                document.getElementById('iaJustification').textContent = data.error || 'Erreur lors de l\'analyse.';
            }
        } catch (e) {
            loader.style.display = 'none';
            resultDiv.style.display = 'block';
            document.getElementById('iaIcon').textContent = 'àƒÂ¢à‚Âà…â€™';
            document.getElementById('iaJustification').textContent = 'Erreur de connexion au serveur.';
        }

        // Reset
        this.value = '';
        currentTransportId = null;
    });
})();

</script>
