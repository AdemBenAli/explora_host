                <td>{{ transport.heureDepart ? transport.heureDepart|date('H:i') : '—' }}</td>
                <td>{{ transport.dateArrivee ? transport.dateArrivee|date('d/m/Y') : '—' }}</td>
                <td>{{ transport.heureArrivee ? transport.heureArrivee|date('H:i') : '—' }}</td>
                <td>
                    <div class="at-prix-block">
                        {% if transport.prixOriginal and transport.prixOriginal != transport.prix %}
