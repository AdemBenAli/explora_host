        <div class="svc-link">Explorer les activités <i class="fas fa-arrow-right"></i></div>
      </a>
      <a href="{{ path('user_transport') }}" class="service-card">
        <div class="svc-icon"><i class="fas fa-bus-alt"></i></div>
        <div class="svc-title">Transport</div>
        <div class="svc-desc">Avion, train, bus, voiture — tous vos besoins de déplacement en un seul endroit.</div>
