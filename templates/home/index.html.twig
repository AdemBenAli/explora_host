    <p class="hero-sub">Découvrez des destinations extraordinaires, réservez vos activités, transports et hébergements en quelques clics. Votre aventure commence ici.</p>
    <div class="hero-actions">
      <a href="{{ path('voyages') }}" class="btn btn-primary" style="padding:14px 30px;font-size:15px;border-radius:30px;">
        <i class="fas fa-compass"></i> Explorer les voyages
      </a>
      <a href="{{ path('app_login') }}" class="btn btn-outline" style="padding:14px 30px;font-size:15px;border-radius:30px;">
        <i class="fas fa-user"></i> Mon compte
      </a>
    </div>
  </div>
  <div class="hero-scroll"><i class="fas fa-chevron-down"></i></div>
</section>

<!-- STATS -->
<div class="stats">
  <div class="stats-inner">
    <div class="stat-item">
      <div class="stat-num">50<span>+</span></div>
      <div class="stat-label">Destinations</div>
    </div>
    <div class="stat-item">
      <div class="stat-num">1<span>k+</span></div>
      <div class="stat-label">Voyageurs satisfaits</div>
    </div>
    <div class="stat-item">
      <div class="stat-num">200<span>+</span></div>
      <div class="stat-label">Activités disponibles</div>
    </div>
    <div class="stat-item">
      <div class="stat-num">4.9<span>★</span></div>
      <div class="stat-label">Note moyenne</div>
    </div>
  </div>
</div>

<!-- SERVICES -->
<div style="background:#fff;">
  <div class="section">
    <div class="section-tag">Nos services</div>
    <h2 class="section-title">Tout ce dont vous<br>avez besoin pour voyager</h2>
    <p class="section-sub">Une plateforme complète pour organiser chaque aspect de votre voyage parfait.</p>
    <div class="services-grid">
      <a href="{{ path('voyages') }}" class="service-card">
        <div class="svc-icon"><i class="fas fa-plane-departure"></i></div>
