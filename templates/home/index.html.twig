<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Explora — Voyagez autrement</title>
<meta name="description" content="Explora, votre plateforme de voyages tout-en-un. Découvrez des destinations uniques, réservez vos activités, transports et hébergements.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --navy:#0f2540;--navy2:#1a3a5c;--orange:#f7941d;--orange2:#e07800;
  --white:#fff;--bg:#f4f7fb;--text:#1e293b;--text2:#64748b;
  --r:14px;--sh:0 8px 32px rgba(15,37,64,.12);--tr:.25s ease;
}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);overflow-x:hidden;}

/* ── NAVBAR ── */
.navbar{position:fixed;top:0;left:0;right:0;z-index:100;padding:0 40px;height:70px;display:flex;align-items:center;justify-content:space-between;background:rgba(15,37,64,.92);backdrop-filter:blur(12px);}
.logo{display:flex;align-items:center;gap:10px;text-decoration:none;}
.logo-icon{width:40px;height:40px;border-radius:50%;background:var(--orange);display:flex;align-items:center;justify-content:center;font-size:18px;color:#fff;}
.logo-text{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:20px;color:#fff;}
.logo-text em{color:var(--orange);font-style:normal;}
.nav-links{display:flex;gap:6px;}
.nav-link{color:rgba(255,255,255,.75);text-decoration:none;font-size:14px;font-weight:600;padding:8px 16px;border-radius:8px;transition:var(--tr);}
.nav-link:hover,.nav-link.active{color:#fff;background:rgba(255,255,255,.1);}
.nav-cta{display:flex;gap:10px;}
.btn{display:inline-flex;align-items:center;gap:8px;padding:10px 22px;border-radius:25px;font-size:14px;font-weight:700;cursor:pointer;text-decoration:none;border:none;transition:var(--tr);font-family:'Plus Jakarta Sans',sans-serif;}
.btn-outline{background:transparent;color:#fff;border:1.5px solid rgba(255,255,255,.4);}
.btn-outline:hover{background:rgba(255,255,255,.1);border-color:#fff;}
.btn-primary{background:var(--orange);color:#fff;box-shadow:0 4px 16px rgba(247,148,29,.4);}
.btn-primary:hover{background:var(--orange2);transform:translateY(-2px);}

/* ── HERO ── */
.hero{min-height:100vh;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;background:linear-gradient(135deg,#0f2540 0%,#1a4070 50%,#0f2540 100%);}
.hero-bg{position:absolute;inset:0;background:url('https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?w=1600&q=80') center/cover no-repeat;opacity:.18;}
.hero-orb{position:absolute;border-radius:50%;filter:blur(80px);}
.hero-orb-1{width:600px;height:600px;background:radial-gradient(circle,rgba(247,148,29,.25),transparent);top:-100px;right:-150px;}
.hero-orb-2{width:400px;height:400px;background:radial-gradient(circle,rgba(26,96,175,.4),transparent);bottom:-50px;left:-100px;}
.hero-content{position:relative;z-index:1;text-align:center;max-width:800px;padding:0 20px;}
.hero-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(247,148,29,.15);border:1px solid rgba(247,148,29,.4);color:var(--orange);border-radius:50px;padding:8px 18px;font-size:13px;font-weight:700;margin-bottom:28px;animation:fadeUp .6s ease both;}
.hero-title{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(40px,6vw,72px);color:#fff;line-height:1.1;margin-bottom:22px;animation:fadeUp .7s .1s ease both;}
.hero-title span{color:var(--orange);}
.hero-sub{font-size:18px;color:rgba(255,255,255,.7);line-height:1.7;max-width:580px;margin:0 auto 40px;animation:fadeUp .8s .2s ease both;}
.hero-actions{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;animation:fadeUp .9s .3s ease both;}
.hero-scroll{position:absolute;bottom:36px;left:50%;transform:translateX(-50%);color:rgba(255,255,255,.5);font-size:22px;animation:bounce 2s infinite;}
@keyframes bounce{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(10px)}}
@keyframes fadeUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}

/* ── STATS ── */
.stats{background:#fff;padding:60px 40px;display:flex;justify-content:center;gap:0;box-shadow:var(--sh);}
.stats-inner{display:flex;gap:0;max-width:900px;width:100%;}
.stat-item{flex:1;text-align:center;padding:20px;border-right:1px solid #e2e8f0;}
.stat-item:last-child{border-right:none;}
.stat-num{font-family:'Plus Jakarta Sans',sans-serif;font-size:40px;font-weight:800;color:var(--navy);line-height:1;}
.stat-num span{color:var(--orange);}
.stat-label{font-size:13px;color:var(--text2);margin-top:6px;font-weight:500;}

/* ── SERVICES ── */
.section{padding:90px 40px;max-width:1200px;margin:0 auto;}
.section-tag{display:inline-block;background:rgba(247,148,29,.12);color:var(--orange);font-size:12px;font-weight:800;letter-spacing:1px;text-transform:uppercase;padding:6px 14px;border-radius:50px;margin-bottom:14px;}
.section-title{font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(28px,4vw,44px);font-weight:800;color:var(--navy);margin-bottom:12px;}
.section-sub{font-size:16px;color:var(--text2);max-width:560px;line-height:1.7;}
.services-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:24px;margin-top:48px;}
.service-card{background:#fff;border-radius:var(--r);padding:32px 28px;box-shadow:0 4px 20px rgba(15,37,64,.07);transition:var(--tr);cursor:pointer;border:1px solid #e8edf5;position:relative;overflow:hidden;text-decoration:none;color:inherit;display:block;}
.service-card::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,var(--navy),var(--navy2));opacity:0;transition:var(--tr);}
.service-card:hover{transform:translateY(-6px);box-shadow:0 16px 48px rgba(15,37,64,.16);}
.service-card:hover::before{opacity:1;}
.service-card:hover .svc-icon,.service-card:hover .svc-title,.service-card:hover .svc-desc,.service-card:hover .svc-link{color:#fff!important;border-color:rgba(255,255,255,.2)!important;}
.service-card:hover .svc-icon{background:rgba(247,148,29,.2)!important;}
.svc-icon{position:relative;z-index:1;width:58px;height:58px;border-radius:14px;background:rgba(15,37,64,.08);display:flex;align-items:center;justify-content:center;font-size:24px;color:var(--navy);margin-bottom:20px;transition:var(--tr);}
.svc-title{position:relative;z-index:1;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:18px;color:var(--navy);margin-bottom:8px;transition:var(--tr);}
.svc-desc{position:relative;z-index:1;font-size:14px;color:var(--text2);line-height:1.6;transition:var(--tr);}
.svc-link{position:relative;z-index:1;display:inline-flex;align-items:center;gap:6px;margin-top:20px;font-size:13px;font-weight:700;color:var(--orange);transition:var(--tr);}

/* ── DESTINATIONS ── */
.destinations-wrap{background:linear-gradient(180deg,#f4f7fb 0%,#e8eef8 100%);padding:90px 40px;}
.destinations-inner{max-width:1200px;margin:0 auto;}
.dest-grid{display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:auto;gap:20px;margin-top:48px;}
.dest-card{border-radius:var(--r);overflow:hidden;position:relative;cursor:pointer;aspect-ratio:4/3;}
.dest-card:first-child{grid-row:span 2;aspect-ratio:auto;}
.dest-card img{width:100%;height:100%;object-fit:cover;transition:transform .5s ease;}
.dest-card:hover img{transform:scale(1.06);}
.dest-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(15,37,64,.8) 0%,transparent 60%);}
.dest-info{position:absolute;bottom:20px;left:20px;color:#fff;}
.dest-name{font-family:'Plus Jakarta Sans',sans-serif;font-size:20px;font-weight:700;}
.dest-tag{font-size:12px;opacity:.8;margin-top:4px;}

/* ── CTA ── */
.cta-section{background:linear-gradient(135deg,var(--navy) 0%,#1a4070 100%);padding:90px 40px;text-align:center;position:relative;overflow:hidden;}
.cta-orb{position:absolute;border-radius:50%;filter:blur(60px);background:radial-gradient(circle,rgba(247,148,29,.3),transparent);}
.cta-orb-1{width:500px;height:500px;top:-200px;right:-100px;}
.cta-orb-2{width:300px;height:300px;bottom:-100px;left:-50px;}
.cta-content{position:relative;z-index:1;max-width:600px;margin:0 auto;}
.cta-title{font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(28px,4vw,48px);font-weight:800;color:#fff;margin-bottom:16px;}
.cta-title span{color:var(--orange);}
.cta-sub{font-size:16px;color:rgba(255,255,255,.7);margin-bottom:36px;line-height:1.7;}

/* ── FOOTER ── */
.footer{background:var(--navy);padding:40px;text-align:center;color:rgba(255,255,255,.5);font-size:13px;}
.footer a{color:var(--orange);text-decoration:none;}

@media(max-width:768px){
  .navbar{padding:0 20px;}
  .nav-links{display:none;}
  .stats-inner{flex-wrap:wrap;}
  .stat-item{flex:0 0 50%;border-right:none;border-bottom:1px solid #e2e8f0;}
  .dest-grid{grid-template-columns:1fr;grid-template-rows:auto;}
  .dest-card:first-child{grid-row:span 1;}
  .section{padding:60px 20px;}
}
</style>
</head>
<body>

<!-- NAVBAR -->
<nav class="navbar">
  <a href="{{ path('app_home') }}" class="logo">
    <div class="logo-icon"><i class="fas fa-globe-europe"></i></div>
    <div class="logo-text">Explo<em>ra</em></div>
  </a>
  <div class="nav-links">
    <a href="{{ path('app_home') }}" class="nav-link active">Accueil</a>
    <a href="{{ path('voyages') }}" class="nav-link">Voyages</a>
    <a href="{{ path('voyageur_index') }}" class="nav-link">Activités</a>
    <a href="{{ path('user_transport') }}" class="nav-link">Transport</a>
