        <div class="svc-link">Trouver un hôtel <i class="fas fa-arrow-right"></i></div>
      </a>
    </div>
  </div>
</div>

<!-- DESTINATIONS -->
<div class="destinations-wrap">
  <div class="destinations-inner">
    <div class="section-tag">Destinations populaires</div>
    <h2 class="section-title">Des lieux qui vous<br>feront rêver</h2>
    <div class="dest-grid">
