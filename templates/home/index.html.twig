        <div class="dest-overlay"></div>
        <div class="dest-info"><div class="dest-name">Barcelone, Espagne</div><div class="dest-tag">Plage & Culture</div></div>
      </div>
    </div>
  </div>
</div>

<!-- CTA -->
<div class="cta-section">
  <div class="cta-orb cta-orb-1"></div>
  <div class="cta-orb cta-orb-2"></div>
  <div class="cta-content">
    <h2 class="cta-title">Prêt à <span>partir à l'aventure</span> ?</h2>
    <p class="cta-sub">Rejoignez des milliers de voyageurs qui font confiance à Explora pour leurs aventures. Créez votre compte gratuitement et commencez à explorer.</p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
      <a href="{{ path('app_signup') }}" class="btn btn-primary" style="padding:16px 36px;font-size:16px;border-radius:30px;">
        <i class="fas fa-rocket"></i> Créer mon compte
      </a>
      <a href="{{ path('voyages') }}" class="btn btn-outline" style="padding:16px 36px;font-size:16px;border-radius:30px;">
        <i class="fas fa-compass"></i> Voir les voyages
      </a>
    </div>
  </div>
</div>

<!-- FOOTER -->
<footer class="footer">
  <p>© 2026 <a href="{{ path('app_home') }}">Explora</a> — Tous droits réservés. Voyagez autrement.</p>
</footer>

<script>
// Smooth reveal on scroll
const observer = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting) { e.target.style.opacity='1'; e.target.style.transform='translateY(0)'; }});
}, {threshold: 0.1});
document.querySelectorAll('.service-card, .dest-card, .stat-item').forEach(el => {
  el.style.opacity='0'; el.style.transform='translateY(20px)'; el.style.transition='opacity .5s ease, transform .5s ease';
  observer.observe(el);
});
</script>
</body>
</html>
