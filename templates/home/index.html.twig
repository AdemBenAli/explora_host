  <div class="hero-orb hero-orb-1"></div>
  <div class="hero-orb hero-orb-2"></div>
  <div class="hero-content">
    <div class="hero-badge"><i class="fas fa-star"></i> Plateforme de voyage N°1 en Tunisie</div>
